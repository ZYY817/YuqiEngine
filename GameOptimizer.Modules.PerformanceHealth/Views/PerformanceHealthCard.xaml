<UserControl x:Class="GameOptimizer.Modules.PerformanceHealth.Views.PerformanceHealthCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:GameOptimizer.Core.Models;assembly=GameOptimizer.Core"
             mc:Ignorable="d">
    <Border CornerRadius="24" Background="{StaticResource Brush.CardSurface}" Padding="26" Effect="{StaticResource Shadow.Card}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="56" Height="56" CornerRadius="20" Background="#1E2140">
                        <TextBlock Text="GO" FontSize="20" FontWeight="Bold" Foreground="#7D9BFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="16,0,0,0">
                        <TextBlock Text="{Binding GameDisplayName}"
                                   Foreground="{StaticResource Brush.TextPrimary}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding GameStatusText}"
                                   Foreground="{StaticResource Brush.TextMuted}"
                                   FontSize="13" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding HealthScore}" FontSize="40" FontWeight="Bold" Foreground="{StaticResource Brush.TextPrimary}" HorizontalAlignment="Right" />
                    <TextBlock Text="/100" Foreground="{StaticResource Brush.TextMuted}" HorizontalAlignment="Right" />
                    <Button Content="{Binding BtnRefresh}" Command="{Binding RefreshStateCommand}" Width="110" Margin="0,12,0,0" />
                </StackPanel>
            </Grid>

            <UniformGrid Grid.Row="1" Columns="4" Margin="0,24,0,16">
                <Border Background="{StaticResource Brush.CardAlt}" CornerRadius="14" Padding="12" Margin="4">
                    <StackPanel>
                        <TextBlock Text="CPU" Foreground="{StaticResource Brush.TextMuted}" />
                        <TextBlock Text="{Binding Snapshot.CpuUsage, StringFormat={}{0}%}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource Brush.CardAlt}" CornerRadius="14" Padding="12" Margin="4">
                    <StackPanel>
                        <TextBlock Text="GPU" Foreground="{StaticResource Brush.TextMuted}" />
                        <TextBlock Text="{Binding Snapshot.GpuUsage, StringFormat={}{0}%}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource Brush.CardAlt}" CornerRadius="14" Padding="12" Margin="4">
                    <StackPanel>
                        <TextBlock Text="{Binding LblMemory}" Foreground="{StaticResource Brush.TextMuted}" />
                        <TextBlock Text="{Binding Snapshot.MemoryUsageGb, StringFormat={}{0} GB}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource Brush.CardAlt}" CornerRadius="14" Padding="12" Margin="4">
                    <StackPanel>
                        <TextBlock Text="{Binding LblLatency}" Foreground="{StaticResource Brush.TextMuted}" />
                        <TextBlock Text="{Binding Snapshot.NetworkLatencyMs, StringFormat={}{0} ms}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <StackPanel Grid.Row="2">
                <TextBlock Text="{Binding LblRecommendations}" Foreground="{StaticResource Brush.TextPrimary}" FontSize="16" FontWeight="SemiBold" />
                <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Recommendations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:OptimizationRecommendation}">
                            <Border Background="#1E233F" CornerRadius="16" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource Brush.TextPrimary}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource Brush.TextMuted}" FontSize="12" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding Impact}" Foreground="{StaticResource Brush.TextPrimary}" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

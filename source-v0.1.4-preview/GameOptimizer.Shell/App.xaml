<Application x:Class="GameOptimizer.Shell.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:GameOptimizer.Shell.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml"/>
                <ResourceDictionary Source="Themes/DesignTokens.xaml"/>
                <ResourceDictionary Source="Themes/GlobalControlStyles.xaml"/>
                <ResourceDictionary Source="Themes/Animations.xaml"/>
                <ResourceDictionary Source="Themes/ModernStyles.xaml"/>
                <ResourceDictionary Source="Themes/ShellCompatibilityResources.xaml"/>
                <!-- Single final authority for native WPF control states. -->
                <ResourceDictionary Source="Themes/YuqiComponentLibrary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:EnumEqualsConverter x:Key="EnumEqualsConverter" />
            <converters:BooleanNegationConverter x:Key="BooleanNegationConverter" />
            <converters:PercentToWidthConverter x:Key="PercentToWidthConverter" MaxWidth="100"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <converters:ZeroToVisibleConverter x:Key="ZeroToVisibleConverter" />
            <converters:NonZeroToVisibleConverter x:Key="NonZeroToVisibleConverter" />
            <converters:EqualityToVisibilityConverter x:Key="EqualityToVisibilityConverter" />
            <converters:StringToVisibilityConverter x:Key="StringToVisibility" />
            <converters:EnumToBoolConverter x:Key="EnumToBoolConverter" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <DropShadowEffect x:Key="Visual.Shadow.Card" Color="Black" BlurRadius="8" ShadowDepth="1" Opacity="0.14"/>
            <DropShadowEffect x:Key="Visual.Shadow.Dialog" Color="Black" BlurRadius="22" ShadowDepth="2" Opacity="0.22"/>
            <DropShadowEffect x:Key="Visual.Shadow.NavigationSelection" Color="Black" BlurRadius="12" ShadowDepth="2" Opacity="0.14"/>
        </ResourceDictionary>
    </Application.Resources>

</Application>

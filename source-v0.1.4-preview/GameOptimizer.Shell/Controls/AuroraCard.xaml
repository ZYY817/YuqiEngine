<UserControl x:Class="GameOptimizer.Shell.Controls.AuroraCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <UserControl.Resources>
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="32"
                          ShadowDepth="0"
                          Opacity="0.45"
                          Color="#1E0F3D66" />
        <LinearGradientBrush x:Key="DefaultSurface" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1F273E" Offset="0" />
            <GradientStop Color="#12182A" Offset="1" />
        </LinearGradientBrush>
    </UserControl.Resources>
    <Border CornerRadius="30"
            Background="{Binding SurfaceBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
            Padding="26"
            SnapsToDevicePixels="True"
            Effect="{StaticResource CardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.Brush.TextPrimary}" />
                    <TextBlock Text="{Binding Subtitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontSize="12"
                               Foreground="#92A0C1"
                               Margin="0,4,0,0" />
                </StackPanel>
                <Border Background="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Height="4"
                        Width="32"
                        CornerRadius="2"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Opacity="0.9"/>
                <ContentPresenter Content="{Binding HeaderContent, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Margin="12,0,0,0"
                                  VerticalAlignment="Center"/>
            </StackPanel>

            <ContentPresenter Grid.Row="1"
                              Margin="0,18,0,0"
                              Content="{Binding Body, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Grid>
    </Border>
</UserControl>

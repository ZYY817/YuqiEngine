<UserControl x:Class="GameOptimizer.Shell.Controls.RiskGauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Background="{DynamicResource Theme.Brush.RowBackground}" BorderBrush="{DynamicResource Theme.Brush.CardBorder}" BorderThickness="1" CornerRadius="10" Padding="16">
        <StackPanel>
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TxtIcon" Text="✅" FontSize="16" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtTitle" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="14" FontWeight="Medium"/>
                </StackPanel>
                <Border x:Name="ModifiedCountBadge" HorizontalAlignment="Right" Background="#1A007AFF" 
                        CornerRadius="4" Padding="8,2" Visibility="Collapsed">
                    <TextBlock x:Name="TxtModifiedCount" Foreground="#2E88F2" FontSize="11"/>
                </Border>
            </Grid>
            
            <TextBlock x:Name="TxtInitialState" Text="当前为默认设置" Foreground="#6B6B70" 
                       FontSize="12" Margin="0,8,0,0" Visibility="Collapsed"/>
            
            <StackPanel x:Name="RiskValuePanel" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                <TextBlock x:Name="TxtRiskValue" Text="0" Foreground="#34C759" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="/100" Foreground="#48484A" FontSize="14" VerticalAlignment="Bottom" Margin="2,0,0,6"/>
            </StackPanel>
            
            <Border Height="8" CornerRadius="4" Margin="0,12,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#34C759" Offset="0"/>
                        <GradientStop Color="#34C759" Offset="0.2"/>
                        <GradientStop Color="#FF9500" Offset="0.5"/>
                        <GradientStop Color="#FF3B30" Offset="0.8"/>
                        <GradientStop Color="#FF3B30" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Canvas ClipToBounds="True">
                    <Border x:Name="Indicator" Width="4" Height="12" CornerRadius="2" 
                            Background="White" Canvas.Top="-2" Canvas.Left="0"/>
                </Canvas>
            </Border>
            
            <TextBlock x:Name="TxtRiskLevel" Text="当前设置安全，可放心使用" Foreground="#34C759" 
                       FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</UserControl>

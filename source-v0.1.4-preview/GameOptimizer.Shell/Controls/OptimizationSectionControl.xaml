<UserControl x:Class="GameOptimizer.Shell.Controls.OptimizationSectionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GameOptimizer.Shell.Controls"
             x:Name="Root">
    <Border Background="#0D1424" CornerRadius="16" Padding="20">
        <StackPanel>
            <!-- 标题栏 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Border Width="32" Height="32" CornerRadius="8" Background="{Binding IconBackground, ElementName=Root}">
                    <TextBlock Text="{Binding Icon, ElementName=Root}" FontFamily="Segoe MDL2 Assets" FontSize="16" 
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding Title, ElementName=Root}" FontSize="16" FontWeight="SemiBold" 
                           Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <Border Background="#1E2A42" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="11" Foreground="#8B94C6">
                        <Run Text="{Binding ItemsSource.Count, ElementName=Root, Mode=OneWay}"/><Run Text="项"/>
                    </TextBlock>
                </Border>
            </StackPanel>
            
            <!-- 优化项列表 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="{Binding MaxHeight, ElementName=Root}">
                <ItemsControl ItemsSource="{Binding ItemsSource, ElementName=Root}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:OptimizationCardControl Margin="0,0,0,10"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            
            <!-- 底部操作按钮 -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="全选" Click="SelectAll_Click" Style="{StaticResource SecondaryBtnStyle}" Padding="14,8" Margin="0,0,10,0"/>
                <Button Content="全不选" Click="DeselectAll_Click" Style="{StaticResource SecondaryBtnStyle}" Padding="14,8"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>

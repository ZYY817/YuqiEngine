<UserControl x:Class="GameOptimizer.Shell.Controls.EmptyState"
             x:Name="EmptyStateRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GameOptimizer.Shell.Controls"
             AutomationProperties.Name="{Binding Title, ElementName=EmptyStateRoot}">
    <Border Padding="{DynamicResource Token.Padding.CardLarge}"
            CornerRadius="0"
            BorderThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Theme.Brush.CardBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.CardBorder}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding VisualState, ElementName=EmptyStateRoot}" Value="Loading"><Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Info}"/></DataTrigger>
                    <DataTrigger Binding="{Binding VisualState, ElementName=EmptyStateRoot}" Value="Error"><Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Error}"/></DataTrigger>
                    <DataTrigger Binding="{Binding VisualState, ElementName=EmptyStateRoot}" Value="Unauthorized"><Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Warning}"/></DataTrigger>
                    <DataTrigger Binding="{Binding VisualState, ElementName=EmptyStateRoot}" Value="Recovering"><Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Warning}"/></DataTrigger>
                    <DataTrigger Binding="{Binding VisualState, ElementName=EmptyStateRoot}" Value="Success"><Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Success}"/></DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="64" Height="64"
                    CornerRadius="0"
                    Background="{DynamicResource Theme.Brush.IconBackground}"
                    Margin="0,0,0,16"
                    HorizontalAlignment="Center">
                <TextBlock Text="{Binding Icon, ElementName=EmptyStateRoot}"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="{DynamicResource Token.FontSize.2xl}"
                           Foreground="{DynamicResource Theme.Brush.IconPrimary}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="{Binding Title, ElementName=EmptyStateRoot}"
                       Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                       FontSize="{DynamicResource Token.FontSize.Lg}"
                       FontWeight="{DynamicResource Token.FontWeight.SemiBold}"
                       HorizontalAlignment="Center"
                       MaxWidth="360"
                       TextWrapping="Wrap"
                       TextAlignment="Center"/>
            <TextBlock Text="{Binding Description, ElementName=EmptyStateRoot}"
                       Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                       FontSize="{DynamicResource Token.FontSize.Sm}"
                       Margin="{DynamicResource Token.Padding.Sm}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       MaxWidth="320"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="StateHint"
                       FontSize="{DynamicResource Token.FontSize.Sm}"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding VisualState, ElementName=EmptyStateRoot}" Value="Loading"><Setter Property="Visibility" Value="Visible"/><Setter Property="Text" Value="正在加载…"/></DataTrigger>
                            <DataTrigger Binding="{Binding VisualState, ElementName=EmptyStateRoot}" Value="Error"><Setter Property="Visibility" Value="Visible"/><Setter Property="Text" Value="加载失败，请重试。"/><Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Error}"/></DataTrigger>
                            <DataTrigger Binding="{Binding VisualState, ElementName=EmptyStateRoot}" Value="Unauthorized"><Setter Property="Visibility" Value="Visible"/><Setter Property="Text" Value="需要权限才能继续。"/><Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Warning}"/></DataTrigger>
                            <DataTrigger Binding="{Binding VisualState, ElementName=EmptyStateRoot}" Value="Recovering"><Setter Property="Visibility" Value="Visible"/><Setter Property="Text" Value="正在恢复，请稍候…"/><Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Warning}"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button x:Name="ActionBtn"
                    Content="{Binding ActionText, ElementName=EmptyStateRoot}"
                    Click="ActionBtn_Click"
                    Margin="{DynamicResource Token.Padding.Md}"
                    Padding="{DynamicResource Token.Padding.Button}"
                    HorizontalAlignment="Center"
                    MinHeight="{DynamicResource Token.Size.MinInteractive}"
                    FocusVisualStyle="{StaticResource Token.FocusVisualStyle}"
                    controls:ControlStateProperties.State="{Binding VisualState, ElementName=EmptyStateRoot}"
                    AutomationProperties.Name="{Binding ActionText, ElementName=EmptyStateRoot}"
                    Visibility="{Binding HasAction, ElementName=EmptyStateRoot, Converter={StaticResource BoolToVisibilityConverter}}">
                <Button.ContentTemplate>
                    <DataTemplate><TextBlock Text="{Binding}" MaxWidth="240" TextWrapping="Wrap" TextAlignment="Center"/></DataTemplate>
                </Button.ContentTemplate>
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource AppButton}">
                        <Setter Property="Background" Value="{DynamicResource Theme.Brush.ControlAccent}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextOnAccent}"/>
                        <Setter Property="FontWeight" Value="{DynamicResource Token.FontWeight.Medium}"/>
                        <Setter Property="Padding" Value="{DynamicResource Token.Padding.Button}"/>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Border>
</UserControl>

<UserControl x:Class="GameOptimizer.Shell.Controls.StatusBadge"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GameOptimizer.Shell.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             AutomationProperties.Name="{Binding Text, ElementName=Root}">
    <Border CornerRadius="{DynamicResource Token.Radius.Badge}"
            Padding="{DynamicResource Token.Padding.ButtonSm}"
            BorderThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceRaised}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="Info"><Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Info}"/></DataTrigger>
                    <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="Success"><Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Success}"/></DataTrigger>
                    <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="Warning"><Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Warning}"/></DataTrigger>
                    <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="Error"><Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Error}"/></DataTrigger>
                    <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="Loading"><Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Info}"/></DataTrigger>
                    <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="Unauthorized"><Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Warning}"/></DataTrigger>
                    <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="Recovering"><Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Warning}"/></DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel Orientation="Horizontal">
            <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"
                     Visibility="{Binding ShowDot, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="{DynamicResource Theme.Brush.Info}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="Success"><Setter Property="Fill" Value="{DynamicResource Theme.Brush.Success}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="Warning"><Setter Property="Fill" Value="{DynamicResource Theme.Brush.Warning}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="Error"><Setter Property="Fill" Value="{DynamicResource Theme.Brush.Error}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="Unauthorized"><Setter Property="Fill" Value="{DynamicResource Theme.Brush.Warning}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="Recovering"><Setter Property="Fill" Value="{DynamicResource Theme.Brush.Warning}"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="{Binding Text, ElementName=Root}"
                       FontSize="{DynamicResource Token.FontSize.Sm}"
                       MaxWidth="320"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="Info"><Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Info}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="Success"><Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Success}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Warning}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Error}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="Loading"><Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Info}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="Unauthorized"><Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Warning}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="Recovering"><Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Warning}"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>

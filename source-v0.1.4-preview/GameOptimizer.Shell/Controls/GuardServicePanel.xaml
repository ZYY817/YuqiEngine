<!-- File: GameOptimizer.Shell/Controls/GuardServicePanel.xaml -->
<UserControl x:Class="GameOptimizer.Shell.Controls.GuardServicePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Border CornerRadius="8" Background="{DynamicResource Theme.Brush.CardBackgroundAlt}" 
            BorderBrush="{DynamicResource Theme.Brush.CardBorderSubtle}" BorderThickness="1"
            Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Icon & Title -->
                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="5" Background="#15F59E0B" Margin="0,0,10,0">
                    <TextBlock Text="🛡" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="优化守护服务" FontSize="13" FontWeight="SemiBold" 
                               Foreground="{DynamicResource Theme.Brush.TextPrimary}"/>
                    <TextBlock x:Name="StatusText" Text="已禁用" FontSize="10" 
                               Foreground="{DynamicResource Theme.Brush.TextMuted}" Margin="0,2,0,0"/>
                </StackPanel>
                
                <!-- Expand/Collapse Button -->
                <Border Grid.Column="2" Width="28" Height="28" CornerRadius="6" Background="Transparent" 
                        Cursor="Hand" MouseLeftButtonUp="ToggleExpand_Click">
                    <TextBlock x:Name="ExpandIcon" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" 
                               FontSize="12" Foreground="{DynamicResource Theme.Brush.TextMuted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
            
            <!-- Expanded Content -->
            <Border x:Name="ExpandedContent" Grid.Row="1" Visibility="Collapsed" Margin="0,12,0,0">
                <StackPanel>
                    <!-- Status Info -->
                    <Border CornerRadius="6" Background="{DynamicResource Theme.Brush.DialogBackground}" 
                            Padding="10,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="保护项数" FontSize="9" Foreground="{DynamicResource Theme.Brush.TextDisabled}"/>
                                <TextBlock x:Name="ProtectedCountText" Text="0" FontSize="16" FontWeight="SemiBold" 
                                           Foreground="{DynamicResource Theme.Brush.TextPrimary}" Margin="0,2,0,0"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="最后检查" FontSize="9" Foreground="{DynamicResource Theme.Brush.TextDisabled}"/>
                                <TextBlock x:Name="LastCheckText" Text="从未" FontSize="10" 
                                           Foreground="{DynamicResource Theme.Brush.TextMuted}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- Action Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Enable/Disable Button -->
                        <Border x:Name="ToggleBtn" Grid.Column="0" Grid.Row="0" CornerRadius="6" 
                                Background="{DynamicResource Theme.Brush.ButtonBackground}" 
                                Padding="0,8" Cursor="Hand" MouseLeftButtonUp="ToggleService_Click">
                            <TextBlock x:Name="ToggleBtnText" Text="启用守护" FontSize="11" 
                                       Foreground="{DynamicResource Theme.Brush.TextPrimary}" 
                                       HorizontalAlignment="Center"/>
                        </Border>
                        
                        <!-- Settings Button -->
                        <Border Grid.Column="2" Grid.Row="0" CornerRadius="6" 
                                Background="{DynamicResource Theme.Brush.ButtonBackground}" 
                                Padding="0,8" Cursor="Hand" MouseLeftButtonUp="Settings_Click">
                            <TextBlock Text="设置" FontSize="11" 
                                       Foreground="{DynamicResource Theme.Brush.TextPrimary}" 
                                       HorizontalAlignment="Center"/>
                        </Border>
                        
                        <!-- View List Button -->
                        <Border Grid.Column="0" Grid.Row="2" CornerRadius="6" 
                                Background="{DynamicResource Theme.Brush.ButtonBackground}" 
                                Padding="0,8" Cursor="Hand" MouseLeftButtonUp="ViewList_Click">
                            <TextBlock Text="查看列表" FontSize="11" 
                                       Foreground="{DynamicResource Theme.Brush.TextPrimary}" 
                                       HorizontalAlignment="Center"/>
                        </Border>
                        
                        <!-- Check Now Button -->
                        <Border x:Name="CheckNowBtn" Grid.Column="2" Grid.Row="2" CornerRadius="6" 
                                Background="{DynamicResource Theme.Brush.ButtonBackground}" 
                                Padding="0,8" Cursor="Hand" MouseLeftButtonUp="CheckNow_Click"
                                IsEnabled="False" Opacity="0.5">
                            <TextBlock Text="立即检查" FontSize="11" 
                                       Foreground="{DynamicResource Theme.Brush.TextPrimary}" 
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>

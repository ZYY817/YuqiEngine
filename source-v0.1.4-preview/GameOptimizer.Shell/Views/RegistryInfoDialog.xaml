<Window x:Class="GameOptimizer.Shell.Views.RegistryInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="高级信息" Width="620" Height="640"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize">
    <Border Background="{DynamicResource Theme.Brush.BackgroundSecondary}" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource Theme.Brush.BorderSubtle}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.6" Color="{DynamicResource Theme.Color.Shadow}"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="{DynamicResource Theme.Brush.SurfaceMuted}" CornerRadius="16,16,0,0" Padding="20,14" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📋" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock x:Name="DialogTitle" Text="高级信息（可选）" Foreground="{DynamicResource Theme.Brush.TextPrimaryAlt}" FontSize="15" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" Click="Close_Click"
                            Background="Transparent" Foreground="{DynamicResource Theme.Brush.TextMuted}" BorderThickness="0"
                            Width="28" Height="28" Cursor="Hand" FontSize="14"/>
                </Grid>
            </Border>
            
            <!-- 内容区域 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                <StackPanel>
                    <!-- 优化项名称 -->
                    <Border Background="{DynamicResource Theme.Brush.RowBackground}" CornerRadius="10" Padding="16,12" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock x:Name="OptimizationTitle" Text="优化项名称" Foreground="{DynamicResource Theme.Brush.TextPrimaryAlt}" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock x:Name="OptimizationDesc" Text="优化项描述" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- 为什么这样做 -->
                    <Border x:Name="WhyPanel" Background="{DynamicResource Theme.Brush.CardBackgroundAlt}" CornerRadius="10" Padding="16,12" Margin="0,0,0,16" 
                            BorderBrush="#334ADE80" BorderThickness="1" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="LblWhyTitle" Text="💡 为什么这样做" Foreground="#4ADE80" FontSize="12" FontWeight="Medium" Margin="0,0,0,8"/>
                            <TextBlock x:Name="WhyText" Text="" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="12" TextWrapping="Wrap" LineHeight="20"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- 注册表位置 -->
                    <TextBlock x:Name="LblRegLocation" Text="📍 系统设置位置（可选）" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="13" FontWeight="Medium" Margin="0,0,0,8"/>
                    <Border Background="{DynamicResource Theme.Brush.PanelBackground}" CornerRadius="8" Padding="14,12" BorderBrush="{DynamicResource Theme.Brush.Border}" BorderThickness="1" Margin="0,0,0,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" x:Name="LblKeyPath" Text="键路径:" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="11"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="KeyPathText" Text="HKLM\..." Foreground="#4ADE80" FontSize="11" 
                                       FontFamily="Consolas" TextWrapping="Wrap"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" x:Name="LblValueName" Text="值名称:" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="11" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ValueNameText" Text="ValueName" Foreground="#60A5FA" FontSize="11" 
                                       FontFamily="Consolas" Margin="0,6,0,0"/>
                        </Grid>
                    </Border>
                    
                    <!-- 复制按钮 -->
                    <Border Background="{DynamicResource Theme.Brush.Border}" CornerRadius="6" Padding="10,6" HorizontalAlignment="Left"
                            Cursor="Hand" MouseLeftButtonUp="CopyPath_Click" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄" FontSize="11"/>
                            <TextBlock x:Name="CopyBtnText" Text="复制完整路径" FontSize="11" Foreground="{DynamicResource Theme.Brush.TextSecondary}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- 值对比区域 -->
                    <TextBlock x:Name="LblValueCompare" Text="📊 设置变化（可选）" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="13" FontWeight="Medium" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- 当前系统值 -->
                        <Border Grid.Column="0" Background="{DynamicResource Theme.Brush.SurfaceMuted}" CornerRadius="8" Padding="12" Margin="0,0,6,0" BorderBrush="{DynamicResource Theme.Brush.Border}" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Ellipse Width="8" Height="8" Fill="#FBBF24"/>
                                    <TextBlock x:Name="LblCurrentValue" Text="当前系统值" Foreground="#FBBF24" FontSize="11" FontWeight="Medium" Margin="6,0,0,0"/>
                                </StackPanel>
                                <Border Background="{DynamicResource Theme.Brush.PanelBackground}" CornerRadius="6" Padding="10,8">
                                    <TextBlock x:Name="CurrentValueText" Text="-" Foreground="{DynamicResource Theme.Brush.TextPrimaryAlt}" FontSize="13" FontFamily="Consolas" 
                                               TextWrapping="Wrap" TextAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        
                        <!-- 优化后的值 -->
                        <Border Grid.Column="1" Background="{DynamicResource Theme.Brush.SurfaceMuted}" CornerRadius="8" Padding="12" Margin="3,0,3,0" BorderBrush="{DynamicResource Theme.Brush.Border}" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Ellipse Width="8" Height="8" Fill="#4ADE80"/>
                                    <TextBlock x:Name="LblOptimizedValue" Text="优化值" Foreground="#4ADE80" FontSize="11" FontWeight="Medium" Margin="6,0,0,0"/>
                                </StackPanel>
                                <Border Background="{DynamicResource Theme.Brush.PanelBackground}" CornerRadius="6" Padding="10,8">
                                    <TextBlock x:Name="OptimizedValueText" Text="-" Foreground="{DynamicResource Theme.Brush.TextPrimaryAlt}" FontSize="13" FontFamily="Consolas" 
                                               TextWrapping="Wrap" TextAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        
                        <!-- Windows 默认值 -->
                        <Border Grid.Column="2" Background="{DynamicResource Theme.Brush.SurfaceMuted}" CornerRadius="8" Padding="12" Margin="6,0,0,0" BorderBrush="{DynamicResource Theme.Brush.Border}" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource Theme.Brush.IconMuted}"/>
                                    <TextBlock x:Name="LblDefaultValue" Text="Windows 默认" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="11" FontWeight="Medium" Margin="6,0,0,0"/>
                                </StackPanel>
                                <Border Background="{DynamicResource Theme.Brush.PanelBackground}" CornerRadius="6" Padding="10,8">
                                    <TextBlock x:Name="DefaultValueText" Text="-" Foreground="{DynamicResource Theme.Brush.TextPrimaryAlt}" FontSize="13" FontFamily="Consolas" 
                                               TextWrapping="Wrap" TextAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                    
                    <!-- 值类型 -->
                    <Border Background="{DynamicResource Theme.Brush.RowBackground}" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="LblValueType" Text="值类型:" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="11"/>
                            <TextBlock x:Name="ValueTypeText" Text="DWORD (32位)" Foreground="#60A5FA" FontSize="11" FontFamily="Consolas" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- 状态指示 -->
                    <Border x:Name="StatusBorder" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="StatusIcon" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#22C55E"/>
                            <TextBlock x:Name="StatusText" Text="当前已应用优化值" Foreground="{DynamicResource Theme.Brush.TextPrimaryAlt}" FontSize="12" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- 手动操作说明 -->
                    <Border Background="{DynamicResource Theme.Brush.CardBackgroundAlt}" CornerRadius="8" Padding="14,12" BorderBrush="{DynamicResource Theme.Brush.Border}" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="💡" FontSize="12"/>
                                <TextBlock x:Name="LblManualMethod" Text="手动修改方法" Foreground="#60A5FA" FontSize="12" FontWeight="Medium" Margin="6,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="ManualStepsText" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="11" TextWrapping="Wrap" LineHeight="20">
                                <Run x:Name="Step1Label" FontWeight="SemiBold">步骤 1:</Run><Run x:Name="Step1Text"> 按 Win+R，输入 regedit 打开注册表编辑器</Run><LineBreak/>
                                <Run x:Name="Step2Label" FontWeight="SemiBold">步骤 2:</Run><Run x:Name="Step2Text"> 在右侧面板找到值名称 "</Run><Run x:Name="StepValueName" Foreground="#60A5FA">ValueName</Run><Run>"</Run><LineBreak/>
                                <Run x:Name="Step3Label" FontWeight="SemiBold">步骤 3:</Run><Run x:Name="Step3Text"> 双击该值，修改数据为您需要的值</Run><LineBreak/>
                                <Run x:Name="Step4Label" FontWeight="SemiBold">步骤 4:</Run><Run x:Name="Step4Text"> 点击确定保存，部分设置需要重启生效</Run>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            
            <!-- 底部按钮 -->
            <Border Grid.Row="2" Background="{DynamicResource Theme.Brush.SurfaceMuted}" CornerRadius="0,0,16,16" Padding="20,14">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button x:Name="RefreshBtn" Click="Refresh_Click" Cursor="Hand"
                                Background="Transparent" Foreground="{DynamicResource Theme.Brush.TextMuted}" BorderThickness="1" BorderBrush="{DynamicResource Theme.Brush.BorderLight}"
                                Padding="12,6" FontSize="11" ToolTip="重新读取当前系统值">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔄" FontSize="10"/>
                                            <TextBlock x:Name="RefreshText" Text="刷新" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="11" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Brush.CardBackgroundHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="OpenRegeditBtn" Click="OpenRegedit_Click" Cursor="Hand"
                                Background="#2563EB" Foreground="White" BorderThickness="0"
                                Padding="16,8" FontSize="12">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔧" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="OpenRegeditText" Text="打开注册表" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#3B82F6"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="CloseBtn" Click="Close_Click" Cursor="Hand" Margin="10,0,0,0"
                                Background="Transparent" Foreground="{DynamicResource Theme.Brush.TextSecondary}" BorderThickness="1" BorderBrush="{DynamicResource Theme.Brush.BorderLight}"
                                Padding="16,8" FontSize="12">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <TextBlock x:Name="CloseText" Text="关闭" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="12"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Brush.CardBackgroundHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

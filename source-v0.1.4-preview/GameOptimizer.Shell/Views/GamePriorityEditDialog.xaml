<!-- File: GameOptimizer.Shell/Views/GamePriorityEditDialog.xaml -->
<Window x:Class="GameOptimizer.Shell.Views.GamePriorityEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Game Priority" Width="550" Height="450"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource Theme.Brush.RowBackground}" BorderBrush="{DynamicResource Theme.Brush.CardBorder}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource Theme.Brush.BackgroundSecondary}" CornerRadius="12,12,0,0" Padding="16,12"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock x:Name="DialogTitleText" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="&#x2715;" HorizontalAlignment="Right" Click="CloseButton_Click"
                            Background="Transparent" BorderThickness="0" Foreground="#6B6B70" 
                            FontSize="14" Cursor="Hand" Width="24" Height="24"/>
                </Grid>
            </Border>
            
            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                <StackPanel>
                    <!-- Game Name -->
                    <TextBlock x:Name="LblGameName" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="13" Margin="0,0,0,8"/>
                    <TextBox x:Name="GameNameBox" Background="{DynamicResource Theme.Brush.RowBackground}" Foreground="{DynamicResource Theme.Brush.TextPrimary}" 
                             BorderBrush="{DynamicResource Theme.Brush.CardBorder}" Padding="12,10" FontSize="13" Margin="0,0,0,16"/>
                    
                    <!-- Executable Path -->
                    <TextBlock x:Name="LblExePath" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="13" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ExePathBox" Background="{DynamicResource Theme.Brush.RowBackground}" Foreground="{DynamicResource Theme.Brush.TextPrimary}" 
                                 BorderBrush="{DynamicResource Theme.Brush.CardBorder}" Padding="12,10" FontSize="13" IsReadOnly="True"/>
                        <Button x:Name="BrowseBtn" Grid.Column="1" Click="BrowseButton_Click" Margin="8,0,0,0"
                                Background="{DynamicResource Theme.Brush.CardBackgroundAlt}" BorderBrush="{DynamicResource Theme.Brush.CardBorder}" BorderThickness="1"
                                Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="12" Padding="16,10" Cursor="Hand"/>
                    </Grid>
                    
                    <!-- Priority Selection -->
                    <Border Background="{DynamicResource Theme.Brush.BackgroundSecondary}" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="LblPriority" Text="Process Priority" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="13" FontWeight="Medium"/>
                                <TextBlock x:Name="LblPriorityDesc" Text="Higher priority = more CPU resources" Foreground="#6B6B70" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                            <ComboBox x:Name="PriorityCombo" Grid.Column="1" Width="160" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Priority Info Card -->
                    <Border Background="#1A2E88F2" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="ℹ️" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock x:Name="LblPriorityInfo" Foreground="#2E88F2" FontSize="13" FontWeight="Medium"/>
                            </StackPanel>
                            <TextBlock x:Name="PriorityInfoText" TextWrapping="Wrap" Foreground="#6B6B70" FontSize="11" LineHeight="16"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Enable Toggle -->
                    <Border Background="{DynamicResource Theme.Brush.RowBackground}" CornerRadius="8" Padding="14">
                        <Grid>
                            <StackPanel>
                                <TextBlock x:Name="LblEnabled" Text="Enable Auto Priority" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="13" FontWeight="Medium"/>
                                <TextBlock x:Name="LblEnabledDesc" Text="Automatically apply priority when game starts" Foreground="#6B6B70" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="EnabledCheck" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="True"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            
            <!-- Footer Buttons -->
            <Border Grid.Row="2" Background="{DynamicResource Theme.Brush.BackgroundSecondary}" CornerRadius="0,0,12,12" Padding="20,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelBtn" Click="CancelButton_Click"
                            Background="Transparent" BorderBrush="{DynamicResource Theme.Brush.CardBorder}" BorderThickness="1"
                            Foreground="#A1A1A6" FontSize="13" Padding="20,10" Cursor="Hand"/>
                    <Button x:Name="SaveBtn" Click="SaveButton_Click" Margin="12,0,0,0"
                            Background="#2E88F2" BorderThickness="0"
                            Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="13" Padding="20,10" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

<!-- File: GameOptimizer.Shell/Views/ProcessPriorityEditDialog.xaml -->
<Window x:Class="GameOptimizer.Shell.Views.ProcessPriorityEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="进程优先级配置" Height="580" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.Brush.AppBackground}"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True">
    <Window.Resources>
        <!-- Dialog Border Style -->
        <Style x:Key="DialogBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.CardBackground}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.GlassBorder}"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.2" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Padding="20,0"
                                Background="{DynamicResource Theme.Brush.HeroButtonBackground}"
                                BorderThickness="1" BorderBrush="#30FFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Brush.HeroButtonBackgroundHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Padding="20,0"
                                Background="Transparent"
                                BorderThickness="1" BorderBrush="{DynamicResource Theme.Brush.BorderLight}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#10FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource DialogBorder}" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#10FFFFFF" CornerRadius="16,16,0,0" Padding="24,20">
                <Grid>
                    <TextBlock x:Name="DialogTitle" FontSize="18" FontWeight="Bold" 
                               Foreground="{DynamicResource Theme.Brush.TextPrimaryAlt}"/>
                    <Button x:Name="CloseButton" Content="✕" Click="CloseButton_Click"
                            Width="32" Height="32" HorizontalAlignment="Right"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource Theme.Brush.TextMuted}"
                            FontSize="16" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
                <StackPanel>
                    <!-- Game Name -->
                    <TextBlock x:Name="GameNameLabel" FontSize="12" FontWeight="Medium"
                               Foreground="{DynamicResource Theme.Brush.TextSecondary}" Margin="0,0,0,8"/>
                    <TextBox x:Name="GameNameTextBox" Height="40" Padding="12,0"
                             FontSize="14" Margin="0,0,0,20"
                             Background="{DynamicResource Theme.Brush.InputBackground}"
                             Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                             BorderBrush="{DynamicResource Theme.Brush.BorderLight}"
                             BorderThickness="1"/>

                    <!-- Executable Path -->
                    <TextBlock x:Name="ExecutablePathLabel" FontSize="12" FontWeight="Medium"
                               Foreground="{DynamicResource Theme.Brush.TextSecondary}" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ExecutablePathTextBox" Grid.Column="0" Height="40" Padding="12,0"
                                 FontSize="13" IsReadOnly="True"
                                 Background="{DynamicResource Theme.Brush.InputBackground}"
                                 Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                                 BorderBrush="{DynamicResource Theme.Brush.BorderLight}"
                                 BorderThickness="1"/>
                        <Button x:Name="BrowseButton" Grid.Column="1" Click="BrowseButton_Click"
                                Width="80" Height="40" Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButton}"
                                Foreground="{DynamicResource Theme.Brush.TextSecondary}"/>
                    </Grid>

                    <!-- Priority Selection -->
                    <TextBlock x:Name="PriorityLabel" FontSize="12" FontWeight="Medium"
                               Foreground="{DynamicResource Theme.Brush.TextSecondary}" Margin="0,0,0,12"/>
                    <StackPanel x:Name="PriorityOptionsPanel" Margin="0,0,0,16">
                        <RadioButton x:Name="PriorityIdle" GroupName="Priority" Margin="0,0,0,10"
                                     Foreground="{DynamicResource Theme.Brush.TextPrimary}"/>
                        <RadioButton x:Name="PriorityBelowNormal" GroupName="Priority" Margin="0,0,0,10"
                                     Foreground="{DynamicResource Theme.Brush.TextPrimary}"/>
                        <RadioButton x:Name="PriorityNormal" GroupName="Priority" Margin="0,0,0,10"
                                     Foreground="{DynamicResource Theme.Brush.TextPrimary}"/>
                        <RadioButton x:Name="PriorityAboveNormal" GroupName="Priority" Margin="0,0,0,10" IsChecked="True"
                                     Foreground="{DynamicResource Theme.Brush.TextPrimary}"/>
                        <RadioButton x:Name="PriorityHigh" GroupName="Priority" Margin="0,0,0,10"
                                     Foreground="{DynamicResource Theme.Brush.TextPrimary}"/>
                        <RadioButton x:Name="PriorityRealtime" GroupName="Priority" Margin="0,0,0,10"
                                     Foreground="#F87171" Checked="PriorityRealtime_Checked"/>
                    </StackPanel>

                    <!-- Realtime Warning -->
                    <Border x:Name="RealtimeWarning" Visibility="Collapsed" 
                            Background="#1AEF4444" BorderBrush="#EF4444" BorderThickness="1"
                            CornerRadius="8" Padding="12" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️" FontSize="16" VerticalAlignment="Top" Margin="0,0,8,0"/>
                            <TextBlock x:Name="RealtimeWarningText" TextWrapping="Wrap" FontSize="12"
                                       Foreground="#EF4444" LineHeight="18"/>
                        </StackPanel>
                    </Border>

                    <!-- Enable Checkbox -->
                    <CheckBox x:Name="EnableCheckBox" IsChecked="True" Margin="0,4,0,0"
                              Foreground="{DynamicResource Theme.Brush.TextPrimary}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#10FFFFFF" CornerRadius="0,0,16,16" Padding="24,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Click="CancelButton_Click"
                            Style="{StaticResource SecondaryButton}"
                            Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                            Margin="0,0,12,0"/>
                    <Button x:Name="SaveButton" Click="SaveButton_Click"
                            Style="{StaticResource PrimaryButton}">
                        <TextBlock Foreground="White" FontWeight="SemiBold"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

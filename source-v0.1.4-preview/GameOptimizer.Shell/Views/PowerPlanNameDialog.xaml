<Window x:Class="GameOptimizer.Shell.Views.PowerPlanNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="创建电源计划" Width="520" Height="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource Theme.Brush.DialogBackground}" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource Theme.Brush.DialogBorder}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.5" Color="{DynamicResource Theme.Color.Shadow}"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- 顶部光晕效果 -->
            <Border Grid.Row="0" Grid.RowSpan="2" Height="120" VerticalAlignment="Top" IsHitTestVisible="False" CornerRadius="12,12,0,0" Background="{DynamicResource Theme.Brush.DialogGlow}"/>
            
            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="Transparent" Padding="20,16" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,14,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2022D3EE" Offset="0"/>
                                    <GradientStop Color="#1022D3EE" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Brush.TextPrimary}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="DialogTitle" Text="创建电源计划" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DialogSubtitle" Text="为您的优化方案命名" Foreground="{DynamicResource Theme.Brush.TextDisabled}" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" Click="Cancel_Click" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Theme.Brush.TextDisabled}" FontSize="14" Cursor="Hand" Width="36" Height="36">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Width="36" Height="36">
                                    <TextBlock Text="✕" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Brush.TextDisabled}" FontSize="14"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Brush.CardBackgroundHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
            
            <!-- 主内容区 -->
            <Border Grid.Row="1" Padding="20,8,20,16">
                <StackPanel>
                
                <!-- 方案信息卡片 -->
                <Border Background="{DynamicResource Theme.Brush.CardBackgroundAlt}" BorderBrush="{DynamicResource Theme.Brush.CardBorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock x:Name="PlanIconText" Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" Foreground="#60A5FA"/>
                            <TextBlock x:Name="PlanNameText" Text="游戏优化方案" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="PlanDescText" Text="针对游戏场景优化的电源方案" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                
                <!-- 电源计划名称输入 -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock x:Name="LblPlanName" Text="电源计划名称" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="13" FontWeight="Medium" Margin="0,0,0,8"/>
                    <TextBox x:Name="PlanNameInput" Text="宇奇引擎 - 游戏优化" 
                             Background="{DynamicResource Theme.Brush.DialogBackground}" 
                             Foreground="{DynamicResource Theme.Brush.TextPrimary}" 
                             BorderBrush="{DynamicResource Theme.Brush.CardBorder}" 
                             BorderThickness="1" Padding="12,10" CaretBrush="#22D3EE" FontSize="13">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsFocused" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#22D3EE"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </StackPanel>
                
                <!-- 提示信息 -->
                <Border CornerRadius="8" Padding="12" Background="#0822D3EE" BorderBrush="#1522D3EE" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ℹ️" FontSize="14" Margin="0,0,10,0"/>
                        <TextBlock x:Name="TxtWarning" Text="新电源计划将不会影响您现有的电源配置" Foreground="#22D3EE" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                </StackPanel>
            </Border>
            
            <!-- 底部按钮栏 -->
            <Border Grid.Row="2" Background="{DynamicResource Theme.Brush.CardBackgroundAlt}" CornerRadius="0,0,12,12" Padding="20,14" BorderBrush="{DynamicResource Theme.Brush.CardBorderSubtle}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button x:Name="CancelBtn" Content="取消" Click="Cancel_Click" HorizontalAlignment="Left" Padding="20,10" Cursor="Hand" Grid.Column="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{DynamicResource Theme.Brush.CardBackground}" CornerRadius="8" Padding="{TemplateBinding Padding}" Cursor="Hand" BorderBrush="{DynamicResource Theme.Brush.CardBorder}" BorderThickness="1">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Brush.CardBackgroundHover}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextSecondary}"/>
                                <Setter Property="FontSize" Value="13"/>
                            </Style>
                        </Button.Style>
                    </Button>
                    
                    <Button x:Name="ConfirmBtn" Click="Confirm_Click" HorizontalAlignment="Right" Padding="24,10" Cursor="Hand" Grid.Column="1">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}" Cursor="Hand">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#22D3EE" Offset="0"/>
                                                        <GradientStop Color="#0EA5E9" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#22D3EE" BlurRadius="12" ShadowDepth="0" Opacity="0.25"/>
                                                </Border.Effect>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="✓" FontSize="14" Margin="0,0,8,0" Foreground="#FFFFFF"/>
                                                    <TextBlock x:Name="ConfirmBtnText" Text="确认创建" Foreground="#FFFFFF" FontSize="13" FontWeight="Medium"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

<!-- File: GameOptimizer.Shell/Views/RevertResultDialog.xaml -->
<Window x:Class="GameOptimizer.Shell.Views.RevertResultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="已取消的优化项" Width="680" Height="600"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown"
        FocusManager.FocusedElement="{Binding ElementName=CloseBtn}">
    <Border Background="{DynamicResource Theme.Brush.BackgroundSecondary}" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource Theme.Brush.BorderSubtle}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.5" Color="{DynamicResource Theme.Color.Shadow}"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="{DynamicResource Theme.Brush.SurfaceMuted}" CornerRadius="16,16,0,0" Padding="24,16" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✅" FontSize="18" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock x:Name="TitleText" Text="已取消的优化项" Foreground="{DynamicResource Theme.Brush.TextPrimaryAlt}" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SubtitleText" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" Click="Close_Click"
                            Background="Transparent" Foreground="{DynamicResource Theme.Brush.TextMuted}" BorderThickness="0"
                            Width="32" Height="32" Cursor="Hand" FontSize="16">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Brush.CardBorder}"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
            
            <!-- 搜索框 -->
            <Border Grid.Row="1" Padding="24,16,24,12">
                <Border Background="{DynamicResource Theme.Brush.CardBackground}" BorderBrush="{DynamicResource Theme.Brush.CardBorder}" 
                        BorderThickness="1" CornerRadius="8" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource Theme.Brush.TextMuted}"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0" 
                                 VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource Theme.Brush.TextPrimaryAlt}"
                                 TextChanged="SearchBox_TextChanged"/>
                        <TextBlock Grid.Column="1" x:Name="SearchPlaceholder" Text="搜索优化项..." IsHitTestVisible="False"
                                   VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource Theme.Brush.TextMuted}"
                                   Visibility="{Binding Text.Length, ElementName=SearchBox, Converter={StaticResource ZeroToVisibleConverter}}"/>
                        <Button Grid.Column="2" Content="✕" Click="ClearSearch_Click" Cursor="Hand"
                                Visibility="{Binding Text.Length, ElementName=SearchBox, Converter={StaticResource NonZeroToVisibleConverter}}"
                                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Theme.Brush.TextMuted}"
                                Width="20" Height="20" FontSize="12" Padding="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Brush.CardBackgroundHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Border>
            
            <!-- 内容区域 -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="24,0,24,16">
                <StackPanel x:Name="GroupsContainer">
                    <!-- 空状态提示 -->
                    <Border x:Name="EmptyState" Visibility="Collapsed" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🔍" FontSize="48" HorizontalAlignment="Center" Opacity="0.3" Margin="0,0,0,16"/>
                            <TextBlock x:Name="EmptyStateText" Text="未找到匹配的优化项" 
                                       Foreground="{DynamicResource Theme.Brush.TextMuted}" 
                                       FontSize="14" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- 动态生成的分组列表 -->
                    <ItemsControl x:Name="GroupsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,12" Background="{DynamicResource Theme.Brush.CardBackground}" 
                                        BorderBrush="{DynamicResource Theme.Brush.CardBorder}" BorderThickness="1" CornerRadius="12"
                                        Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
                                        <Expander.Header>
                                            <Grid Margin="8,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding ModuleName}" 
                                                           Foreground="{DynamicResource Theme.Brush.TextPrimaryAlt}" 
                                                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" CornerRadius="6" Padding="8,4" Margin="8,0,0,0"
                                                        Background="{DynamicResource Theme.Brush.IconBackground}"
                                                        BorderBrush="{DynamicResource Theme.Brush.IconBorder}" BorderThickness="1">
                                                    <TextBlock Text="{Binding StatusText}" 
                                                               Foreground="{DynamicResource Theme.Brush.TextSecondary}" 
                                                               FontSize="11"/>
                                                </Border>
                                            </Grid>
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{Binding Items}" Margin="12,0,12,12">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="12,8" Margin="0,4,0,0" Background="{DynamicResource Theme.Brush.SurfaceMuted}" 
                                                            CornerRadius="6"
                                                            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            
                                                            <TextBlock Grid.Column="0" Grid.Row="0" Text="✓" FontSize="14" FontWeight="Bold"
                                                                       Foreground="#10B981" Margin="0,0,12,0" VerticalAlignment="Center"
                                                                       Visibility="{Binding Success, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                            <TextBlock Grid.Column="0" Grid.Row="0" Text="✗" FontSize="14" FontWeight="Bold"
                                                                       Foreground="#EF4444" Margin="0,0,12,0" VerticalAlignment="Center"
                                                                       Visibility="{Binding Success, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                                            <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding Title}" 
                                                                       Foreground="{DynamicResource Theme.Brush.TextSecondary}" 
                                                                       FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                            
                                                            <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding ErrorMessage}" 
                                                                       Foreground="#EF4444" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                                                       Visibility="{Binding Success, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            
            <!-- 底部按钮 -->
            <Border Grid.Row="3" Background="{DynamicResource Theme.Brush.SurfaceMuted}" CornerRadius="0,0,16,16" Padding="24,16">
                <Button x:Name="CloseBtn" Click="Close_Click" Cursor="Hand" HorizontalAlignment="Center" IsDefault="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="8" Padding="32,10">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#6366F1" Offset="0"/>
                                        <GradientStop Color="#8B5CF6" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock x:Name="CloseBtnText" Text="关闭" Foreground="#FFFFFF" FontSize="13" FontWeight="Medium"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#7C7FF2" Offset="0"/>
                                                <GradientStop Color="#9D7DF7" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>

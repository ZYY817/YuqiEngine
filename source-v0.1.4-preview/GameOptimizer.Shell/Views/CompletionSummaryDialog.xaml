<!-- File: GameOptimizer.Shell/Views/CompletionSummaryDialog.xaml -->
<Window x:Class="GameOptimizer.Shell.Views.CompletionSummaryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="操作完成" Width="520" Height="Auto" MinHeight="280" MaxHeight="600"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        SizeToContent="Height" ShowInTaskbar="False" Opacity="0">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        
        <!-- Success Icon Geometry: Circle with checkmark -->
        <Geometry x:Key="SuccessIconGeometry">M12,2 C6.48,2 2,6.48 2,12 C2,17.52 6.48,22 12,22 C17.52,22 22,17.52 22,12 C22,6.48 17.52,2 12,2 Z M10,17 L5,12 L6.41,10.59 L10,14.17 L17.59,6.58 L19,8 L10,17 Z</Geometry>
        
        <!-- Error Icon Geometry: Circle with X -->
        <Geometry x:Key="ErrorIconGeometry">M12,2 C6.48,2 2,6.48 2,12 C2,17.52 6.48,22 12,22 C17.52,22 22,17.52 22,12 C22,6.48 17.52,2 12,2 Z M16.3,16.3 C15.91,16.69 15.28,16.69 14.89,16.3 L12,13.41 L9.11,16.3 C8.72,16.69 8.09,16.69 7.7,16.3 C7.31,15.91 7.31,15.28 7.7,14.89 L10.59,12 L7.7,9.11 C7.31,8.72 7.31,8.09 7.7,7.7 C8.09,7.31 8.72,7.31 9.11,7.7 L12,10.59 L14.89,7.7 C15.28,7.31 15.91,7.31 16.3,7.7 C16.69,8.09 16.69,8.72 16.3,9.11 L13.41,12 L16.3,14.89 C16.69,15.28 16.69,15.91 16.3,16.3 Z</Geometry>
        
        <!-- Fade-in animation -->
        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>
    
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeInAnimation}"/>
        </EventTrigger>
    </Window.Triggers>
    
    <Border Background="{DynamicResource Theme.Brush.DialogBackground}" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource Theme.Brush.BorderSubtle}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="0" Opacity="0.5" Color="{DynamicResource Theme.Color.Shadow}"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="{DynamicResource Theme.Brush.SurfaceMuted}" CornerRadius="12,12,0,0" Padding="20,14" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="16" Height="16" Margin="0,0,10,0">
                            <Path Data="{StaticResource SuccessIconGeometry}" Fill="#10B981" Stretch="Uniform"/>
                        </Viewbox>
                        <TextBlock x:Name="TitleText" Text="操作完成" Foreground="{DynamicResource Theme.Brush.TextPrimaryAlt}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" Click="Close_Click"
                            Background="Transparent" Foreground="{DynamicResource Theme.Brush.TextMuted}" BorderThickness="0"
                            Width="28" Height="28" Cursor="Hand" FontSize="14">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#30EF4444"/>
                                        <Setter Property="Foreground" Value="#EF4444"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#40EF4444"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
            
            <!-- 内容区域 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20" MaxHeight="400">
                <StackPanel>
                    <!-- 成功信息 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="48" Height="48" CornerRadius="24" Margin="0,0,16,0">
                            <Border.Background>
                                <SolidColorBrush Color="#10B981" Opacity="0.15"/>
                            </Border.Background>
                            <Viewbox Width="28" Height="28" Margin="10">
                                <Path Data="{StaticResource SuccessIconGeometry}" Fill="#10B981" Stretch="Uniform"/>
                            </Viewbox>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="SuccessText" Text="成功应用 0 项优化" 
                                       Foreground="{DynamicResource Theme.Brush.TextPrimary}" 
                                       FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SuccessSubText" Text="所有操作已完成" 
                                       Foreground="{DynamicResource Theme.Brush.TextSecondary}" 
                                       FontSize="13" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- 失败摘要 -->
                    <Border x:Name="FailureSummaryPanel" Visibility="Collapsed" 
                            Background="{DynamicResource Theme.Brush.SurfaceMuted}" 
                            CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="16" Margin="0,0,12,0">
                                <Border.Background>
                                    <SolidColorBrush Color="#EF4444" Opacity="0.15"/>
                                </Border.Background>
                                <Viewbox Width="18" Height="18" Margin="7">
                                    <Path Data="{StaticResource ErrorIconGeometry}" Fill="#EF4444" Stretch="Uniform"/>
                                </Viewbox>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="FailureText" Text="失败 0 项" 
                                           Foreground="#EF4444" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="点击下方查看详细错误信息" 
                                           Foreground="{DynamicResource Theme.Brush.TextSecondary}" 
                                           FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- 错误详情展开器 -->
                    <Expander x:Name="ErrorDetailsExpander" Visibility="Collapsed" 
                              IsExpanded="False" Background="Transparent">
                        <Expander.Header>
                            <TextBlock x:Name="ViewDetailsText" Text="查看详细信息" 
                                       Foreground="{DynamicResource Theme.Brush.TextPrimary}" 
                                       FontSize="14" FontWeight="Medium"/>
                        </Expander.Header>
                        <Border Background="{DynamicResource Theme.Brush.BackgroundSecondary}" 
                                CornerRadius="8" Padding="16" Margin="0,8,0,0" BorderThickness="1" 
                                BorderBrush="{DynamicResource Theme.Brush.BorderSubtle}">
                            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ErrorList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="0,0,0,12" Margin="0,0,0,8" 
                                                    BorderBrush="{DynamicResource Theme.Brush.BorderSubtle}" 
                                                    BorderThickness="0,0,0,1">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding ItemName}" 
                                                               Foreground="{DynamicResource Theme.Brush.TextPrimary}" 
                                                               FontSize="13" FontWeight="SemiBold" 
                                                               Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding ErrorMessage}" 
                                                               Foreground="{DynamicResource Theme.Brush.TextSecondary}" 
                                                               FontSize="12" TextWrapping="Wrap" 
                                                               LineHeight="18"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
            
            <!-- 底部按钮 -->
            <Border Grid.Row="2" Background="{DynamicResource Theme.Brush.SurfaceMuted}" CornerRadius="0,0,12,12" Padding="20,14">
                <Button x:Name="CloseBtn" Click="Close_Click" Cursor="Hand" HorizontalAlignment="Right">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="8" Padding="32,10">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#6366F1" Offset="0"/>
                                        <GradientStop Color="#8B5CF6" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.3" Color="#6366F1"/>
                                </Border.Effect>
                                <TextBlock x:Name="CloseBtnText" Text="关闭" 
                                           Foreground="#FFFFFF" 
                                           FontSize="13" FontWeight="Medium" 
                                           HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#7C7FF2" Offset="0"/>
                                                <GradientStop Color="#9D7DF7" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="Bd" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.5" Color="#6366F1"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#5558E3" Offset="0"/>
                                                <GradientStop Color="#7C4FE8" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>

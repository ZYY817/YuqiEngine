<UserControl x:Class="GameOptimizer.Shell.Views.CpuCoreManagementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:constants="clr-namespace:GameOptimizer.Shell.Constants"
             xmlns:controls="clr-namespace:GameOptimizer.Shell.Controls"
             xmlns:conv="clr-namespace:GameOptimizer.Shell.Converters"
             AutomationProperties.Name="CPU 核心管理">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />

    <Style x:Key="ProcessCard" TargetType="Border" BasedOn="{StaticResource Yuqi.Card}">
      <Setter Property="Background" Value="{DynamicResource Theme.Brush.CardBackgroundAlt}" />
    </Style>
    <Style x:Key="TopologyCard" TargetType="Border" BasedOn="{StaticResource Yuqi.Card}">
      <Setter Property="Background" Value="{DynamicResource Theme.Brush.CardBackgroundAlt}" />
    </Style>
    <Style x:Key="ConsoleCard" TargetType="Border" BasedOn="{StaticResource Yuqi.Card}">
      <Setter Property="Background" Value="{DynamicResource Theme.Brush.CardBackgroundAlt}" />
    </Style>

    <Style x:Key="ColHead" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextPrimary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ColAside" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource Yuqi.ToolButton}">
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource CompactButton}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextSecondary}" />
      <Setter Property="Padding" Value="8,6" />
    </Style>

    <!-- 核心格：更大、更清晰；圆角走 Token，避免字面量 CornerRadius 契约冲突 -->
    <Style x:Key="CoreToggle" TargetType="ToggleButton">
      <Setter Property="Width" Value="56" />
      <Setter Property="Height" Value="56" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Cell"
                    Background="{DynamicResource Theme.Brush.CardBackground}"
                    BorderBrush="{DynamicResource Theme.Brush.GlassCardBorder}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Token.Radius.Card}">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="CellText"
                           Text="{Binding Index}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="ThreadText"
                           Text="T0"
                           FontSize="10"
                           FontFamily="Consolas"
                           Foreground="{DynamicResource Theme.Brush.TextMuted}"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,0" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource Theme.Brush.ControlAccent}" />
                <Setter TargetName="Cell" Property="Background" Value="{DynamicResource Theme.Brush.CardBackgroundAlt}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource Theme.Brush.ControlAccent}" />
                <Setter TargetName="Cell" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Cell" Property="Background" Value="{DynamicResource Theme.Brush.ControlAccent}" />
                <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource Theme.Brush.ControlAccent}" />
                <Setter TargetName="CellText" Property="Foreground" Value="{DynamicResource Theme.Brush.TextOnAccent}" />
                <Setter TargetName="CellText" Property="FontSize" Value="17" />
                <Setter TargetName="ThreadText" Property="Foreground" Value="{DynamicResource Theme.Brush.TextOnAccent}" />
                <Setter TargetName="ThreadText" Property="Opacity" Value="0.75" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid Background="{DynamicResource Theme.Brush.AppBackground}" Margin="16,12,16,10" ClipToBounds="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 顶栏 -->
    <Grid Grid.Row="0" Margin="4,0,4,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" MinWidth="0">
        <TextBlock x:Name="CpuInfoLabel" Text="已识别处理器" Style="{StaticResource ColAside}" />
        <TextBlock Text="{Binding CpuDisplayName}" FontSize="15" FontWeight="SemiBold"
                   Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
          <TextBlock Text="{Binding ArchLabel}" Style="{StaticResource ColAside}" />
          <TextBlock Text=" · " Style="{StaticResource ColAside}" />
          <TextBlock Text="{Binding CoreCountLabel}" Style="{StaticResource ColAside}" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
        <TextBlock Text="{Binding StatusText}" FontSize="12.5" FontWeight="SemiBold"
                   Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                   HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="280" />
      </StackPanel>
    </Grid>

    <Grid x:Name="WorkspaceHost" Grid.Row="1" MinHeight="0">

      <!-- ========== 实时绑定 ========== -->
      <Grid x:Name="LiveWorkspace" Visibility="Visible" MinHeight="0">
        <Grid x:Name="LiveWorkspaceGrid" MinHeight="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- 左：可配置进程 -->
          <Border x:Name="ProcessWorkspace" Grid.Column="0" Style="{StaticResource ProcessCard}" Padding="12,10" MinHeight="0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="可配置进程" Style="{StaticResource ColHead}" />
                  <TextBlock Text="{Binding ProcessList.Count}" Style="{StaticResource ColAside}" Margin="6,0,0,0" />
                </StackPanel>
                <Button x:Name="RefreshBtn" Grid.Column="1"
                        Command="{Binding RefreshProcessesCommand}"
                        Style="{StaticResource QuietButton}"
                        ToolTip="重新读取可见窗口进程">
                  <TextBlock x:Name="RefreshBtnText" Text="刷新" />
                </Button>
              </Grid>

              <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="112" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ProcessSearchBox" TextChanged="ProcessSearchBox_TextChanged"
                         Padding="10,7,10,7" VerticalContentAlignment="Center"
                         ToolTip="按应用名称或窗口标题搜索" />
                <ComboBox x:Name="ProcessFilterBox" Grid.Column="2" SelectionChanged="ProcessFilterBox_SelectionChanged" SelectedIndex="0">
                  <ComboBoxItem Content="全部进程" Tag="all" />
                  <ComboBoxItem Content="有窗口标题" Tag="window" />
                  <ComboBoxItem Content="当前选择" Tag="selected" />
                </ComboBox>
              </Grid>

              <Grid Grid.Row="2" MinHeight="0" Margin="0,6,0,0">
                <ListBox x:Name="ProcessListBox"
                         ItemsSource="{Binding ProcessList}"
                         SelectedItem="{Binding SelectedProcess, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True">
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                      <Setter Property="Padding" Value="8,8" />
                      <Setter Property="Margin" Value="0,0,0,2" />
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                              <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Brush.CardBackground}" />
                              </Trigger>
                              <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Brush.ControlAccent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextOnAccent}" />
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" MinWidth="0" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" MinWidth="0">
                          <TextBlock FontSize="13" FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis"
                                     Foreground="{DynamicResource Theme.Brush.TextPrimary}">
                            <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=".exe" />
                          </TextBlock>
                          <TextBlock Text="{Binding WindowTitle}" FontSize="11"
                                     Foreground="{DynamicResource Theme.Brush.TextMuted}"
                                     TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                                     MaxHeight="18" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Id}" FontSize="11" FontFamily="Consolas"
                                   Foreground="{DynamicResource Theme.Brush.TextMuted}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <controls:EmptyState Title="没有可配置进程"
                                     Description="{Binding ProcessListMessage}"
                                     ActionText="重新读取"
                                     ActionCommand="{Binding RefreshProcessesCommand}"
                                     Visibility="{Binding HasNoProcesses, Converter={StaticResource BoolToVis}}" />
              </Grid>
            </Grid>
          </Border>

          <!-- 右：CPU 核心分配 -->
          <Border x:Name="LiveCoreWorkspace" Grid.Column="2" Style="{StaticResource TopologyCard}" Padding="14,10" MinHeight="0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" MinWidth="0">
                  <TextBlock x:Name="CoreTopologyTitle" Text="CPU 核心分配" Style="{StaticResource ColHead}" />
                  <TextBlock Text=" · " Style="{StaticResource ColAside}" />
                  <TextBlock Text="当前目标：" Style="{StaticResource ColAside}" />
                  <TextBlock Text="{Binding SelectedProcess.DisplayName, TargetNullValue=未选择进程, FallbackValue=未选择进程}"
                             Style="{StaticResource ColAside}" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <TextBlock x:Name="SelectedLabel" Text="已选 " Style="{StaticResource ColAside}" />
                  <TextBlock Text="{Binding SelectedCount}" FontSize="16" FontWeight="SemiBold"
                             Foreground="{DynamicResource Theme.Brush.TextPrimary}" />
                </StackPanel>
              </Grid>

              <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,6">
                <Button Command="{Binding SelectAllCommand}" Style="{StaticResource QuietButton}">
                  <TextBlock x:Name="SelectAllBtn" Text="全选" />
                </Button>
                <Button Command="{Binding ClearAllCommand}" Style="{StaticResource QuietButton}">
                  <TextBlock x:Name="ClearAllBtn" Text="清空" />
                </Button>
                <Button Command="{Binding InvertSelectionCommand}" Style="{StaticResource QuietButton}">
                  <TextBlock x:Name="InvertBtn" Text="反选" />
                </Button>
              </StackPanel>

              <Grid Grid.Row="2" MinHeight="0">
                <ScrollViewer x:Name="TopologyScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasUsableTopology, Converter={StaticResource BoolToVis}}">
                  <ItemsControl ItemsSource="{Binding CoreGroups}" HorizontalAlignment="Left">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="0,0,0,10">
                          <Grid Margin="0,0,0,4" MaxWidth="960">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding GroupName}" Style="{StaticResource ColAside}" />
                            <Button Grid.Column="1"
                                    Command="{Binding DataContext.SelectGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource QuietButton}"
                                    Padding="6,2" FontSize="11"
                                    Content="只选本组" />
                          </Grid>
                          <ItemsControl ItemsSource="{Binding Cores}" HorizontalAlignment="Left">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay}" Style="{StaticResource CoreToggle}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <controls:EmptyState Title="核心拓扑不可用"
                                     Description="{Binding AffinitySupportMessage}"
                                     ActionText="重新读取"
                                     ActionCommand="{Binding RefreshProcessesCommand}"
                                     Visibility="{Binding HasUsableTopology, Converter={StaticResource InverseBoolToVis}}" />
              </Grid>

              <!-- 预览只放这里一处，底栏不再重复进程名 -->
              <TextBlock Grid.Row="3" x:Name="GuideLabel"
                         Text="选择进程与至少一个核心后才能应用。"
                         Style="{StaticResource ColAside}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <!-- ========== 配置文件 ========== -->
      <Grid x:Name="ProfileWorkspace" Visibility="Collapsed" MinHeight="0">
        <Grid x:Name="ProfileWorkspaceGrid" MinHeight="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border x:Name="ProfileListWorkspace" Grid.Column="0" Style="{StaticResource ProcessCard}" Padding="12,10" MinHeight="0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="CPU 配置文件" Style="{StaticResource ColHead}" />
                <Button Command="{Binding RefreshProfileStatusCommand}" Style="{StaticResource QuietButton}" ToolTip="刷新配置状态">
                  <TextBlock Text="刷新状态" />
                </Button>
              </Grid>
              <Button Grid.Row="1" Command="{Binding AddProcessCommand}" Margin="0,8,0,8"
                      Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Padding="12,8">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{x:Static constants:IconGlyphs.Add}" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" />
                  <TextBlock x:Name="AddProgramBtn" Text="添加程序" />
                </StackPanel>
              </Button>
              <Grid Grid.Row="2" MinHeight="0">
                <ListBox ItemsSource="{Binding Profiles}"
                         SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                      <Setter Property="Padding" Value="8,8" />
                      <Setter Property="Margin" Value="0,0,0,2" />
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                              <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Brush.CardBackground}" />
                              </Trigger>
                              <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Brush.ControlAccent}" />
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel MinWidth="0">
                          <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                     Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding AffinityDescription}" FontSize="11.5"
                                     Foreground="{DynamicResource Theme.Brush.TextMuted}"
                                     Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{Binding StatusColor}"
                                   FontSize="11.5" Margin="10,0,0,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="100" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <controls:EmptyState x:Name="NoConfigState" Title="暂无配置"
                                     Description="添加程序后可保存核心偏好。"
                                     ActionText="添加程序"
                                     ActionCommand="{Binding AddProcessCommand}"
                                     Visibility="{Binding HasProfiles, Converter={StaticResource InverseBoolToVis}}" />
              </Grid>
            </Grid>
          </Border>

          <Border x:Name="ProfilePreviewWorkspace" Grid.Column="2" Style="{StaticResource TopologyCard}" Padding="14,10" MinHeight="0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Text="配置预览" Style="{StaticResource ColHead}" />
              <StackPanel Grid.Row="1" Margin="0,6,0,6">
                <TextBlock Text="{Binding SelectedProfile.DisplayName, TargetNullValue=未选择配置文件, FallbackValue=未选择配置文件}"
                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding SelectedProfile.AffinityDescription}" Style="{StaticResource ColAside}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding SelectedProfile.StatusText}" Foreground="{Binding SelectedProfile.StatusColor}"
                           Style="{StaticResource ColAside}" Margin="0,2,0,0" />
              </StackPanel>
              <Grid Grid.Row="2" MinHeight="0">
                <ScrollViewer x:Name="ProfileCorePreview" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                  <ItemsControl ItemsSource="{Binding CoreGroups}" HorizontalAlignment="Left">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="0,0,0,10">
                          <TextBlock Text="{Binding GroupName}" Style="{StaticResource ColAside}" Margin="0,0,0,4" />
                          <ItemsControl ItemsSource="{Binding Cores}" HorizontalAlignment="Left">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <ToggleButton IsChecked="{Binding IsSelected}" IsEnabled="False" Style="{StaticResource CoreToggle}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <controls:EmptyState x:Name="ProfileTopologyUnavailable" Title="核心拓扑不可用" Description="{Binding AffinitySupportMessage}" Visibility="Collapsed" />
                <controls:EmptyState x:Name="NoProfileSelectedState" Title="选择一个配置文件" Description="配置预览会显示该规则保存的核心分配；未选择时不显示默认核心。" Visibility="Visible" />
              </Grid>
              <StackPanel x:Name="ProfileActions" Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                <Button Command="{Binding EditProfileCommand}" CommandParameter="{Binding SelectedProfile}" Style="{StaticResource CompactButton}">编辑</Button>
                <Button Command="{Binding ApplySingleProfileCommand}" CommandParameter="{Binding SelectedProfile}" Style="{StaticResource CompactButton}" Margin="8,0,0,0">应用</Button>
                <Button Command="{Binding RestoreProfileCommand}" CommandParameter="{Binding SelectedProfile}" Style="{StaticResource CompactButton}" Margin="8,0,0,0">恢复</Button>
                <Button Command="{Binding DeleteProfileCommand}" CommandParameter="{Binding SelectedProfile}" Style="{StaticResource DangerButtonStyle}" Margin="8,0,0,0">删除</Button>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>

    <!-- 底栏：实时 -->
    <Border x:Name="LiveCommandBar" Grid.Row="2" Style="{StaticResource ConsoleCard}" Margin="0,8,0,0" Padding="12,10">
      <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding SelectedProcess.DisplayName, TargetNullValue=未选择进程, FallbackValue=未选择进程}"
                   Style="{StaticResource ColAside}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" MaxWidth="320" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Command="{Binding RestoreDefaultCommand}" Style="{StaticResource CompactButton}">
            <TextBlock x:Name="RestoreDefaultBtn" Text="恢复默认" />
          </Button>
          <Button Click="ProfilesButton_Click" Style="{StaticResource CompactButton}" Margin="8,0,0,0">配置文件</Button>
          <Button Command="{Binding StopAccelerateCommand}" IsEnabled="{Binding IsAccelerating}"
                  Style="{StaticResource CompactButton}" Margin="8,0,0,0">
            <TextBlock x:Name="StopBtnText" Text="停止并恢复" />
          </Button>
          <Button Command="{Binding StartAccelerateCommand}" IsEnabled="{Binding CanStartAccelerate}"
                  Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" Padding="16,8">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{x:Static constants:IconGlyphs.Boost}" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,5,0" />
              <TextBlock x:Name="StartBtnText" Text="应用到该进程" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 底栏：配置 -->
    <Border x:Name="ProfileCommandBar" Grid.Row="2" Style="{StaticResource ConsoleCard}" Margin="0,8,0,0" Padding="12,10" Visibility="Collapsed">
      <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="每个程序会使用自己的核心选择；应用前软件会再次确认目标程序是否正确。"
                   Style="{StaticResource ColAside}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Click="BackToLiveButton_Click" Style="{StaticResource CompactButton}">返回实时绑定</Button>
          <Button Command="{Binding ApplyAllProfilesCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" Padding="16,8">应用全部配置</Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>

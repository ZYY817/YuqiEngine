<Window x:Class="GameOptimizer.Shell.Views.GameScanResultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="扫描结果" Width="550" Height="550"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource Theme.Brush.RowBackground}" BorderBrush="{DynamicResource Theme.Brush.CardBorder}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Border Grid.Row="0" Background="{DynamicResource Theme.Brush.BackgroundSecondary}" CornerRadius="12,12,0,0" Padding="16,12"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock x:Name="DialogTitleText" Text="扫描结果" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" Click="CloseButton_Click"
                            Background="Transparent" BorderThickness="0" Foreground="#6B6B70" 
                            FontSize="14" Cursor="Hand" Width="24" Height="24"/>
                </Grid>
            </Border>
            
            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- 副标题和统计 -->
                <Grid Margin="0,0,0,12">
                    <TextBlock x:Name="SubtitleText" Text="检测到 0 个新游戏" Foreground="#6B6B70" FontSize="12"/>
                    <TextBlock x:Name="SelectedCountText" Text="已选择 0 个游戏" Foreground="#2E88F2" FontSize="12" HorizontalAlignment="Right"/>
                </Grid>
                
                <!-- 操作按钮 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                    <Button x:Name="SelectAllBtn" Content="全选" Click="SelectAllButton_Click" Background="Transparent" BorderBrush="{DynamicResource Theme.Brush.CardBorder}" BorderThickness="1"
                            Foreground="#A1A1A6" FontSize="11" Padding="10,4" Cursor="Hand" Margin="0,0,8,0"/>
                    <Button x:Name="DeselectAllBtn" Content="取消全选" Click="DeselectAllButton_Click" Background="Transparent" BorderBrush="{DynamicResource Theme.Brush.CardBorder}" BorderThickness="1"
                            Foreground="#A1A1A6" FontSize="11" Padding="10,4" Cursor="Hand"/>
                </StackPanel>

                <!-- 游戏列表 -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="GameList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Theme.Brush.RowBackground}" CornerRadius="8" Padding="14" Margin="0,0,0,8" Cursor="Hand"
                                        MouseLeftButtonDown="GameItem_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Game.Name}" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="13" FontWeight="Medium"/>
                                            <TextBlock Text="{Binding Game.ExecutablePath}" Foreground="#6B6B70" FontSize="10" 
                                                       Margin="0,4,0,0" TextTrimming="CharacterEllipsis" MaxWidth="350"/>
                                        </StackPanel>
                                        
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" Foreground="#48484A" FontSize="11" 
                                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
            
            <Border Grid.Row="2" Background="{DynamicResource Theme.Brush.BackgroundSecondary}" CornerRadius="0,0,12,12" Padding="20,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelBtn" Content="取消" Click="CancelButton_Click"
                            Background="Transparent" BorderBrush="{DynamicResource Theme.Brush.CardBorder}" BorderThickness="1"
                            Foreground="#A1A1A6" FontSize="13" Padding="20,10" Cursor="Hand"/>
                    <Button x:Name="ConfirmBtn" Content="添加选中的游戏" Click="ConfirmButton_Click" Margin="12,0,0,0"
                            Background="#2E88F2" BorderThickness="0"
                            Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="13" Padding="20,10" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

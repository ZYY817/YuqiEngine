<UserControl x:Class="GameOptimizer.Shell.Views.UniversalModuleTemplate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding Description}" Foreground="#6B6B70" FontSize="13" Margin="0,0,0,24"/>
            
            <Border Background="#1E1E20" CornerRadius="12" BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="20">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#28282A" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Foreground="#FFFFFF" FontSize="13" FontWeight="Medium"/>
                                        <TextBlock Text="{Binding Description}" Foreground="#6B6B70" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

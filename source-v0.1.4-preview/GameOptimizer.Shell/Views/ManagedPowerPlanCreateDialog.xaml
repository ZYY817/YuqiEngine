<Window x:Class="GameOptimizer.Shell.Views.ManagedPowerPlanCreateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="智能创建电源计划" Width="760" Height="700" MinWidth="600" MinHeight="520"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="CanResize" ShowInTaskbar="False">
    <Border Background="{DynamicResource Theme.Brush.DialogBackground}"
            BorderBrush="{DynamicResource Theme.Brush.DialogBorder}" BorderThickness="1"
            CornerRadius="{DynamicResource Token.Radius.CardLarge}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="0" Opacity="0.45" Color="{DynamicResource Theme.Color.Shadow}"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Padding="20,16" Background="{DynamicResource Theme.Brush.CardBackgroundAlt}"
                    BorderBrush="{DynamicResource Theme.Brush.CardBorderSubtle}" BorderThickness="0,0,0,1"
                    CornerRadius="{DynamicResource Token.Radius.CardLarge}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" Margin="0,0,12,0" CornerRadius="{DynamicResource Token.Radius.Card}"
                                Background="{DynamicResource Theme.Brush.IconBackground}" BorderBrush="{DynamicResource Theme.Brush.ControlAccent}" BorderThickness="1">
                            <Path Data="M12,2 V22 M6,8 L12,2 L18,8 M5,13 H19 M8,17 H16" Margin="9"
                                  Stroke="{DynamicResource Theme.Brush.IconPrimary}" StrokeThickness="1.7" Stretch="Uniform"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="智能创建电源计划" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Brush.TextPrimary}"/>
                            <TextBlock Text="先查看适合当前电脑的方案，再新建一个可编辑的电源计划" Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource Theme.Brush.TextSecondary}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" Padding="10,6" AutomationProperties.Name="关闭智能电源创建">
                        <TextBlock Text="关闭"/>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20" KeyboardNavigation.DirectionalNavigation="Contained">
                <StackPanel>
                    <Border Background="{DynamicResource Theme.Brush.CardBackgroundAlt}" BorderBrush="{DynamicResource Theme.Brush.CardBorderSubtle}" BorderThickness="1" CornerRadius="{DynamicResource Token.Radius.Card}" Padding="14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="自动匹配" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Brush.ControlAccent}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="DetectedEnvironmentText" FontSize="12" Foreground="{DynamicResource Theme.Brush.TextPrimary}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="AvailabilityText" Margin="0,4,0,0" FontSize="10" Foreground="{DynamicResource Theme.Brush.TextSecondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="{DynamicResource Theme.Brush.CardBackground}" BorderBrush="{DynamicResource Theme.Brush.CardBorderSubtle}" BorderThickness="1" CornerRadius="{DynamicResource Token.Radius.Card}" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="将创建的策略" FontSize="11" Foreground="{DynamicResource Theme.Brush.TextMuted}"/>
                                    <TextBlock x:Name="MatchedProfileNameText" Margin="0,3,0,0" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Brush.TextPrimary}"/>
                                    <TextBlock x:Name="MatchedProfileDescriptionText" Margin="0,3,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Theme.Brush.TextSecondary}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Padding="8,4" VerticalAlignment="Top" Background="{DynamicResource Theme.Brush.IconBackground}" BorderBrush="{DynamicResource Theme.Brush.CardBorderSubtle}" BorderThickness="1" CornerRadius="{DynamicResource Token.Radius.Badge}">
                                    <TextBlock x:Name="ProfileStatusText" FontSize="10" Foreground="{DynamicResource Theme.Brush.TextSecondary}"/>
                                </Border>
                            </Grid>
                            <CheckBox x:Name="ExtremeModeCheckBox" Margin="0,14,0,0" Checked="ExtremeModeChanged" Unchecked="ExtremeModeChanged" AutomationProperties.Name="启用极限性能模式">
                                <StackPanel>
                                    <TextBlock Text="启用极限模式（仅散热和供电充足的台式机）" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Brush.TextPrimary}"/>
                                    <TextBlock x:Name="ExtremeModeHintText" Margin="0,2,0,0" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource Theme.Brush.TextSecondary}"/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource Theme.Brush.CardBackground}" BorderBrush="{DynamicResource Theme.Brush.CardBorderSubtle}" BorderThickness="1" CornerRadius="{DynamicResource Token.Radius.Card}" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="电源计划名称（可选）" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Brush.TextPrimary}"/>
                            <TextBox x:Name="PlanNameTextBox" Margin="0,8,0,0" MaxLength="80" Padding="10,7" FontSize="12" AutomationProperties.Name="自定义电源计划名称"/>
                            <TextBlock x:Name="NameHintText" Margin="0,5,0,0" FontSize="10" Foreground="{DynamicResource Theme.Brush.TextSecondary}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="本次将调整的设置" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Brush.TextPrimary}" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="ParameterList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Theme.Brush.CardBackgroundAlt}" BorderBrush="{DynamicResource Theme.Brush.CardBorderSubtle}" BorderThickness="1" CornerRadius="{DynamicResource Token.Radius.Button}" Padding="12" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Brush.TextPrimary}"/>
                                            <TextBlock Text="{Binding Description}" Margin="0,2,0,0" FontSize="10" Foreground="{DynamicResource Theme.Brush.TextSecondary}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding ValueText}" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Brush.ControlAccent}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Margin="0,8,0,0" Padding="12" Background="{DynamicResource Theme.Brush.CardBackgroundAlt}" BorderBrush="{DynamicResource Theme.Brush.CardBorderSubtle}" BorderThickness="1" CornerRadius="{DynamicResource Token.Radius.Card}">
                        <TextBlock x:Name="SafetyBoundaryText" FontSize="10" Foreground="{DynamicResource Theme.Brush.TextSecondary}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Padding="20,14" Background="{DynamicResource Theme.Brush.CardBackgroundAlt}" BorderBrush="{DynamicResource Theme.Brush.CardBorderSubtle}" BorderThickness="0,1,0,0" CornerRadius="{DynamicResource Token.Radius.CardLarge}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" Margin="0,0,10,0"><TextBlock Text="取消"/></Button>
                    <Button x:Name="CreateButton" Style="{StaticResource PrimaryButtonStyle}" Click="Create_Click" AutomationProperties.Name="创建电源方案"><TextBlock Text="创建电源方案"/></Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

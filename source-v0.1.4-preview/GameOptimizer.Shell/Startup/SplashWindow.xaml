<!-- File: GameOptimizer.Shell/Startup/SplashWindow.xaml -->
<Window x:Class="GameOptimizer.Shell.Startup.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="宇奇引擎"
        Width="420" Height="188"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Topmost="False"
        KeyDown="Window_KeyDown">

    <Border CornerRadius="8" BorderThickness="1" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0C0C0F" Offset="0"/>
                <GradientStop Color="#101016" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#22D3EE" Offset="0"/>
                <GradientStop Color="#1A1A24" Offset="0.3"/>
                <GradientStop Color="#1A1A24" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.35" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <!-- 顶部 accent 线 -->
            <Border Height="2" VerticalAlignment="Top" CornerRadius="8,8,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#22D3EE" Offset="0"/>
                        <GradientStop Color="#0EA5E9" Offset="0.4"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- 内容从顶部自然堆叠 -->
            <StackPanel Margin="20,14,20,0" VerticalAlignment="Top">

                <!-- Logo + 产品名 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" x:Name="LogoImage" Width="32" Height="32"
                           Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="宇奇引擎" FontSize="15" FontWeight="Bold" Foreground="#F4F4F5"/>
                            <TextBlock x:Name="VersionText" FontSize="9.5" Foreground="#52525B"
                                       VerticalAlignment="Bottom" Margin="8,0,0,2"/>
                        </StackPanel>
                        <TextBlock Text="游戏性能优化  ·  智能检测  ·  一键加速" FontSize="9"
                                   Foreground="#3F3F46" Margin="0,1,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- TIP -->
                <Border Background="#0E0E13" CornerRadius="5" Padding="10,6" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="TIP" FontSize="8.5" FontWeight="Bold"
                                   Foreground="#22D3EE" Margin="0,1,7,0" VerticalAlignment="Top"/>
                        <TextBlock Grid.Column="1" x:Name="TipText" FontSize="10" Foreground="#71717A"
                                   TextWrapping="Wrap" LineHeight="14.5"
                                   Text="宇奇引擎可以自动检测你的硬件配置，并推荐最佳的优化方案。"/>
                    </Grid>
                </Border>

                <!-- 进度条 -->
                <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Height="1.5" Margin="0,8,0,0"
                             Background="#18181B" Foreground="#22D3EE" BorderThickness="0"/>

                <!-- 状态文本 -->
                <TextBlock x:Name="StatusText" Text="正在启动..." FontSize="9.5"
                           Foreground="#52525B" Margin="0,4,0,0"/>

                <!-- 警告/错误（默认隐藏） -->
                <StackPanel x:Name="AlertPanel" Visibility="Collapsed" Margin="0,4,0,0">
                    <TextBlock x:Name="WarningText" FontSize="10" Foreground="#FACC15"
                               TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed"/>
                    <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" Margin="0,4,0,0">
                        <TextBlock x:Name="ErrorText" FontSize="10" Foreground="#F87171"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Button x:Name="RetryButton" Content="重试" Visibility="Collapsed"
                                    Click="RetryButton_Click" Margin="0,0,6,0"
                                    Style="{x:Null}" Padding="14,3" FontSize="10"
                                    Background="#22D3EE" Foreground="#09090B" BorderThickness="0" Cursor="Hand"/>
                            <Button x:Name="ExitButton" Content="退出" Click="ExitButton_Click"
                                    Style="{x:Null}" Padding="14,3" FontSize="10"
                                    Background="#3F3F46" Foreground="#F4F4F5" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- 底栏：绝对定位钉在底部 -->
            <Grid Margin="20,0,20,10" VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="9" Foreground="#27272A"
                           Text="© 2026 宇奇  ·  YuQi"/>
                <TextBlock Grid.Column="1" FontSize="9" Foreground="#27272A" Text="ESC 取消"/>
            </Grid>
        </Grid>
    </Border>
</Window>

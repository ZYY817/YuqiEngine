<!-- File: GameOptimizer.Shell/Views/MemoryControlPanel.xaml -->
<UserControl x:Class="GameOptimizer.Shell.Views.Controls.MemoryControlPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <StackPanel>
        <Border x:Name="MemoryHeroCard" CornerRadius="16" BorderThickness="1" Padding="18,16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#10231A" Offset="0"/><GradientStop Color="#0D1820" Offset="0.55"/><GradientStop Color="#112A1D" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush><SolidColorBrush Color="#22C55E" Opacity="0.38"/></Border.BorderBrush>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="174"/></Grid.ColumnDefinitions>
                <Grid x:Name="MemoryUsageVisual" Grid.Column="0" Width="126" Height="126" HorizontalAlignment="Left">
                    <Ellipse Width="116" Height="116" Stroke="#263B32" StrokeThickness="8"/>
                    <Ellipse x:Name="MemoryUsageRing" Width="116" Height="116" Stroke="#22C55E" StrokeThickness="8"
                             StrokeDashCap="Round" StrokeDashArray="0 100" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform>
                    </Ellipse>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="MemoryPercentText" Text="--" FontSize="27" FontWeight="Bold" Foreground="{DynamicResource Theme.Brush.TextPrimary}"/>
                            <TextBlock Text="%" Margin="2,5,0,0" FontSize="12" Foreground="#86EFAC"/>
                        </StackPanel>
                        <TextBlock x:Name="MemoryRatioText" Text="-- / -- GB" Margin="0,2,0,0" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource Theme.Brush.TextMuted}"/>
                        <TextBlock x:Name="MemoryHealthText" Text="正在读取" Margin="0,4,0,0" FontSize="10" HorizontalAlignment="Center" Foreground="#4ADE80"/>
                    </StackPanel>
                </Grid>
                <StackPanel x:Name="MemoryHeroContent" Grid.Column="1" VerticalAlignment="Center" Margin="4,0,24,0">
                    <Border HorizontalAlignment="Left" CornerRadius="10" Padding="9,4" Background="#2822C55E">
                        <TextBlock x:Name="MemoryHeroEyebrow" Text="进程结束工具" FontSize="11" FontWeight="SemiBold" Foreground="#86EFAC"/>
                    </Border>
                    <TextBlock x:Name="MemoryHeroTitle" Text="手动结束占用内存的应用" Margin="0,9,0,0" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Theme.Brush.TextPrimary}"/>
                    <TextBlock x:Name="MemoryHeroSubtitle" Text="实时读取 Windows 物理内存状态" Margin="0,5,0,0" FontSize="11" Foreground="{DynamicResource Theme.Brush.TextMuted}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <StackPanel Margin="0,0,24,0"><TextBlock x:Name="AvailableLabel" Text="可用" FontSize="10" Foreground="{DynamicResource Theme.Brush.TextMuted}"/><TextBlock x:Name="AvailableValueText" Text="--" Margin="0,3,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Brush.TextPrimary}"/></StackPanel>
                        <StackPanel Margin="0,0,24,0"><TextBlock x:Name="UsedLabel" Text="已用" FontSize="10" Foreground="{DynamicResource Theme.Brush.TextMuted}"/><TextBlock x:Name="UsedValueText" Text="--" Margin="0,3,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Brush.TextPrimary}"/></StackPanel>
                        <StackPanel><TextBlock x:Name="TotalLabel" Text="总计" FontSize="10" Foreground="{DynamicResource Theme.Brush.TextMuted}"/><TextBlock x:Name="TotalValueText" Text="--" Margin="0,3,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Brush.TextPrimary}"/></StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Button x:Name="SmartBoostBtn" Click="SmartBoost_Click" Cursor="Hand" Height="54" IsEnabled="False">
                        <Button.Template><ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="27" BorderThickness="1" BorderBrush="#6622C55E">
                                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#22C55E" Offset="0"/><GradientStop Color="#15803D" Offset="1"/></LinearGradientBrush></Border.Background>
                                <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.34" Color="#22C55E"/></Border.Effect>
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel x:Name="CtaContent" Orientation="Horizontal">
                                        <Viewbox x:Name="CtaIcon" Width="18" Height="18" Margin="0,0,8,0">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="White" Data="M13.2,1.8 L5.7,13.1 L11.2,13.1 L10.6,22.2 L18.3,10.7 L12.8,10.7 Z"/>
                                            </Canvas>
                                        </Viewbox>
                                        <Viewbox x:Name="CtaSpinner" Width="18" Height="18" Margin="0,0,8,0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                            <Viewbox.RenderTransform><RotateTransform x:Name="CtaSpinnerRotation"/></Viewbox.RenderTransform>
                                            <Canvas Width="24" Height="24">
                                                <Path Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M12,3 A9,9 0 1 1 4.2,7.5"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock x:Name="MemBoostBtnText" Text="选择并结束" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#22B858"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#13733A"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.68"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate></Button.Template>
                    </Button>
                    <Border x:Name="MemoryActionStatePanel" Margin="0,8,0,0" Padding="9,7" CornerRadius="9" Background="#161F2923" BorderBrush="#334ADE80" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border x:Name="MemoryActionStateIconBadge" Width="20" Height="20" CornerRadius="10" Background="#2834D399" VerticalAlignment="Top">
                                <TextBlock x:Name="MemoryActionStateIcon" Text="i" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#86EFAC"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                <TextBlock x:Name="MemoryActionStateTitle" Text="正在核验权限" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Brush.TextSecondary}"/>
                                <TextBlock x:Name="MemoryMutationStatusText" Text="内存写入安全边界核验中" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="9" MaxHeight="34"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Button x:Name="CleanJunkBtn" Click="CleanJunk_Click" Cursor="Hand" Margin="0,8,0,0" Content="转到系统清理" Padding="12,7"/>
                </StackPanel>
                <Border x:Name="MemoryUnavailablePanel" Grid.ColumnSpan="3" Visibility="Collapsed" CornerRadius="12" Background="#E60B111A" BorderBrush="#665F6B7A" BorderThickness="1" Padding="24">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="MemoryUnavailableTitle" Text="无法读取内存状态" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource Theme.Brush.TextPrimary}"/><TextBlock x:Name="MemoryUnavailableHint" Text="系统内存接口暂不可用，请稍后重试" Margin="0,7,0,0" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource Theme.Brush.TextMuted}"/></StackPanel>
                </Border>
            </Grid>
        </Border>
        <Border x:Name="TopProcessCard" Margin="0,12,0,0" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource Theme.Brush.CardBorder}" Background="{DynamicResource Theme.Brush.CardBackground}" Padding="14,12">
            <StackPanel>
                <Grid Margin="2,0,2,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal"><TextBlock x:Name="TopProcessTitle" Text="占用排行" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Brush.TextPrimary}"/><TextBlock Text="TOP 5" Margin="8,1,0,0" FontSize="10" Foreground="#4ADE80"/></StackPanel>
                    <TextBlock x:Name="TopProcessStateText" Grid.Column="1" Text="正在读取进程" FontSize="10" Foreground="{DynamicResource Theme.Brush.TextMuted}"/>
                </Grid>
                <UniformGrid x:Name="TopProcessItemsPanel" Rows="1" Columns="5"/>
                <Border x:Name="TopProcessEmptyPanel" Visibility="Collapsed" CornerRadius="10" Padding="16,12" Background="{DynamicResource Theme.Brush.SurfaceMuted}">
                    <TextBlock x:Name="TopProcessEmptyText" Text="暂时无法读取进程内存占用" TextAlignment="Center" Foreground="{DynamicResource Theme.Brush.TextMuted}"/>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

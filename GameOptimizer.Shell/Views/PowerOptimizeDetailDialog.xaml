<Window x:Class="GameOptimizer.Shell.Views.PowerOptimizeDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="优化详情" Width="680" Height="720"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="DarkScrollBarThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource Theme.Brush.ScrollbarThumb}" CornerRadius="3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource DarkScrollBarThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Border Background="{DynamicResource Theme.Brush.DialogBackground}" CornerRadius="12" BorderThickness="1">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#2022D3EE" Offset="0"/>
                <GradientStop Color="#10FFFFFF" Offset="0.5"/>
                <GradientStop Color="#200EA5E9" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.5" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="{DynamicResource Theme.Brush.CardBackgroundAlt}" CornerRadius="12,12,0,0" Padding="20,14" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,12,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2022D3EE" Offset="0"/>
                                    <GradientStop Color="#1022D3EE" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Brush.TextPrimary}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="优化详情" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtSubtitle" Text="查看完整的电源优化清单" Foreground="{DynamicResource Theme.Brush.TextDisabled}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" Click="Close_Click" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Theme.Brush.TextDisabled}" FontSize="14" Cursor="Hand" Width="32" Height="32">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Width="32" Height="32">
                                    <TextBlock Text="✕" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Brush.TextDisabled}" FontSize="14"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Brush.CardBackgroundHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
            
            <!-- 主内容区 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBar}"/>
                </ScrollViewer.Resources>
                <StackPanel>
                    
                    <!-- 方案概述 -->
                    <Border Background="{DynamicResource Theme.Brush.CardBackgroundAlt}" CornerRadius="10" Padding="16" Margin="0,0,0,16" BorderBrush="{DynamicResource Theme.Brush.CardBorderSubtle}" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock x:Name="TxtPlanIcon" Text="🎮" FontSize="18" Margin="0,0,10,0" Foreground="{DynamicResource Theme.Brush.TextPrimary}"/>
                                <StackPanel>
                                    <TextBlock x:Name="TxtPlanName" Text="游戏优化方案" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtPlanDesc" Text="针对游戏性能优化" Foreground="{DynamicResource Theme.Brush.TextDisabled}" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="TxtPlanReason" Text="" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="12" TextWrapping="Wrap" LineHeight="20"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- 风险概览卡片 -->
                    <Border Background="{DynamicResource Theme.Brush.CardBackgroundAlt}" CornerRadius="10" Padding="16" Margin="0,0,0,16" BorderBrush="{DynamicResource Theme.Brush.CardBorderSubtle}" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Width="4" Height="16" CornerRadius="2" Background="#F59E0B" Margin="0,0,10,0"/>
                                <TextBlock Text="风险概览" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- 温度风险 -->
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="🌡️" FontSize="20" HorizontalAlignment="Center" Foreground="{DynamicResource Theme.Brush.TextPrimary}"/>
                                    <TextBlock Text="温度风险" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,2"/>
                                    <TextBlock x:Name="TxtThermalRiskValue" Text="中等" Foreground="#F59E0B" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <!-- 噪音风险 -->
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="🔊" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock Text="噪音风险" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,2"/>
                                    <TextBlock x:Name="TxtNoiseRiskValue" Text="中等" Foreground="#F59E0B" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <!-- 功耗增加 -->
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" Foreground="{DynamicResource Theme.Brush.TextPrimary}"/>
                                    <TextBlock Text="功耗增加" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,2"/>
                                    <TextBlock x:Name="TxtPowerIncreaseValue" Text="+20%" Foreground="#F59E0B" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    
                    <!-- 优化清单标题 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Width="4" Height="16" CornerRadius="2" Background="#22D3EE" Margin="0,0,10,0"/>
                        <TextBlock Text="电源设置对比" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                    
                    <!-- 设置对比列表 -->
                    <Border Background="{DynamicResource Theme.Brush.CardBackgroundMuted}" CornerRadius="10" Padding="0" Margin="0,0,0,16" BorderBrush="{DynamicResource Theme.Brush.CardBorderSubtle}" BorderThickness="1">
                        <StackPanel x:Name="SettingsCompareList"/>
                    </Border>
                    
                    <!-- 潜在副作用 -->
                    <Border x:Name="SideEffectsPanel" Background="#10EF4444" CornerRadius="10" Padding="14" Margin="0,0,0,16" BorderBrush="#20EF4444" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="⚠️" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="潜在副作用" Foreground="#EF4444" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtSideEffects" Text="" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="12" TextWrapping="Wrap" LineHeight="22"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- 散热建议 -->
                    <Border Background="#0822D3EE" CornerRadius="10" Padding="14" Margin="0,0,0,16" BorderBrush="#1522D3EE" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="❄️" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="散热建议" Foreground="#22D3EE" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtCoolerRecommendation" Text="" Foreground="#22D3EE" FontSize="12" FontWeight="Medium" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtCoolingTips" Text="" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="12" TextWrapping="Wrap" LineHeight="22"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- 性能提升说明 -->
                    <Border Background="#0822C55E" CornerRadius="10" Padding="14" Margin="0,0,0,16" BorderBrush="#1522C55E" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="✨" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="性能提升说明" Foreground="#22C55E" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtPerformanceGain" Text="" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="12" TextWrapping="Wrap" LineHeight="20"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- 风险提示 -->
                    <Border x:Name="RiskPanel" Background="#10F59E0B" CornerRadius="10" Padding="14" Margin="0,0,0,16" BorderBrush="#20F59E0B" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="🔥" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="温度与功耗" Foreground="#F59E0B" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtRisks" Text="" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="12" TextWrapping="Wrap" LineHeight="20"/>
                            <TextBlock x:Name="TxtPowerSupplyNote" Text="" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- 常见问题 -->
                    <Border Background="{DynamicResource Theme.Brush.CardBackgroundAlt}" CornerRadius="10" Padding="14" Margin="0,0,0,16" BorderBrush="{DynamicResource Theme.Brush.CardBorderSubtle}" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="❓" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="常见问题" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel x:Name="FAQList"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- 建议 -->
                    <Border x:Name="RecommendPanel" Background="#0822D3EE" CornerRadius="10" Padding="14" BorderBrush="#1522D3EE" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="💡" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="使用建议" Foreground="#22D3EE" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtRecommendations" Text="" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="12" TextWrapping="Wrap" LineHeight="20"/>
                        </StackPanel>
                    </Border>
                    
                </StackPanel>
            </ScrollViewer>
            
            <!-- 底部按钮 -->
            <Border Grid.Row="2" Background="{DynamicResource Theme.Brush.CardBackgroundAlt}" CornerRadius="0,0,12,12" Padding="20,14" BorderBrush="{DynamicResource Theme.Brush.CardBorderSubtle}" BorderThickness="0,1,0,0">
                <Button Click="Close_Click" HorizontalAlignment="Right" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="8" Padding="24,10">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#22D3EE" Offset="0"/>
                                        <GradientStop Color="#0EA5E9" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="我知道了" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="13" FontWeight="Medium"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>

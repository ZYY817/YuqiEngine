<!-- File: GameOptimizer.Shell/Views/PowerPlanEditorPage.xaml -->
<UserControl x:Class="GameOptimizer.Shell.Views.PowerPlanEditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:GameOptimizer.Shell.Controls"
             xmlns:constants="clr-namespace:GameOptimizer.Shell.Constants"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="980"
             Background="{DynamicResource Theme.Brush.AppBackground}">
    <UserControl.Resources>
        <Style x:Key="PowerSection" TargetType="Border" BasedOn="{StaticResource Yuqi.Tool.Surface}">
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="PowerPlanRow" TargetType="Border" BasedOn="{StaticResource Yuqi.Tool.Surface}">
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
        <Style x:Key="PowerBadge" TargetType="Border">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.CardBackgroundAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.CardBorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Token.Radius.Badge}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer x:Name="ToolPageContentScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch"
                      Padding="24,20,24,36"
                      KeyboardNavigation.DirectionalNavigation="Contained">
            <StackPanel Style="{StaticResource Yuqi.ToolPageEntrance}">
                <controls:ToolTopbar x:Name="PageHeader"
                                     Margin="0,0,0,14"
                                     Title="电源优化"
                                     Subtitle="真实计划、已验证设置与可恢复变更"
                                     IconData="{x:Static constants:NavigationIconData.Power}">
                    <controls:ToolTopbar.Actions>
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Click="BtnRefreshPlans_Click"
                                ToolTip="重新读取 Windows 电源状态与计划">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M4,7 V3 M4,3 H8 M4,3 L7,6 M5,7 A8,8 0 1 1 4,15 M12,8 V13 L15,15"
                                      Width="14" Height="14" Margin="0,0,6,0"
                                      Stroke="{DynamicResource Theme.Brush.IconSecondary}"
                                      StrokeThickness="1.7" Stretch="Uniform"/>
                                <TextBlock Text="刷新"/>
                            </StackPanel>
                        </Button>
                    </controls:ToolTopbar.Actions>
                </controls:ToolTopbar>

                <Border Style="{StaticResource Yuqi.Tool.Inset}" Margin="0,0,0,14" Padding="14,12">
                    <WrapPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Theme.Brush.Success}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                            <TextBlock Text="当前激活计划" FontSize="11" Foreground="{DynamicResource Theme.Brush.TextMuted}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtCurrentPlanName" Text="正在读取…" MaxWidth="260" Margin="9,0,0,0"
                                       FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Style="{StaticResource PowerBadge}" Margin="0,0,10,0">
                            <TextBlock x:Name="TxtPowerStatus" Text="正在读取供电能力" FontSize="10"
                                       Foreground="{DynamicResource Theme.Brush.TextSecondary}"/>
                        </Border>
                        <Border Style="{StaticResource PowerBadge}">
                            <TextBlock x:Name="TxtDeviceTypeStatus" Text="正在读取设备能力" FontSize="10"
                                       Foreground="{DynamicResource Theme.Brush.TextSecondary}"/>
                        </Border>
                    </WrapPanel>
                </Border>

                <Border Style="{StaticResource PowerSection}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" Margin="0,0,10,0"
                                    Background="{DynamicResource Theme.Brush.IconBackground}"
                                    BorderBrush="{DynamicResource Theme.Brush.CardBorderSubtle}"
                                    BorderThickness="1" CornerRadius="{DynamicResource Token.Radius.Card}">
                                <Path Data="M12,2 V22 M6,8 L12,2 L18,8 M5,13 H19 M8,17 H16"
                                      Margin="8" Stroke="{DynamicResource Theme.Brush.IconPrimary}" StrokeThickness="1.7"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="内置受管策略" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Theme.Brush.TextPrimary}"/>
                                <TextBlock Text="按 CPU 与设备能力创建独立副本；先完整备份源计划，再写入、激活和回读。"
                                           Margin="0,2,0,0" FontSize="10" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Theme.Brush.TextMuted}"/>
                            </StackPanel>
                            <Button x:Name="BtnOpenIntelligentCreate" Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="16,0,0,0" VerticalAlignment="Center" Click="BtnOpenIntelligentCreate_Click"
                                    ToolTip="先显示 CPU 匹配、计划名称与将写入的真实参数；确认后才创建独立副本"
                                    AutomationProperties.Name="智能创建电源计划">
                                <TextBlock Text="智能创建电源计划"/>
                            </Button>
                        </Grid>
                        <ItemsControl x:Name="ProfileCards">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PowerPlanRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel MinWidth="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Theme.Brush.TextPrimary}"/>
                                                    <Border Style="{StaticResource PowerBadge}" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding Status}" FontSize="9"
                                                                   Foreground="{DynamicResource Theme.Brush.TextSecondary}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" Margin="0,3,0,0" FontSize="10"
                                                           TextWrapping="Wrap" Foreground="{DynamicResource Theme.Brush.TextSecondary}"/>
                                                <TextBlock Text="{Binding Preconditions}" Margin="0,5,0,0" FontSize="9"
                                                           TextWrapping="Wrap" Foreground="{DynamicResource Theme.Brush.TextMuted}"/>
                                                <TextBlock Text="{Binding ParameterSummary}" Margin="0,3,0,0" FontSize="9"
                                                           TextWrapping="Wrap" Foreground="{DynamicResource Theme.Brush.TextSecondary}"/>
                                                <TextBlock Text="{Binding Details}" Margin="0,3,0,0" FontSize="9"
                                                           TextWrapping="Wrap" Foreground="{DynamicResource Theme.Brush.TextMuted}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                                                       Text="通过上方统一入口预览后创建" FontSize="10"
                                                       Foreground="{DynamicResource Theme.Brush.TextMuted}" TextAlignment="Right" TextWrapping="Wrap" MaxWidth="120"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="TxtProfileStatus" Margin="0,5,0,0" FontSize="10" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Theme.Brush.TextSecondary}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PowerSection}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" Margin="0,0,10,0"
                                    Background="{DynamicResource Theme.Brush.IconBackground}"
                                    BorderBrush="{DynamicResource Theme.Brush.CardBorderSubtle}"
                                    BorderThickness="1" CornerRadius="{DynamicResource Token.Radius.Card}">
                                <Path Data="M3,6 H10 L12,8 H21 V19 H3 Z M7,12 H17 M7,15 H14" Margin="8"
                                      Stroke="{DynamicResource Theme.Brush.IconPrimary}" StrokeThickness="1.7"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Stretch="Uniform"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="电源计划" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Theme.Brush.TextPrimary}"/>
                                <TextBlock Text="Windows / OEM 计划保持只读；只有标记为“宇奇受管”的副本允许修改和激活。"
                                           Margin="0,2,0,0" FontSize="10"
                                           Foreground="{DynamicResource Theme.Brush.TextMuted}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                        <ItemsControl x:Name="PowerPlansList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PowerPlanRow}" AutomationProperties.Name="{Binding Name}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="38" Height="38" Margin="0,0,12,0"
                                                    Background="{DynamicResource Theme.Brush.IconBackground}"
                                                    BorderBrush="{DynamicResource Theme.Brush.CardBorderSubtle}"
                                                    BorderThickness="1" CornerRadius="{DynamicResource Token.Radius.Button}">
                                                <Path Data="{Binding IconData}" Margin="9" Stroke="{Binding IconColor}"
                                                      StrokeThickness="1.7" StrokeLineJoin="Round"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" MinWidth="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" MaxWidth="420" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Theme.Brush.TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                    <Border Style="{StaticResource PowerBadge}" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding PlanKind}" FontSize="9" Foreground="{DynamicResource Theme.Brush.TextMuted}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" Margin="0,3,0,0" FontSize="10"
                                                           Foreground="{DynamicResource Theme.Brush.TextMuted}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <Border Visibility="{Binding IsActiveVisibility}" Padding="8,4" Margin="0,0,8,0"
                                                        Background="{DynamicResource Theme.Brush.CardBackgroundAlt}"
                                                        BorderBrush="{DynamicResource Theme.Brush.Success}" BorderThickness="1"
                                                        CornerRadius="{DynamicResource Token.Radius.Badge}">
                                                    <TextBlock Text="当前使用" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Theme.Brush.TextPrimary}"/>
                                                </Border>
                                                <Button Visibility="{Binding CloneActionVisibility}" Style="{StaticResource SecondaryButtonStyle}"
                                                        Tag="{Binding Guid}" Click="BtnClonePlan_Click" ToolTip="先备份此计划，再创建可编辑副本">
                                                    <TextBlock Text="以此智能创建"/>
                                                </Button>
                                                <Button Visibility="{Binding ManagedActionsVisibility}" Style="{StaticResource SecondaryButtonStyle}"
                                                        Tag="{Binding Guid}" Click="BtnSelectManagedPlan_Click" Margin="0,0,8,0">
                                                    <TextBlock Text="高级设置"/>
                                                </Button>
                                                <Button Visibility="{Binding ManagedActionsVisibility}" Style="{StaticResource SecondaryButtonStyle}"
                                                        Tag="{Binding Guid}" Click="BtnActivateManagedPlan_Click">
                                                    <TextBlock Text="激活"/>
                                                </Button>
                                                <Button Visibility="{Binding ManagedActionsVisibility}" Style="{StaticResource SecondaryButtonStyle}"
                                                        Tag="{Binding Guid}" Click="BtnDeleteManagedPlan_Click" Margin="8,0,0,0"
                                                        ToolTip="切回创建前的源计划后删除此宇奇受管副本">
                                                    <TextBlock Text="删除并切回原计划"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="TxtPlansEmpty" Visibility="Collapsed" Margin="0,6,0,0" FontSize="11"
                                   Foreground="{DynamicResource Theme.Brush.TextSecondary}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PowerSection}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" Margin="0,0,10,0"
                                    Background="{DynamicResource Theme.Brush.IconBackground}"
                                    BorderBrush="{DynamicResource Theme.Brush.CardBorderSubtle}"
                                    BorderThickness="1" CornerRadius="{DynamicResource Token.Radius.Card}">
                                <Path Data="M12,8 A4,4 0 1 1 12,16 A4,4 0 1 1 12,8 M12,3 V5 M12,19 V21 M3,12 H5 M19,12 H21 M5.6,5.6 L7,7 M17,17 L18.4,18.4 M18.4,5.6 L17,7 M7,17 L5.6,18.4" Margin="8"
                                      Stroke="{DynamicResource Theme.Brush.IconPrimary}" StrokeThickness="1.7"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="受管计划高级设置" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Theme.Brush.TextPrimary}"/>
                                <TextBlock Text="只编辑宇奇创建的副本；每次保存前导出完整 .pow 备份，失败会补偿原值。"
                                           Margin="0,2,0,0" FontSize="10"
                                           Foreground="{DynamicResource Theme.Brush.TextMuted}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="TxtNoManagedPlan" Text="尚无受管计划。请先从上方策略或 Windows / OEM 计划创建副本；此处不会用默认值猜测系统参数。"
                                   Margin="0,2,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Theme.Brush.TextSecondary}"/>
                        <StackPanel x:Name="AdvancedEditorPanel">
                        <ComboBox x:Name="ManagedPlanSelector" DisplayMemberPath="Name" SelectionChanged="ManagedPlanSelector_SelectionChanged"
                                  MinHeight="36" Margin="0,0,0,14" AutomationProperties.Name="选择宇奇受管电源计划"/>

                        <controls:EnhancedSlider x:Name="SliderCpuMinimum" Title="处理器最小状态（AC）"
                                                 Description="保留动态降频可降低待机温度；极限 100% 会显著增加功耗。"
                                                 Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTick="True" Unit="%" Margin="0,0,0,10"/>
                        <controls:EnhancedSlider x:Name="SliderCpuMaximum" Title="处理器最大状态（AC）"
                                                 Description="100% 允许处理器使用完整性能范围。"
                                                 Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTick="True" Unit="%" Margin="0,0,0,10"/>
                        <controls:EnhancedSlider x:Name="SliderCpuEpp" Title="能效性能偏好 EPP（AC）"
                                                 Description="0 偏向性能，100 偏向节能；仅在平台实际公开时可保存。"
                                                 Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTick="True" Unit="%" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="性能提升模式（AC）" FontSize="11" Foreground="{DynamicResource Theme.Brush.TextSecondary}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="BoostModeSelector" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="禁用" Tag="0"/><ComboBoxItem Content="启用" Tag="1"/><ComboBoxItem Content="激进" Tag="2"/>
                                    <ComboBoxItem Content="高效启用" Tag="3"/><ComboBoxItem Content="高效激进" Tag="4"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel x:Name="HeteroPolicyPanel" Grid.Column="2">
                                <TextBlock Text="Intel 异构长线程调度（AC）" FontSize="11" Foreground="{DynamicResource Theme.Brush.TextSecondary}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="HeteroPolicySelector" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="全部处理器" Tag="0"/><ComboBoxItem Content="仅性能核" Tag="1"/>
                                    <ComboBoxItem Content="偏好性能核" Tag="2"/><ComboBoxItem Content="仅能效核" Tag="3"/>
                                    <ComboBoxItem Content="偏好能效核" Tag="4"/><ComboBoxItem Content="自动（推荐）" Tag="5"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" x:Name="TxtDisplayTimeoutState" MaxWidth="560"
                                       VerticalAlignment="Center" FontSize="10" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Theme.Brush.TextSecondary}"/>
                            <Button x:Name="BtnApplyAll" DockPanel.Dock="Right" Style="{StaticResource PrimaryButtonStyle}"
                                    Click="BtnApplyAll_Click" Margin="16,0,0,0"
                                    AutomationProperties.Name="备份并保存受管电源高级设置">
                                <TextBlock Text="备份并保存"/>
                            </Button>
                        </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Yuqi.Tool.Inset}" Margin="0,0,0,14" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Data="M12,8 A4,4 0 1 1 12,16 A4,4 0 1 1 12,8 M12,3 V5 M12,19 V21 M3,12 H5 M19,12 H21 M5.6,5.6 L7,7 M17,17 L18.4,18.4 M18.4,5.6 L17,7 M7,17 L5.6,18.4" Width="20" Height="20" Margin="0,1,12,0"
                              Stroke="{DynamicResource Theme.Brush.IconSecondary}" StrokeThickness="1.7" Stretch="Uniform"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="安全边界" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Theme.Brush.TextPrimary}"/>
                            <TextBlock x:Name="TxtPowerCapabilityState" Margin="0,4,0,0" FontSize="10" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Theme.Brush.TextSecondary}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource PowerSection}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="恢复最近一次已验证更改" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Theme.Brush.TextPrimary}"/>
                            <TextBlock Text="只恢复受管计划的已校验完整 .pow 备份；恢复前会再次备份当前受管计划。"
                                       Margin="0,4,0,0" FontSize="10" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Theme.Brush.TextSecondary}"/>
                        </StackPanel>
                        <Button x:Name="BtnRestoreDefault" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                                Click="BtnRestoreDefault_Click" Margin="16,0,0,0"
                                AutomationProperties.Name="恢复已验证的电源更改">
                            <TextBlock Text="恢复记录"/>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

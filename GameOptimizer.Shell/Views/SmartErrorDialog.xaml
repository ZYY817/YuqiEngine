<!-- File: GameOptimizer.Shell/Views/SmartErrorDialog.xaml -->
<Window x:Class="GameOptimizer.Shell.Views.SmartErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="错误详情"
        Width="700" Height="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    
    <Window.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>
        
        <Style x:Key="RepairButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Border Background="{DynamicResource Theme.Brush.DialogBackground}"
            CornerRadius="12"
            BorderBrush="{DynamicResource Theme.Brush.Border}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="20" ShadowDepth="0"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Title Bar -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource Theme.Brush.DialogHeader}"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Height="48" Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ErrorIcon" 
                                   Text="&#xE783;" 
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="20"
                                   Foreground="#EF4444"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <TextBlock x:Name="TitleText" 
                                   Text="错误详情"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <Button Content="&#xE711;" 
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="12"
                            Width="32" Height="32"
                            HorizontalAlignment="Right"
                            Style="{DynamicResource IconButtonStyle}"
                            Click="Close_Click"/>
                </Grid>
            </Border>
            
            <!-- Content -->
            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto"
                          Padding="24,16">
                <StackPanel>
                    <!-- Error Summary -->
                    <Border Background="{DynamicResource Theme.Brush.CardBackground}"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="错误摘要" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="ErrorSummary" 
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                                       FontSize="13"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Possible Causes -->
                    <StackPanel x:Name="CausesSection" Visibility="Collapsed">
                        <TextBlock Text="可能原因" Style="{StaticResource SectionHeaderStyle}"/>
                        <ItemsControl x:Name="CausesList" Margin="0,0,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Theme.Brush.CardBackground}"
                                            CornerRadius="6"
                                            Padding="12"
                                            Margin="0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="•" 
                                                       FontSize="16"
                                                       Foreground="{DynamicResource Theme.Brush.Accent}"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Top"/>
                                            <TextBlock Text="{Binding}" 
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                                                       FontSize="13"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    
                    <!-- Auto Repair Options -->
                    <StackPanel x:Name="RepairSection" Visibility="Collapsed">
                        <TextBlock Text="自动修复" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="点击下方按钮尝试自动修复此问题："
                                   Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                                   FontSize="12"
                                   Margin="0,0,0,8"/>
                        <ItemsControl x:Name="RepairOptionsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RepairButtonStyle}"
                                            Click="RepairOption_Click"
                                            Tag="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72C;" 
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="14"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Description}" 
                                                       FontSize="13"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    
                    <!-- Manual Steps -->
                    <StackPanel x:Name="ManualStepsSection" Visibility="Collapsed" Margin="0,16,0,0">
                        <TextBlock Text="手动解决步骤" Style="{StaticResource SectionHeaderStyle}"/>
                        <ItemsControl x:Name="ManualStepsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Theme.Brush.CardBackground}"
                                            CornerRadius="6"
                                            Padding="12"
                                            Margin="0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{DynamicResource Theme.Brush.Accent}"
                                                    Width="24" Height="24"
                                                    CornerRadius="12"
                                                    Margin="0,0,12,0"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding StepNumber}" 
                                                           Foreground="White"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding Description}" 
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                                                       FontSize="13"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    
                    <!-- Technical Details -->
                    <StackPanel x:Name="TechnicalSection" Visibility="Collapsed" Margin="0,16,0,0">
                        <TextBlock Text="技术详情" Style="{StaticResource SectionHeaderStyle}"/>
                        <Border Background="{DynamicResource Theme.Brush.CardBackground}"
                                CornerRadius="6"
                                Padding="12">
                            <TextBlock x:Name="TechnicalDetails" 
                                       TextWrapping="Wrap"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Foreground="{DynamicResource Theme.Brush.TextSecondary}"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            
            <!-- Footer -->
            <Border Grid.Row="2" 
                    Background="{DynamicResource Theme.Brush.CardBackground}"
                    BorderBrush="{DynamicResource Theme.Brush.Border}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12"
                    Padding="24,16">
                <Grid>
                    <Button x:Name="CopyReportBtn"
                            Content="复制错误报告"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            HorizontalAlignment="Left"
                            Click="CopyReport_Click"/>
                    
                    <Button Content="关闭"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            HorizontalAlignment="Right"
                            Click="Close_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

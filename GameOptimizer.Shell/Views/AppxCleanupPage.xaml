<!-- File: GameOptimizer.Shell/Views/AppxCleanupPage.xaml -->
<UserControl x:Class="GameOptimizer.Shell.Views.AppxCleanupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Theme.Brush.Background}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="CyberCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" Width="22" Height="22" CornerRadius="6"
                                Background="{DynamicResource Theme.Brush.RowBackground}" BorderBrush="{DynamicResource Theme.Brush.RowBorder}" BorderThickness="1">
                            <Path x:Name="Check" Data="M4 12l5 5L20 7" Stroke="#F59E0B" StrokeThickness="2"
                                  Stretch="Uniform" Width="12" Height="12" Visibility="Collapsed"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#20F59E0B"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#F59E0B"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#60F59E0B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="No"/>
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 恢复徽章：StagedRegister=绿 / StoreOnly=红；颜色之外有文字语义 -->
        <Style x:Key="RecoverableBadge" TargetType="Border">
            <Setter Property="Background" Value="#1522C55E"/>
            <Setter Property="BorderBrush" Value="#3022C55E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="卸载后可从本机 Staged 载荷自动恢复"/>
        </Style>

        <Style x:Key="StoreOnlyBadge" TargetType="Border">
            <Setter Property="Background" Value="#15EF4444"/>
            <Setter Property="BorderBrush" Value="#30EF4444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="无法自动恢复，如需还原只能从 Microsoft Store 手动重装"/>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.RowBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextSecondary}"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Brush.CardBackgroundHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Theme.Brush.CardBorderHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="24,12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#EF4444" Offset="0"/>
                                    <GradientStop Color="#DC2626" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#F87171" Offset="0"/>
                                            <GradientStop Color="#EF4444" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 头部 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="预装应用"
                           Foreground="{DynamicResource Theme.Brush.TextPrimaryAlt}"
                           FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="选择不需要的预装应用后再移除。显示“可恢复”的项目可由本软件恢复；其他项目需要从应用商店重新安装。"
                           Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                           FontSize="15" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Command="{Binding LoadCommand}" Style="{StaticResource GhostButton}"
                    Content="刷新列表" Margin="16,6,0,0" VerticalAlignment="Top"
                    ToolTip="重新枚举本机当前用户已注册的应用"/>
        </StackPanel>

        <!-- 内容区：列表 + 四种非就绪状态覆盖（规约 9.2） -->
        <Grid Grid.Row="1">
            <!-- 列表 -->
            <ScrollViewer Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Packages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Theme.Brush.CardBackground}"
                                    BorderBrush="{DynamicResource Theme.Brush.CardBorder}" BorderThickness="1"
                                    CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" Style="{StaticResource CyberCheckBox}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding Removable}"
                                              ToolTip="{Binding FamilyName}"/>

                                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                                                   FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="12">
                                            <Run Text="{Binding Publisher, Mode=OneWay}"/>
                                            <Run Text="{Binding Version, Mode=OneWay, StringFormat=v{0}}"/>
                                            <Run Text="{Binding FamilyName, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding NotRemovableReason}"
                                                   Foreground="#EF4444" FontSize="12" Margin="0,2,0,0"
                                                   Visibility="{Binding Removable, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                    </StackPanel>

                                    <Border Grid.Column="2" Style="{StaticResource RecoverableBadge}" Margin="0,0,8,0"
                                            Visibility="{Binding IsStagedRegister, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding RecoveryBadgeText}" FontSize="12" Foreground="#22C55E"/>
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource StoreOnlyBadge}"
                                            Visibility="{Binding IsStoreOnly, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding RecoveryBadgeText}" FontSize="12" Foreground="#EF4444"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 加载态 -->
            <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                           Foreground="#F59E0B" HorizontalAlignment="Center"/>
                <TextBlock Text="正在枚举本机应用…" Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                           FontSize="14" Margin="0,12,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- 空态 -->
            <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="本机没有枚举到可展示的应用。"
                           Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="14" HorizontalAlignment="Center"/>
                <Button Command="{Binding LoadCommand}" Style="{StaticResource GhostButton}" Content="重新加载"
                       Margin="0,16,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- 错误态 -->
            <StackPanel Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="读取失败" Foreground="#EF4444" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                           FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="480" HorizontalAlignment="Center"/>
                <Button Command="{Binding LoadCommand}" Style="{StaticResource GhostButton}" Content="重试"
                       Margin="0,16,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- 权限不足态 -->
            <StackPanel Visibility="{Binding IsUnauthorized, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="需要管理员权限" Foreground="#F59E0B" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                           FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="480" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 底部操作栏 -->
        <Border Grid.Row="2" Background="{DynamicResource Theme.Brush.SurfaceMuted}"
                CornerRadius="10" Padding="16,12" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                           Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                           FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>

                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="取消"
                        Command="{Binding CancelCommand}" Margin="0,0,12,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                        ToolTip="取消当前枚举或剩余项卸载；已完成项保留"/>

                <Button Grid.Column="2" Style="{StaticResource DangerButton}"
                        Command="{Binding UninstallSelectedCommand}">
                    <TextBlock Text="{Binding RemoveButtonText}" Foreground="#FFFFFF" FontSize="14" FontWeight="Medium"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>

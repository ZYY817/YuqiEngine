<UserControl x:Class="GameOptimizer.Shell.Views.LatencyTestPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题和说明 -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="系统响应性基准测试" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Style="{StaticResource PageSubtitleStyle}">
                    <Run Text="GameOptimizer 独家算法 | 7维度深度分析 | 精准瓶颈诊断"/>
                </TextBlock>
            </StackPanel>

            <!-- 控制面板 -->
            <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="采样次数:" VerticalAlignment="Center" Foreground="White"/>
                        <TextBox Text="{Binding SampleCount, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource ModernTextBox}"
                                 Width="80" Margin="12,0" VerticalAlignment="Center" Padding="10,8"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="24,0">
                        <Button Content="🚀 开始测试" Command="{Binding StartTestCommand}" 
                                Style="{StaticResource ModernSuccessButton}"
                                Padding="20,10" Margin="0,0,8,0"/>
                        <Button Content="停止" Command="{Binding StopTestCommand}" 
                                Style="{StaticResource ModernSecondaryButton}"
                                Padding="20,10" Margin="0,0,8,0"/>
                        <Button Content="📄 导出报告" Command="{Binding ExportReportCommand}" 
                                Style="{StaticResource ModernPrimaryButton}"
                                Padding="16,10"
                                IsEnabled="{Binding CanExport}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="16,0">
                        <ProgressBar Value="{Binding Progress, FallbackValue=0, TargetNullValue=0}" Maximum="100" 
                                     Style="{StaticResource ModernProgressBar}"
                                     Height="8" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}" Foreground="#8B94C6" FontSize="12" Margin="0,6,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Run Text="{Binding GradeEmoji, Mode=OneWay}" FontSize="24"/>
                        <Run Text="{Binding GradeText, Mode=OneWay}" Foreground="#4D66FF" FontWeight="Bold" FontSize="16"/>
                    </TextBlock>

                    <!-- 优化建议提示 -->
                    <Border Grid.Row="1" Grid.ColumnSpan="4" Margin="0,12,0,0"
                            Background="#1A2540" CornerRadius="8" Padding="12"
                            Visibility="{Binding HasOptimizationTip, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="💡" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding OptimizationTip}" 
                                       Foreground="#A1B4FF" FontSize="13" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="{Binding ShowTipsButtonText}" 
                                    Command="{Binding ToggleTipsCommand}"
                                    Style="{StaticResource ModernSecondaryButton}"
                                    Padding="12,6"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 综合评分区域 -->
            <Grid Grid.Row="2" Margin="0,0,0,16" Visibility="{Binding HasTestResult, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 综合评分卡片 -->
                <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}" Margin="0,0,8,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="综合响应性评分" Foreground="#8B94C6" FontSize="13" HorizontalAlignment="Center"/>
                        <Grid Margin="0,16">
                            <Ellipse Width="140" Height="140" Stroke="#2A3A5A" StrokeThickness="8"/>
                            <Ellipse Width="140" Height="140" Stroke="#4D66FF" StrokeThickness="8"
                                     StrokeDashArray="3.5 0.5" StrokeDashOffset="0">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-90" CenterX="70" CenterY="70"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding OverallScore}" FontSize="48" FontWeight="Bold" 
                                           Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock Text="/100" FontSize="16" Foreground="#6B7AA0" HorizontalAlignment="Center" Margin="0,-8,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Border Background="#1A2540" CornerRadius="8" Padding="12,8" HorizontalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center">
                                <Run Text="{Binding GradeEmoji, Mode=OneWay}" FontSize="16"/>
                                <Run Text="{Binding GradeText, Mode=OneWay}" Foreground="#4D66FF" FontWeight="Bold" FontSize="14"/>
                            </TextBlock>
                        </Border>
                        <TextBlock Margin="0,12,0,0" Foreground="#6B7AA0" FontSize="12" HorizontalAlignment="Center">
                            <Run Text="与理想电竞PC差距: "/>
                            <Run Text="{Binding IdealComparison, StringFormat={}{0}%}" Foreground="#F59E0B"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 核心指标 + 维度详情 -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 三大核心指标 -->
                    <Border Style="{StaticResource SectionCardStyle}" Margin="8,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="响应速度" Foreground="#8B94C6" FontSize="12" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding SpeedScore}" FontSize="32" FontWeight="Bold" 
                                           Foreground="#10B981" HorizontalAlignment="Center" Margin="0,4"/>
                                <TextBlock Text="{Binding SpeedGrade}" Foreground="#10B981" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="稳定性" Foreground="#8B94C6" FontSize="12" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding StabilityScore}" FontSize="32" FontWeight="Bold" 
                                           Foreground="#3B82F6" HorizontalAlignment="Center" Margin="0,4"/>
                                <TextBlock Text="{Binding StabilityGrade}" Foreground="#3B82F6" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="极端表现" Foreground="#8B94C6" FontSize="12" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TailScore}" FontSize="32" FontWeight="Bold" 
                                           Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,4"/>
                                <TextBlock Text="{Binding TailGrade}" Foreground="#F59E0B" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 7维度详情 -->
                    <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="详细维度分析" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding DimensionResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                            <Grid Grid.Column="1" Margin="8,0">
                                                <ProgressBar Value="{Binding Score, FallbackValue=0, TargetNullValue=0}" Maximum="100" 
                                                             Style="{StaticResource ModernProgressBar}"
                                                             Height="8" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock Grid.Column="2" Text="{Binding Score, StringFormat={}{0}分}" 
                                                       Foreground="#4D66FF" FontWeight="SemiBold" FontSize="12" 
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="3" Text="{Binding FormattedValue}" 
                                                       Foreground="#6B7AA0" FontSize="11" 
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- 详细优化建议面板 -->
            <Border Grid.Row="3" Style="{StaticResource SectionCardStyle}" Margin="0,0,0,16"
                    Visibility="{Binding ShowDetailedTips, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="🔧 瓶颈诊断与优化建议" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding Bottlenecks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#141E30" CornerRadius="8" Padding="14" Margin="0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border CornerRadius="6" Padding="8,4" VerticalAlignment="Top" Margin="0,0,12,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1AF59E0B"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Priority}" Value="高">
                                                            <Setter Property="Background" Value="#1AEF4444"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" FontWeight="Medium">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                        <Setter Property="Text" Value="⚠️ 中"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Priority}" Value="高">
                                                                <Setter Property="Foreground" Value="#EF4444"/>
                                                                <Setter Property="Text" Value="🔴 高"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Priority}" Value="低">
                                                                <Setter Property="Foreground" Value="#6B7AA0"/>
                                                                <Setter Property="Text" Value="🔵 低"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Issue}" Foreground="White" FontSize="13" FontWeight="Medium"/>
                                            <TextBlock Text="{Binding Suggestion}" Foreground="#A1B4FF" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 历史记录 -->
            <Border Grid.Row="4" Style="{StaticResource SectionCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="历史记录" Style="{StaticResource CardTitleStyle}"/>
                        <Button Content="🗑️ 清除历史" Command="{Binding RequestClearHistoryCommand}" 
                                Style="{StaticResource ModernDangerButton}"
                                HorizontalAlignment="Right" Padding="16,8"
                                Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>

                    <!-- 清空确认提示 -->
                    <Border Grid.Row="1" Background="#2A1A1A" CornerRadius="8" Padding="16" Margin="0,0,0,12"
                            Visibility="{Binding ShowClearHistoryConfirm, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="⚠️" FontSize="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="确认清空历史记录？" Foreground="#EF4444" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Foreground="#FCA5A5" FontSize="12" Margin="0,4,0,0">
                                    <Run Text="将删除全部 "/>
                                    <Run Text="{Binding History.Count, Mode=OneWay}"/>
                                    <Run Text=" 条测试记录"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="取消" Command="{Binding CancelClearHistoryCommand}"
                                        Style="{StaticResource ModernSecondaryButton}" Padding="16,8" Margin="0,0,8,0"/>
                                <Button Content="确认清空" Command="{Binding ConfirmClearHistoryCommand}"
                                        Style="{StaticResource ModernDangerButton}" Padding="16,8"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 空状态 -->
                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasHistory, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <TextBlock Text="📊" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock Text="暂无测试记录" Foreground="White" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="完成首次响应性测试后，记录将显示在这里" Foreground="#6B7AA0" FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,16"/>
                        <Button Content="🚀 开始测试" Command="{Binding StartTestCommand}"
                                Style="{StaticResource ModernSuccessButton}" Padding="20,12" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <ListView Grid.Row="2" ItemsSource="{Binding History}" 
                              Background="Transparent" BorderThickness="0"
                              Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,4" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" 
                                                      Command="{Binding DataContext.SelectHistoryItemCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource InnerCardStyle}">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="#4D66FF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding StartTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}" 
                                                   Foreground="#8B94C6" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center">
                                            <Run Text="{Binding ResponsivenessData.GradeEmoji, Mode=OneWay, FallbackValue=📊}"/>
                                            <Run Text="{Binding ResponsivenessData.OverallScore, Mode=OneWay, StringFormat={}评分: {0}, FallbackValue=--}" Foreground="White"/>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" 
                                                   Text="{Binding ResponsivenessData.GradeText, Mode=OneWay, FallbackValue=--}" 
                                                   Foreground="#4D66FF" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="👁 查看" Foreground="#4D66FF" FontSize="12" 
                                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

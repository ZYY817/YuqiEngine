<Window x:Class="GameOptimizer.Shell.Views.RestorePointConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认操作" Width="480" Height="Auto"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        SizeToContent="Height" MaxHeight="550" ShowInTaskbar="False">
    <Border Background="{DynamicResource Theme.Brush.BackgroundSecondary}" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource Theme.Brush.BorderSubtle}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.6" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="{DynamicResource Theme.Brush.SurfaceMuted}" CornerRadius="16,16,0,0" Padding="20,14" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TitleIcon" Text="&#xE81E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,10,0" Foreground="{DynamicResource Theme.Brush.TextPrimaryAlt}"/>
                        <TextBlock x:Name="TitleText" Text="创建系统还原点" Foreground="{DynamicResource Theme.Brush.TextPrimaryAlt}" FontSize="15" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" Click="Close_Click"
                            Background="Transparent" Foreground="{DynamicResource Theme.Brush.TextMuted}" BorderThickness="0"
                            Width="28" Height="28" Cursor="Hand" FontSize="14"/>
                </Grid>
            </Border>
            
            <!-- 内容区域 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                <StackPanel>
                    <!-- 主要信息卡片 -->
                    <Border x:Name="MainInfoCard" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1022C55E" Offset="0"/>
                                <GradientStop Color="#0809090B" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2522C55E" Offset="0"/>
                                <GradientStop Color="#10FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.BorderThickness>1</Border.BorderThickness>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="48" Height="48" CornerRadius="10" Margin="0,0,14,0" VerticalAlignment="Top">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#2022C55E" Offset="0"/>
                                        <GradientStop Color="#1022C55E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock x:Name="CardIcon" Text="&#xE83D;" FontFamily="Segoe MDL2 Assets" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#22C55E"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="CardTitle" Text="即将创建系统快照" Foreground="{DynamicResource Theme.Brush.TextPrimaryAlt}" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock x:Name="CardDescription" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- 还原点描述 (仅创建时显示) -->
                    <Border x:Name="DescriptionSection" Background="{DynamicResource Theme.Brush.SurfaceMuted}" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock x:Name="DescriptionLabel" Text="还原点描述" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="12" Margin="0,0,0,8"/>
                            <Border Background="{DynamicResource Theme.Brush.CardBackgroundAlt}" CornerRadius="8" Padding="12,10" BorderBrush="{DynamicResource Theme.Brush.CardBorder}" BorderThickness="1">
                                <TextBlock x:Name="DescriptionText" Foreground="{DynamicResource Theme.Brush.TextPrimaryAlt}" FontSize="13" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    
                    <!-- 操作说明 -->
                    <TextBlock x:Name="InfoLabel" Text="操作说明" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="12" Margin="0,0,0,10"/>
                    <Border Background="{DynamicResource Theme.Brush.SurfaceMuted}" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                        <StackPanel x:Name="InfoList">
                            <!-- 动态填充 -->
                        </StackPanel>
                    </Border>
                    
                    <!-- 时间提示 -->
                    <Border x:Name="TimeHintSection" Background="#0AF59E0B" CornerRadius="10" Padding="14" BorderBrush="#15F59E0B" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏱️" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TimeHintText" Text="预计需要 1-2 分钟，请耐心等待" Foreground="#F59E0B" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            
            <!-- 底部按钮 -->
            <Border Grid.Row="2" Background="{DynamicResource Theme.Brush.SurfaceMuted}" CornerRadius="0,0,16,16" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock x:Name="FooterHint" Grid.Column="0" Foreground="{DynamicResource Theme.Brush.TextDisabled}" FontSize="11" VerticalAlignment="Center"/>
                    
                    <Button Grid.Column="1" Click="Cancel_Click" Cursor="Hand" Margin="0,0,10,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource Theme.Brush.BorderLight}" BorderThickness="1" CornerRadius="8" Padding="20,10">
                                    <TextBlock Text="取消" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="12"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Brush.CardBackgroundHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <Button x:Name="ConfirmBtn" Grid.Column="2" Click="Confirm_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="8" Padding="20,10">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#22C55E" Offset="0"/>
                                            <GradientStop Color="#16A34A" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="ConfirmIcon" Text="&#xE81E;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Brush.TextPrimary}"/>
                                        <TextBlock x:Name="ConfirmText" Text="确认创建" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#4ADE80" Offset="0"/>
                                                    <GradientStop Color="#22C55E" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

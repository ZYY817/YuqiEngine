<Window x:Class="GameOptimizer.Shell.Views.CleanupConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认清理" Width="600" Height="520"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        SizeToContent="Height" MaxHeight="700"
        KeyDown="Window_KeyDown"
        FocusManager.FocusedElement="{Binding ElementName=ConfirmBtn}">
    <Border Background="{DynamicResource Theme.Brush.BackgroundSecondary}" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource Theme.Brush.BorderSubtle}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.6" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="{DynamicResource Theme.Brush.SurfaceMuted}" CornerRadius="16,16,0,0" Padding="20,14" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠" FontSize="16" Foreground="#F59E0B" Margin="0,0,10,0"/>
                        <TextBlock x:Name="DialogTitleText" Text="确认清理" Foreground="{DynamicResource Theme.Brush.TextPrimaryAlt}" FontSize="15" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" Click="Close_Click"
                            Background="Transparent" Foreground="{DynamicResource Theme.Brush.TextMuted}" BorderThickness="0"
                            Width="28" Height="28" Cursor="Hand" FontSize="14"/>
                </Grid>
            </Border>
            
            <!-- 内容区域 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                <StackPanel>
                    <!-- 警告提示 -->
                    <Border Background="#15F59E0B" CornerRadius="10" Padding="16,12" Margin="0,0,0,16" BorderBrush="#30F59E0B" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠" FontSize="14" Foreground="#F59E0B" Margin="0,0,8,0"/>
                                <TextBlock x:Name="WarningTitleText" Text="文件将移入可恢复隔离区" Foreground="#F59E0B" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock x:Name="WarningDescText" Text="文件不会立刻删除，而是先移到隔离区。需要时可用“恢复隔离文件”放回原来的位置。" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- 统计信息 -->
                    <Border Background="{DynamicResource Theme.Brush.RowBackground}" CornerRadius="10" Padding="16,14" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock x:Name="LblSelectedItems" Text="清理项目" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="12" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="SelectedCountText" Text="0" Foreground="{DynamicResource Theme.Brush.TextPrimaryAlt}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                            
                            <Border Grid.Column="1" Width="1" Height="36" Background="{DynamicResource Theme.Brush.Border}"/>
                            
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock x:Name="LblFileCount" Text="文件数量" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="12" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="FileCountText" Text="0" Foreground="#F59E0B" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                            
                            <Border Grid.Column="3" Width="1" Height="36" Background="{DynamicResource Theme.Brush.Border}"/>
                            
                            <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                <TextBlock x:Name="LblTotalSize" Text="可释放空间" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="12" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TotalSizeText" Text="0 MB" Foreground="#22C55E" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- 清理项目列表标题 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="📋" FontSize="12"/>
                        <TextBlock x:Name="LblItemDetails" Text="清理项目详情" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="12" FontWeight="Medium" Margin="6,0,0,0"/>
                    </StackPanel>
                    
                    <!-- 清理项目列表 -->
                    <Border Background="{DynamicResource Theme.Brush.SurfaceMuted}" CornerRadius="10" Padding="4" BorderBrush="{DynamicResource Theme.Brush.Border}" BorderThickness="1">
                        <ItemsControl x:Name="ItemsListControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Theme.Brush.BackgroundSecondary}" CornerRadius="8" Padding="12,10" Margin="2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- 图标 -->
                                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="{DynamicResource Theme.Brush.Border}" Margin="0,0,10,0">
                                                <TextBlock Text="🗑️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            
                                            <!-- 名称和描述 -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Theme.Brush.TextPrimaryAlt}" FontSize="12" FontWeight="Medium"/>
                                                    <!-- 风险标签 -->
                                                    <Border Margin="8,0,0,0" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#1522C55E"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Risk}" Value="Low">
                                                                        <Setter Property="Background" Value="#1560A5FA"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Risk}" Value="Medium">
                                                                        <Setter Property="Background" Value="#15F59E0B"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="9">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="安全"/>
                                                                    <Setter Property="Foreground" Value="#22C55E"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Risk}" Value="Low">
                                                                            <Setter Property="Text" Value="低风险"/>
                                                                            <Setter Property="Foreground" Value="#60A5FA"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Risk}" Value="Medium">
                                                                            <Setter Property="Text" Value="中等"/>
                                                                            <Setter Property="Foreground" Value="#F59E0B"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource Theme.Brush.TextDisabled}" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                                            </StackPanel>
                                            
                                            <!-- 文件数 -->
                                            <TextBlock Grid.Column="2" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} 个">
                                                        <Binding Path="FileCount"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            
                                            <!-- 大小 -->
                                            <TextBlock Grid.Column="3" Text="{Binding SizeText}" Foreground="#F59E0B" FontSize="12" FontWeight="SemiBold" 
                                                       FontFamily="Consolas" VerticalAlignment="Center" MinWidth="70" TextAlignment="Right" Margin="0,0,10,0"/>
                                            
                                            <!-- 查看详情按钮 -->
                                            <Border Grid.Column="4" Width="24" Height="24" CornerRadius="4" Background="{DynamicResource Theme.Brush.Border}" 
                                                    Cursor="Hand" ToolTip="查看文件列表" VerticalAlignment="Center"
                                                    MouseLeftButtonUp="ViewDetails_Click" Tag="{Binding}">
                                                <TextBlock Text="📂" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            
            <!-- 底部按钮 -->
            <Border Grid.Row="2" Background="{DynamicResource Theme.Brush.SurfaceMuted}" CornerRadius="0,0,16,16" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock x:Name="TipText" Grid.Column="0" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="12" VerticalAlignment="Center">
                        <Run Text="💡 有疑问时，可先取消并查看每项的文件列表"/>
                    </TextBlock>
                    
                    <Button x:Name="CancelBtn" Grid.Column="1" Click="Cancel_Click" Cursor="Hand" Margin="0,0,10,0" IsCancel="True"
                            Background="Transparent" Foreground="{DynamicResource Theme.Brush.TextSecondary}" BorderThickness="1" BorderBrush="{DynamicResource Theme.Brush.BorderLight}"
                            Padding="20,10" FontSize="12">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <TextBlock x:Name="CancelBtnText" Text="取消" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="12"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Brush.CardBackgroundHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <Button x:Name="ConfirmBtn" Grid.Column="2" Click="Confirm_Click" Cursor="Hand" IsDefault="True">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="8" Padding="20,10">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#F59E0B" Offset="0"/>
                                            <GradientStop Color="#D97706" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🧹" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ConfirmBtnText" Text="确认清理" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#FBBF24" Offset="0"/>
                                                    <GradientStop Color="#F59E0B" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

<Window x:Class="GameOptimizer.Shell.Views.GameProfileEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Game Profile" Width="650" Height="750"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource Theme.Brush.RowBackground}" BorderBrush="{DynamicResource Theme.Brush.CardBorder}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Border Grid.Row="0" Background="{DynamicResource Theme.Brush.BackgroundSecondary}" CornerRadius="12,12,0,0" Padding="16,12"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F3AE;" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock x:Name="DialogTitleText" Text="Edit Game Profile" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="&#x2715;" HorizontalAlignment="Right" Click="CloseButton_Click"
                            Background="Transparent" BorderThickness="0" Foreground="#6B6B70" 
                            FontSize="14" Cursor="Hand" Width="24" Height="24"/>
                </Grid>
            </Border>
            
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                <StackPanel>
                    <TextBlock x:Name="LblGameName" Text="Game Name" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="13" Margin="0,0,0,8"/>
                    <TextBox x:Name="GameNameBox" Background="{DynamicResource Theme.Brush.RowBackground}" Foreground="{DynamicResource Theme.Brush.TextPrimary}" 
                             BorderBrush="{DynamicResource Theme.Brush.CardBorder}" Padding="12,10" FontSize="13"/>
                    
                    <TextBlock x:Name="LblExePath" Text="Executable Path" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="13" Margin="0,16,0,8"/>
                    <TextBlock x:Name="GamePathText" Foreground="#6B6B70" FontSize="12" TextWrapping="Wrap"/>
                    
                    <Border Background="{DynamicResource Theme.Brush.BackgroundSecondary}" CornerRadius="8" Padding="14" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="LblGameType" Text="Game Type" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="13" FontWeight="Medium"/>
                                <TextBlock x:Name="GameTypeDescText" Text="Auto-detected based on game name" Foreground="#6B6B70" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                            <ComboBox x:Name="GameTypeCombo" Grid.Column="1" Width="160" VerticalAlignment="Center" SelectionChanged="GameTypeCombo_SelectionChanged"/>
                        </Grid>
                    </Border>

                    <Border x:Name="RecommendationPanel" Background="#1A2E88F2" CornerRadius="8" Padding="14" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x2728;" FontSize="14" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="LblSmartRecommend" Text="Smart Recommendation" Foreground="#2E88F2" FontSize="13" FontWeight="Medium"/>
                                </StackPanel>
                                <TextBlock x:Name="RecommendDescText" Text="Apply optimizations for this game type" Foreground="#6B6B70" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button x:Name="ApplyRecommendBtn" Grid.Column="1" Content="Apply" Click="ApplyRecommendation_Click"
                                    Background="#2E88F2" BorderThickness="0" Foreground="White" FontSize="12" Padding="16,8" Cursor="Hand" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    
                    <Border Background="{DynamicResource Theme.Brush.RowBackground}" CornerRadius="8" Padding="14" Margin="0,12,0,0">
                        <Grid>
                            <StackPanel>
                                <TextBlock x:Name="LblAutoOptimize" Text="Auto-optimize on Launch" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="13" FontWeight="Medium"/>
                                <TextBlock x:Name="LblAutoOptimizeDesc" Text="Automatically apply optimizations when game starts" Foreground="#6B6B70" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="AutoOptimizeCheck" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    
                    <Border Background="{DynamicResource Theme.Brush.RowBackground}" CornerRadius="8" Padding="14" Margin="0,8,0,0">
                        <Grid>
                            <StackPanel>
                                <TextBlock x:Name="LblRestoreOnExit" Text="Restore on Exit" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="13" FontWeight="Medium"/>
                                <TextBlock x:Name="LblRestoreOnExitDesc" Text="Restore original settings when game exits" Foreground="#6B6B70" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="RestoreOnExitCheck" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Background="{DynamicResource Theme.Brush.RowBackground}" CornerRadius="8" Padding="14" Margin="0,8,0,0">
                        <Grid>
                            <StackPanel>
                                <TextBlock x:Name="LblAutoHighPriority" Text="Auto High Priority" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="13" FontWeight="Medium"/>
                                <TextBlock x:Name="LblAutoHighPriorityDesc" Text="Automatically set process to high priority when game starts" Foreground="#6B6B70" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="AutoHighPriorityCheck" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Grid Margin="0,16,0,8">
                        <TextBlock x:Name="LblEnabledOpts" Text="Enabled Optimizations" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="13"/>
                        <TextBlock x:Name="SelectedCountText" Text="0 selected" Foreground="#6B6B70" FontSize="12" HorizontalAlignment="Right"/>
                    </Grid>

                    <ItemsControl x:Name="OptimizationList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Theme.Brush.RowBackground}" CornerRadius="6" Padding="12" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="12" FontWeight="Medium"/>
                                                <Border CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#1A34C759"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RiskLevel}" Value="High">
                                                                    <Setter Property="Background" Value="#1AFF3B30"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding RiskLevel}" Value="Medium">
                                                                    <Setter Property="Background" Value="#1AFF9500"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding RiskText}" FontSize="10">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#34C759"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RiskLevel}" Value="High">
                                                                        <Setter Property="Foreground" Value="#FF3B30"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding RiskLevel}" Value="Medium">
                                                                        <Setter Property="Foreground" Value="#FF9500"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Foreground="#6B6B70" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding ModuleName}" Foreground="#48484A" FontSize="10" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            
            <Border Grid.Row="2" Background="{DynamicResource Theme.Brush.BackgroundSecondary}" CornerRadius="0,0,12,12" Padding="20,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelBtn" Content="Cancel" Click="CancelButton_Click"
                            Background="Transparent" BorderBrush="{DynamicResource Theme.Brush.CardBorder}" BorderThickness="1"
                            Foreground="#A1A1A6" FontSize="13" Padding="20,10" Cursor="Hand"/>
                    <Button x:Name="SaveBtn" Content="Save" Click="SaveButton_Click" Margin="12,0,0,0"
                            Background="#2E88F2" BorderThickness="0"
                            Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="13" Padding="20,10" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

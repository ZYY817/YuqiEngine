<UserControl x:Class="GameOptimizer.Shell.Views.RepairCenterPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GameOptimizer.Shell.Converters" xmlns:constants="clr-namespace:GameOptimizer.Shell.Constants" Background="{DynamicResource Theme.Brush.AppBackground}">
  <UserControl.Resources>
    <local:InverseBoolConverter x:Key="InverseBool"/><local:EnumEqualsConverter x:Key="SelectedRepairCategory"/><local:BoolToVisibilityConverter x:Key="BoolToVisibility"/><local:IntToVisibilityConverter x:Key="PositiveCountToVisibility"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextPrimary}"/><Setter Property="TextOptions.TextFormattingMode" Value="Display"/><Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/></Style>
    <Style x:Key="BlackActionButton" TargetType="Button" BasedOn="{StaticResource Yuqi.ToolButton}"><Setter Property="Background" Value="#2F6FED"/><Setter Property="BorderBrush" Value="#4A82F2"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="14,9"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#245AC5"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#323844"/><Setter Property="BorderBrush" Value="#505969"/><Setter Property="Foreground" Value="#C8CFDA"/></Trigger></Style.Triggers></Style>
    <Style x:Key="SoftActionButton" TargetType="Button" BasedOn="{StaticResource Yuqi.ToolButton}"><Setter Property="Background" Value="{DynamicResource Theme.Brush.CardBackgroundAlt}"/><Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.CardBorderSubtle}"/><Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextPrimary}"/><Setter Property="Padding" Value="12,8"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style>
    <Style x:Key="CategoryButton" TargetType="Button" BasedOn="{StaticResource Yuqi.ToolButton}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,9"/><Setter Property="Margin" Value="0,0,0,3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
    <Style x:Key="CategoryToggle" TargetType="ToggleButton" BasedOn="{StaticResource Yuqi.RailToggle}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,9"/><Setter Property="Margin" Value="0,0,0,3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
    <Style x:Key="RepairItemCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Theme.Brush.CardBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.CardBorderSubtle}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Token.Radius.Card}"/>
      <Setter Property="Focusable" Value="False"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Theme.Brush.CardBackgroundHover}"/><Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.CardBorderHover}"/></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.ControlAccent}"/><Setter Property="BorderThickness" Value="2"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ScanResultPrimaryText" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextPrimary}"/><Setter Property="TextOptions.TextFormattingMode" Value="Display"/><Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/></Style>
    <Style x:Key="ScanResultMetaText" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextSecondary}"/><Setter Property="TextOptions.TextFormattingMode" Value="Display"/><Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/></Style>
    <!-- 扫描结论使用文字而非字体图标，避免设备缺字时出现空白或乱码符号。 -->
    <Style x:Key="ScanResultIcon" TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/></Style>
  </UserControl.Resources>
  <Grid Margin="24,20,24,28" Style="{StaticResource Yuqi.ToolPageEntrance}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="{DynamicResource Theme.Brush.CardBackground}" BorderBrush="{DynamicResource Theme.Brush.CardBorderSubtle}" BorderThickness="1" CornerRadius="{DynamicResource Token.Radius.CardLarge}" Padding="24,20">
        <Grid MinHeight="136"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
          <Border Width="96" Height="96" CornerRadius="48" Background="{DynamicResource Theme.Brush.CardBackgroundAlt}" BorderBrush="{DynamicResource Theme.Brush.CardBorderSubtle}" BorderThickness="1" VerticalAlignment="Center"><Grid VerticalAlignment="Center"><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="26"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Viewbox Grid.Row="0" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="M14,5 C16,3 19,3 21,4 L17,8 L14,7 L13,4 C10,5 9,8 11,10 L4,17 C3,18 3,19 4,20 C5,21 6,21 7,20 L14,13 C16,15 19,14 20,11" Fill="Transparent" Stroke="{DynamicResource Theme.Brush.TextSecondary}" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox><TextBlock Grid.Row="1" Text="{Binding ScannedItemCount}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Grid.Row="2" Text="已扫描" FontSize="11" Foreground="{DynamicResource Theme.Brush.TextSecondary}" HorizontalAlignment="Center"/></Grid></Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="让电脑回到健康状态" FontSize="22" FontWeight="Bold"/><TextBlock Text="一键扫描系统潜在故障 · 自动定位 · 解释原理 · 安全修复" FontSize="12" Foreground="{DynamicResource Theme.Brush.TextSecondary}" Margin="0,5,0,12"/><StackPanel Orientation="Horizontal">
            <StackPanel Width="72"><TextBlock Text="{Binding TotalRepairItemsCount}" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="修复工具" FontSize="10" Foreground="{DynamicResource Theme.Brush.TextSecondary}"/></StackPanel><Border Width="1" Height="34" Background="{DynamicResource Theme.Brush.CardBorderSubtle}" Margin="0,0,16,0"/>
            <StackPanel Width="62"><TextBlock Text="{Binding PotentialIssueCount}" FontSize="21" FontWeight="SemiBold" Foreground="#D76500"/><TextBlock Text="发现问题" FontSize="10" Foreground="{DynamicResource Theme.Brush.TextSecondary}"/></StackPanel><Border Width="1" Height="34" Background="{DynamicResource Theme.Brush.CardBorderSubtle}" Margin="0,0,16,0"/>
            <StackPanel Width="62"><TextBlock Text="{Binding NormalItemCount}" FontSize="21" FontWeight="SemiBold" Foreground="#00B886"/><TextBlock Text="无异常" FontSize="10" Foreground="{DynamicResource Theme.Brush.TextSecondary}"/></StackPanel><Border Width="1" Height="34" Background="{DynamicResource Theme.Brush.CardBorderSubtle}" Margin="0,0,16,0"/>
            <StackPanel Width="94"><TextBlock Text="{Binding RepairableIssueCount}" FontSize="21" FontWeight="SemiBold" Foreground="#2F6FED"/><TextBlock Text="可修复" FontSize="10" Foreground="{DynamicResource Theme.Brush.TextSecondary}"/></StackPanel>
          </StackPanel></StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center"><Button Style="{StaticResource BlackActionButton}" Command="{Binding StartScanCommand}" IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}" Height="44"><StackPanel Orientation="Horizontal"><Viewbox Width="15" Height="15" Margin="0,0,8,0"><Path Data="M12,3 V21 M3,12 H21 M6,6 L18,18 M18,6 L6,18" Fill="Transparent" Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox><TextBlock Text="一键诊断扫描" Foreground="White"/></StackPanel></Button><Border Margin="0,8,0,0" Padding="10,8" Background="{DynamicResource Theme.Brush.CardBackgroundAlt}" BorderBrush="{DynamicResource Theme.Brush.CardBorderSubtle}" BorderThickness="1" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}"><StackPanel><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding ScanProgressText}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,42,0"/><TextBlock Text="{Binding ScanProgress, StringFormat={}{0}%}" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold"/><Button Grid.Row="1" Content="取消" Command="{Binding CancelScanCommand}" Style="{StaticResource SoftActionButton}" HorizontalAlignment="Right" Margin="0,6,0,0" Padding="9,4"/></Grid><ProgressBar Value="{Binding ScanProgress}" Maximum="100" Height="4" Margin="0,7,0,0"/></StackPanel></Border><Border Margin="0,8,0,0" Padding="10,8" Background="{DynamicResource Theme.Brush.CardBackgroundAlt}" BorderBrush="{DynamicResource Theme.Brush.CardBorderSubtle}" BorderThickness="1" Visibility="{Binding HasScanResult, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="{Binding ScanProgressText}" FontSize="11" Foreground="{DynamicResource Theme.Brush.TextSecondary}" TextWrapping="Wrap"/></Border><Border Background="{DynamicResource Theme.Brush.CardBackgroundAlt}" BorderBrush="{DynamicResource Theme.Brush.CardBorderSubtle}" BorderThickness="1" Padding="10,8" Margin="0,8,0,0"><TextBlock Text="{Binding PotentialIssueCount, StringFormat=已检出 {0} 项；请逐项确认后修复}" FontSize="11" Foreground="{DynamicResource Theme.Brush.TextSecondary}" TextWrapping="Wrap"/></Border><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Viewbox Width="12" Height="12" Margin="2,0,7,0"><Path Data="M12,3 L20,6 V11 C20,16 17,20 12,22 C7,20 4,16 4,11 V6 Z M9,12 L11,14 L15,10" Fill="Transparent" Stroke="#00B886" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox><TextBlock Text="修复前会确认；不可用或不可恢复的项目会被拦截" FontSize="10" Foreground="{DynamicResource Theme.Brush.TextSecondary}"/></StackPanel></StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource Theme.Brush.CardBackground}" BorderBrush="{DynamicResource Theme.Brush.CardBorderSubtle}" BorderThickness="1" CornerRadius="0" Padding="11"><StackPanel>
          <DockPanel Margin="2,1,2,9"><TextBlock DockPanel.Dock="Right" Text="点击筛选" FontSize="10" Foreground="{DynamicResource Theme.Brush.TextMuted}"/><TextBlock Text="分类" FontSize="13" FontWeight="Bold"/></DockPanel><Border Height="1" Background="{DynamicResource Theme.Brush.CardBorderSubtle}" Margin="0,0,0,9"/>
          <Button Style="{StaticResource CategoryButton}" Command="{Binding FilterByCategoryCommand}" CommandParameter="" Background="#181A20" Foreground="White"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Viewbox Width="16" Height="16" VerticalAlignment="Center"><Path Data="M14,5 C16,3 19,3 21,4 L17,8 L14,7 L13,4 C10,5 9,8 11,10 L4,17 C3,18 3,19 4,20 C5,21 6,21 7,20 L14,13 C16,15 19,14 20,11" Fill="Transparent" Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox><TextBlock Grid.Column="1" Text="常见问题" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Grid.Column="2" Background="#555961" CornerRadius="20" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="{Binding QuickRepairActions.Count}" Foreground="White" FontSize="10"/></Border></Grid></Button>
          <ToggleButton Style="{StaticResource CategoryToggle}" Command="{Binding FilterByCategoryCommand}" CommandParameter="SystemCore" IsChecked="{Binding SelectedCategory, Mode=OneWay, Converter={StaticResource SelectedRepairCategory}, ConverterParameter=SystemCore}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Viewbox Width="16" Height="16" VerticalAlignment="Center"><Path Data="M4,4 H10 V10 H4 Z M14,4 H20 V10 H14 Z M4,14 H10 V20 H4 Z M14,14 H20 V20 H14 Z" Fill="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Foreground}"/></Viewbox><TextBlock Grid.Column="1" Text="Windows 系统" VerticalAlignment="Center"/></Grid></ToggleButton>
          <ToggleButton Style="{StaticResource CategoryToggle}" Command="{Binding FilterByCategoryCommand}" CommandParameter="Network" IsChecked="{Binding SelectedCategory, Mode=OneWay, Converter={StaticResource SelectedRepairCategory}, ConverterParameter=Network}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Viewbox Width="16" Height="16" VerticalAlignment="Center"><Path Data="M4,9 C8,5 16,5 20,9 M7,12 C10,9 14,9 17,12 M10,15 C11,14 13,14 14,15 M12,19 H12.1" Fill="Transparent" Stroke="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Foreground}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox><TextBlock Grid.Column="1" Text="网络与连接" VerticalAlignment="Center"/></Grid></ToggleButton>
          <ToggleButton Style="{StaticResource CategoryToggle}" Command="{Binding FilterByCategoryCommand}" CommandParameter="Audio" IsChecked="{Binding SelectedCategory, Mode=OneWay, Converter={StaticResource SelectedRepairCategory}, ConverterParameter=Audio}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Viewbox Width="16" Height="16" VerticalAlignment="Center"><Path Data="M4,10 H8 L13,6 V18 L8,14 H4 Z M16,9 C18,10.5 18,13.5 16,15 M18.5,6.5 C22,9.5 22,14.5 18.5,17.5" Fill="Transparent" Stroke="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Foreground}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox><TextBlock Grid.Column="1" Text="音频与显示" VerticalAlignment="Center"/></Grid></ToggleButton>
          <ToggleButton Style="{StaticResource CategoryToggle}" Command="{Binding FilterByCategoryCommand}" CommandParameter="Bluetooth" IsChecked="{Binding SelectedCategory, Mode=OneWay, Converter={StaticResource SelectedRepairCategory}, ConverterParameter=Bluetooth}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Viewbox Width="16" Height="16" VerticalAlignment="Center"><Path Data="M12,3 V21 M12,3 L17,8 L12,12 L17,16 L12,21 M7,7 L17,16 M7,17 L17,8" Fill="Transparent" Stroke="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Foreground}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Viewbox><TextBlock Grid.Column="1" Text="设备与蓝牙" VerticalAlignment="Center"/></Grid></ToggleButton>
          <ToggleButton Style="{StaticResource CategoryToggle}" Command="{Binding FilterByCategoryCommand}" CommandParameter="OptimizationRevert" IsChecked="{Binding SelectedCategory, Mode=OneWay, Converter={StaticResource SelectedRepairCategory}, ConverterParameter=OptimizationRevert}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Viewbox Width="16" Height="16" VerticalAlignment="Center"><Path Data="M7,7 H3 V3 M3,7 C6,3 13,2 18,6 C23,10 21,18 16,20 C11,22 6,19 5,15" Fill="Transparent" Stroke="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Foreground}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Viewbox><TextBlock Grid.Column="1" Text="优化项回滚" VerticalAlignment="Center"/></Grid></ToggleButton>
          <Border Height="1" Background="{DynamicResource Theme.Brush.CardBorderSubtle}" Margin="0,8"/><StackPanel Margin="8,0,0,0"><TextBlock Text="●  正常" Foreground="#2F6FED" FontSize="10" Margin="0,0,0,5"/><TextBlock Text="●  检出" Foreground="#D76500" FontSize="10" Margin="0,0,0,5"/><TextBlock Text="●  已修" Foreground="#00B886" FontSize="10" Margin="0,0,0,5"/><TextBlock Text="●  失败" Foreground="#E34B5F" FontSize="10"/></StackPanel>
        </StackPanel></Border>
        <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="4,1,2,9"><TextBlock DockPanel.Dock="Right" Text="按症状选择；不代表已检测到异常" FontSize="10" Foreground="{DynamicResource Theme.Brush.TextMuted}" VerticalAlignment="Center"/><TextBlock Text="常见问题处理" FontSize="16" FontWeight="Bold"/></DockPanel><Border Grid.Row="1" Height="1" Background="{DynamicResource Theme.Brush.CardBorderSubtle}" Margin="0,0,0,9"/>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" Padding="0,0,2,0" x:Name="ToolPageContentScrollViewer"><StackPanel>
            <Border Style="{StaticResource RepairItemCard}" Margin="0,0,10,12" Padding="14,12" Visibility="{Binding HasScanResult, Converter={StaticResource BoolToVisibility}}"><StackPanel>
              <DockPanel><TextBlock Text="{Binding ScanProgressText}" DockPanel.Dock="Right" FontSize="10" Foreground="{DynamicResource Theme.Brush.TextMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260"/><TextBlock Text="本次扫描结果" FontSize="15" FontWeight="Bold"/></DockPanel>
              <UniformGrid Columns="4" Margin="0,10,0,6"><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ScanResultIcon}" Text="{x:Static constants:IconGlyphs.Info}" Margin="0,0,5,0"/><TextBlock Style="{StaticResource ScanResultPrimaryText}" Text="{Binding ScannedItemCount}" FontSize="18" FontWeight="SemiBold"/></StackPanel><TextBlock Style="{StaticResource ScanResultMetaText}" Text="已扫描" FontSize="10"/></StackPanel><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ScanResultIcon}" Text="{x:Static constants:IconGlyphs.Check}" Foreground="{DynamicResource Theme.Brush.Success}" Margin="0,0,5,0"/><TextBlock Style="{StaticResource ScanResultPrimaryText}" Text="{Binding NormalItemCount}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Brush.Success}"/></StackPanel><TextBlock Style="{StaticResource ScanResultMetaText}" Text="无异常" FontSize="10"/></StackPanel><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ScanResultIcon}" Text="{x:Static constants:IconGlyphs.Warning}" Foreground="{DynamicResource Theme.Brush.Warning}" Margin="0,0,5,0"/><TextBlock Style="{StaticResource ScanResultPrimaryText}" Text="{Binding PotentialIssueCount}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Brush.Warning}"/></StackPanel><TextBlock Style="{StaticResource ScanResultMetaText}" Text="发现问题" FontSize="10"/></StackPanel><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ScanResultIcon}" Text="{x:Static constants:IconGlyphs.Repair}" Foreground="{DynamicResource Theme.Brush.ControlAccent}" Margin="0,0,5,0"/><TextBlock Style="{StaticResource ScanResultPrimaryText}" Text="{Binding RepairableIssueCount}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Brush.ControlAccent}"/></StackPanel><TextBlock Style="{StaticResource ScanResultMetaText}" Text="可修复" FontSize="10"/></StackPanel></UniformGrid>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ScanResultIcon}" Text="{x:Static constants:IconGlyphs.Info}" Margin="0,0,4,0"/><TextBlock Style="{StaticResource ScanResultMetaText}" FontSize="10" Text="{Binding ReadOnlyIssueCount, StringFormat=仅检测 {0} 项}"/></StackPanel><StackPanel Orientation="Horizontal" Margin="14,0,0,0"><TextBlock Style="{StaticResource ScanResultIcon}" Text="{x:Static constants:IconGlyphs.Lock}" Foreground="{DynamicResource Theme.Brush.Warning}" Margin="0,0,4,0"/><TextBlock Style="{StaticResource ScanResultMetaText}" FontSize="10" Text="{Binding SafetyBlockedIssueCount, StringFormat=已安全拦截 {0} 项}"/></StackPanel><StackPanel Orientation="Horizontal" Margin="14,0,0,0"><TextBlock Style="{StaticResource ScanResultIcon}" Text="{x:Static constants:IconGlyphs.Error}" Foreground="{DynamicResource Theme.Brush.Error}" Margin="0,0,4,0"/><TextBlock Style="{StaticResource ScanResultMetaText}" FontSize="10" Text="{Binding SkippedScanItemCount, StringFormat=未完成 {0} 项}"/></StackPanel></StackPanel>
              <Border Height="1" Background="{DynamicResource Theme.Brush.CardBorderSubtle}"/>
              <StackPanel Orientation="Horizontal" Margin="0,10,0,6" Visibility="{Binding PotentialIssueCount, Converter={StaticResource PositiveCountToVisibility}}"><TextBlock Style="{StaticResource ScanResultIcon}" Text="{x:Static constants:IconGlyphs.Warning}" Foreground="{DynamicResource Theme.Brush.Warning}" Margin="0,0,6,0"/><TextBlock Style="{StaticResource ScanResultPrimaryText}" Text="发现的问题" FontWeight="SemiBold"/></StackPanel>
              <ItemsControl ItemsSource="{Binding PotentialIssues}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource Theme.Brush.CardBorderSubtle}" BorderThickness="0,0,0,1" Padding="0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Style="{StaticResource ScanResultPrimaryText}" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Style="{StaticResource ScanResultMetaText}" Text="{Binding Description}" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel><Border Grid.Column="2" Background="{DynamicResource Theme.Brush.CardBackgroundAlt}" BorderBrush="{DynamicResource Theme.Brush.CardBorderSubtle}" BorderThickness="1" Padding="6,2" VerticalAlignment="Center"><TextBlock Style="{StaticResource ScanResultPrimaryText}" Text="{Binding SeverityText}" FontSize="10"/></Border><Button Grid.Column="4" Style="{StaticResource SoftActionButton}" Command="{Binding DataContext.ShowScanResultDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="8,5"><TextBlock Style="{StaticResource ScanResultPrimaryText}" Text="详情"/></Button><Button Grid.Column="6" Style="{StaticResource BlackActionButton}" Command="{Binding DataContext.RepairDetectedIssueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="8,5" Visibility="{Binding CanRepair, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="修复"/></Button></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <TextBlock Text="本次未发现异常" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Brush.Success}" Margin="0,10,0,0" Visibility="{Binding HasNoDetectedIssues, Converter={StaticResource BoolToVisibility}}"/>
              <TextBlock Text="本次没有发现需要处理的问题。" FontSize="11" Foreground="{DynamicResource Theme.Brush.TextSecondary}" Margin="0,8,0,0" Visibility="{Binding HasNoDetectedIssues, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel></Border>
            <ItemsControl ItemsSource="{Binding QuickRepairActions}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><DataTemplate.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextPrimary}"/><Setter Property="TextOptions.TextFormattingMode" Value="Display"/><Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/></Style></DataTemplate.Resources>
              <Border MinHeight="146" Margin="0,0,10,10" Style="{StaticResource RepairItemCard}" ClipToBounds="True"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{DynamicResource Theme.Brush.ControlAccent}" Opacity="0.72"/><Grid Grid.Column="1" Margin="14,12,14,11"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="32" Height="32" Background="{DynamicResource Theme.Brush.CardBackgroundAlt}" CornerRadius="0"><TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,8,0" TextTrimming="CharacterEllipsis"/><Border Grid.Column="2" Background="{DynamicResource Theme.Brush.CardBackgroundAlt}" BorderBrush="{DynamicResource Theme.Brush.CardBorderSubtle}" BorderThickness="1" CornerRadius="0" Padding="7,2"><TextBlock Text="{Binding AvailabilityText}" FontSize="10" Foreground="{DynamicResource Theme.Brush.TextSecondary}"/></Border></Grid>
                <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="14" LineHeight="20" Foreground="{DynamicResource Theme.Brush.TextSecondary}" TextWrapping="Wrap" MaxHeight="44" Margin="40,5,0,0"/><StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,9,0,9"><TextBlock Text="{x:Static constants:IconGlyphs.ShieldCheck}" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#00B886" Margin="0,0,6,0"/><TextBlock Text="{Binding AvailabilityText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Brush.TextSecondary}"/></StackPanel><Border Grid.Row="3" Height="1" BorderBrush="{DynamicResource Theme.Brush.CardBorderSubtle}" BorderThickness="0,1,0,0"/><Grid Grid.Row="4" Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Style="{StaticResource SoftActionButton}" Click="QuickRepairDetails_Click" Tag="{Binding}" Padding="10,7"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="{x:Static constants:IconGlyphs.Info}" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0"/><TextBlock Text="查看说明"/></StackPanel></Button><Button Grid.Column="2" Style="{StaticResource BlackActionButton}" Command="{Binding DataContext.ExecuteQuickRepairActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" IsEnabled="{Binding IsActionAvailable}" Padding="10,7"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="{x:Static constants:IconGlyphs.Repair}" FontFamily="Segoe MDL2 Assets" Foreground="White" Margin="0,0,6,0"/><TextBlock Text="开始修复" Foreground="White"/></StackPanel></Button></Grid>
              </Grid></Grid></Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
  </Grid>
</UserControl>

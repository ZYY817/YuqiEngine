<!-- File: GameOptimizer.Shell/Views/PowerScenarioConfirmDialog.xaml -->
<Window x:Class="GameOptimizer.Shell.Views.PowerScenarioConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="应用场景预设" Width="680" Height="600"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown"
        FocusManager.FocusedElement="{Binding ElementName=ConfirmBtn}">
    <Border Background="{DynamicResource Theme.Brush.BackgroundSecondary}" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource Theme.Brush.BorderSubtle}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="0" Opacity="0.5" Color="{DynamicResource Theme.Color.Shadow}"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="{DynamicResource Theme.Brush.SurfaceMuted}" CornerRadius="16,16,0,0" Padding="24,16" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡" FontSize="18" Foreground="{DynamicResource Theme.Brush.TextPrimaryAlt}" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock x:Name="TitleText" Text="应用场景预设" Foreground="{DynamicResource Theme.Brush.TextPrimaryAlt}" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ScenarioNameText" Text="" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" Click="CloseButton_Click"
                            Background="Transparent" Foreground="{DynamicResource Theme.Brush.TextMuted}" BorderThickness="0"
                            Width="32" Height="32" Cursor="Hand" FontSize="16">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Brush.CardBorder}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
            
            <!-- 内容区域 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
                <StackPanel>
                    <!-- 场景描述 -->
                    <Border Background="{DynamicResource Theme.Brush.CardBackground}" BorderBrush="{DynamicResource Theme.Brush.CardBorder}" 
                            BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock x:Name="DescriptionLabelText" Text="场景说明" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="11" Margin="0,0,0,6"/>
                            <TextBlock x:Name="ScenarioDescriptionText" Text="" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="13" 
                                       TextWrapping="Wrap" LineHeight="20"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- 变更统计 -->
                    <Border Background="{DynamicResource Theme.Brush.SurfaceMuted}" BorderBrush="{DynamicResource Theme.Brush.CardBorder}" 
                            BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="📊" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="ChangesCountText" Grid.Column="1" Text="共 0 项变更" 
                                       Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    
                    <!-- 参数对比表格 -->
                    <TextBlock x:Name="ComparisonTableHeaderText" Text="参数对比" Foreground="{DynamicResource Theme.Brush.TextPrimary}" 
                               FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    
                    <!-- 表头 -->
                    <Border Background="{DynamicResource Theme.Brush.SurfaceMuted}" BorderBrush="{DynamicResource Theme.Brush.CardBorder}" 
                            BorderThickness="1,1,1,0" CornerRadius="12,12,0,0" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="HeaderParameterNameText" Grid.Column="0" Text="参数名称" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="11" FontWeight="Medium"/>
                            <TextBlock x:Name="HeaderCurrentValueText" Grid.Column="1" Text="当前值" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="11" FontWeight="Medium" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="HeaderNewValueText" Grid.Column="2" Text="新值" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="11" FontWeight="Medium" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>
                    
                    <!-- 参数列表 -->
                    <ItemsControl x:Name="ComparisonsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Theme.Brush.CardBackground}" BorderBrush="{DynamicResource Theme.Brush.CardBorder}" 
                                        BorderThickness="1,0,1,1" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- 参数名称 -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="13" FontWeight="Medium"/>
                                            <TextBlock Text="{Binding Category}" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="10" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        
                                        <!-- 当前值 -->
                                        <TextBlock Grid.Column="1" Text="{Binding CurrentDisplayValue}" Foreground="{DynamicResource Theme.Brush.TextSecondary}" 
                                                   FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        
                                        <!-- 新值 -->
                                        <Border Grid.Column="2" Background="{DynamicResource Theme.Brush.SurfaceMuted}" CornerRadius="6" Padding="8,4" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding NewDisplayValue}" Foreground="{DynamicResource Theme.Brush.AccentPrimary}" 
                                                       FontSize="13" FontWeight="Medium"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <!-- 无变更提示 -->
                    <Border x:Name="NoChangesPanel" Visibility="Collapsed" Background="{DynamicResource Theme.Brush.CardBackground}" 
                            BorderBrush="{DynamicResource Theme.Brush.CardBorder}" BorderThickness="1,0,1,1" CornerRadius="0,0,12,12" Padding="24">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="✓" FontSize="32" Foreground="{DynamicResource Theme.Brush.TextMuted}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock x:Name="NoChangesText" Text="无变更" Foreground="{DynamicResource Theme.Brush.TextMuted}" 
                                       FontSize="13" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            
            <!-- 底部按钮 -->
            <Border Grid.Row="2" Background="{DynamicResource Theme.Brush.SurfaceMuted}" CornerRadius="0,0,16,16" Padding="24,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelBtn" Click="CancelButton_Click" Cursor="Hand" Margin="0,0,12,0" IsCancel="True">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource Theme.Brush.CardBorder}" BorderThickness="1" CornerRadius="10" Padding="24,12">
                                    <TextBlock x:Name="CancelBtnText" Text="取消" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="13"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Brush.CardBackgroundHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="ConfirmBtn" Click="ConfirmButton_Click" Cursor="Hand" IsDefault="True">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="10" Padding="24,12">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#6366F1" Offset="0"/>
                                            <GradientStop Color="#8B5CF6" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock x:Name="ConfirmBtnText" Text="确认应用" Foreground="#FFFFFF" FontSize="13" FontWeight="Medium"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#7C7FF2" Offset="0"/>
                                                    <GradientStop Color="#9D7DF7" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

<UserControl x:Class="GameOptimizer.Shell.Views.GameModeHubPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1000"
             Background="Transparent">
    <UserControl.Resources>
        <!-- 主卡片样式 -->
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#0D1424"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        
        <!-- 优化项卡片样式 - 未选中 -->
        <Style x:Key="OptItemCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#141E30"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1E2A42"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <!-- 圆形选择指示器样式 - 未选中 -->
        <Style x:Key="SelectIndicatorStyle" TargetType="Border">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#3A4565"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <!-- 已生效标签样式 -->
        <Style x:Key="ActiveTagStyle" TargetType="Border">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        
        <!-- 风险标签 -->
        <Style x:Key="RiskTagSafe" TargetType="Border">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>
        <Style x:Key="RiskTagMedium" TargetType="Border">
            <Setter Property="Background" Value="#F59E0B"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>
        <Style x:Key="RiskTagHigh" TargetType="Border">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>

        <!-- 筛选按钮样式 - 未选中 -->
        <Style x:Key="FilterBtnStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#8B94C6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#2A3555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4D66FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4D66FF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E2A42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 主操作按钮 -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#4D66FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5D76FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 次要按钮 -->
        <Style x:Key="SecondaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A2340"/>
            <Setter Property="Foreground" Value="#C9D2FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2A3555"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#253055"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4D66FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 快捷操作按钮 -->
        <Style x:Key="QuickBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#141E30"/>
            <Setter Property="Foreground" Value="#C9D2FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1E2A42"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E2A42"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4D66FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 信息图标 -->
        <Style x:Key="InfoIconStyle" TargetType="Border">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background" Value="#2A3555"/>
            <Setter Property="Cursor" Value="Help"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4D66FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,24">
            
            <!-- 页面标题 -->
            <StackPanel Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <Border Width="36" Height="36" CornerRadius="8" Background="#4D66FF">
                        <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="18" 
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="游戏模式中心" FontSize="26" FontWeight="Bold" 
                               Foreground="White" Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="为玩家打造的一站式游戏优化体验 · 提升帧率 · 降低延迟" 
                           FontSize="14" Foreground="#8B94C6" Margin="50,8,0,0"/>
            </StackPanel>

            <!-- 操作栏：筛选 + 快捷操作 + 主按钮 -->
            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- 第一行：筛选按钮 + 恢复/应用按钮 -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- 筛选按钮组 -->
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="FilterAll" Content="全部" GroupName="Filter" IsChecked="True"
                                         Style="{StaticResource FilterBtnStyle}" Checked="FilterChanged" Margin="0,0,8,0"/>
                            <RadioButton x:Name="FilterPerformance" Content="性能优先" GroupName="Filter"
                                         Style="{StaticResource FilterBtnStyle}" Checked="FilterChanged" Margin="0,0,8,0"/>
                            <RadioButton x:Name="FilterBalanced" Content="平衡模式" GroupName="Filter"
                                         Style="{StaticResource FilterBtnStyle}" Checked="FilterChanged" Margin="0,0,8,0"/>
                            <RadioButton x:Name="FilterSafe" Content="安全模式" GroupName="Filter"
                                         Style="{StaticResource FilterBtnStyle}" Checked="FilterChanged"/>
                        </StackPanel>
                        
                        <!-- 恢复只允许从可验证的备份中心进入；不猜测不同 Windows 的“默认值”。 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="RestoreBackupBtn" Click="OpenBackupManager_Click" Style="{StaticResource SecondaryBtnStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="备份与恢复" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    
                    <!-- 分隔线 -->
                    <Border Grid.Row="1" Height="1" Background="#1E2A42" Margin="0,16"/>
                    
                    <!-- 第二行：快捷操作 + 应用按钮 -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- 快捷操作 -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="快捷操作：" Foreground="#8B94C6" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Click="ClearCache_Click" Style="{StaticResource QuickBtnStyle}" Margin="0,0,10,0"
                                    ToolTip="清理 Windows 临时目录中的文件">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="清理临时文件" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Click="FlushDns_Click" Style="{StaticResource QuickBtnStyle}" Margin="0,0,10,0"
                                    ToolTip="清除 DNS 解析缓存">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="刷新 DNS" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Click="FreeMemory_Click" Style="{StaticResource QuickBtnStyle}" Margin="0,0,10,0"
                                    ToolTip="释放系统待机内存">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEBFC;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="释放内存" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Click="RestartExplorer_Click" Style="{StaticResource QuickBtnStyle}"
                                    ToolTip="重启资源管理器刷新界面">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="重启资源管理器" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        
                        <!-- 应用按钮 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="ApplyBtn" Click="ApplySelected_Click" Style="{StaticResource PrimaryBtnStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="应用勾选优化" Margin="8,0,0,0" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 三列优化区域 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 帧率提升 -->
                <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#F59E0B">
                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="16" 
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="帧率提升" FontSize="16" FontWeight="SemiBold" 
                                       Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            <Border Background="#1E2A42" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="9项" FontSize="11" Foreground="#8B94C6"/>
                            </Border>
                        </StackPanel>
                        
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                            <StackPanel x:Name="FpsOptPanel">
                                <!-- GPU 优化组标题 -->
                                <TextBlock Text="GPU 优化" Foreground="#F59E0B" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                
                                <!-- 硬件加速 GPU 调度 -->
                                <Border x:Name="CardHags" Style="{StaticResource OptItemCardStyle}" Margin="0,0,0,10" 
                                        MouseLeftButtonUp="OptCard_Click" Tag="gpu.enable_hags">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="显卡硬件加速调度" Foreground="White" FontSize="13" FontWeight="Medium"/>
                                                <Border Style="{StaticResource InfoIconStyle}"
                                                        ToolTip="功能说明：启用 Windows 硬件加速 GPU 调度 (HAGS)&#x0a;优化原理：让显卡自己管理显存，不用CPU来指挥，减少中间环节&#x0a;预期效果：FPS 提升 3-8%，画面更流畅&#x0a;通俗解释：让显卡自己干活，不用CPU当中间人传话&#x0a;适用场景：所有现代游戏，需要Win10 2004以上版本">
                                                    <TextBlock Text="?" Foreground="#C9D2FF" FontSize="10" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="让显卡自己管理显存，减少CPU干预" Foreground="#8B94C6" FontSize="11" Margin="0,6,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Border Style="{StaticResource RiskTagSafe}">
                                                    <TextBlock Text="安全" Foreground="White" FontSize="10" FontWeight="Medium"/>
                                                </Border>
                                                <TextBlock Text="FPS +3-8%" Foreground="#10B981" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border x:Name="TagHagsActive" Style="{StaticResource ActiveTagStyle}" Margin="0,10,0,0" Visibility="Collapsed">
                                                <TextBlock Text="已生效" Foreground="White" FontSize="11" FontWeight="Medium"/>
                                            </Border>
                                        </StackPanel>
                                        <!-- 选中指示器 -->
                                        <Border Grid.Column="1" x:Name="IndicatorHags" Style="{StaticResource SelectIndicatorStyle}">
                                            <Ellipse x:Name="DotHags" Width="12" Height="12" Fill="#4D66FF" Visibility="Collapsed"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                
                                <!-- 全局优先独显 -->
                                <Border x:Name="CardForceGpu" Style="{StaticResource OptItemCardStyle}" Margin="0,0,0,10"
                                        MouseLeftButtonUp="OptCard_Click" Tag="gpu.force_high_performance_gpu">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="全局优先独显" Foreground="White" FontSize="13" FontWeight="Medium"/>
                                                <Border Style="{StaticResource InfoIconStyle}"
                                                        ToolTip="功能说明：强制所有程序使用独立显卡运行&#x0a;优化原理：避免集成显卡和独立显卡之间的切换延迟&#x0a;预期效果：FPS 提升 5-10%&#x0a;注意：可能增加功耗和发热">
                                                    <TextBlock Text="?" Foreground="#C9D2FF" FontSize="10" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="强制所有程序使用独立显卡" Foreground="#8B94C6" FontSize="11" Margin="0,6,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Border Style="{StaticResource RiskTagMedium}">
                                                    <TextBlock Text="中等" Foreground="White" FontSize="10" FontWeight="Medium"/>
                                                </Border>
                                                <TextBlock Text="FPS +5-10%" Foreground="#F59E0B" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border x:Name="TagForceGpuActive" Style="{StaticResource ActiveTagStyle}" Margin="0,10,0,0" Visibility="Collapsed">
                                                <TextBlock Text="已生效" Foreground="White" FontSize="11" FontWeight="Medium"/>
                                            </Border>
                                        </StackPanel>
                                        <Border Grid.Column="1" x:Name="IndicatorForceGpu" Style="{StaticResource SelectIndicatorStyle}">
                                            <Ellipse x:Name="DotForceGpu" Width="12" Height="12" Fill="#4D66FF" Visibility="Collapsed"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                
                                <!-- GPU SFIO 优先级 -->
                                <Border x:Name="CardSfio" Style="{StaticResource OptItemCardStyle}" Margin="0,0,0,16"
                                        MouseLeftButtonUp="OptCard_Click" Tag="gpu.set_sfio_priority">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="游戏读写优先" Foreground="White" FontSize="13" FontWeight="Medium"/>
                                                <Border Style="{StaticResource InfoIconStyle}"
                                                        ToolTip="功能说明：提升游戏进程的磁盘读写优先级 (SFIO)&#x0a;优化原理：让系统优先处理游戏的数据读写请求，减少加载卡顿&#x0a;预期效果：FPS 提升 2-5%，减少游戏中的卡顿&#x0a;通俗解释：让电脑优先给游戏读取数据，其他程序排队等&#x0a;风险提示：可能影响其他程序的响应速度">
                                                    <TextBlock Text="?" Foreground="#C9D2FF" FontSize="10" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="优先处理游戏的数据读写请求" Foreground="#8B94C6" FontSize="11" Margin="0,6,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Border Style="{StaticResource RiskTagHigh}">
                                                    <TextBlock Text="高风险" Foreground="White" FontSize="10" FontWeight="Medium"/>
                                                </Border>
                                                <TextBlock Text="FPS +2-5%" Foreground="#EF4444" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border x:Name="TagSfioActive" Style="{StaticResource ActiveTagStyle}" Margin="0,10,0,0" Visibility="Collapsed">
                                                <TextBlock Text="已生效" Foreground="White" FontSize="11" FontWeight="Medium"/>
                                            </Border>
                                        </StackPanel>
                                        <Border Grid.Column="1" x:Name="IndicatorSfio" Style="{StaticResource SelectIndicatorStyle}">
                                            <Ellipse x:Name="DotSfio" Width="12" Height="12" Fill="#4D66FF" Visibility="Collapsed"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                
                                <!-- 全屏优化组标题 -->
                                <TextBlock Text="全屏优化" Foreground="#F59E0B" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                
                                <!-- 禁用全屏优化 -->
                                <Border x:Name="CardFullscreen" Style="{StaticResource OptItemCardStyle}" Margin="0,0,0,10"
                                        MouseLeftButtonUp="OptCard_Click" Tag="fps.disable_fullscreen_optimizations">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="禁用全屏优化" Foreground="White" FontSize="13" FontWeight="Medium"/>
                                                <Border Style="{StaticResource InfoIconStyle}"
                                                        ToolTip="功能说明：关闭 Windows 的全屏优化功能&#x0a;优化原理：避免 DWM 窗口合成带来的额外延迟&#x0a;预期效果：输入延迟降低约 5ms">
                                                    <TextBlock Text="?" Foreground="#C9D2FF" FontSize="10" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="关闭 Windows 的全屏优化功能" Foreground="#8B94C6" FontSize="11" Margin="0,6,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Border Style="{StaticResource RiskTagSafe}">
                                                    <TextBlock Text="安全" Foreground="White" FontSize="10" FontWeight="Medium"/>
                                                </Border>
                                                <TextBlock Text="延迟 -5ms" Foreground="#10B981" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border x:Name="TagFullscreenActive" Style="{StaticResource ActiveTagStyle}" Margin="0,10,0,0" Visibility="Collapsed">
                                                <TextBlock Text="已生效" Foreground="White" FontSize="11" FontWeight="Medium"/>
                                            </Border>
                                        </StackPanel>
                                        <Border Grid.Column="1" x:Name="IndicatorFullscreen" Style="{StaticResource SelectIndicatorStyle}">
                                            <Ellipse x:Name="DotFullscreen" Width="12" Height="12" Fill="#4D66FF" Visibility="Collapsed"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                
                                <!-- 启用系统游戏模式 -->
                                <Border x:Name="CardGameMode" Style="{StaticResource OptItemCardStyle}" Margin="0,0,0,10"
                                        MouseLeftButtonUp="OptCard_Click" Tag="gaming.mode.enable">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">

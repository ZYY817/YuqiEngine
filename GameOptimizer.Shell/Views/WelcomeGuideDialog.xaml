<Window x:Class="GameOptimizer.Shell.Views.WelcomeGuideDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="欢迎使用 宇奇引擎" Width="720" Height="680"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        KeyDown="Window_KeyDown">
    <Border Background="{DynamicResource Theme.Brush.DialogBackground}" 
            BorderBrush="{DynamicResource Theme.Brush.CardBorder}" BorderThickness="1" CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource Theme.Brush.BackgroundSecondary}" 
                    CornerRadius="16,16,0,0" Padding="20,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="16" 
                                   Foreground="{DynamicResource Theme.Brush.AccentBlue}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="TitleLabel" Text="欢迎使用 宇奇引擎" 
                                   Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Click="CloseButton_Click" 
                            Background="Transparent" BorderThickness="0" Cursor="Hand" Width="32" Height="32" VerticalAlignment="Center">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" 
                                   Foreground="{DynamicResource Theme.Brush.TextMuted}"/>
                    </Button>
                </Grid>
            </Border>
            
            <!-- Content -->
            <ScrollViewer x:Name="ContentScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,24,32,24" ScrollChanged="ContentScrollViewer_ScrollChanged">
                <StackPanel>
                    <!-- Step 1: 免费声明 -->
                    <Border Background="{DynamicResource Theme.Brush.CardBackground}" CornerRadius="12" Padding="24" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Step Number -->
                            <Border Grid.Column="0" Width="48" Height="48" Background="#153B82F6" CornerRadius="24" VerticalAlignment="Top" Margin="0,0,16,0">
                                <TextBlock Text="1" FontSize="24" FontWeight="Bold" Foreground="#3B82F6" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            
                            <!-- Content -->
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" FontSize="18" 
                                               Foreground="#22C55E" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="Step1Title" Text="软件免费" 
                                               Foreground="{DynamicResource Theme.Brush.TextPrimary}" 
                                               FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="Step1Content" TextWrapping="Wrap" 
                                           Foreground="{DynamicResource Theme.Brush.TextSecondary}" 
                                           FontSize="13" LineHeight="22" Margin="0,0,0,12">
                                    宇奇引擎是<Run FontWeight="SemiBold" Foreground="#22C55E">免费</Run>软件。<LineBreak/>
                                    如果你在其他地方买到本软件，请直接举报卖家，谨防受骗。
                                </TextBlock>
                                <Border Background="#1522C55E" BorderBrush="#3022C55E" BorderThickness="1" CornerRadius="8" Padding="16" HorizontalAlignment="Stretch">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="ContactLabel" Text="官方联系方式" 
                                                   Foreground="#22C55E" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" TextAlignment="Center"/>
                                        <TextBlock Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="12" LineHeight="20" TextAlignment="Center">
                                            <Run>QQ：</Run><Run x:Name="QQNumber" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Brush.TextPrimary}">571567759</Run><LineBreak/>
                                            <Run>抖音号：</Run><Run x:Name="DouyinNumber" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Brush.TextPrimary}">35071658</Run><LineBreak/>
                                            <Run>哔哩哔哩：</Run><Run x:Name="BilibiliAccount" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Brush.TextPrimary}">智宇、817</Run>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- Step 2: 备份提醒 -->
                    <Border Background="{DynamicResource Theme.Brush.CardBackground}" CornerRadius="12" Padding="24" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" Width="48" Height="48" Background="#15F59E0B" CornerRadius="24" VerticalAlignment="Top" Margin="0,0,16,0">
                                <TextBlock Text="2" FontSize="24" FontWeight="Bold" Foreground="#F59E0B" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="18" 
                                               Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="Step2Title" Text="优化前请备份" 
                                               Foreground="{DynamicResource Theme.Brush.TextPrimary}" 
                                               FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="Step2Content" TextWrapping="Wrap" 
                                           Foreground="{DynamicResource Theme.Brush.TextSecondary}" 
                                           FontSize="13" LineHeight="22" Margin="0,0,0,12">
                                    使用前，请先创建一个 <Run FontWeight="SemiBold" Foreground="#F59E0B">Windows 还原点</Run>。遇到问题时，它能帮助你恢复系统设置。
                                </TextBlock>
                                <Border Background="#15F59E0B" BorderBrush="#30F59E0B" BorderThickness="1" CornerRadius="8" Padding="16" HorizontalAlignment="Stretch">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="BackupMethodLabel" Text="备份方法" 
                                                   Foreground="#F59E0B" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" TextAlignment="Center"/>
                                        <TextBlock x:Name="BackupSteps" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="12" LineHeight="20" TextAlignment="Center">
                                            <Run>1. 在左侧打开「系统还原点」</Run><LineBreak/>
                                            <Run>2. 输入名称后，点击「创建还原点」</Run>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- Step 3: 效果说明 -->
                    <Border Background="{DynamicResource Theme.Brush.CardBackground}" CornerRadius="12" Padding="24" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" Width="48" Height="48" Background="#153B82F6" CornerRadius="24" VerticalAlignment="Top" Margin="0,0,16,0">
                                <TextBlock Text="3" FontSize="24" FontWeight="Bold" Foreground="#3B82F6" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="18" 
                                               Foreground="#3B82F6" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="Step3Title" Text="优化原理与效果" 
                                               Foreground="{DynamicResource Theme.Brush.TextPrimary}" 
                                               FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="Step3Content" TextWrapping="Wrap" 
                                           Foreground="{DynamicResource Theme.Brush.TextSecondary}" 
                                           FontSize="13" LineHeight="22">
                                    软件会根据你选择的项目调整 Windows 设置，减少不必要的后台占用。<LineBreak/><LineBreak/>
                                    <Run FontWeight="SemiBold" Foreground="#3B82F6">请注意：</Run><LineBreak/>
                                    效果会因电脑、驱动和游戏不同而变化。每个项目都可以单独查看说明，也可以恢复。
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- Step 4: 支持作者 -->
                    <Border Background="{DynamicResource Theme.Brush.CardBackground}" CornerRadius="12" Padding="24" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" Width="48" Height="48" Background="#15EC4899" CornerRadius="24" VerticalAlignment="Top" Margin="0,0,16,0">
                                <TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#EC4899" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="18" 
                                               Foreground="#EC4899" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="Step4Title" Text="支持作者" 
                                               Foreground="{DynamicResource Theme.Brush.TextPrimary}" 
                                               FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="Step4Content" TextWrapping="Wrap" 
                                           Foreground="{DynamicResource Theme.Brush.TextSecondary}" 
                                           FontSize="13" LineHeight="20" Margin="0,0,0,16">
                                    如果宇奇引擎对你有帮助，欢迎请作者喝杯咖啡 ☕<LineBreak/>
                                    不收费，只是给作者一点鼓励；也欢迎分享给更多需要的人。
                                </TextBlock>
                                <Border Background="{DynamicResource Theme.Brush.BackgroundSecondary}" 
                                        CornerRadius="12" Padding="16" HorizontalAlignment="Center">
                                    <StackPanel>
                                        <Image Source="/Assets/donate_qrcode.jpg" Width="280" Height="280" Stretch="Uniform"/>
                                        <TextBlock x:Name="QRCodeLabel" Text="微信扫码赞赏" 
                                                   Foreground="{DynamicResource Theme.Brush.TextMuted}" 
                                                   FontSize="12" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            
            <!-- Footer -->
            <Border Grid.Row="2" Background="{DynamicResource Theme.Brush.BackgroundSecondary}" 
                    BorderBrush="{DynamicResource Theme.Brush.CardBorder}" BorderThickness="0,1,0,0" 
                    CornerRadius="0,0,16,16" Padding="32,16">
                <Grid>
                    <CheckBox x:Name="DontShowAgainCheckBox" VerticalAlignment="Center" Cursor="Hand" 
                              Padding="8,0,0,0" Margin="4,0,0,0">
                        <CheckBox.Resources>
                            <Style TargetType="CheckBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="CheckBox">
                                            <StackPanel Orientation="Horizontal">
                                                <Border x:Name="CheckBoxBorder" Width="18" Height="18" 
                                                        Background="{DynamicResource Theme.Brush.BackgroundSecondary}"
                                                        BorderBrush="{DynamicResource Theme.Brush.CardBorder}" 
                                                        BorderThickness="1.5" CornerRadius="4" Margin="0,0,8,0">
                                                    <TextBlock x:Name="CheckMark" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" 
                                                               FontSize="12" Foreground="{DynamicResource Theme.Brush.AccentBlue}" 
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                                </Border>
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.AccentBlue}"/>
                                                    <Setter TargetName="CheckBoxBorder" Property="Background" Value="#153B82F6"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.AccentBlue}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </CheckBox.Resources>
                        <TextBlock x:Name="DontShowAgainLabel" Text="不再显示此提示" 
                                   Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="13"/>
                    </CheckBox>
                    <Border x:Name="StartButtonBorder" HorizontalAlignment="Right" Background="{DynamicResource Theme.Brush.AccentBlue}" 
                            CornerRadius="10" Cursor="Hand" Opacity="0.5" Padding="40,14">
                        <Button x:Name="StartButton" Click="StartButton_Click" IsEnabled="False"
                                Background="Transparent" BorderThickness="0" Padding="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="StartButtonText" Text="开始使用" 
                                           Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="14" 
                                           Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

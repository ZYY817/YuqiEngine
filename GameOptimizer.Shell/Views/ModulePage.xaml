<UserControl x:Class="GameOptimizer.Shell.Views.ModulePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <!-- 空状态提示 - 当模块未加载时显示 -->
        <Border Visibility="{Binding HasModuleSelected, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="📦" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="模块加载中..." FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                <TextBlock Text="请稍候，正在加载优化模块数据" Foreground="#6B6B70" FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- 模块内容 - 当模块已加载时显示 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24"
                      Visibility="{Binding HasModuleSelected, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <Grid Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedOptimizationModule.Title}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="{Binding SelectedOptimizationModule.Description}" Foreground="#6B6B70" FontSize="13" Margin="0,8,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="全部应用" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ApplyModuleCommand}" Padding="16,10"/>
                        <Button Content="全部恢复" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RestoreModuleCommand}" Margin="12,0,0,0" Padding="16,10"/>
                    </StackPanel>
                </Grid>
                
                <Border Background="#1E1E20" CornerRadius="12" BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="20">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="优化项" FontSize="16" FontWeight="Medium" Foreground="#FFFFFF"/>
                            <TextBlock HorizontalAlignment="Right" Foreground="#6B6B70" FontSize="13">
                                <Run Text="{Binding SelectedModuleAppliedCount, Mode=OneWay}"/>
                                <Run Text="/"/>
                                <Run Text="{Binding SelectedOptimizationModule.Toggles.Count, Mode=OneWay}"/>
                                <Run Text="项已应用"/>
                            </TextBlock>
                        </Grid>
                        
                        <!-- 空优化项提示 -->
                        <TextBlock Text="该模块暂无优化项" Foreground="#48484A" FontSize="13" 
                                   HorizontalAlignment="Center" Margin="0,20,0,20"
                                   Visibility="{Binding SelectedOptimizationModule.Toggles.Count, Converter={StaticResource ZeroToVisibleConverter}}"/>
                        
                        <ItemsControl ItemsSource="{Binding SelectedOptimizationModule.Toggles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#28282A" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" Foreground="#FFFFFF" FontSize="13" FontWeight="Medium"/>
                                                <Border Background="#1A34C759" CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                                        Visibility="{Binding IsApplied, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="已应用" Foreground="#34C759" FontSize="10"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Foreground="#6B6B70" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Width="51" Height="31">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="Bg" Background="#39393D" CornerRadius="15.5" Cursor="Hand">
                                                        <Border x:Name="Thumb" Width="27" Height="27" CornerRadius="13.5" Background="White" 
                                                                HorizontalAlignment="Left" Margin="2,0,0,0"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Bg" Property="Background" Value="#34C759"/>
                                                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</UserControl>

<!-- File: GameOptimizer.Shell/Views/GamePriorityManagerPage.xaml -->
<UserControl x:Class="GameOptimizer.Shell.Views.GamePriorityManagerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="900"
             Background="{DynamicResource Theme.Brush.AppBackground}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <!-- Glass Card Style -->
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.CardBackground}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.GlassBorder}"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.12" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="20,0"
                                Background="{DynamicResource Theme.Brush.HeroButtonBackground}"
                                BorderThickness="1" BorderBrush="#30FFFFFF">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Brush.HeroButtonBackgroundHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#50FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <!-- Ambient Glow -->
        <Ellipse Width="600" Height="600" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-200,-200,0" Opacity="0.08" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#6366F1" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Page Header -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock x:Name="PageTitle" Foreground="{DynamicResource Theme.Brush.TextPrimaryAlt}" FontSize="26" FontWeight="Bold" FontFamily="Microsoft YaHei UI"/>
                        <TextBlock x:Name="PageSubtitle" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="13" Margin="0,8,0,0"/>
                    </StackPanel>
                    <Button x:Name="AddGameBtn" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="AddGameButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="AddGameBtnText" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Stats Card -->
                <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="20" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="TotalGamesLabel" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="12"/>
                            <TextBlock x:Name="TotalGamesCount" Text="0" FontFamily="JetBrains Mono, Consolas" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource Theme.Brush.TextPrimary}" Margin="0,4,0,0"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="EnabledGamesLabel" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="12"/>
                            <TextBlock x:Name="EnabledGamesCount" Text="0" FontFamily="JetBrains Mono, Consolas" FontSize="28" FontWeight="Bold" Foreground="#4ADE80" Margin="0,4,0,0"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="LastUsedLabel" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="12"/>
                            <TextBlock x:Name="LastUsedText" FontSize="13" Foreground="{DynamicResource Theme.Brush.TextSecondary}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Games List -->
                <StackPanel Grid.Row="2">
                    <!-- Empty State -->
                    <Border x:Name="EmptyState" Visibility="Collapsed" Margin="0,40,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="120" Height="120" CornerRadius="60" Margin="0,0,0,24">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#1A6366F1" Offset="0"/>
                                        <GradientStop Color="#0A6366F1" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="⚡" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Brush.TextPrimary}"/>
                            </Border>
                            <TextBlock x:Name="EmptyTitle" Foreground="{DynamicResource Theme.Brush.TextPrimaryAlt}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="EmptySubtitle" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Games List Container -->
                    <ItemsControl x:Name="GamesListContainer">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GlassCard}" Padding="20" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Icon -->
                                        <Border Width="48" Height="48" CornerRadius="10" VerticalAlignment="Center">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#206366F1" Offset="0"/>
                                                    <GradientStop Color="#108B5CF6" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="🎮" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Brush.TextPrimary}"/>
                                        </Border>
                                        
                                        <!-- Info -->
                                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding GameName}" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="15" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding ExecutablePath}" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Border CornerRadius="4" Padding="8,3" Background="#156366F1" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding PriorityDisplay}" Foreground="#6366F1" FontSize="10" FontWeight="Medium"/>
                                                </Border>
                                                <Border x:Name="EnabledBadge" CornerRadius="4" Padding="8,3" Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVis}}">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="#4ADE80" Opacity="0.15"/>
                                                    </Border.Background>
                                                    <TextBlock x:Name="EnabledBadgeText" Foreground="#4ADE80" FontSize="10" FontWeight="Medium"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                        
                                        <!-- Actions -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                                            <Button x:Name="EditButton" Click="EditGameButton_Click" Tag="{Binding Id}"
                                                    Background="Transparent" BorderBrush="{DynamicResource Theme.Brush.BorderLight}" BorderThickness="1"
                                                    Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="11" Padding="12,6" Cursor="Hand" Margin="0,0,8,0"/>
                                            <Button x:Name="DeleteButton" Click="DeleteGameButton_Click" Tag="{Binding Id}"
                                                    Background="Transparent" BorderBrush="#7F1D1D" BorderThickness="1"
                                                    Foreground="#F87171" FontSize="11" Padding="12,6" Cursor="Hand"/>
                                        </StackPanel>
                                        
                                        <!-- Enable Toggle -->
                                        <CheckBox Grid.Column="3" IsChecked="{Binding IsEnabled}" Checked="EnableToggle_Changed" Unchecked="EnableToggle_Changed" Tag="{Binding Id}"
                                                  VerticalAlignment="Center" Margin="16,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>

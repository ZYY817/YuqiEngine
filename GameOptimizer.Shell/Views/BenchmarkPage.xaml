<UserControl x:Class="GameOptimizer.Shell.Views.BenchmarkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#0D1424"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style x:Key="TestBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#4D66FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#2A3555"/>
                                <Setter Property="Foreground" Value="#6B7280"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5D76FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,24">
            <!-- 页面标题 -->
            <StackPanel Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <Border Width="36" Height="36" CornerRadius="8" Background="#10B981">
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="18" 
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="性能基准测试" FontSize="26" FontWeight="Bold" 
                               Foreground="White" Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="测试系统各项性能指标，了解优化前后的提升效果" 
                           FontSize="14" Foreground="#8B94C6" Margin="50,8,0,0"/>
            </StackPanel>

            <!-- 快速测试按钮 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="一键综合测试" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="运行CPU、内存、磁盘全套测试，约需30秒" Foreground="#8B94C6" FontSize="13" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="RunAllBtn" Content="开始测试" Click="RunAllTests_Click" Style="{StaticResource TestBtnStyle}"/>
                </Grid>
            </Border>

            <!-- 测试进度 -->
            <Border x:Name="ProgressPanel" Style="{StaticResource CardStyle}" Margin="0,0,0,20" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="ProgressText" Text="正在测试..." Foreground="White" FontSize="14" FontWeight="Medium"/>
                    <ProgressBar x:Name="TestProgress" Height="8" Margin="0,12,0,0" Background="#1A2340" Foreground="#4D66FF" Maximum="100"/>
                </StackPanel>
            </Border>

            <!-- 三列测试卡片 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CPU测试 -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="40" Height="40" CornerRadius="10" Background="#F59E0B">
                                <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="18" 
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="CPU 性能" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="计算能力测试" Foreground="#8B94C6" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <Border Background="#141E30" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="单核性能" Foreground="#8B94C6" FontSize="12"/>
                                <TextBlock x:Name="CpuSingleScore" Text="--" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="分" Foreground="#6B7280" FontSize="12"/>
                                    <TextBlock x:Name="CpuSingleRef" Text="" Foreground="#10B981" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                        <Border Background="#141E30" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="多核性能" Foreground="#8B94C6" FontSize="12"/>
                                <TextBlock x:Name="CpuMultiScore" Text="--" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="分" Foreground="#6B7280" FontSize="12"/>
                                    <TextBlock x:Name="CpuMultiRef" Text="" Foreground="#10B981" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                        <Button x:Name="CpuTestBtn" Content="单独测试" Click="CpuTest_Click" Style="{StaticResource TestBtnStyle}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>

                <!-- 内存测试 -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="4,0,4,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="40" Height="40" CornerRadius="10" Background="#8B5CF6">
                                <TextBlock Text="&#xE964;" FontFamily="Segoe MDL2 Assets" FontSize="18" 
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="内存性能" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="读写速度测试" Foreground="#8B94C6" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <Border Background="#141E30" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="读取速度" Foreground="#8B94C6" FontSize="12"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock x:Name="MemReadSpeed" Text="--" Foreground="White" FontSize="28" FontWeight="Bold"/>
                                    <TextBlock Text=" GB/s" Foreground="#6B7280" FontSize="14" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                </StackPanel>
                                <TextBlock x:Name="MemReadRef" Text="" Foreground="#10B981" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        
                        <Border Background="#141E30" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="写入速度" Foreground="#8B94C6" FontSize="12"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock x:Name="MemWriteSpeed" Text="--" Foreground="White" FontSize="28" FontWeight="Bold"/>
                                    <TextBlock Text=" GB/s" Foreground="#6B7280" FontSize="14" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                </StackPanel>
                                <TextBlock x:Name="MemWriteRef" Text="" Foreground="#10B981" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        
                        <Button x:Name="MemTestBtn" Content="单独测试" Click="MemTest_Click" Style="{StaticResource TestBtnStyle}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>

                <!-- 磁盘测试 -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="40" Height="40" CornerRadius="10" Background="#EC4899">
                                <TextBlock Text="&#xEDA2;" FontFamily="Segoe MDL2 Assets" FontSize="18" 
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="磁盘性能" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="I/O速度测试" Foreground="#8B94C6" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <Border Background="#141E30" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="顺序读取" Foreground="#8B94C6" FontSize="12"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock x:Name="DiskReadSpeed" Text="--" Foreground="White" FontSize="28" FontWeight="Bold"/>
                                    <TextBlock Text=" MB/s" Foreground="#6B7280" FontSize="14" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                </StackPanel>
                                <TextBlock x:Name="DiskReadRef" Text="" Foreground="#10B981" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        
                        <Border Background="#141E30" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="顺序写入" Foreground="#8B94C6" FontSize="12"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock x:Name="DiskWriteSpeed" Text="--" Foreground="White" FontSize="28" FontWeight="Bold"/>
                                    <TextBlock Text=" MB/s" Foreground="#6B7280" FontSize="14" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                </StackPanel>
                                <TextBlock x:Name="DiskWriteRef" Text="" Foreground="#10B981" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        
                        <Button x:Name="DiskTestBtn" Content="单独测试" Click="DiskTest_Click" Style="{StaticResource TestBtnStyle}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 测试历史 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="测试历史" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                        <Button x:Name="ClearHistoryBtn" Content="清空记录" Click="ClearHistory_Click" HorizontalAlignment="Right"
                                Background="Transparent" Foreground="#8B94C6" Padding="8,4" BorderThickness="0" Cursor="Hand"/>
                    </Grid>
                    <ItemsControl x:Name="HistoryList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#141E30" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TestTime}" Foreground="#8B94C6" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,20,0">
                                            <TextBlock Text="CPU: " Foreground="#8B94C6" FontSize="12"/>
                                            <TextBlock Text="{Binding CpuScore}" Foreground="#F59E0B" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,20,0">
                                            <TextBlock Text="内存: " Foreground="#8B94C6" FontSize="12"/>
                                            <TextBlock Text="{Binding MemSpeed}" Foreground="#8B5CF6" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                                            <TextBlock Text="磁盘: " Foreground="#8B94C6" FontSize="12"/>
                                            <TextBlock Text="{Binding DiskSpeed}" Foreground="#EC4899" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoHistoryText" Text="暂无测试记录" Foreground="#6B7280" FontSize="13" HorizontalAlignment="Center" Margin="0,20,0,20"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

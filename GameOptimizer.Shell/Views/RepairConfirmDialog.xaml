<Window x:Class="GameOptimizer.Shell.Views.RepairConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修复确认" Width="440" Height="Auto" MinHeight="220" MaxHeight="400"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        SizeToContent="Height" ShowInTaskbar="False">
    <Border Background="{DynamicResource Theme.Brush.BackgroundSecondary}" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource Theme.Brush.BorderSubtle}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="0" Opacity="0.5" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="{DynamicResource Theme.Brush.SurfaceMuted}" CornerRadius="12,12,0,0" Padding="20,14" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="IconText" Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource Theme.Brush.TextPrimary}" Margin="0,0,10,0"/>
                        <TextBlock x:Name="DialogTitleText" Text="修复确认" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="15" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" Click="Cancel_Click"
                            Background="Transparent" Foreground="{DynamicResource Theme.Brush.TextMuted}" BorderThickness="0"
                            Width="28" Height="28" Cursor="Hand" FontSize="14">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Brush.CardBorder}"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
            
            <!-- 内容区域 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
                <StackPanel>
                    <!-- 修复项信息 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="48" Height="48" CornerRadius="10" Background="{DynamicResource Theme.Brush.CardBackgroundHover}" Margin="0,0,14,0">
                            <TextBlock x:Name="ItemIcon" Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ItemName" Text="修复项名称" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ItemDesc" Text="修复项描述" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="300"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- 状态提示 -->
                    <Border x:Name="StatusBorder" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="StatusIcon" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#22C55E"/>
                            <TextBlock x:Name="StatusText" Text="状态信息" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 检测依据和实际变更内容，确认前必须可见。 -->
                    <Border Background="{DynamicResource Theme.Brush.CardBackgroundAlt}" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="检测依据" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DetectionText" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,10"/>
                            <TextBlock Text="将要修改" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ChangePlanText" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,10"/>
                            <TextBlock x:Name="RecoveryText" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- 风险提示 -->
                    <Border x:Name="RiskBorder" Background="#20EF4444" CornerRadius="8" Padding="14,12" Margin="0,0,0,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="RiskText" Text="此操作可能需要重启系统才能生效" Foreground="#F87171" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            
            <!-- 底部按钮 -->
            <Border Grid.Row="2" Background="{DynamicResource Theme.Brush.SurfaceMuted}" CornerRadius="0,0,12,12" Padding="20,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelBtn" Click="Cancel_Click" Cursor="Hand" Margin="0,0,10,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource Theme.Brush.BorderLight}" BorderThickness="1" CornerRadius="8" Padding="20,10">
                                    <TextBlock x:Name="CancelBtnText" Text="取消" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="13"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Brush.CardBackgroundHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="ConfirmBtn" Click="Confirm_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="8" Padding="20,10">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#22D3EE" Offset="0"/>
                                            <GradientStop Color="#06B6D4" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock x:Name="ConfirmBtnText" Text="确认修复" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="13" FontWeight="Medium"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

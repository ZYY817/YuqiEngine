<!-- File: GameOptimizer.Shell/Views/ScenarioConfirmationDialog.xaml -->
<Window x:Class="GameOptimizer.Shell.Views.ScenarioConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:GameOptimizer.Shell.Localization"
        Title="场景预设确认" Width="700" Height="600"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" KeyDown="Window_KeyDown">
    <Border Background="{DynamicResource Theme.Brush.BackgroundSecondary}" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource Theme.Brush.BorderSubtle}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="0" Opacity="0.5" Color="{DynamicResource Theme.Color.Shadow}"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="{DynamicResource Theme.Brush.SurfaceMuted}" CornerRadius="12,12,0,0" Padding="20,14" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource Theme.Brush.TextPrimaryAlt}" Margin="0,0,10,0"/>
                        <TextBlock x:Name="TitleText" Text="应用场景预设" Foreground="{DynamicResource Theme.Brush.TextPrimaryAlt}" FontSize="15" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" Click="Cancel_Click"
                            Background="Transparent" Foreground="{DynamicResource Theme.Brush.TextMuted}" BorderThickness="0"
                            Width="28" Height="28" Cursor="Hand" FontSize="14">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Brush.CardBorder}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
            
            <!-- 内容区域 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
                <StackPanel>
                    <!-- 场景信息 -->
                    <Border Background="{DynamicResource Theme.Brush.CardBackgroundAlt}" CornerRadius="8" Padding="16,14" Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock x:Name="ScenarioNameText" Text="游戏模式" Foreground="{DynamicResource Theme.Brush.TextPrimaryAlt}" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ScenarioDescText" Grid.Row="1" Text="针对游戏场景优化的电源计划" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            
                            <!-- 电源计划名称 -->
                            <Grid Grid.Row="2" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Text="当前计划：" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CurrentPlanText" Grid.Column="1" Text="平衡" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                
                                <TextBlock Grid.Row="1" Text="新建计划：" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="12" Margin="0,4,0,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NewPlanText" Grid.Row="1" Grid.Column="1" Text="宇奇引擎 - 游戏模式" Foreground="#6366F1" FontSize="12" FontWeight="Medium" Margin="6,4,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>
                    
                    <!-- 冲突警告 -->
                    <Border x:Name="ConflictWarning" Visibility="Collapsed" Background="#FEF3C7" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#F59E0B" VerticalAlignment="Top" Margin="0,2,0,0"/>
                            <TextBlock x:Name="ConflictMessageText" Grid.Column="1" Text="已存在同名电源计划，将被覆盖" Foreground="#92400E" FontSize="13" TextWrapping="Wrap" Margin="10,0,0,0"/>
                        </Grid>
                    </Border>
                    
                    <!-- 参数对比表标题 -->
                    <TextBlock Text="参数对比" Foreground="{DynamicResource Theme.Brush.TextPrimaryAlt}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    
                    <!-- 参数对比表 -->
                    <DataGrid x:Name="ComparisonGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="Transparent" BorderThickness="0" GridLinesVisibility="None"
                              HeadersVisibility="Column" CanUserResizeRows="False" CanUserSortColumns="False"
                              SelectionMode="Single" SelectionUnit="FullRow">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceMuted}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextMuted}"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                                <Setter Property="Padding" Value="12,10"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Theme.Brush.CardBackgroundHover}"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Theme.Brush.CardBackgroundAlt}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="参数名称" Binding="{Binding DisplayName}" Width="2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextPrimaryAlt}"/>
                                        <Setter Property="FontSize" Value="13"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="当前值" Binding="{Binding CurrentDisplayValue}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextSecondary}"/>
                                        <Setter Property="FontSize" Value="13"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="变化" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="14" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="—"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextMuted}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Direction}" Value="Increase">
                                                            <Setter Property="Text" Value="↑"/>
                                                            <Setter Property="Foreground" Value="#10B981"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Direction}" Value="Decrease">
                                                            <Setter Property="Text" Value="↓"/>
                                                            <Setter Property="Foreground" Value="#F59E0B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="新值" Binding="{Binding NewDisplayValue}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextSecondary}"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                                <Setter Property="Foreground" Value="#6366F1"/>
                                                <Setter Property="FontWeight" Value="Medium"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ScrollViewer>
            
            <!-- 底部按钮 -->
            <Border Grid.Row="2" Background="{DynamicResource Theme.Brush.SurfaceMuted}" CornerRadius="0,0,12,12" Padding="20,14">
                <Grid>
                    <!-- 进度指示器 -->
                    <StackPanel x:Name="ProgressPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <Border Width="20" Height="20" Margin="0,0,10,0">
                            <Border.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate" CenterX="10" CenterY="10"/>
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="SpinnerRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <Path Data="M10,2 A8,8 0 0,1 18,10" Stroke="#6366F1" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Border>
                        <TextBlock x:Name="ProgressText" Text="正在应用场景..." Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- 按钮组 -->
                    <StackPanel x:Name="ButtonPanel" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelBtn" Content="取消" Click="Cancel_Click" Cursor="Hand" Margin="0,0,10,0"
                                Background="Transparent" BorderBrush="{DynamicResource Theme.Brush.CardBorder}" BorderThickness="1"
                                Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="13" Padding="20,10"
                                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="ConfirmBtn" Content="应用场景" Click="Confirm_Click" Cursor="Hand"
                                Foreground="#FFFFFF" FontSize="13" FontWeight="Medium" Padding="20,10" BorderThickness="0"
                                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#6366F1" Offset="0"/>
                                    <GradientStop Color="#8B5CF6" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

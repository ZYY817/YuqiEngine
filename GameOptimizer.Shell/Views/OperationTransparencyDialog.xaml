<Window x:Class="GameOptimizer.Shell.Views.OperationTransparencyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="功能说明"
        Width="1020"
        Height="820"
        MinWidth="920"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Border Background="{DynamicResource Theme.Brush.DialogBackground}"
            BorderBrush="{DynamicResource Theme.Brush.CardBorder}"
            BorderThickness="1"
            CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="66"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource Theme.Brush.BackgroundSecondary}"
                    CornerRadius="16,16,0,0"
                    Padding="18,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   Foreground="{DynamicResource Theme.Brush.AccentBlue}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="WindowTitleText"
                                   Margin="10,0,0,0"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                                   Text="功能说明"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            Width="32"
                            Height="32"
                            Click="CloseButton_Click"
                            BorderThickness="0"
                            Background="Transparent"
                            Cursor="Hand">
                        <TextBlock Text="&#xE711;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   Foreground="{DynamicResource Theme.Brush.TextMuted}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="22,16,22,10">
                <StackPanel>
                    <Border Background="{DynamicResource Theme.Brush.CardBackground}" CornerRadius="12" Padding="16,14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="OperationTitleText"
                                           Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="OperationDescText"
                                           Margin="0,8,0,0"
                                           Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                                           FontSize="12.5"
                                           TextWrapping="Wrap"
                                           LineHeight="22"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Top">
                                <Border CornerRadius="7" Padding="10,4" Background="#1440A7F5" BorderBrush="#3040A7F5" BorderThickness="1">
                                    <TextBlock x:Name="TypeBadgeText" Foreground="#74B8FF" FontSize="11.5" FontWeight="SemiBold" Text="类型"/>
                                </Border>
                                <Border Margin="0,8,0,0" CornerRadius="7" Padding="10,4" Background="#1522C55E" BorderBrush="#3022C55E" BorderThickness="1">
                                    <TextBlock x:Name="RiskBadgeText" Foreground="#4ADE80" FontSize="11.5" FontWeight="SemiBold" Text="风险"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="这个功能会做什么"
                               Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <Border Background="{DynamicResource Theme.Brush.CardBackgroundAlt}" CornerRadius="10" Padding="12" BorderBrush="{DynamicResource Theme.Brush.Border}" BorderThickness="1" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="0"/>
                                <RowDefinition Height="0"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="作用" Foreground="{DynamicResource Theme.Brush.TextMuted}" Margin="0,0,10,6"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="FunctionPurposeText" TextWrapping="Wrap" Foreground="{DynamicResource Theme.Brush.TextPrimary}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="修改对象" Visibility="Collapsed"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ModifyObjectText" Visibility="Collapsed"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="修改位置" Visibility="Collapsed"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ModifyLocationText" Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="当前设置与建议"
                               Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource Theme.Brush.SurfaceMuted}" CornerRadius="10" Padding="12" BorderBrush="{DynamicResource Theme.Brush.Border}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Windows 默认值" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="11"/>
                                <TextBlock x:Name="WindowsDefaultText" Margin="0,6,0,0" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="13" FontFamily="Consolas" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource Theme.Brush.SurfaceMuted}" CornerRadius="10" Padding="12" BorderBrush="{DynamicResource Theme.Brush.Border}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="建议值" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="11"/>
                                <TextBlock x:Name="RecommendedValueText" Margin="0,6,0,0" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="13" FontFamily="Consolas" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Margin="0,10,0,0" Background="{DynamicResource Theme.Brush.SurfaceMuted}" CornerRadius="10" Padding="12" BorderBrush="{DynamicResource Theme.Brush.Border}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="改前值" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="11"/>
                                <TextBlock x:Name="BeforeValueText" Margin="0,6,0,0" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="13" FontFamily="Consolas" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="2" Margin="0,10,0,0" Background="{DynamicResource Theme.Brush.SurfaceMuted}" CornerRadius="10" Padding="12" BorderBrush="{DynamicResource Theme.Brush.Border}" BorderThickness="1">
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="当前值（实时读取）" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="11" DockPanel.Dock="Left"/>
                                    <Button Content="读取当前值"
                                            DockPanel.Dock="Right"
                                            FontSize="11"
                                            Padding="8,2"
                                            Margin="10,0,0,0"
                                            Click="RefreshCurrentButton_Click"/>
                                </DockPanel>
                                <TextBlock x:Name="CurrentValueText" Margin="0,6,0,0" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="13" FontFamily="Consolas" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="软件会怎么做"
                               Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,2,0,8"/>
                    <Border Background="{DynamicResource Theme.Brush.CardBackgroundAlt}" CornerRadius="10" Padding="12" BorderBrush="{DynamicResource Theme.Brush.Border}" BorderThickness="1" Margin="0,0,0,10">
                        <TextBlock x:Name="ApplyActionText" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="12.5" TextWrapping="Wrap" LineHeight="20"/>
                    </Border>
                    <Expander Header="技术详情（可选）" IsExpanded="False" Margin="0,0,0,12">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="执行方式 / 可核验命令" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="11.5" VerticalAlignment="Top" Margin="0,3,8,0"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="ApplyCommandText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="56" Padding="8" FontFamily="Consolas" FontSize="12" Margin="0,0,8,8"/>
                        <Button Grid.Row="0" Grid.Column="2" Content="复制" Padding="10,6" Margin="0,0,0,8" Click="CopyApplyButton_Click"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="校验命令" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="11.5" VerticalAlignment="Top" Margin="0,3,8,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="VerifyCommandText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="56" Padding="8" FontFamily="Consolas" FontSize="12" Margin="0,0,8,8"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="复制" Padding="10,6" Margin="0,0,0,8" Click="CopyVerifyButton_Click"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="回滚命令" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="11.5" VerticalAlignment="Top" Margin="0,3,8,0"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="RollbackCommandText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="56" Padding="8" FontFamily="Consolas" FontSize="12" Margin="0,0,8,0"/>
                        <Button x:Name="CopyRollbackButton" Grid.Row="2" Grid.Column="2" Content="复制" Padding="10,6" Click="CopyRollbackButton_Click"/>
                    </Grid>
                    </Expander>

                    <TextBlock Text="使用前请知道"
                               Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,2,0,8"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource Theme.Brush.CardBackgroundAlt}" CornerRadius="10" Padding="12" BorderBrush="{DynamicResource Theme.Brush.Border}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="什么时候生效" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="11"/>
                                <TextBlock x:Name="EffectiveConditionText" Margin="0,6,0,0" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="12.5" TextWrapping="Wrap" LineHeight="20"/>
                                <TextBlock Text="可能带来的变化" Margin="0,10,0,0" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="11"/>
                                <TextBlock x:Name="BenefitText" Margin="0,6,0,0" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="12.5" TextWrapping="Wrap" LineHeight="20"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{DynamicResource Theme.Brush.CardBackgroundAlt}" CornerRadius="10" Padding="12" BorderBrush="{DynamicResource Theme.Brush.Border}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="可能的不适合情况" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="11"/>
                                <TextBlock x:Name="SideEffectText" Margin="0,6,0,0" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="12.5" TextWrapping="Wrap" LineHeight="20"/>
                                <TextBlock Text="需要注意" Margin="0,10,0,0" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="11"/>
                                <TextBlock x:Name="RiskReasonText" Margin="0,6,0,0" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="12.5" TextWrapping="Wrap" LineHeight="20"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="需要恢复时"
                               Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,2,0,8"/>
                    <Border Background="{DynamicResource Theme.Brush.CardBackgroundAlt}" CornerRadius="10" Padding="12" BorderBrush="{DynamicResource Theme.Brush.Border}" BorderThickness="1" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="软件内恢复" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="11"/>
                            <TextBlock x:Name="OneClickRollbackText" Margin="0,6,0,0" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="12.5" TextWrapping="Wrap" LineHeight="20"/>
                            <Button x:Name="OneClickRollbackButton"
                                    Content="立即回滚此项"
                                    Margin="0,8,0,0"
                                    Padding="12,6"
                                    HorizontalAlignment="Left"
                                    Click="OneClickRollbackButton_Click"/>
                            <Expander Header="手动恢复方法（可选）" IsExpanded="False" Margin="0,10,0,0">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock x:Name="ManualRollbackText" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="12.5" TextWrapping="Wrap" LineHeight="20" FontFamily="Consolas"/>
                                    <TextBlock Text="恢复遇到问题" Margin="0,10,0,0" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="11"/>
                                    <TextBlock x:Name="RollbackTroubleshootText" Margin="0,6,0,0" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="12.5" TextWrapping="Wrap" LineHeight="20"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="系统入口（可选）"
                               Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,2,0,8"/>
                    <Border Background="{DynamicResource Theme.Brush.CardBackgroundAlt}" CornerRadius="10" Padding="12" BorderBrush="{DynamicResource Theme.Brush.Border}" BorderThickness="1" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="RegistryPathText" Foreground="#4ADE80" FontSize="12.5" FontFamily="Consolas" TextWrapping="Wrap"/>
                            <TextBlock x:Name="ManualEntryText" Margin="0,6,0,0" Foreground="#60A5FA" FontSize="12.5" FontFamily="Consolas" TextWrapping="Wrap"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="OpenEntryButton" Grid.Column="0" Content="打开入口" MinHeight="30" Padding="10,5" Click="OpenEntryButton_Click"/>
                            <Button x:Name="OpenRegistryButton" Grid.Column="2" Content="打开注册表" MinHeight="30" Padding="10,5" Click="OpenRegistryButton_Click"/>
                            <Button x:Name="CopyPathButton" Grid.Column="4" Content="复制路径" MinHeight="30" Padding="10,5" Click="CopyPathButton_Click"/>
                        </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="上次操作记录"
                               Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,2,0,8"/>
                    <Border Background="{DynamicResource Theme.Brush.CardBackgroundAlt}" CornerRadius="10" Padding="12" BorderBrush="{DynamicResource Theme.Brush.Border}" BorderThickness="1" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="状态" Foreground="{DynamicResource Theme.Brush.TextMuted}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="EvidenceStatusText" Foreground="{DynamicResource Theme.Brush.TextPrimary}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,6,0,0" Text="信息" Foreground="{DynamicResource Theme.Brush.TextMuted}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" x:Name="EvidenceMessageText" Foreground="{DynamicResource Theme.Brush.TextPrimary}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,6,0,0" Text="错误" Foreground="{DynamicResource Theme.Brush.TextMuted}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" x:Name="EvidenceErrorText" Foreground="{DynamicResource Theme.Brush.TextPrimary}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,6,0,0" Text="来源" Foreground="{DynamicResource Theme.Brush.TextMuted}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,6,0,0" x:Name="EvidenceSourceText" Foreground="{DynamicResource Theme.Brush.TextPrimary}" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <Expander Header="更多技术信息（可选）"
                              IsExpanded="False">
                        <Border Background="{DynamicResource Theme.Brush.SurfaceMuted}" CornerRadius="10" Padding="12" BorderBrush="{DynamicResource Theme.Brush.Border}" BorderThickness="1" Margin="0,8,0,0">
                            <ItemsControl x:Name="AdvancedItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="230"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="11.5" Margin="0,1,10,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="12" TextWrapping="Wrap"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="{DynamicResource Theme.Brush.BackgroundSecondary}"
                    BorderBrush="{DynamicResource Theme.Brush.CardBorder}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,16,16"
                    Padding="18,0">
                <Grid>
                    <TextBlock x:Name="FooterHintText"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Theme.Brush.TextMuted}"
                               FontSize="11.5">建议先创建备份；需要恢复时，优先使用本软件的“恢复”按钮。</TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="复制全部"
                                Margin="0,0,8,0"
                                Padding="12,6"
                                Click="CopyAllButton_Click"/>
                        <Button Content="关闭"
                                Padding="14,6"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>


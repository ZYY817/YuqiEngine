<Window x:Class="GameOptimizer.Shell.Views.CpuRulesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CPU 优化规则" Width="600" Height="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource Theme.Brush.RowBackground}" BorderBrush="{DynamicResource Theme.Brush.CardBorder}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Border Grid.Row="0" Background="{DynamicResource Theme.Brush.BackgroundSecondary}" CornerRadius="12,12,0,0" Padding="16,12"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙️" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock x:Name="DialogTitleText" Text="CPU 优化规则" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" Click="Close_Click"
                            Background="Transparent" BorderThickness="0" Foreground="#6B6B70" 
                            FontSize="14" Cursor="Hand" Width="24" Height="24"/>
                </Grid>
            </Border>
            
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                <StackPanel>
                    <TextBlock x:Name="DescText" Text="智能优化会根据您的 CPU 型号自动匹配最优参数" Foreground="#6B6B70" FontSize="12" Margin="0,0,0,16"/>
                    
                    <ItemsControl x:Name="RulesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Theme.Brush.RowBackground}" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="13" FontWeight="Medium"/>
                                            <TextBlock Text="{Binding Description}" Foreground="#6B6B70" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                <TextBlock x:Name="LblMinState" Text="最小状态: " Foreground="#6B6B70" FontSize="10"/>
                                                <TextBlock Text="{Binding MinState}" Foreground="#2E88F2" FontSize="10"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                <TextBlock x:Name="LblCoreParking" Text="核心停靠: " Foreground="#6B6B70" FontSize="10"/>
                                                <TextBlock Text="{Binding CoreParking}" Foreground="#34C759" FontSize="10"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="LblSafeTemp" Text="安全温度: " Foreground="#6B6B70" FontSize="10"/>
                                                <TextBlock Text="{Binding SafeTemp}" Foreground="#FF9500" FontSize="10"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            
            <Border Grid.Row="2" Background="{DynamicResource Theme.Brush.BackgroundSecondary}" CornerRadius="0,0,12,12" Padding="20,16">
                <Button x:Name="CloseBtn" Content="关闭" Click="Close_Click" HorizontalAlignment="Right"
                        Background="#2E88F2" BorderThickness="0"
                        Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="13" Padding="24,10" Cursor="Hand"/>
            </Border>
        </Grid>
    </Border>
</Window>

<UserControl x:Class="GameOptimizer.Shell.Views.SystemCleanupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:constants="clr-namespace:GameOptimizer.Shell.Constants"
             xmlns:controls="clr-namespace:GameOptimizer.Shell.Controls"
             Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <!-- Compact, high-contrast selection control. -->
        <Style x:Key="CyberCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" Width="22" Height="22" CornerRadius="0" 
                                Background="{DynamicResource Theme.Brush.RowBackground}" BorderBrush="{DynamicResource Theme.Brush.RowBorder}" BorderThickness="1">
                            <Path x:Name="Check" Data="M4 12l5 5L20 7" Stroke="#8BB7FF" StrokeThickness="2" 
                                  Stretch="Uniform" Width="12" Height="12" Visibility="Collapsed"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#263B82F6"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#78A8FF"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6B8FBF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Risk Badge Styles -->
        <Style x:Key="SafeBadge" TargetType="Border">
            <Setter Property="Background" Value="#1522C55E"/>
            <Setter Property="BorderBrush" Value="#3022C55E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>
        
        <Style x:Key="MediumBadge" TargetType="Border">
            <Setter Property="Background" Value="#15F59E0B"/>
            <Setter Property="BorderBrush" Value="#30F59E0B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>
        
        <Style x:Key="HighBadge" TargetType="Border">
            <Setter Property="Background" Value="#15EF4444"/>
            <Setter Property="BorderBrush" Value="#30EF4444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>
        
        <!-- Ghost Button -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.RowBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextSecondary}"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Brush.CardBackgroundHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Theme.Brush.CardBorderHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- One restrained primary action: no rainbow gradient or simulated glow. -->
        <Style x:Key="OrangeButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="0" Padding="24,12" Background="#2B62C9" BorderBrush="#4D84E6" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3775DE"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#79A8FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScanCoreButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategoryButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="AllCategoryButton" TargetType="Button" BasedOn="{StaticResource CategoryButton}">
            <Style.Triggers><DataTrigger Binding="{Binding SelectedCleanupCategory}" Value="All"><Setter Property="Background" Value="#203766A8"/><Setter Property="BorderBrush" Value="#6F9FF5"/><Setter Property="Foreground" Value="#DDEBFF"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="SystemCategoryButton" TargetType="Button" BasedOn="{StaticResource CategoryButton}">
            <Style.Triggers><DataTrigger Binding="{Binding SelectedCleanupCategory}" Value="System"><Setter Property="Background" Value="#203766A8"/><Setter Property="BorderBrush" Value="#6F9FF5"/><Setter Property="Foreground" Value="#DDEBFF"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="UserCategoryButton" TargetType="Button" BasedOn="{StaticResource CategoryButton}">
            <Style.Triggers><DataTrigger Binding="{Binding SelectedCleanupCategory}" Value="User"><Setter Property="Background" Value="#203766A8"/><Setter Property="BorderBrush" Value="#6F9FF5"/><Setter Property="Foreground" Value="#DDEBFF"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="GameCategoryButton" TargetType="Button" BasedOn="{StaticResource CategoryButton}">
            <Style.Triggers><DataTrigger Binding="{Binding SelectedCleanupCategory}" Value="Game"><Setter Property="Background" Value="#203766A8"/><Setter Property="BorderBrush" Value="#6F9FF5"/><Setter Property="Foreground" Value="#DDEBFF"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="BrowserCategoryButton" TargetType="Button" BasedOn="{StaticResource CategoryButton}">
            <Style.Triggers><DataTrigger Binding="{Binding SelectedCleanupCategory}" Value="Browser"><Setter Property="Background" Value="#203766A8"/><Setter Property="BorderBrush" Value="#6F9FF5"/><Setter Property="Foreground" Value="#DDEBFF"/></DataTrigger></Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" PanningMode="VerticalOnly">
    <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Web-aligned top bar: breadcrumb on the left, live disk portrait on the right. -->
        <Grid Grid.Row="0" Margin="24,18,24,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="VisiblePageTitle" Text="系统清理" Foreground="{DynamicResource Theme.Brush.TextPrimaryAlt}" FontSize="16" FontWeight="Bold"/>
                    <Border Width="1" Height="14" Background="{DynamicResource Theme.Brush.Border}" Margin="12,3,12,0"/>
                    <TextBlock x:Name="PageSubtitle" Text="释放磁盘空间 · 提升系统响应" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="PageTitle" Text="系统清理" Visibility="Collapsed"/>
            </StackPanel>
            <Border HorizontalAlignment="Right" Padding="12,7" BorderBrush="{DynamicResource Theme.Brush.GlassCardBorder}" BorderThickness="1" Background="{DynamicResource Theme.Brush.GlassCardBackground}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="SystemDiskLabel" Text="系统盘" FontSize="11" Foreground="{DynamicResource Theme.Brush.TextMuted}" VerticalAlignment="Center"/>
                    <ProgressBar Width="110" Height="5" Value="{Binding DiskUsagePercent}" Maximum="100" Margin="10,0" Foreground="#6F9FF5" Background="{DynamicResource Theme.Brush.GaugeTrack}"/>
                    <TextBlock Text="{Binding DiskUsedText}" FontFamily="JetBrains Mono, Consolas" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text=" / " FontSize="11" Foreground="{DynamicResource Theme.Brush.TextMuted}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DiskTotalText}" FontFamily="JetBrains Mono, Consolas" FontSize="11" Foreground="{DynamicResource Theme.Brush.TextMuted}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Scan control: a compact, dark-metal state machine derived from the legacy Web flow. -->
        <Border Grid.Row="1" Margin="24,16,24,0" CornerRadius="0" Padding="24,16" Background="{DynamicResource Theme.Brush.GlassCardBackground}" BorderBrush="{DynamicResource Theme.Brush.GlassCardBorder}" BorderThickness="1">
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <Button Grid.Row="0" Width="176" Height="176" HorizontalAlignment="Center"
                        Style="{StaticResource ScanCoreButton}" Click="ScanCore_Click"
                        AutomationProperties.Name="扫描清理项"
                        ToolTip="点击扫描，扫描完成后点击确认清理">
                <Viewbox Width="176" Height="176" Stretch="Uniform">
                <Grid Width="224" Height="224">
                    <!-- Same geometry as the legacy Web scan sphere: metal core, static track, true progress arc. -->
                    <Ellipse Width="190" Height="190" StrokeThickness="1" Stroke="#607694">
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="0.28,0.2" Center="0.5,0.5" RadiusX="0.64" RadiusY="0.64">
                                <GradientStop Color="#405674" Offset="0"/>
                                <GradientStop Color="#1C2A3C" Offset="0.50"/>
                                <GradientStop Color="#0C1420" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="214" Height="214" StrokeThickness="8" Stroke="#24364D"/>
                    <Ellipse Width="204" Height="204" StrokeThickness="2" Stroke="#476889" Opacity="0.6"/>
                    <Path Data="{Binding ScannerProgressArc}" Stroke="#82B1FF" StrokeThickness="5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" SnapsToDevicePixels="True"/>

                    <!-- A single sweep point rotates only during real preview work; it is not a decorative loop. -->
                    <Ellipse Width="9" Height="9" Fill="#B9D5FF" Stroke="#5B91E8" StrokeThickness="1"
                             HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0"
                             Visibility="Collapsed" RenderTransformOrigin="0.5,24">
                        <Ellipse.RenderTransform>
                            <RotateTransform CenterX="4.5" CenterY="111"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="ScanSweepStoryboard">
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     From="-90" To="270" Duration="0:0:1.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <RemoveStoryboard BeginStoryboardName="ScanSweepStoryboard"/>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <!-- Central state machine: each value is bound to the real preview/clean lifecycle. -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding VisualStateLabel}" Foreground="#BFD1EA" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,0">
                            <TextBlock Text="{Binding VisualPrimaryValue}" Foreground="{DynamicResource Theme.Brush.TextPrimary}" 
                                   FontSize="25" FontWeight="Bold" FontFamily="JetBrains Mono, Consolas"
                                   HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding VisualPrimaryUnit}" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="3,0,0,3"/>
                        </StackPanel>
                        <TextBlock x:Name="RecoverableLabel" Text="{Binding VisualStateHint}" Foreground="#9AAFC9" FontSize="10"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" TextAlignment="Center"
                                   MaxWidth="158" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
                </Viewbox>
                </Button>
                
                <!-- Center: Status & Info -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="14" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding SkippedDirectoryCount, StringFormat=已跳过不可访问目录：{0} 个}"
                               Foreground="{DynamicResource Theme.Brush.TextMuted}"
                               FontSize="11"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               Visibility="{Binding HasScanned, Converter={StaticResource BoolToVis}}"/>
                    
                    <!-- Disk Info Bar -->
                    <Border Background="#0D1522" BorderBrush="#29394D" BorderThickness="1" CornerRadius="0" Padding="16,10" Margin="0,10,0,0" MaxWidth="520" HorizontalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="DiskTotalLabel" Text="磁盘总量" Foreground="{DynamicResource Theme.Brush.TextDisabled}" FontSize="11"/>
                                <TextBlock Text="{Binding DiskTotalText}" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="13" FontWeight="Medium" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="1" Height="24" Background="{DynamicResource Theme.Brush.Border}" Margin="16,0"/>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="DiskUsedLabel" Text="已使用" Foreground="{DynamicResource Theme.Brush.TextDisabled}" FontSize="11"/>
                                <TextBlock Text="{Binding DiskUsedText}" Foreground="#D6A75C" FontSize="13" FontWeight="Medium" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="3" Width="1" Height="24" Background="{DynamicResource Theme.Brush.Border}" Margin="16,0"/>
                            <StackPanel Grid.Column="4">
                                <TextBlock x:Name="DiskFreeLabel" Text="可用空间" Foreground="{DynamicResource Theme.Brush.TextDisabled}" FontSize="11"/>
                                <TextBlock Text="{Binding DiskFreeText}" Foreground="#6BC690" FontSize="13" FontWeight="Medium" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- Quick Select Buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Center">
                        <Button AutomationProperties.AutomationId="SelectAllBtn" Style="{StaticResource GhostButton}" Command="{Binding SelectAllCommand}" Padding="12,6">
                            <TextBlock x:Name="SelectAllText" Text="全选" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="12"/>
                        </Button>
                        <Button AutomationProperties.AutomationId="DeselectAllBtn" Style="{StaticResource GhostButton}" Command="{Binding DeselectAllCommand}" Padding="12,6" Margin="8,0,0,0">
                            <TextBlock x:Name="DeselectAllText" Text="取消全选" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="12"/>
                        </Button>
                        <Button AutomationProperties.AutomationId="SelectSafeOnlyBtn" Style="{StaticResource GhostButton}" Command="{Binding SelectSafeOnlyCommand}" Padding="12,6" Margin="8,0,0,0">
                            <TextBlock x:Name="SelectSafeOnlyText" Text="仅选安全项" Foreground="#22C55E" FontSize="12"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
                
            </Grid>
        </Border>

        <!-- Functional categories: they now filter the actual cleanup catalog. -->
        <Border Grid.Row="2" Margin="24,16,24,0" Padding="10,8" Background="{DynamicResource Theme.Brush.GlassCardBackground}" BorderBrush="{DynamicResource Theme.Brush.GlassCardBorder}" BorderThickness="1">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="AllCategoryButton" Style="{StaticResource AllCategoryButton}" Command="{Binding SelectCategoryCommand}" CommandParameter="All">全部清理项</Button>
                    <Button x:Name="SystemCategoryButton" Style="{StaticResource SystemCategoryButton}" Command="{Binding SelectCategoryCommand}" CommandParameter="System">系统</Button>
                    <Button x:Name="UserCategoryButton" Style="{StaticResource UserCategoryButton}" Command="{Binding SelectCategoryCommand}" CommandParameter="User">用户</Button>
                    <Button x:Name="GameCategoryButton" Style="{StaticResource GameCategoryButton}" Command="{Binding SelectCategoryCommand}" CommandParameter="Game">游戏</Button>
                    <Button x:Name="BrowserCategoryButton" Style="{StaticResource BrowserCategoryButton}" Command="{Binding SelectCategoryCommand}" CommandParameter="Browser" Margin="0">浏览器</Button>
                </StackPanel>
                <TextBlock x:Name="CleanupSafetyHint" HorizontalAlignment="Right" VerticalAlignment="Center" Text="勾选后扫描预览，确认后才会清理" FontSize="11" Foreground="{DynamicResource Theme.Brush.TextMuted}"/>
            </Grid>
        </Border>

        <!-- Cleaning Matrix -->
            <Border Grid.Row="3" Margin="24,12,24,0" x:Name="CleanupItemsList" Background="{DynamicResource Theme.Brush.DialogBackground}" CornerRadius="0" BorderBrush="{DynamicResource Theme.Brush.CardBorder}" BorderThickness="1" Padding="8">
                <Grid MinHeight="180">
                    <ItemsControl ItemsSource="{Binding FilteredCleanupItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="ItemBorder" Background="{DynamicResource Theme.Brush.BackgroundSecondary}" CornerRadius="0" Padding="14,12" Margin="0,0,0,6" BorderBrush="{DynamicResource Theme.Brush.RowBorder}" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Size}" Value="0">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Checkbox -->
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Style="{StaticResource CyberCheckBox}" 
                                              VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    
                                    <!-- Icon -->
                                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="0" Margin="0,0,14,0"
                                            VerticalAlignment="Center">
                                        <Border.Background>#1E3150</Border.Background>
                                        <TextBlock Text="{x:Static constants:IconGlyphs.Delete}" 
                                                   FontFamily="Segoe MDL2 Assets" FontSize="18" 
                                                   Foreground="#93B8F6"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    
                                    <!-- Title & Description -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding LocalizedName}" Foreground="{DynamicResource Theme.Brush.TextPrimaryAlt}" FontSize="14" FontWeight="Medium"/>
                                            <!-- Risk Badge -->
                                            <Border Margin="10,0,0,0" VerticalAlignment="Center" CornerRadius="0" Padding="6,2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#1522C55E"/>
                                                        <Setter Property="BorderBrush" Value="#3022C55E"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Risk}" Value="Low">
                                                                <Setter Property="Background" Value="#1560A5FA"/>
                                                                <Setter Property="BorderBrush" Value="#3060A5FA"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Risk}" Value="Medium">
                                                                <Setter Property="Background" Value="#15F59E0B"/>
                                                                <Setter Property="BorderBrush" Value="#30F59E0B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding RiskText}" FontSize="10" FontWeight="Medium">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#22C55E"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Risk}" Value="Low">
                                                                    <Setter Property="Foreground" Value="#60A5FA"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Risk}" Value="Medium">
                                                                    <Setter Property="Foreground" Value="#F59E0B"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding LocalizedDescription}" Foreground="{DynamicResource Theme.Brush.TextDisabled}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    
                                    <!-- File Count -->
                                    <TextBlock Grid.Column="3" Text="{Binding FileCountText}" Foreground="{DynamicResource Theme.Brush.TextDisabled}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    
                                    <!-- View Details Button -->
                                    <Border Grid.Column="4" Width="28" Height="28" CornerRadius="0" Background="{DynamicResource Theme.Brush.Border}" 
                                            VerticalAlignment="Center" Margin="0,0,12,0" Cursor="Hand" ToolTip="{Binding ViewFileListTooltip}"
                                            MouseLeftButtonUp="ViewDetails_Click" Tag="{Binding}">
                                        <TextBlock Text="{x:Static constants:IconGlyphs.Folder}" 
                                                   FontFamily="Segoe MDL2 Assets" FontSize="12" 
                                                   Foreground="{DynamicResource Theme.Brush.IconSecondary}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    
                                    <!-- Size -->
                                    <TextBlock Grid.Column="5" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                               FontFamily="JetBrains Mono, Consolas"
                                               Text="{Binding SizeText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#D6A75C"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Size}" Value="0">
                                                        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.BorderLight}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <controls:EmptyState
                        Icon="{x:Static constants:IconGlyphs.Info}"
                        Title="暂无可清理项目"
                        Description="未加载到清理目录，已阻止执行。"
                        Visibility="{Binding CleanupItems.Count, Converter={StaticResource ZeroToVisibleConverter}}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"/>
                </Grid>
            </Border>
        
        <!-- Bottom Action Bar -->
        <Border Grid.Row="4" Margin="24,12,24,24">
            <Border CornerRadius="0">
                <Border CornerRadius="0" Padding="20,14"
                        BorderBrush="{DynamicResource Theme.Brush.MemoryFooterBorder}"
                        Background="{DynamicResource Theme.Brush.MemoryFooterBackground}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="SelectedLabel" Text="已选: " Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="13"/>
                            <TextBlock Text="{Binding SelectedCount}" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="13" FontWeight="Medium"/>
                            <TextBlock x:Name="ItemsLabel" Text=" 项" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="13"/>
                            <Border Width="1" Height="12" Background="{DynamicResource Theme.Brush.Border}" Margin="16,0"/>
                            <TextBlock x:Name="TotalLabel" Text="共 " Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="13"/>
                            <TextBlock Text="{Binding TotalFileCount}" Foreground="#D6A75C" FontSize="13" FontWeight="Medium"/>
                            <TextBlock x:Name="FilesLabel" Text=" 个文件" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="13"/>
                        </StackPanel>
                        
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Command="{Binding CancelCommand}" 
                                Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}" Margin="0,0,12,0">
                            <TextBlock x:Name="CancelText" Text="取消" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="13"/>
                        </Button>
                        
                        <Button Grid.Column="3" Style="{StaticResource OrangeButton}" Command="{Binding CleanCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Static constants:IconGlyphs.Cleanup}" 
                                           FontFamily="Segoe MDL2 Assets" FontSize="14" 
                                           Foreground="{DynamicResource Theme.Brush.TextPrimary}" 
                                           Margin="0,0,8,0"/>
                                <TextBlock x:Name="CleanNowText" Text="立即清理" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Border>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>

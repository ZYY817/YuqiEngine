<Window x:Class="GameOptimizer.Shell.Views.OptimizationResultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:GameOptimizer.Shell.Converters"
        Title="优化结果" Width="600" Height="550"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    
    <Window.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    
    <Border Background="{DynamicResource Theme.Brush.DialogBackground}" CornerRadius="12" 
            BorderThickness="1" BorderBrush="{DynamicResource Theme.Brush.DialogBorder}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.5" Color="{DynamicResource Theme.Color.Shadow}"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="Transparent" Padding="20,16" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="8" Background="#1522D3EE" Margin="0,0,12,0">
                            <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="18" 
                                       Foreground="#22D3EE" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText" Text="本次操作结果"
                                       Foreground="{DynamicResource Theme.Brush.TextPrimary}" 
                                       FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SubtitleText" Text="看看哪些已完成、哪些需要你处理"
                                       Foreground="{DynamicResource Theme.Brush.TextDisabled}" 
                                       FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Click="Close_Click" 
                            Background="Transparent" BorderThickness="0" 
                            Foreground="{DynamicResource Theme.Brush.TextDisabled}" 
                            FontSize="14" Cursor="Hand" Width="32" Height="32">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               Foreground="{DynamicResource Theme.Brush.TextMuted}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Brush.CardBackgroundHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
            
            <!-- 统计摘要 -->
            <Border Grid.Row="1" Margin="20,0,20,16" Padding="16" CornerRadius="10" 
                    Background="{DynamicResource Theme.Brush.CardBackgroundAlt}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                        <Border Width="28" Height="28" CornerRadius="14" Background="#2010B981" Margin="0,0,8,0">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="#10B981" FontSize="12" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="SuccessCountText" Text="成功 0 项" 
                                       Foreground="#10B981" FontSize="14" FontWeight="Medium"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                        <Border Width="28" Height="28" CornerRadius="14" Background="#20EF4444" Margin="0,0,8,0">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" Foreground="#EF4444" FontSize="12" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="FailedCountText" Text="失败 0 项" 
                                       Foreground="#EF4444" FontSize="14" FontWeight="Medium"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal">
                        <Border Width="28" Height="28" CornerRadius="14" Background="#208B94C6" Margin="0,0,8,0">
                            <TextBlock Text="&#xE893;" FontFamily="Segoe MDL2 Assets" Foreground="#8B94C6" FontSize="12" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="SkippedCountText" Text="跳过 0 项" 
                                       Foreground="#8B94C6" FontSize="14" FontWeight="Medium"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- 结果列表 -->
            <ScrollViewer Grid.Row="2" Margin="20,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 成功项 -->
                    <StackPanel x:Name="SuccessPanel" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="#10B981" FontSize="15" 
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="SuccessHeader" Text="成功项目" 
                                       Foreground="#10B981" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                        <ItemsControl x:Name="SuccessList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Theme.Brush.CardBackgroundAlt}" 
                                            CornerRadius="8" Padding="14,10" Margin="0,0,0,6"
                                            BorderBrush="#2510B981" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding StatusIcon}" FontFamily="Segoe MDL2 Assets"
                                                       Foreground="{Binding StatusForeground}" 
                                                       FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" 
                                                       Foreground="{DynamicResource Theme.Brush.TextPrimary}" 
                                                       FontSize="13.5" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding ModuleName}" 
                                                       Foreground="{DynamicResource Theme.Brush.TextMuted}" 
                                                       FontSize="12" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    
                    <!-- 失败项 -->
                    <StackPanel x:Name="FailedPanel" Margin="0,0,0,16" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" Foreground="#EF4444" FontSize="15" 
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="FailedHeader" Text="失败项目" 
                                       Foreground="#EF4444" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                        <ItemsControl x:Name="FailedList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#10EF4444" CornerRadius="8" Padding="14,10" Margin="0,0,0,6"
                                            BorderBrush="#30EF4444" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding StatusIcon}" FontFamily="Segoe MDL2 Assets"
                                                           Foreground="{Binding StatusForeground}" 
                                                           FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" 
                                                           Foreground="{DynamicResource Theme.Brush.TextPrimary}" 
                                                           FontSize="13.5" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding ModuleName}" 
                                                           Foreground="{DynamicResource Theme.Brush.TextMuted}" 
                                                           FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <Button Grid.Column="3" Click="ViewDetails_Click" Tag="{Binding}"
                                                        Cursor="Hand" Background="Transparent" BorderThickness="0"
                                                        Padding="6,4" ToolTip="查看详情" Margin="0,0,4,0"
                                                        Visibility="{Binding HasDiagnostic, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" 
                                                                   FontSize="12" Foreground="#22D3EE" 
                                                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <TextBlock Text="详情" FontSize="11" Foreground="#22D3EE" 
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" Background="Transparent" 
                                                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="#1522D3EE"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <Button Grid.Column="4" Click="TryRepair_Click" Tag="{Binding}"
                                                        Cursor="Hand" Background="Transparent" BorderThickness="0"
                                                        Padding="6,4" ToolTip="尝试修复"
                                                        Visibility="{Binding HasRepairOptions, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" 
                                                                   FontSize="12" Foreground="#10B981" 
                                                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <TextBlock Text="修复" FontSize="11" Foreground="#10B981" 
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" Background="Transparent" 
                                                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="#1510B981"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                            
                                            <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" 
                                                       Foreground="#F87171" FontSize="12" Margin="26,6,0,0"
                                                       TextWrapping="Wrap" LineHeight="18"
                                                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    
                    <!-- 跳过项（高风险） -->
                    <StackPanel x:Name="SkippedPanel" Margin="0,0,0,16" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="&#xE893;" FontFamily="Segoe MDL2 Assets" Foreground="#8B94C6" FontSize="15" 
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="SkippedHeader" Text="暂未处理的项目"
                                       Foreground="#8B94C6" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                        <ItemsControl x:Name="SkippedList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Theme.Brush.CardBackgroundAlt}" 
                                            CornerRadius="8" Padding="14,10" Margin="0,0,0,6"
                                            BorderBrush="{DynamicResource Theme.Brush.CardBorderSubtle}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="○" Foreground="#8B94C6" 
                                                       FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" 
                                                           Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="13"/>
                                                <TextBlock Text="{Binding SkipReason}" 
                                                           Foreground="{DynamicResource Theme.Brush.TextDisabled}" FontSize="11"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="查看处理方法 →" Click="NavigateToConfig_Click"
                                                    Tag="{Binding NavigateTarget}" Cursor="Hand"
                                                    Background="Transparent" BorderThickness="0"
                                                    Foreground="#22D3EE" FontSize="11"
                                                    Visibility="{Binding NavigateTarget, Converter={StaticResource NullToVisibilityConverter}}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            
            <!-- 底部按钮 -->
            <Border Grid.Row="3" Padding="20,16" Background="{DynamicResource Theme.Brush.CardBackgroundAlt}">
                <Grid>
                    <Button x:Name="CopyReportBtn" Click="CopyReport_Click" 
                            HorizontalAlignment="Left" Padding="16,10" Cursor="Hand"
                            Background="{DynamicResource Theme.Brush.CardBackground}"
                            Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                            BorderBrush="{DynamicResource Theme.Brush.CardBorder}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="14" 
                                       Foreground="{DynamicResource Theme.Brush.TextSecondary}" 
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="复制报告" Foreground="{DynamicResource Theme.Brush.TextSecondary}"/>
                        </StackPanel>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Brush.CardBackgroundHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <Button x:Name="CloseBtn" Content="关闭" Click="Close_Click" 
                            HorizontalAlignment="Right" Padding="24,10" Cursor="Hand"
                            Foreground="White" FontWeight="Medium">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#22D3EE" Offset="0"/>
                                            <GradientStop Color="#0EA5E9" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

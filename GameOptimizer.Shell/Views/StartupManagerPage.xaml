<UserControl x:Class="GameOptimizer.Shell.Views.StartupManagerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">
            <!-- 页面标题 - 增强视觉效果 -->
            <Border CornerRadius="20" Padding="28" Margin="0,0,0,20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0D1424" Offset="0"/>
                        <GradientStop Color="#141E30" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="48" Height="48" CornerRadius="14" Margin="0,0,16,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#F59E0B" Offset="0"/>
                                        <GradientStop Color="#FBBF24" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="🚀" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="启动管理" Foreground="White" FontSize="28" FontWeight="Bold"/>
                                <TextBlock Text="管理系统启动项，优化开机速度，加快系统启动" 
                                           Foreground="#8B94C6" FontSize="14" Margin="0,6,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="10" Padding="14,8" Margin="0,0,12,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#1A2340" Offset="0"/>
                                    <GradientStop Color="#1E2A42" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalCount, StringFormat='共 {0} 项'}" Foreground="#C9D2FF" FontSize="13" FontWeight="Medium"/>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="10" Padding="14,8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#F59E0B" Offset="0"/>
                                    <GradientStop Color="#FBBF24" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#F59E0B" BlurRadius="12" ShadowDepth="0" Opacity="0.3"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏸" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="White"/>
                                <TextBlock Text="{Binding DisabledCount, StringFormat='已禁用: {0} 项'}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
            
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 操作栏 -->
            <Border Grid.Row="0" Style="{StaticResource SectionCardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="🚀 应用全部建议" Command="{Binding ApplyAllRecommendationsCommand}" 
                                Style="{StaticResource ModernSuccessButton}"
                                Padding="18,10" Margin="0,0,10,0"
                                ToolTip="自动禁用非必要启动项，加快开机速度"/>
                        <Button Content="💡 分析影响" Command="{Binding AnalyzeImpactCommand}" 
                                Style="{StaticResource ModernPrimaryButton}"
                                Padding="18,10" Margin="0,0,10,0"/>
                        <Button Content="刷新列表" Command="{Binding LoadItemsCommand}" 
                                Style="{StaticResource ModernSecondaryButton}"
                                Padding="18,10"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="启动项:" VerticalAlignment="Center" Foreground="#8B94C6" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding TotalCount}" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text=" | 已禁用:" VerticalAlignment="Center" Foreground="#8B94C6" FontSize="13" Margin="16,0,8,0"/>
                        <TextBlock Text="{Binding DisabledCount}" VerticalAlignment="Center" Foreground="#F59E0B" FontWeight="SemiBold" FontSize="14"/>
                    </StackPanel>

                    <!-- 智能推荐提示 -->
                    <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0"
                            Background="#1A2540" CornerRadius="8" Padding="12"
                            Visibility="{Binding HasRecommendations, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="💡" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Foreground="#A1B4FF" FontSize="13">
                                    <Run Text="发现 "/>
                                    <Run Text="{Binding Recommendations.Count, Mode=OneWay}" FontWeight="Bold"/>
                                    <Run Text=" 个可优化的启动项，禁用后可加快开机速度"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 启动项列表 -->
            <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="启动项列表" Style="{StaticResource CardTitleStyle}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="筛选:" VerticalAlignment="Center" Foreground="#8B94C6" FontSize="13" Margin="0,0,10,0"/>
                            <ComboBox SelectedIndex="0" Width="120"
                                      Style="{StaticResource ModernComboBox}">
                                <ComboBoxItem Content="全部"/>
                                <ComboBoxItem Content="已启用"/>
                                <ComboBoxItem Content="已禁用"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- 删除确认提示 -->
                    <Border Grid.Row="1" Background="#2A1A1A" CornerRadius="8" Padding="16" Margin="0,0,0,12"
                            Visibility="{Binding ShowDeleteConfirm, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="⚠️" FontSize="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="确认删除启动项？" Foreground="#EF4444" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="{Binding PendingDeleteItem.Name, StringFormat={}将删除: {0}}" 
                                           Foreground="#FCA5A5" FontSize="12" Margin="0,4,0,0"/>
                                <TextBlock Text="此操作将修改注册表，请谨慎操作" 
                                           Foreground="#F59E0B" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="取消" Command="{Binding CancelDeleteItemCommand}"
                                        Style="{StaticResource ModernSecondaryButton}" Padding="16,8" Margin="0,0,8,0"/>
                                <Button Content="确认删除" Command="{Binding ConfirmDeleteItemCommand}"
                                        Style="{StaticResource ModernDangerButton}" Padding="16,8"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ListView Grid.Row="1" ItemsSource="{Binding StartupItems}" 
                              SelectedItem="{Binding SelectedItem}"
                              Background="Transparent" BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,16,0"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="White" FontSize="14"/>
                                            <TextBlock Text="{Binding Path}" FontSize="11" Foreground="#6B7AA0" 
                                                       TextTrimming="CharacterEllipsis" MaxWidth="400" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding Location}" 
                                                   VerticalAlignment="Center" Foreground="#8B94C6" FontSize="12"/>

                                        <Border Grid.Column="3" CornerRadius="6" Padding="10,4" VerticalAlignment="Center"
                                                HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1A10B981"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                            <Setter Property="Background" Value="#1AF59E0B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="12" FontWeight="Medium">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="已启用"/>
                                                        <Setter Property="Foreground" Value="#10B981"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                <Setter Property="Text" Value="已禁用"/>
                                                                <Setter Property="Foreground" Value="#F59E0B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                                            <Button Content="切换" 
                                                    Command="{Binding DataContext.ToggleItemCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource ModernSecondaryButton}"
                                                    Padding="12,6" Margin="0,0,6,0"/>
                                            <Button Content="定位" 
                                                    Command="{Binding DataContext.LocateItemCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource ModernSecondaryButton}"
                                                    Padding="12,6" Margin="0,0,6,0"/>
                                            <Button Content="删除" 
                                                    Command="{Binding DataContext.RequestDeleteItemCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource ModernDangerButton}"
                                                    Padding="12,6"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock x:Name="NoItemsText" Grid.Row="1" Text="暂无启动项" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#6B7280" FontSize="14" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- 状态栏 -->
            <TextBlock Grid.Row="2" Text="{Binding StatusText}" Margin="0,16,0,0"
                       Foreground="#8B94C6" FontSize="13"/>
        </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

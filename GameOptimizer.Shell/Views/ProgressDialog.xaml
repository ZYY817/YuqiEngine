<!-- File: GameOptimizer.Shell/Views/ProgressDialog.xaml -->
<Window x:Class="GameOptimizer.Shell.Views.ProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GameOptimizer.Shell.Controls"
        Title="{Binding Title}"
        Width="580" Height="Auto"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <!-- 淡入动画 - 更平滑的入场效果 -->
        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        
        <!-- 滑入动画 - 更流畅的滑动效果 -->
        <Storyboard x:Key="SlideInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                           From="30" To="0" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>
    
    <!-- 主容器 -->
    <Border Background="{DynamicResource Theme.Brush.BackgroundSecondary}"
            BorderBrush="{DynamicResource Theme.Brush.Border}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="30" ShadowDepth="0"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 顶部渐变区域 -->
                <RowDefinition Height="*"/>    <!-- 内容区域 -->
            </Grid.RowDefinitions>
            
            <!-- 顶部渐变背景 -->
            <Border Grid.Row="0" 
                    CornerRadius="16,16,0,0" 
                    Height="80"
                    ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#206366F1" Offset="0"/>
                        <GradientStop Color="#308B5CF6" Offset="0.5"/>
                        <GradientStop Color="#20A855F7" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                
                <!-- 装饰性网格 -->
                <Grid Opacity="0.1">
                    <Line X1="0" Y1="0" X2="580" Y2="80" Stroke="White" StrokeThickness="1"/>
                    <Line X1="0" Y1="40" X2="580" Y2="40" Stroke="White" StrokeThickness="1"/>
                </Grid>
            </Border>
            
            <!-- 内容区域 -->
            <StackPanel Grid.Row="0" Grid.RowSpan="2" Margin="40,30,40,35">
                
                <!-- 标题区域 -->
                <Grid Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- 图标 -->
                    <Border Grid.Column="0"
                            Width="48" Height="48"
                            CornerRadius="12"
                            Background="{DynamicResource Theme.Brush.Accent}"
                            Margin="0,0,16,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#6366F1" Opacity="0.4" BlurRadius="12" ShadowDepth="0"/>
                        </Border.Effect>
                        <TextBlock Text="&#xE9F3;" 
                                 FontFamily="Segoe MDL2 Assets"
                                 FontSize="24"
                                 Foreground="White"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Border>
                    
                    <!-- 标题文本 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                 FontSize="20"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource Theme.Brush.TextPrimary}"/>
                        <TextBlock Text="{Binding Subtitle}"
                                 FontSize="13"
                                 Foreground="{DynamicResource Theme.Brush.TextMuted}"
                                 Margin="0,4,0,0"
                                 Visibility="{Binding ShowSubtitle, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Grid>
                
                <!-- 进度百分比 -->
                <TextBlock Text="{Binding ProgressPercentageText}"
                         FontSize="42"
                         FontWeight="Bold"
                         Foreground="{DynamicResource Theme.Brush.Accent}"
                         HorizontalAlignment="Center"
                         Margin="0,0,0,15"
                         Visibility="{Binding ShowPercentage, Converter={StaticResource BoolToVis}}">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#6366F1" Opacity="0.3" BlurRadius="8" ShadowDepth="0"/>
                    </TextBlock.Effect>
                </TextBlock>
                
                <!-- 进度条 -->
                <controls:ModernProgressBar Value="{Binding ProgressPercentage}"
                                          IsIndeterminate="{Binding IsIndeterminate}"
                                          Height="12"
                                          Margin="0,0,0,12"/>
                
                <!-- 进度文本 -->
                <TextBlock Text="{Binding ProgressText}"
                         FontSize="13"
                         FontWeight="Medium"
                         Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                         HorizontalAlignment="Center"
                         Margin="0,0,0,25"/>
                
                <!-- 当前操作卡片 -->
                <Border Background="{DynamicResource Theme.Brush.CardBackgroundAlt}"
                        BorderBrush="{DynamicResource Theme.Brush.CardBorder}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20,16"
                        Margin="0,0,0,20"
                        Visibility="{Binding ShowCurrentOperation, Converter={StaticResource BoolToVis}}"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TranslateTransform/>
                    </Border.RenderTransform>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- 分类图标 -->
                        <Border Grid.Column="0"
                                Width="40" Height="40"
                                CornerRadius="10"
                                Margin="0,0,14,0"
                                VerticalAlignment="Top">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#306366F1" Offset="0"/>
                                    <GradientStop Color="#408B5CF6" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="{Binding CategoryIcon}"
                                     FontFamily="Segoe MDL2 Assets"
                                     FontSize="18"
                                     Foreground="White"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Border>
                        
                        <!-- 操作信息 -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentOperationLabel}"
                                     FontSize="11"
                                     Foreground="{DynamicResource Theme.Brush.TextMuted}"
                                     Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding CurrentOperationCategory}"
                                     FontSize="12"
                                     Foreground="{DynamicResource Theme.Brush.Accent}"
                                     FontWeight="Medium"
                                     Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding CurrentOperationTitle}"
                                     FontSize="14"
                                     Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                                     TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <!-- 信息栏 -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- 预计时间 -->
                    <StackPanel Grid.Column="0" 
                              Orientation="Horizontal"
                              Visibility="{Binding ShowEstimatedTime, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="&#xE917;" 
                                 FontFamily="Segoe MDL2 Assets"
                                 FontSize="14"
                                 Foreground="#06B6D4"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0"/>
                        <TextBlock FontSize="13" Foreground="{DynamicResource Theme.Brush.TextSecondary}">
                            <Run Text="{Binding EstimatedTimeLabel, Mode=OneWay}"/>
                            <Run Text="{Binding EstimatedTimeText}" 
                                 Foreground="#06B6D4" 
                                 FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>
                    
                    <!-- 提示信息 -->
                    <StackPanel Grid.Column="1" 
                              Orientation="Horizontal"
                              Visibility="{Binding ShowTip, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="&#xE946;" 
                                 FontFamily="Segoe MDL2 Assets"
                                 FontSize="14"
                                 Foreground="#F59E0B"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding TipText}"
                                 FontSize="12"
                                 Foreground="{DynamicResource Theme.Brush.TextMuted}"/>
                    </StackPanel>
                </Grid>
                
                <!-- 通用消息（兼容旧用法） -->
                <TextBlock Text="{Binding Message}"
                         FontSize="13"
                         Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                         HorizontalAlignment="Center"
                         TextWrapping="Wrap"
                         TextAlignment="Center"
                         Margin="0,0,0,20"
                         Visibility="{Binding ShowMessage, Converter={StaticResource BoolToVis}}"/>
                
                <!-- 取消按钮 -->
                <Button x:Name="CancelButton"
                        Content="{Binding CancelButtonText}"
                        Click="CancelButton_Click"
                        HorizontalAlignment="Center"
                        Padding="32,12"
                        Cursor="Hand"
                        FontSize="13"
                        FontWeight="Medium"
                        Visibility="{Binding ShowCancelButton, Converter={StaticResource BoolToVis}}"
                        Background="Transparent"
                        BorderBrush="{DynamicResource Theme.Brush.CardBorder}"
                        BorderThickness="1"
                        Foreground="{DynamicResource Theme.Brush.TextSecondary}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10" 
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Brush.CardBackgroundHover}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Theme.Brush.Accent}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>

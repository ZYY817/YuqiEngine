<UserControl x:Class="GameOptimizer.Shell.Views.GameProfilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Theme.Brush.Background}" Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        
        <Style x:Key="GameCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.3" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="GlowPrimaryButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="20,12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2563EB" Offset="0"/>
                                    <GradientStop Color="#3B82F6" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5" Color="#3B82F6"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#3B82F6" Offset="0"/>
                                            <GradientStop Color="#60A5FA" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Ellipse Width="500" Height="500" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-150,-150,0" Opacity="0.06" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#3B82F6" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24">
            <StackPanel>
                <Grid Margin="0,0,0,28">
                    <StackPanel>
                        <TextBlock x:Name="PageTitle" Text="Game Arsenal" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource Theme.Brush.TextPrimaryAlt}" FontFamily="Microsoft YaHei UI"/>
                        <TextBlock x:Name="PageSubtitle" Text="Create custom optimization profiles for your games" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="13" Margin="0,8,0,0"/>
                    </StackPanel>
                    <Button x:Name="ScanGamesBtn" Style="{StaticResource GlowPrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ScanGamesButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Theme.Brush.TextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="ScanButtonText" Text="Scan / Add Games" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Brush.TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Border x:Name="EmptyState" Visibility="Collapsed" Margin="0,40,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="120" Height="120" CornerRadius="60" Margin="0,0,0,24">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1A2563EB" Offset="0"/>
                                    <GradientStop Color="#0A2563EB" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="&#x1F3AE;" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="EmptyTitle" Text="Game Library Empty" Foreground="{DynamicResource Theme.Brush.TextPrimaryAlt}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptySubtitle" Text="Click the button above to scan installed games or add manually" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                
                <ItemsControl x:Name="GameCardsContainer">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GameCardStyle}" Margin="8" Height="240" ClipToBounds="True">
                                <Grid>
                                    <Border CornerRadius="12" Background="{DynamicResource Theme.Brush.CardAlt}"/>
                                    
                                    <Border Width="64" Height="64" CornerRadius="12" VerticalAlignment="Center" Margin="0,0,0,50">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#1A3B82F6" Offset="0"/>
                                                <GradientStop Color="#0A3B82F6" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock Text="&#x1F3AE;" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    
                                    <Border CornerRadius="12" Background="{DynamicResource Theme.Brush.CardGradient}"/>
                                    
                                    <!-- Game Type Badge (Top Left) -->
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" CornerRadius="6" Padding="8,4">
                                        <Border.Background>
                                            <SolidColorBrush Color="#3B82F6" Opacity="0.2"/>
                                        </Border.Background>
                                        <TextBlock Text="{Binding GameTypeDisplay}" Foreground="#60A5FA" FontSize="10" FontWeight="Medium"/>
                                    </Border>
                                    
                                    <!-- Status Badge (Top Right) -->
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Background="#1A4ADE80" CornerRadius="6" Padding="8,4"
                                            Visibility="{Binding HasOptimizations, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <Ellipse.Fill>
                                                    <RadialGradientBrush>
                                                        <GradientStop Color="#4ADE80" Offset="0"/>
                                                        <GradientStop Color="#22C55E" Offset="1"/>
                                                    </RadialGradientBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="{Binding OptimizedText}" Foreground="#4ADE80" FontSize="10" FontWeight="Medium"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Title & Info (Bottom) -->
                                    <StackPanel VerticalAlignment="Bottom" Margin="16,0,16,16">
                                        <TextBlock Text="{Binding GameName}" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding OptimizationSummary}" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Border Background="#1A3B82F6" CornerRadius="4" Padding="6,2">
                                                <TextBlock Foreground="#60A5FA" FontSize="10" Text="{Binding OptimizationCountText}"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <!-- Hover Overlay -->
                                    <Border x:Name="HoverOverlay" CornerRadius="12" Opacity="0" Background="{DynamicResource Theme.Brush.LoadingOverlay}">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Button Content="{Binding LaunchGameText}" Click="LaunchGameButton_Click" Tag="{Binding Id}"
                                                    Background="#2563EB" BorderThickness="0" Foreground="White" FontSize="13" FontWeight="SemiBold" Padding="24,10" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="#2563EB" CornerRadius="8" Padding="24,10">
                                                            <ContentPresenter HorizontalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#3B82F6"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                                <Button Content="{Binding ConfigureText}" Click="EditGameButton_Click" Tag="{Binding Id}"
                                                        Background="Transparent" BorderBrush="{DynamicResource Theme.Brush.BorderLight}" BorderThickness="1"
                                                        Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="11" Padding="12,6" Cursor="Hand" Margin="0,0,8,0"/>
                                                <Button Content="{Binding DeleteText}" Click="DeleteGameButton_Click" Tag="{Binding Id}"
                                                        Background="Transparent" BorderBrush="#7F1D1D" BorderThickness="1"
                                                        Foreground="#F87171" FontSize="11" Padding="12,6" Cursor="Hand"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
                <Border x:Name="AddGameCard" Margin="8,16,8,8" Height="240" CornerRadius="12" 
                        Background="{DynamicResource Theme.Brush.PanelBackground}" Cursor="Hand" MouseLeftButtonUp="AddGameButton_Click"
                        HorizontalAlignment="Left" Width="260">
                    <Border.BorderBrush>
                        <VisualBrush TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
                            <VisualBrush.Visual>
                                <Rectangle Width="8" Height="8" StrokeThickness="1" Stroke="{DynamicResource Theme.Brush.Border}"/>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Border.BorderBrush>
                    <Border.BorderThickness>1</Border.BorderThickness>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource Theme.Brush.BackgroundSecondary}" Margin="0,0,0,12">
                            <TextBlock Text="+" FontSize="24" FontWeight="Light" Foreground="{DynamicResource Theme.Brush.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="AddCardText" Text="Add New Game" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="13" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

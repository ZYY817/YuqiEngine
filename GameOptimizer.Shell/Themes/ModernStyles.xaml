<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════════════
         ZY Core - 极简扁平样式系统 v3.0
         Inspired by Vercel / Linear / Apple Settings
         
         设计原则:
         - 无渐变、无发光、无阴影
         - 单一强调色 ({DynamicResource Theme.Brush.AccentBlue} Electric Blue)
         - 扁平、干净、专业
    ═══════════════════════════════════════════════════════════════════════ -->

    <!-- ==================== 颜色定义 - Digital Craftsmanship ==================== -->
    <Style x:Key="ModernPrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="18,11"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{DynamicResource Theme.Brush.ControlAccent}" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Theme.Brush.AccentBlueLight}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Theme.Brush.AccentBlue}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 次要按钮样式 - Apple Style (深灰色) ==================== -->
    <Style x:Key="ModernSecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceRaised}"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextOnAccent}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" 
                            CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Theme.Brush.TextSecondary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Theme.Brush.CardBackgroundHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 成功按钮样式 ==================== -->
    <Style x:Key="ModernSuccessButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.Success}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" 
                            CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Theme.Brush.Success}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Theme.Brush.Success}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 危险按钮样式 ==================== -->
    <Style x:Key="ModernDangerButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.Error}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" 
                            CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Theme.Brush.Error}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Theme.Brush.Error}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 卡片样式 - 精密边框 12px 圆角 ==================== -->
    <Style x:Key="ModernCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="ModernClickableCard" TargetType="Border" BasedOn="{StaticResource ModernCard}">
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Theme.Brush.CardBackgroundHover}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.BorderLight}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ==================== 徽章样式 ==================== -->
    <Style x:Key="ModernBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceRaised}"/>
    </Style>

    <Style x:Key="ModernBadgeSuccess" TargetType="Border" BasedOn="{StaticResource ModernBadge}">
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceRaised}"/>
    </Style>

    <Style x:Key="ModernBadgeWarning" TargetType="Border" BasedOn="{StaticResource ModernBadge}">
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceRaised}"/>
    </Style>

    <Style x:Key="ModernBadgeDanger" TargetType="Border" BasedOn="{StaticResource ModernBadge}">
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceRaised}"/>
    </Style>

    <Style x:Key="ModernBadgeInfo" TargetType="Border" BasedOn="{StaticResource ModernBadge}">
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceRaised}"/>
    </Style>

    <!-- ==================== 进度条样式 ==================== -->
    <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="4"/>
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceRaised}"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.AccentBlue}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="2" SnapsToDevicePixels="True">
                        <Border x:Name="PART_Track" CornerRadius="2">
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" 
                                    Background="{TemplateBinding Foreground}" CornerRadius="2"/>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 开关样式 - iOS 风格 ==================== -->
    <Style x:Key="ModernToggleSwitch" TargetType="ToggleButton">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="track" Background="{DynamicResource Theme.Brush.ToggleTrackOff}" CornerRadius="12"
                            BorderBrush="{DynamicResource Theme.Brush.ToggleTrackBorder}" BorderThickness="1">
                        <Border x:Name="thumb" Width="18" Height="18" CornerRadius="9" 
                                Background="{DynamicResource Theme.Brush.ToggleThumbOff}" Margin="3" HorizontalAlignment="Left">
                            
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{DynamicResource Theme.Brush.ControlAccent}"/>
                            <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Theme.Brush.ControlAccent}"/>
                            <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="thumb" Property="Background" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 文本框样式 ==================== -->
    <Style x:Key="ModernTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextOnAccent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Theme.Brush.ControlAccent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border" Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="8" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Theme.Brush.ControlAccent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 分隔线样式 ==================== -->
    <Style x:Key="ModernDivider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceRaised}"/>
        <Setter Property="Margin" Value="0,12"/>
    </Style>

    <!-- ==================== 标题样式 ==================== -->
    <Style x:Key="ModernSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextOnAccent}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="ModernSectionSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextSecondary}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- ==================== 图标按钮样式 ==================== -->
    <Style x:Key="ModernIconButton" TargetType="Button">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" 
                            CornerRadius="6" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Theme.Brush.SurfaceRaised}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 工具提示样式 ==================== -->
    <Style x:Key="ModernToolTip" TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextOnAccent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 导航分组标题样式 ==================== -->
    <Style x:Key="ModernNavGroupHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextMuted}"/>
    </Style>

    <!-- ==================== 滑块样式 ==================== -->
    <Style x:Key="ModernSlider" TargetType="Slider">
        <Setter Property="Height" Value="20"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Border Height="4" Background="{DynamicResource Theme.Brush.CardBackgroundHover}" CornerRadius="2" VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track">
                            <Track.Thumb>
                                <Thumb Width="16" Height="16">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Width="16" Height="16" CornerRadius="8" Background="{DynamicResource Theme.Brush.ControlAccent}"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 下拉框样式 ==================== -->
    <Style x:Key="ModernComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextOnAccent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- ==================== 状态指示器样式 ==================== -->
    <Style x:Key="ModernStatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="Fill" Value="{DynamicResource Theme.Brush.Success}"/>
    </Style>

    <!-- ==================== 导航图标徽章样式 ==================== -->
    <Style x:Key="ModernIconBadgeStyle" TargetType="Border">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.CardBackgroundHover}"/>
    </Style>

    <!-- ==================== 增强导航项样式 ==================== -->
    <!-- Sidebar Active State: Dark grey rounded pill background (no blue accent bar) -->
    <Style x:Key="EnhancedNavItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextMuted}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Outer" Background="Transparent" CornerRadius="10" 
                            SnapsToDevicePixels="True" Padding="0" Margin="4,0">
                        <ContentPresenter Margin="12,10" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextSecondary}"/>
                            <Setter TargetName="Outer" Property="Background" Value="{DynamicResource Theme.Brush.Border}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter TargetName="Outer" Property="Background" Value="{DynamicResource Theme.Brush.CardBackgroundHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 样式别名 (兼容旧引用) ==================== -->
    <Style x:Key="ModernPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernPrimaryButton}"/>
    <Style x:Key="ModernSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernSecondaryButton}"/>
    <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernSuccessButton}"/>
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernDangerButton}"/>
    <!-- ==================== 预设按钮样式 ==================== -->
    <Style x:Key="PresetButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.CardBackgroundHover}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Theme.Brush.CardBackgroundHover}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Theme.Brush.ControlAccent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Theme.Brush.ControlAccent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernLinkButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.ControlAccent}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="text" Text="{TemplateBinding Content}" 
                               Foreground="{TemplateBinding Foreground}" 
                               TextDecorations="None"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="text" Property="TextDecorations" Value="Underline"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 等宽字体样式 (用于数据显示) ==================== -->
    <Style x:Key="MonoDataText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas, JetBrains Mono, Cascadia Code, monospace"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextOnAccent}"/>
    </Style>
    
    <Style x:Key="MonoDataTextLarge" TargetType="TextBlock" BasedOn="{StaticResource MonoDataText}">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    
    <Style x:Key="MonoDataTextMedium" TargetType="TextBlock" BasedOn="{StaticResource MonoDataText}">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    
    <Style x:Key="MonoDataTextHero" TargetType="TextBlock" BasedOn="{StaticResource MonoDataText}">
        <Setter Property="FontSize" Value="42"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- ==================== 精密工程卡片样式 (Cut Metal Look) ==================== -->
    <Style x:Key="PrecisionCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ==================== 生物发光按钮样式 (Bioluminescence CTA) ==================== -->
        <Style x:Key="BioGlowButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.ControlAccent}"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextOnAccent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="{DynamicResource Token.FontSize.Base}"/>
        <Setter Property="Padding" Value="{DynamicResource Token.Padding.Button}"/>
        <Setter Property="MinHeight" Value="{DynamicResource Token.Size.MinInteractive}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Token.FocusVisualStyle}"/>
    </Style>

    <!-- ==================== iOS 风格开关 (Green/Grey) ==================== -->
    <Style x:Key="iOSToggleSwitch" TargetType="ToggleButton">
        <Setter Property="Width" Value="51"/>
        <Setter Property="Height" Value="31"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="track" Background="{DynamicResource Theme.Brush.SurfaceRaised}" CornerRadius="15.5" SnapsToDevicePixels="True">
                        <Border x:Name="thumb" Width="27" Height="27" CornerRadius="13.5" 
                                Background="White" Margin="2" HorizontalAlignment="Left"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{DynamicResource Theme.Brush.Success}"/>
                            <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 单色监控卡片样式 (Monochrome Monitor) ==================== -->
    <Style x:Key="MonoMonitorCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- ==================== 单色进度条样式 (白色进度条) ==================== -->
    <Style x:Key="MonoProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="4"/>
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.SurfaceRaised}"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextOnAccent}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="2" SnapsToDevicePixels="True">
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" 
                                Background="{TemplateBinding Foreground}" CornerRadius="2"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 双层状态环样式 ==================== -->
    <Style x:Key="DoubleLayerRing" TargetType="Grid">
        <Setter Property="Width" Value="120"/>
        <Setter Property="Height" Value="120"/>
    </Style>

</ResourceDictionary>

<UserControl x:Class="GameOptimizer.Shell.Controls.OptimizationCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- High Contrast Optimization Card - Tactile & Visible -->
    <Border x:Name="CardBorder" CornerRadius="10" Padding="14" Margin="0,0,10,10" Cursor="Hand" MouseLeftButtonUp="Card_Click">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="#1A1A1E"/>
                <Setter Property="BorderBrush" Value="#2A2A2E"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BorderBrush" Value="#3B82F6"/>
                        <Setter Property="Background" Value="#1A3B82F6"/>
                    </DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#252528"/>
                        <Setter Property="BorderBrush" Value="#3A3A3E"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- 顶部：标题 + 风险等级徽章 -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- 选中指示器 (圆形) -->
                <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#2A2A2E"/>
                            <Setter Property="BorderBrush" Value="#404044"/>
                            <Setter Property="BorderThickness" Value="2"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Background" Value="#3B82F6"/>
                                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="✓" Foreground="White" FontSize="11" FontWeight="Bold" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Border>
                
                <!-- 标题 -->
                <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="#FFFFFF" FontSize="13" 
                           FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                
                <!-- 风险等级徽章 -->
                <Border Grid.Column="2" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#1A34C759"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RiskLevel}" Value="Safe">
                                    <Setter Property="Background" Value="#1A34C759"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RiskLevel}" Value="Medium">
                                    <Setter Property="Background" Value="#1AFF9500"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RiskLevel}" Value="High">
                                    <Setter Property="Background" Value="#1AFF3B30"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock FontSize="10" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="安全"/>
                                <Setter Property="Foreground" Value="#34C759"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RiskLevel}" Value="Safe">
                                        <Setter Property="Text" Value="安全"/>
                                        <Setter Property="Foreground" Value="#34C759"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RiskLevel}" Value="Medium">
                                        <Setter Property="Text" Value="中等"/>
                                        <Setter Property="Foreground" Value="#FF9500"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RiskLevel}" Value="High">
                                        <Setter Property="Text" Value="高风险"/>
                                        <Setter Property="Foreground" Value="#FF3B30"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>
            
            <!-- 中间：描述文字 -->
            <TextBlock Grid.Row="1" Text="{Binding Description}" Foreground="#808085" FontSize="11" 
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" Margin="30,0,0,8"/>
            
            <!-- 底部：状态标签 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="30,0,0,0">
                <!-- 硬件要求标签 -->
                <Border x:Name="HardwareTag" CornerRadius="4" Padding="6,2" Margin="0,0,6,0"
                        Background="#1A3B82F6" Visibility="{Binding HardwareRequirement, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock Text="{Binding HardwareRequirement}" Foreground="#60A5FA" FontSize="10"/>
                </Border>
                
                <!-- 已生效标签 -->
                <Border CornerRadius="4" Padding="6,2" Visibility="{Binding IsApplied, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border.Background>
                        <SolidColorBrush Color="#34C759" Opacity="0.15"/>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✓" Foreground="#34C759" FontSize="10" Margin="0,0,4,0"/>
                        <TextBlock Text="已生效" Foreground="#34C759" FontSize="10"/>
                    </StackPanel>
                </Border>
                
                <!-- 性能提升标签 -->
                <Border x:Name="PerformanceTag" CornerRadius="4" Padding="6,2" Margin="6,0,0,0"
                        Background="#1AFF9500" Visibility="{Binding PerformanceHint, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock Text="{Binding PerformanceHint}" Foreground="#FF9500" FontSize="10"/>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

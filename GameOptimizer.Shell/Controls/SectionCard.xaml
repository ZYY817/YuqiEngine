<UserControl x:Class="GameOptimizer.Shell.Controls.SectionCard"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GameOptimizer.Shell.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             AutomationProperties.Name="{Binding Title, ElementName=Root}">
    <Border x:Name="CardBorder"
            CornerRadius="{DynamicResource Token.Radius.Card}"
            Background="{DynamicResource Theme.Brush.CardBackground}"
            BorderThickness="1"
            Padding="{Binding CardPadding, ElementName=Root}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.CardBorder}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding VisualState, ElementName=Root}" Value="Loading"><Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Info}"/></DataTrigger>
                    <DataTrigger Binding="{Binding VisualState, ElementName=Root}" Value="Error"><Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Error}"/></DataTrigger>
                    <DataTrigger Binding="{Binding VisualState, ElementName=Root}" Value="Unauthorized"><Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Warning}"/></DataTrigger>
                    <DataTrigger Binding="{Binding VisualState, ElementName=Root}" Value="Recovering"><Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Warning}"/></DataTrigger>
                    <DataTrigger Binding="{Binding VisualState, ElementName=Root}" Value="Success"><Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Success}"/></DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16"
                  Visibility="{Binding HasHeader, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="{DynamicResource Token.Size.IconBoxMd}"
                        Height="{DynamicResource Token.Size.IconBoxMd}"
                        CornerRadius="{DynamicResource Token.Radius.Icon}"
                        Margin="0,0,12,0"
                        Visibility="{Binding ShowIcon, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border.Background>
                        <SolidColorBrush Color="{Binding IconBackground, ElementName=Root}"/>
                    </Border.Background>
                    <Viewbox Width="{DynamicResource Token.Size.IconSm}" Height="{DynamicResource Token.Size.IconSm}">
                        <Path Data="{Binding IconData, ElementName=Root}"
                              Fill="{Binding IconBrush, ElementName=Root}"
                              Stretch="Uniform"/>
                    </Viewbox>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title, ElementName=Root}"
                               FontSize="{DynamicResource Token.FontSize.Lg}"
                               FontWeight="{DynamicResource Token.FontWeight.SemiBold}"
                               Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Subtitle, ElementName=Root}"
                               FontSize="{DynamicResource Token.FontSize.Sm}"
                               Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                               Margin="{DynamicResource Token.Padding.Xs}"
                               TextWrapping="Wrap"
                               Visibility="{Binding Subtitle, ElementName=Root, Converter={StaticResource NullToVisibilityConverter}}"/>
                </StackPanel>

                <Border Grid.Column="2" Width="8" Height="8" CornerRadius="4" Margin="12,0,12,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Background" Value="{DynamicResource Theme.Brush.Info}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding VisualState, ElementName=Root}" Value="Loading"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                <DataTrigger Binding="{Binding VisualState, ElementName=Root}" Value="Error"><Setter Property="Visibility" Value="Visible"/><Setter Property="Background" Value="{DynamicResource Theme.Brush.Error}"/></DataTrigger>
                                <DataTrigger Binding="{Binding VisualState, ElementName=Root}" Value="Unauthorized"><Setter Property="Visibility" Value="Visible"/><Setter Property="Background" Value="{DynamicResource Theme.Brush.Warning}"/></DataTrigger>
                                <DataTrigger Binding="{Binding VisualState, ElementName=Root}" Value="Recovering"><Setter Property="Visibility" Value="Visible"/><Setter Property="Background" Value="{DynamicResource Theme.Brush.Warning}"/></DataTrigger>
                                <DataTrigger Binding="{Binding VisualState, ElementName=Root}" Value="Success"><Setter Property="Visibility" Value="Visible"/><Setter Property="Background" Value="{DynamicResource Theme.Brush.Success}"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <ContentPresenter Grid.Column="3" Content="{Binding HeaderContent, ElementName=Root}" VerticalAlignment="Center"/>
            </Grid>

            <ContentPresenter Grid.Row="1" Content="{Binding Body, ElementName=Root}"/>
        </Grid>
    </Border>
</UserControl>

<UserControl x:Class="GameOptimizer.Shell.Controls.StatCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    
    <!-- 扁平卡片：无渐变、无阴影 -->
    <Border x:Name="CardBorder"
            CornerRadius="8"
            Padding="16"
            Background="#1E1E20"
            BorderBrush="#1AFFFFFF"
            BorderThickness="1">
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header with icon -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Border Width="32" Height="32"
                        CornerRadius="6"
                        Margin="0,0,12,0"
                        Visibility="{Binding ShowIcon, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border.Background>
                        <SolidColorBrush Color="{Binding IconBackground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </Border.Background>
                    <Viewbox Width="16" Height="16">
                        <Path Data="{Binding IconData, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              Fill="{Binding IconBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              Stretch="Uniform"/>
                    </Viewbox>
                </Border>
                
                <TextBlock Grid.Column="1"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="{DynamicResource Theme.Brush.TextMuted}"
                           FontSize="13"
                           VerticalAlignment="Center"/>
                
                <ContentPresenter Grid.Column="2"
                                  Content="{Binding Badge, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  VerticalAlignment="Center"/>
            </Grid>
            
            <!-- Value -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                           FontSize="24"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Unit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="{DynamicResource Theme.Brush.TextMuted}"
                           FontSize="14"
                           Margin="6,0,0,2"
                           VerticalAlignment="Bottom"
                           Visibility="{Binding Unit, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullToVisibilityConverter}}"/>
            </StackPanel>
            
            <!-- Subtitle / Trend -->
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        Visibility="{Binding Subtitle, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullToVisibilityConverter}}">
                <Path x:Name="TrendIcon" Width="12" Height="12" Margin="0,0,6,0"
                      Stretch="Uniform" VerticalAlignment="Center"
                      Visibility="{Binding ShowTrend, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <TextBlock Text="{Binding Subtitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="{DynamicResource Theme.Brush.TextMuted}"
                           FontSize="12"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

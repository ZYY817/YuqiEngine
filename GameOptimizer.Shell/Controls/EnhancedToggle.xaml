<UserControl x:Class="GameOptimizer.Shell.Controls.EnhancedToggle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Background="{DynamicResource Theme.Brush.SurfaceMuted}" BorderThickness="1" CornerRadius="12" Padding="18"
            MouseLeftButtonUp="Toggle_Click" Cursor="Hand">
        <Border.BorderBrush>
            <DynamicResource ResourceKey="Theme.Brush.GlassBorder"/>
        </Border.BorderBrush>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title, ElementName=Root}" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="14"/>
                    <!-- 推荐值徽章 - 发光校准点样式 -->
                    <Border x:Name="RecommendBadge" CornerRadius="10" Padding="10,4" Margin="10,0,0,0" Visibility="Collapsed">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#1522C55E" Offset="0"/>
                                <GradientStop Color="#0822C55E" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#4022C55E" Offset="0"/>
                                <GradientStop Color="#2022C55E" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.BorderThickness>1</Border.BorderThickness>
                        <Border.Effect>
                            <DropShadowEffect Color="#22C55E" BlurRadius="6" ShadowDepth="0" Opacity="0.3"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#22C55E" Margin="0,0,6,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#22C55E" BlurRadius="4" ShadowDepth="0" Opacity="0.8"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock x:Name="TxtRecommend" Foreground="#22C55E" FontSize="10" FontFamily="Consolas" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
                    <!-- 风险警告徽章 - 闪烁危险样式 -->
                    <Border x:Name="RiskBadge" CornerRadius="10" Padding="10,4" Margin="8,0,0,0" Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect x:Name="RiskGlow" Color="#EF4444" BlurRadius="8" ShadowDepth="0" Opacity="0.4"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtRiskIcon" Text="⚠" FontSize="10" Margin="0,0,4,0"/>
                            <TextBlock x:Name="TxtRisk" FontSize="10" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
                    <!-- 已修改徽章 -->
                    <Border x:Name="ModifiedBadge" CornerRadius="10" Padding="10,4" Margin="8,0,0,0" Visibility="Collapsed">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#15A78BFA" Offset="0"/>
                                <GradientStop Color="#08A78BFA" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#30A78BFA"/>
                        </Border.BorderBrush>
                        <Border.BorderThickness>1</Border.BorderThickness>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="5" Height="5" Fill="#A78BFA" Margin="0,0,5,0"/>
                            <TextBlock Text="已修改" Foreground="#A78BFA" FontSize="10" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding Description, ElementName=Root}" Foreground="{DynamicResource Theme.Brush.TextMuted}" 
                           FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock x:Name="TxtOriginalValue" Foreground="{DynamicResource Theme.Brush.TextDisabled}" FontSize="12" Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtArrow" Text=" → " Foreground="{DynamicResource Theme.Brush.TextDisabled}" FontSize="12" Visibility="Collapsed"/>
                    <Border Background="{DynamicResource Theme.Brush.CardGradient}" CornerRadius="6" Padding="8,4">
                        <TextBlock x:Name="TxtStatus" Foreground="#22C55E" FontSize="12" FontWeight="SemiBold">
                            <TextBlock.Effect>
                                <DropShadowEffect x:Name="StatusGlow" Color="#22C55E" BlurRadius="6" ShadowDepth="0" Opacity="0.4"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </StackPanel>
            
            <!-- 霓虹风格开关 - Cyberpunk Style -->
            <Grid Grid.Column="1" VerticalAlignment="Center">
                <!-- 外层发光环 -->
                <Border x:Name="ToggleGlowOuter" Width="56" Height="32" CornerRadius="16" Opacity="0.4">
                    <Border.Background>
                        <RadialGradientBrush>
                            <GradientStop Color="#2022C55E" Offset="0"/>
                            <GradientStop Color="#0022C55E" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>
                <!-- 开关主体 - 凹槽样式 -->
                <Border x:Name="ToggleBorder" Width="52" Height="28" CornerRadius="14"
                        Background="{DynamicResource Theme.Brush.ToggleTrackOff}"
                        BorderBrush="{DynamicResource Theme.Brush.ToggleTrackBorder}"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="2" Opacity="0.4" Direction="270"/>
                    </Border.Effect>
                    <!-- 内部发光轨道 -->
                    <Grid>
                        <Border x:Name="ToggleTrackGlow" Height="2" CornerRadius="1" Margin="6,0" VerticalAlignment="Center" Opacity="0.5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#22C55E" Offset="0"/>
                                    <GradientStop Color="#4ADE80" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#22C55E" BlurRadius="4" ShadowDepth="0" Opacity="0.6"/>
                            </Border.Effect>
                        </Border>
                        <!-- 滑块 - 发光药丸 -->
                        <Border x:Name="ToggleThumb" Width="24" Height="24" CornerRadius="12" 
                                HorizontalAlignment="Left" Margin="2,0,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFFFFF" Offset="0"/>
                                    <GradientStop Color="#E8E8E8" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect x:Name="ThumbGlow" Color="#22C55E" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                            </Border.Effect>
                            <!-- 中心光点 -->
                            <Ellipse x:Name="ThumbDot" Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#22C55E" Offset="0"/>
                                        <GradientStop Color="#16A34A" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#22C55E" BlurRadius="4" ShadowDepth="0" Opacity="0.8"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>

<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\GameOptimizer.Core\GameOptimizer.Core.csproj" />
    <ProjectReference Include="..\GameOptimizer.Infrastructure.Windows\GameOptimizer.Infrastructure.Windows.csproj" />
    <ProjectReference Include="..\GameOptimizer.Modules.PerformanceHealth\GameOptimizer.Modules.PerformanceHealth.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 高DPI感知设置 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 应用程序图标 -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- 程序集信息 -->
    <AssemblyName>YuqiEngine</AssemblyName>
    <Product>宇奇引擎</Product>
    <AssemblyTitle>宇奇引擎</AssemblyTitle>
    <Description>游戏性能优化工具</Description>
    <Copyright>© 2026 宇奇</Copyright>
    <Version>0.1.0</Version>
    <FileVersion>0.1.0.0</FileVersion>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <!-- 自定义 Main 入口，禁用 WPF 自动生成的 Main -->
    <StartupObject>GameOptimizer.Shell.Program</StartupObject>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <!-- Why: embedded PDB 减少杀毒误报，且不增加额外文件 -->
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Optimize>true</Optimize>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\GameOptimizer.Modules\ModuleLoader.cs" />
    <Compile Include="..\GameOptimizer.Modules\ModuleDescriptor.cs" />
    <Compile Include="..\GameOptimizer.Modules\ModuleManifest.cs" />
    <Compile Include="..\GameOptimizer.Modules\ModuleManifestProvider.cs" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\yuqi-engine-mark.png" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\tray.ico" />
    <Resource Include="Assets\donate_qrcode.jpg" />
    <Resource Include="Assets\donate_wechat.jpg" />
    <Resource Include="Assets\donate_alipay.jpg" />
    <Resource Include="Assets\Fonts\*.otf" />
    <None Remove="Assets\Fonts\OFL-1.1.txt" />
    <Content Include="Assets\Fonts\OFL-1.1.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\PowerPlans\HighPerformance.pow" />
  </ItemGroup>


<!-- File: GameOptimizer.Shell/Views/SystemAutoRevertWarningDialog.xaml -->
<Window x:Class="GameOptimizer.Shell.Views.SystemAutoRevertWarningDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="系统自动恢复警告"
        Width="600" Height="550"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="SectionTitle">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
            <Setter Property="Margin" Value="0,12,0,8"/>
        </Style>
        
        <Style TargetType="TextBlock" x:Key="ContentText">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>
    </Window.Resources>
    
    <Border Background="{DynamicResource Theme.Brush.DialogBackground}"
            BorderBrush="{DynamicResource Theme.Brush.DialogBorder}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="20" ShadowDepth="0"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- 标题栏 -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource Theme.Brush.DialogHeaderBackground}"
                    CornerRadius="12,12,0,0"
                    Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- 警告图标 -->
                    <TextBlock Grid.Column="0"
                               Text="⚠️"
                               FontSize="24"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    
                    <!-- 标题 -->
                    <TextBlock x:Name="TitleText"
                               Grid.Column="1"
                               Text="系统自动恢复警告"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                               VerticalAlignment="Center"/>
                    
                    <!-- 关闭按钮 -->
                    <Button Grid.Column="2"
                            Content="✕"
                            Width="32" Height="32"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="16"
                            Foreground="{DynamicResource Theme.Brush.TextMuted}"
                            Cursor="Hand"
                            Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Color="#20FFFFFF"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
            
            <!-- 内容区域 -->
            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto"
                          Padding="24,16">
                <StackPanel>
                    <!-- 主要消息 -->
                    <TextBlock x:Name="MessageText"
                               Style="{StaticResource ContentText}"
                               Text="检测到优化被系统自动恢复"/>
                    
                    <!-- 原因列表 -->
                    <TextBlock Text="可能原因："
                               Style="{StaticResource SectionTitle}"/>
                    <StackPanel x:Name="ReasonsPanel" Margin="12,0,0,0">
                        <TextBlock x:Name="Reason1Text" Style="{StaticResource ContentText}"/>
                        <TextBlock x:Name="Reason2Text" Style="{StaticResource ContentText}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="Reason3Text" Style="{StaticResource ContentText}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="Reason4Text" Style="{StaticResource ContentText}" Margin="0,4,0,0"/>
                    </StackPanel>
                    
                    <!-- 被恢复的项目 -->
                    <TextBlock x:Name="RevertedItemsTitle"
                               Text="被恢复的项目："
                               Style="{StaticResource SectionTitle}"/>
                    <Border Background="{DynamicResource Theme.Brush.CardBackground}"
                            BorderBrush="{DynamicResource Theme.Brush.CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            MaxHeight="150">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="RevertedItemsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                                                   Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    
                    <!-- 解决方案 -->
                    <TextBlock x:Name="SolutionTitle"
                               Text="解决方案："
                               Style="{StaticResource SectionTitle}"/>
                    
                    <!-- 自动保护选项 -->
                    <Border Background="#15F59E0B"
                            BorderBrush="#40F59E0B"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0"
                                       x:Name="EnableGuardText"
                                       Text="✅ 启用自动保护（推荐）"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="#F59E0B"/>
                            
                            <TextBlock Grid.Row="1"
                                       x:Name="EnableGuardDescText"
                                       Text="启用优化守护服务，自动监控并重新应用被恢复的优化"
                                       Style="{StaticResource ContentText}"
                                       Margin="0,6,0,0"/>
                            
                            <Button Grid.Row="2"
                                    x:Name="EnableGuardButton"
                                    Content="立即启用守护"
                                    Height="36"
                                    Margin="0,12,0,0"
                                    Background="#F59E0B"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Cursor="Hand"
                                    Click="EnableGuardButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="16,0">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.9"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>
                    
                    <!-- 手动修复选项 -->
                    <Border Background="{DynamicResource Theme.Brush.CardBackground}"
                            BorderBrush="{DynamicResource Theme.Brush.CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <StackPanel>
                            <TextBlock x:Name="ManualFixText"
                                       Text="🔧 手动修复"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource Theme.Brush.TextPrimary}"/>
                            
                            <TextBlock x:Name="ManualFixDescText"
                                       Style="{StaticResource ContentText}"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            
            <!-- 底部按钮 -->
            <Border Grid.Row="2"
                    Background="{DynamicResource Theme.Brush.DialogFooterBackground}"
                    BorderBrush="{DynamicResource Theme.Brush.DialogBorder}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12"
                    Padding="24,16">
                <Grid>
                    <Button x:Name="CloseBtn"
                            Content="我知道了"
                            Width="120"
                            Height="36"
                            HorizontalAlignment="Right"
                            Background="{DynamicResource Theme.Brush.ButtonBackground}"
                            Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource Theme.Brush.ButtonBorder}"
                            FontSize="13"
                            Cursor="Hand"
                            Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Color="#206366F1"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

<!-- File: GameOptimizer.Shell/Views/EsportsModeApplyConfirmDialog.xaml -->
<Window x:Class="GameOptimizer.Shell.Views.EsportsModeApplyConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认应用优化" Width="520" Height="Auto" MinHeight="400" MaxHeight="700"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        SizeToContent="Height" ShowInTaskbar="False">
    
    <Border Background="{DynamicResource Theme.Brush.DialogBackground}"
            CornerRadius="12"
            BorderBrush="{DynamicResource Theme.Brush.Border}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="20" ShadowDepth="0"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- 标题栏 -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource Theme.Brush.DialogHeader}"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Height="56" Margin="24,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="8" 
                                Background="#156366F1" Margin="0,0,12,0">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" 
                                       FontSize="18" Foreground="#6366F1"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText" Text="Esports.ConfirmApply.Title"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Theme.Brush.TextPrimary}"/>
                            <TextBlock x:Name="SubtitleText" Text="Esports.ConfirmApply.Subtitle"
                                       FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource Theme.Brush.TextMuted}"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                            FontSize="12" Width="32" Height="32"
                            HorizontalAlignment="Right"
                            Click="Close_Click"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource Theme.Brush.TextMuted}"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Brush.CardBackgroundHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
            
            <!-- 内容区域 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" 
                          Padding="24,20" MaxHeight="500">
                <StackPanel>
                    <!-- 当前策略 -->
                    <Border Background="{DynamicResource Theme.Brush.CardBackground}"
                            CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="StrategyLabel" Text="Esports.ConfirmApply.CurrentStrategy" FontSize="14"
                                       Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="StrategyText" Text="狂暴模式" 
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Theme.Brush.Accent}"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- 总数统计 -->
                    <Border Background="{DynamicResource Theme.Brush.CardBackgroundAlt}"
                            CornerRadius="10" Padding="20" Margin="0,0,0,16">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="TotalCountLabel" Text="Esports.ConfirmApply.WillApply" FontSize="13"
                                       Foreground="{DynamicResource Theme.Brush.TextMuted}"
                                       HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <TextBlock x:Name="TotalCountText" Text="15" 
                                           FontSize="36" FontWeight="Bold"
                                           Foreground="{DynamicResource Theme.Brush.Accent}"/>
                                <TextBlock x:Name="ItemsCountLabel" Text="Esports.ConfirmApply.ItemsCount" FontSize="18" 
                                           Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                                           VerticalAlignment="Bottom" Margin="4,0,0,6"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- 按风险等级分组 -->
                    <TextBlock x:Name="RiskGroupLabel" Text="Esports.ConfirmApply.RiskGrouping" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                               Margin="0,0,0,10"/>
                    <Border Background="{DynamicResource Theme.Brush.CardBackground}"
                            CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="20" Height="20" CornerRadius="10" 
                                        Background="#204ADE80" Margin="0,0,10,0"/>
                                <TextBlock x:Name="SafeLabel" Grid.Column="1" Text="Esports.ConfirmApply.SafeOptimizations" FontSize="13"
                                           Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" x:Name="SafeCountText" Text="5 项"
                                           FontSize="13" FontWeight="Medium"
                                           Foreground="#4ADE80" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="20" Height="20" CornerRadius="10" 
                                        Background="#20F59E0B" Margin="0,0,10,0"/>
                                <TextBlock x:Name="BalancedLabel" Grid.Column="1" Text="Esports.ConfirmApply.BalancedOptimizations" FontSize="13"
                                           Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" x:Name="BalancedCountText" Text="8 项"
                                           FontSize="13" FontWeight="Medium"
                                           Foreground="#F59E0B" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="20" Height="20" CornerRadius="10" 
                                        Background="#20F43F5E" Margin="0,0,10,0"/>
                                <TextBlock x:Name="ExtremeLabel" Grid.Column="1" Text="Esports.ConfirmApply.ExtremeOptimizations" FontSize="13"
                                           Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" x:Name="ExtremeCountText" Text="2 项"
                                           FontSize="13" FontWeight="Medium"
                                           Foreground="#F43F5E" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    
                    <!-- 按功能类别分组 -->
                    <TextBlock x:Name="CategoryGroupLabel" Text="Esports.ConfirmApply.CategoryGrouping" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                               Margin="0,0,0,10"/>
                    <Border Background="{DynamicResource Theme.Brush.CardBackground}"
                            CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <ItemsControl x:Name="CategoryList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16" Foreground="{DynamicResource Theme.Brush.Accent}"
                                                   Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CategoryName}" 
                                                   FontSize="13"
                                                   Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" FontSize="13" FontWeight="Medium"
                                                   Foreground="{DynamicResource Theme.Brush.Accent}"
                                                   VerticalAlignment="Center">
                                            <Run Text="{Binding Count}"/>
                                            <Run Text=" 项"/>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    
                    <!-- 警告提示（仅当有极限优化时显示） -->
                    <Border x:Name="WarningPanel" Background="#15F43F5E" 
                            BorderBrush="#30F43F5E" BorderThickness="1"
                            CornerRadius="8" Padding="14" Margin="0,0,0,16"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="16" Foreground="#F43F5E"
                                       Margin="0,0,10,0" VerticalAlignment="Top"/>
                            <TextBlock Text="注意：极限优化可能影响系统稳定性，建议在了解风险后使用"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="#F87171" LineHeight="18"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            
            <!-- 底部按钮 -->
            <Border Grid.Row="2" 
                    Background="{DynamicResource Theme.Brush.CardBackground}"
                    BorderBrush="{DynamicResource Theme.Brush.Border}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12"
                    Padding="24,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelBtn" Content="取消" Click="Cancel_Click"
                            Cursor="Hand" Margin="0,0,12,0" Padding="20,10"
                            Background="Transparent" BorderThickness="1"
                            BorderBrush="{DynamicResource Theme.Brush.CardBorder}"
                            Foreground="{DynamicResource Theme.Brush.TextSecondary}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Brush.CardBackgroundHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="ConfirmBtn" Content="确定应用" Click="Confirm_Click"
                            Cursor="Hand" Padding="20,10" Foreground="White" FontWeight="Medium">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#6366F1" Offset="0"/>
                                            <GradientStop Color="#8B5CF6" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

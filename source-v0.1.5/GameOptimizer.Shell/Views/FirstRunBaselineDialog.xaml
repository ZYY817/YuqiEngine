<Window x:Class="GameOptimizer.Shell.Views.FirstRunBaselineDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GameOptimizer.Shell.Controls"
        xmlns:constants="clr-namespace:GameOptimizer.Shell.Constants"
        Title="首次使用说明与安全备份" Width="1080" Height="700" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource Onboarding.Surface}" Foreground="{DynamicResource Onboarding.TextPrimary}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <!-- 首次引导视觉独立于主界面；备份、预检和恢复仍复用原有真实服务。 -->
        <!-- 本页只别名化主题语义色；不在页面里另起一套硬编码调色板。 -->
        <SolidColorBrush x:Key="Onboarding.Surface" Color="{DynamicResource Theme.Background.Primary}"/>
        <SolidColorBrush x:Key="Onboarding.Header" Color="{DynamicResource Theme.Dialog.Header}"/>
        <SolidColorBrush x:Key="Onboarding.Canvas" Color="{DynamicResource Theme.Background.Secondary}"/>
        <SolidColorBrush x:Key="Onboarding.CardBackground" Color="{DynamicResource Theme.Background.CardAlt}"/>
        <SolidColorBrush x:Key="Onboarding.Inset" Color="{DynamicResource Theme.Background.PrimaryAlt}"/>
        <SolidColorBrush x:Key="Onboarding.Line" Color="{DynamicResource Theme.Border.Subtle}"/>
        <SolidColorBrush x:Key="Onboarding.LineStrong" Color="{DynamicResource Theme.Border.Light}"/>
        <SolidColorBrush x:Key="Onboarding.TextPrimary" Color="{DynamicResource Theme.Text.Primary}"/>
        <SolidColorBrush x:Key="Onboarding.TextSecondary" Color="{DynamicResource Theme.Text.Secondary}"/>
        <SolidColorBrush x:Key="Onboarding.TextMuted" Color="{DynamicResource Theme.Text.Muted}"/>
        <SolidColorBrush x:Key="Onboarding.Action" Color="{DynamicResource Theme.Accent.Primary}"/>
        <SolidColorBrush x:Key="Onboarding.ActionHover" Color="{DynamicResource Theme.Accent.BlueLight}"/>
        <SolidColorBrush x:Key="Onboarding.Success" Color="{DynamicResource Theme.Status.Success}"/>
        <SolidColorBrush x:Key="Onboarding.Warning" Color="{DynamicResource Theme.Status.Warning}"/>
        <SolidColorBrush x:Key="Onboarding.Error" Color="{DynamicResource Theme.Status.Error}"/>
        <SolidColorBrush x:Key="Onboarding.SoftBlue" Color="{DynamicResource Theme.Background.CardAlt}"/>
        <SolidColorBrush x:Key="Onboarding.SoftSuccess" Color="{DynamicResource Theme.Background.Surface}"/>
        <SolidColorBrush x:Key="Onboarding.SoftWarning" Color="{DynamicResource Theme.Background.Surface}"/>
        <SolidColorBrush x:Key="Onboarding.SoftError" Color="{DynamicResource Theme.Background.Surface}"/>
        <SolidColorBrush x:Key="Onboarding.ProgressPending" Color="{DynamicResource Theme.Scrollbar.Track}"/>

        <Style x:Key="Onboarding.Kicker" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Onboarding.TextSecondary}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style x:Key="Onboarding.Title" TargetType="TextBlock"><Setter Property="FontSize" Value="31"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{StaticResource Onboarding.TextPrimary}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="40"/></Style>
        <Style x:Key="Onboarding.Body" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="LineHeight" Value="23"/><Setter Property="Foreground" Value="{StaticResource Onboarding.TextSecondary}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style x:Key="Onboarding.Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource Onboarding.CardBackground}"/><Setter Property="BorderBrush" Value="{StaticResource Onboarding.Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{DynamicResource Token.Radius.2xl}"/><Setter Property="Padding" Value="20"/></Style>
        <Style x:Key="Onboarding.SectionCard" TargetType="Border" BasedOn="{StaticResource Onboarding.Card}"/>
        <Style x:Key="Onboarding.IconTile" TargetType="Border"><Setter Property="Width" Value="42"/><Setter Property="Height" Value="42"/><Setter Property="Background" Value="{StaticResource Onboarding.SoftBlue}"/><Setter Property="BorderBrush" Value="{StaticResource Onboarding.LineStrong}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/></Style>
        <Style x:Key="Onboarding.PrimaryButton" TargetType="Button"><Setter Property="MinWidth" Value="136"/><Setter Property="Height" Value="42"/><Setter Property="Padding" Value="18,0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource Onboarding.Action}"/><Setter Property="BorderBrush" Value="{StaticResource Onboarding.Action}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Onboarding.ActionHover}"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource Onboarding.ActionHover}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.84"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource Onboarding.TextPrimary}"/><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Theme.Brush.CardBackgroundMuted}"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.CardBorderSubtle}"/><Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextDisabled}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="Onboarding.SecondaryButton" TargetType="Button" BasedOn="{StaticResource Onboarding.PrimaryButton}"><Setter Property="Foreground" Value="{StaticResource Onboarding.TextPrimary}"/><Setter Property="Background" Value="{StaticResource Onboarding.CardBackground}"/><Setter Property="BorderBrush" Value="{StaticResource Onboarding.LineStrong}"/></Style>
        <Style x:Key="Onboarding.WarningRow" TargetType="Border" BasedOn="{StaticResource Onboarding.Card}"><Setter Property="Background" Value="{StaticResource Onboarding.Inset}"/><Setter Property="Padding" Value="15,11"/><Setter Property="Margin" Value="0,0,0,9"/><Setter Property="CornerRadius" Value="9"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Onboarding.TextPrimary}"/><Setter Property="FontSize" Value="14"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><BulletDecorator><BulletDecorator.Bullet><Border x:Name="Box" Width="20" Height="20" Margin="0,1,12,0" Background="{StaticResource Onboarding.Inset}" BorderBrush="{StaticResource Onboarding.LineStrong}" BorderThickness="1" CornerRadius="4"><TextBlock x:Name="Tick" Text="{x:Static constants:IconGlyphs.Check}" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Border></BulletDecorator.Bullet><ContentPresenter VerticalAlignment="Center"/></BulletDecorator><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource Onboarding.Action}"/><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Onboarding.Action}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Onboarding.TextPrimary}"/><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="Onboarding.ProgressBar" TargetType="ProgressBar"><Setter Property="Height" Value="8"/><Setter Property="Background" Value="{StaticResource Onboarding.ProgressPending}"/><Setter Property="Foreground" Value="{StaticResource Onboarding.Action}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Border Background="{TemplateBinding Background}" CornerRadius="4"><Grid><Border x:Name="PART_Track"/><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="4"/></Grid></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource Yuqi.ScrollBar.Base}"/>
    </Window.Resources>

    <Grid><Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="72"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource Onboarding.Header}" BorderBrush="{StaticResource Onboarding.Line}" BorderThickness="0,0,0,1" Padding="24,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Style="{StaticResource Onboarding.IconTile}" Width="34" Height="34" Margin="0,0,10,0"><TextBlock Text="{x:Static constants:IconGlyphs.Shield}" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource Onboarding.ActionHover}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="首次使用说明与安全备份" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Onboarding.TextPrimary}"/><TextBlock Text="Yuqi Engine" FontSize="11" Foreground="{StaticResource Onboarding.TextMuted}" Margin="0,2,0,0"/></StackPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Border x:Name="ProgressSegment1" Width="26" Height="4" Background="{StaticResource Onboarding.Action}" CornerRadius="2" Margin="2"/><Border x:Name="ProgressSegment2" Width="26" Height="4" Background="{StaticResource Onboarding.ProgressPending}" CornerRadius="2" Margin="2"/><Border x:Name="ProgressSegment3" Width="26" Height="4" Background="{StaticResource Onboarding.ProgressPending}" CornerRadius="2" Margin="2"/><Border x:Name="ProgressSegment4" Width="26" Height="4" Background="{StaticResource Onboarding.ProgressPending}" CornerRadius="2" Margin="2"/><Border x:Name="ProgressSegment5" Width="26" Height="4" Background="{StaticResource Onboarding.ProgressPending}" CornerRadius="2" Margin="2"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Width="32" Height="32" Background="{x:Null}" BorderThickness="0" Click="CloseButton_Click" ToolTip="关闭引导" FocusVisualStyle="{x:Null}"><TextBlock Text="{x:Static constants:IconGlyphs.Close}" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Onboarding.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button></StackPanel></Grid></Border>

        <Grid Grid.Row="1" Background="{StaticResource Onboarding.Canvas}"><controls:PageHeader x:Name="DialogHeader" Visibility="Collapsed" Title="首次使用说明与安全备份" Subtitle="Yuqi Engine"/><TextBlock x:Name="IntroStepIndicatorText" Visibility="Collapsed"/><ScrollViewer x:Name="ContentScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="52,34"><Grid VerticalAlignment="Center">
            <Grid x:Name="WelcomeStepPanel" MaxWidth="920" HorizontalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,52,0"><StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="{x:Static constants:IconGlyphs.Shield}" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Onboarding.ActionHover}" Margin="0,0,9,0"/><TextBlock Text="安全门槛" Style="{StaticResource Onboarding.Kicker}"/></StackPanel><TextBlock Text="欢迎使用宇奇引擎：先建立恢复保障" Style="{StaticResource Onboarding.Title}" Margin="0,0,0,10"/><TextBlock Text="开始前，请完整了解软件的能力边界与恢复方式。首次安全备份只记录真正具备验证与恢复链的范围，不会把未知系统设置伪装成可恢复。" Style="{StaticResource Onboarding.Body}" Margin="0,0,0,22"/><Border Background="{StaticResource Onboarding.SoftError}" BorderBrush="{StaticResource Onboarding.Error}" BorderThickness="1" CornerRadius="{DynamicResource Token.Radius.Xl}" Padding="14" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{x:Static constants:IconGlyphs.Warning}" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Onboarding.Error}" FontSize="16" VerticalAlignment="Top"/><StackPanel Grid.Column="1"><TextBlock Text="当前为测试版本" Foreground="{StaticResource Onboarding.Error}" FontWeight="Bold"/><TextBlock Text="功能、兼容性和恢复链仍在持续验证，可能存在未发现的问题。请在使用任何优化前完成安全备份，并优先在可恢复环境中测试。" Style="{StaticResource Onboarding.Body}" Foreground="{StaticResource Onboarding.TextPrimary}" FontSize="12" Margin="0,4,0,0"/></StackPanel></Grid></Border><Border Style="{StaticResource Onboarding.Card}" Padding="14"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource Onboarding.IconTile}" Width="36" Height="36" Background="{StaticResource Onboarding.SoftSuccess}" BorderBrush="{StaticResource Onboarding.Success}" Margin="0,0,12,0"><TextBlock Text="{x:Static constants:IconGlyphs.ShieldCheck}" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Onboarding.Success}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock VerticalAlignment="Center" Style="{StaticResource Onboarding.Body}"><Run Text="首次说明只在首次运行时展示。" FontWeight="SemiBold" Foreground="{StaticResource Onboarding.TextPrimary}"/><Run Text="之后可在设置中重新打开；暂时跳过不会锁住普通功能。"/></TextBlock></StackPanel></Border></StackPanel><Border Grid.Column="1" Style="{StaticResource Onboarding.Card}" Padding="0" VerticalAlignment="Center"><Grid Height="250"><Border Background="{StaticResource Onboarding.SoftBlue}" CornerRadius="12"/><Border Width="92" Height="92" Background="{StaticResource Onboarding.Inset}" BorderBrush="{StaticResource Onboarding.LineStrong}" BorderThickness="1" CornerRadius="24"><TextBlock Text="{x:Static constants:IconGlyphs.ShieldCheck}" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="{StaticResource Onboarding.ActionHover}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border Width="52" Height="40" Background="{StaticResource Onboarding.CardBackground}" BorderBrush="{StaticResource Onboarding.LineStrong}" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{x:Static constants:IconGlyphs.Folder}" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Onboarding.TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border Width="52" Height="40" Background="{StaticResource Onboarding.CardBackground}" BorderBrush="{StaticResource Onboarding.LineStrong}" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="{x:Static constants:IconGlyphs.Backup}" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Onboarding.TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border></Grid>

            <StackPanel x:Name="BoundaryStepPanel" Visibility="Collapsed" MaxWidth="860" HorizontalAlignment="Center"><StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="{x:Static constants:IconGlyphs.Warning}" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Onboarding.Warning}" Margin="0,0,9,0"/><TextBlock Text="使用边界" Style="{StaticResource Onboarding.Kicker}"/></StackPanel><TextBlock Text="软件不是万能优化" Style="{StaticResource Onboarding.Title}"/><TextBlock Text="不同电脑、驱动、系统版本和历史配置都会影响结果。软件会展示真实能力与恢复条件，但不会承诺所有机器都有相同效果；开始前请自行确认 Windows 系统保护已启用，并手动创建系统还原点。" Style="{StaticResource Onboarding.Body}" FontSize="15" Margin="0,10,0,18"/><Border Style="{StaticResource Onboarding.Card}"><StackPanel><TextBlock Text="先理解，再少量尝试" FontWeight="SemiBold" Foreground="{StaticResource Onboarding.TextPrimary}"/><TextBlock Text="推荐先查看单项说明与风险，再根据自己电脑的实际表现决定是否继续。" Style="{StaticResource Onboarding.Body}" Margin="0,5,0,14"/><Border Background="{StaticResource Onboarding.SoftWarning}" BorderBrush="{StaticResource Onboarding.Warning}" BorderThickness="1" CornerRadius="8" Padding="13"><StackPanel Orientation="Horizontal"><TextBlock Text="{x:Static constants:IconGlyphs.Warning}" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Onboarding.Warning}" Margin="0,1,10,0"/><TextBlock Text="系统优化会受到硬件、系统和历史设置影响；备份是后续排查与恢复的必要依据。" Style="{StaticResource Onboarding.Body}" Foreground="{StaticResource Onboarding.TextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Border></StackPanel></Border></StackPanel>

            <Grid x:Name="AuthorStepPanel" Visibility="Collapsed" MaxWidth="940" HorizontalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="390"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,30,0" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="{x:Static constants:IconGlyphs.Info}" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Onboarding.ActionHover}" Margin="0,0,9,0"/><TextBlock Text="免费与来源" Style="{StaticResource Onboarding.Kicker}"/></StackPanel><TextBlock Text="宇奇引擎是免费软件" Style="{StaticResource Onboarding.Title}"/><TextBlock Text="软件不收费，也没有付费专业版。请从作者发布渠道获取，遇到收费售卖或诱导付款时请直接退款或举报。" Style="{StaticResource Onboarding.Body}" FontSize="15" Margin="0,10,0,20"/><Border Style="{StaticResource Onboarding.Card}" Padding="16"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource Onboarding.IconTile}" Width="40" Height="40" Margin="0,0,12,0"><TextBlock Text="{x:Static constants:IconGlyphs.User}" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Onboarding.ActionHover}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="作者：智宇 / 宇奇" FontWeight="SemiBold" Foreground="{StaticResource Onboarding.TextPrimary}"/><TextBlock Text="转发时请保留软件名称、作者信息和风险说明。" Style="{StaticResource Onboarding.Body}" FontSize="12"/></StackPanel></StackPanel></Border><Button Content="打开作者与支持页" Style="{StaticResource Onboarding.SecondaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OpenAuthorSupportButton_Click"/></StackPanel><Border Grid.Column="1" Style="{StaticResource Onboarding.Card}" Padding="18"><StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,13"><TextBlock Text="{x:Static constants:IconGlyphs.Heart}" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Onboarding.Success}" Margin="0,1,10,0"/><StackPanel><TextBlock Text="自愿支持作者" FontWeight="SemiBold" Foreground="{StaticResource Onboarding.TextPrimary}"/><TextBlock Text="赞赏完全自愿，不影响任何功能。点击图片可打开清晰大图。" Style="{StaticResource Onboarding.Body}" FontSize="11" LineHeight="17"/></StackPanel></StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,8,0"><Border Background="White" BorderBrush="{StaticResource Onboarding.LineStrong}" BorderThickness="1" CornerRadius="8" Padding="4"><Image Source="pack://application:,,,/Assets/donate_wechat.jpg" Height="142" Stretch="Uniform" Cursor="Hand" ToolTip="点击放大微信赞赏码" MouseLeftButtonDown="WechatDonationImage_MouseLeftButtonDown"/></Border><TextBlock Text="微信赞赏" Foreground="{StaticResource Onboarding.TextPrimary}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/><TextBlock Text="查看清晰大图" Style="{StaticResource Onboarding.Body}" FontSize="11" HorizontalAlignment="Center"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><Border Background="White" BorderBrush="{StaticResource Onboarding.LineStrong}" BorderThickness="1" CornerRadius="8" Padding="4"><Image Source="pack://application:,,,/Assets/donate_alipay.jpg" Height="142" Stretch="Uniform" Cursor="Hand" ToolTip="点击放大支付宝赞赏码" MouseLeftButtonDown="AlipayDonationImage_MouseLeftButtonDown"/></Border><TextBlock Text="支付宝赞赏" Foreground="{StaticResource Onboarding.TextPrimary}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/><TextBlock Text="查看清晰大图" Style="{StaticResource Onboarding.Body}" FontSize="11" HorizontalAlignment="Center"/></StackPanel></Grid></StackPanel></Border></Grid>

            <StackPanel x:Name="RiskStepPanel" Visibility="Collapsed" MaxWidth="860" HorizontalAlignment="Center"><StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="{x:Static constants:IconGlyphs.Warning}" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Onboarding.Warning}" Margin="0,0,9,0"/><TextBlock Text="开始前确认" Style="{StaticResource Onboarding.Kicker}"/></StackPanel><TextBlock Text="请确认你理解这个边界" Style="{StaticResource Onboarding.Title}"/><TextBlock Text="接下来将进入首次全量安全备份。请先停留阅读 5 秒，确认后才可以继续。" Style="{StaticResource Onboarding.Body}" FontSize="15" Margin="0,10,0,14"/><Border Background="{StaticResource Onboarding.Inset}" BorderBrush="{StaticResource Onboarding.LineStrong}" BorderThickness="1" CornerRadius="18" Padding="11,7" HorizontalAlignment="Left" Margin="0,0,0,12"><StackPanel Orientation="Horizontal"><TextBlock Text="{x:Static constants:IconGlyphs.Clock}" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Onboarding.TextMuted}" Margin="0,0,8,0"/><TextBlock x:Name="RiskCountdownText" Text="请先完整阅读，5s 后可继续" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Onboarding.TextSecondary}"/></StackPanel></Border><Border Style="{StaticResource Onboarding.WarningRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{x:Static constants:IconGlyphs.Warning}" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Onboarding.Warning}"/><TextBlock Grid.Column="1" Text="软件只提供可选调整与风险提示，效果取决于设备、系统、驱动和使用场景。" Foreground="{StaticResource Onboarding.TextPrimary}" FontWeight="SemiBold" TextWrapping="Wrap"/></Grid></Border><Border Style="{StaticResource Onboarding.WarningRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{x:Static constants:IconGlyphs.Warning}" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Onboarding.Warning}"/><TextBlock Grid.Column="1" Text="曾被其他工具改过配置、驱动、策略或电源计划的系统，部分恢复结果需要人工确认。" Foreground="{StaticResource Onboarding.TextPrimary}" FontWeight="SemiBold" TextWrapping="Wrap"/></Grid></Border><Border Style="{StaticResource Onboarding.WarningRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{x:Static constants:IconGlyphs.Shield}" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Onboarding.Success}"/><TextBlock Grid.Column="1" Text="首次备份用于在后续优化出现异常时提供核对和受控恢复的依据；同时请自行确认 Windows 系统保护已启用，并手动创建系统还原点。" Foreground="{StaticResource Onboarding.TextPrimary}" FontWeight="SemiBold" TextWrapping="Wrap"/></Grid></Border><Border Style="{StaticResource Onboarding.WarningRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{x:Static constants:IconGlyphs.Warning}" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Onboarding.Error}"/><TextBlock Grid.Column="1" Text="如果你的 Windows 系统经过精简、魔改或第三方深度修改（精简版镜像、移除系统组件、非官方定制），本软件的检测、优化与恢复结果可能不可靠，甚至引发更大的问题；这种情况下请先在可恢复环境中验证，谨慎使用。" Foreground="{StaticResource Onboarding.TextPrimary}" FontWeight="SemiBold" TextWrapping="Wrap"/></Grid></Border><Border Background="{StaticResource Onboarding.SoftWarning}" BorderBrush="{StaticResource Onboarding.Warning}" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,4,0,0"><CheckBox x:Name="RiskAcknowledgementCheckBox" Checked="RiskAcknowledgementCheckBox_Changed" Unchecked="RiskAcknowledgementCheckBox_Changed"><StackPanel><TextBlock Text="我已阅读并理解软件边界与备份说明" FontWeight="SemiBold"/><TextBlock Text="勾选并完成倒计时后，才能继续创建首次安全备份。" Style="{StaticResource Onboarding.Body}" FontSize="12"/></StackPanel></CheckBox></Border></StackPanel>

            <StackPanel x:Name="BackupStepPanel" Visibility="Collapsed" MaxWidth="900" HorizontalAlignment="Center"><StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="{x:Static constants:IconGlyphs.Backup}" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Onboarding.ActionHover}" Margin="0,0,9,0"/><TextBlock Text="创建备份" Style="{StaticResource Onboarding.Kicker}"/></StackPanel><TextBlock Text="现在创建首次全量安全备份" Style="{StaticResource Onboarding.Title}"/><TextBlock Text="创建完成后可在备份管理中查看、验证，并通过受控流程恢复。它不能替代 Windows 系统还原点：请在开始前自行创建一个还原点。" Style="{StaticResource Onboarding.Body}" FontSize="15" Margin="0,10,0,18"/><Border Style="{StaticResource Onboarding.Card}" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="保存位置" Style="{StaticResource Onboarding.Body}" FontSize="12"/><TextBlock x:Name="BackupPathText" Text="正在读取安全备份目录…" Foreground="{StaticResource Onboarding.TextPrimary}" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,3" TextWrapping="Wrap"/><TextBlock Text="创建前将实际检查目录、磁盘空间和写入能力。" Style="{StaticResource Onboarding.Body}" FontSize="12"/></StackPanel><Button Grid.Column="1" Content="打开位置" Style="{StaticResource Onboarding.SecondaryButton}" VerticalAlignment="Center" Margin="18,0,0,0" Click="OpenBackupFolderButton_Click"/></Grid></Border><Border Style="{StaticResource Onboarding.Card}"><StackPanel><TextBlock Text="首次安全备份会保护这些范围" Foreground="{StaticResource Onboarding.TextPrimary}" FontWeight="SemiBold"/><TextBlock Text="只有通过真实预检和收集器验证的范围，才会被标记为可恢复。" Style="{StaticResource Onboarding.Body}" FontSize="12" Margin="0,3,0,12"/><Border Background="{StaticResource Onboarding.Inset}" BorderBrush="{StaticResource Onboarding.Line}" BorderThickness="1" CornerRadius="8"><StackPanel><Border BorderBrush="{StaticResource Onboarding.Line}" BorderThickness="0,0,0,1" Padding="14,10"><StackPanel Orientation="Horizontal"><TextBlock Text="{x:Static constants:IconGlyphs.RestorePoint}" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Onboarding.ActionHover}" Margin="0,1,10,0"/><StackPanel><TextBlock Text="系统还原与驱动信息" Foreground="{StaticResource Onboarding.TextPrimary}" FontWeight="SemiBold"/><TextBlock Text="用于显示或驱动异常时的状态核对；仍无法恢复时，请从设备厂商渠道重新安装驱动。" Style="{StaticResource Onboarding.Body}" FontSize="12"/></StackPanel></StackPanel></Border><Border BorderBrush="{StaticResource Onboarding.Line}" BorderThickness="0,0,0,1" Padding="14,10"><StackPanel Orientation="Horizontal"><TextBlock Text="{x:Static constants:IconGlyphs.Settings}" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Onboarding.ActionHover}" Margin="0,1,10,0"/><StackPanel><TextBlock Text="软件设置与优化记录" Foreground="{StaticResource Onboarding.TextPrimary}" FontWeight="SemiBold"/><TextBlock Text="按现有执行链回读验证的应用配置与恢复记录。" Style="{StaticResource Onboarding.Body}" FontSize="12"/></StackPanel></StackPanel></Border><Border Padding="14,10"><StackPanel Orientation="Horizontal"><TextBlock Text="{x:Static constants:IconGlyphs.Registry}" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Onboarding.ActionHover}" Margin="0,1,10,0"/><StackPanel><TextBlock Text="系统设置与受控注册表" Foreground="{StaticResource Onboarding.TextPrimary}" FontWeight="SemiBold"/><TextBlock Text="没有安全恢复链的项目不会被伪造成一键恢复；电源异常时请切回优化前的原电源计划。若没有可用备份或还原依据且系统仍无法恢复，可能只能重装系统。" Style="{StaticResource Onboarding.Body}" FontSize="12"/></StackPanel></StackPanel></Border></StackPanel></Border></StackPanel></Border><Expander Header="当前基线验证详情" Margin="0,12,0,0" Foreground="{StaticResource Onboarding.TextSecondary}"><Border Style="{StaticResource Onboarding.Card}" Margin="0,8,0,0"><StackPanel><TextBlock x:Name="ManifestPackageText" Style="{StaticResource Onboarding.Body}"/><TextBlock x:Name="ManifestHashText" Style="{StaticResource Onboarding.Body}" TextWrapping="Wrap"/><TextBlock x:Name="ManifestIntegrityText" Style="{StaticResource Onboarding.Body}"/><TextBlock x:Name="ManifestRecoverabilityText" Style="{StaticResource Onboarding.Body}"/><controls:StatusBadge x:Name="GateStatusBadge" Text="读取中" Status="Loading" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel></Border></Expander></StackPanel>

            <StackPanel x:Name="RunningPanel" Visibility="Collapsed" MaxWidth="820" HorizontalAlignment="Center"><TextBlock Text="正在创建首次全量安全备份" Style="{StaticResource Onboarding.Title}"/><TextBlock Text="只有收集、完整性校验和恢复能力检查都通过后，才会标记为完成。" Style="{StaticResource Onboarding.Body}" FontSize="15" Margin="0,10,0,20"/><Border Style="{StaticResource Onboarding.Card}"><StackPanel><TextBlock x:Name="StepTextBlock" Foreground="{StaticResource Onboarding.TextPrimary}" FontWeight="SemiBold"/><ProgressBar x:Name="MainProgressBar" Style="{StaticResource Onboarding.ProgressBar}" Minimum="0" Maximum="100" Value="0" IsIndeterminate="True" Margin="0,14,0,10"/><TextBlock x:Name="StatusTextBlock" Style="{StaticResource Onboarding.Body}"/><ListBox x:Name="LogListBox" MinHeight="180" MaxHeight="270" Margin="0,16,0,0" Background="{StaticResource Onboarding.Inset}" BorderBrush="{StaticResource Onboarding.Line}" BorderThickness="1" Foreground="{StaticResource Onboarding.TextSecondary}"/></StackPanel></Border></StackPanel>
            <StackPanel x:Name="ManualPanel" Visibility="Collapsed" MaxWidth="820" HorizontalAlignment="Center"><TextBlock Text="需要补充系统级保护" Style="{StaticResource Onboarding.Title}"/><TextBlock Text="首次备份暂时停在安全门禁。完成提示的人工处理后可以重新检测。" Style="{StaticResource Onboarding.Body}" FontSize="15" Margin="0,10,0,20"/><Border Style="{StaticResource Onboarding.Card}" Background="{StaticResource Onboarding.SoftWarning}" BorderBrush="{StaticResource Onboarding.Warning}"><StackPanel><TextBlock x:Name="ManualTitleText" Foreground="{StaticResource Onboarding.Warning}" FontWeight="Bold" FontSize="18"/><TextBlock x:Name="ManualReasonTextBlock" Style="{StaticResource Onboarding.Body}" Foreground="{StaticResource Onboarding.TextPrimary}" Margin="0,8,0,0"/></StackPanel></Border></StackPanel>
            <StackPanel x:Name="FailedPanel" Visibility="Collapsed" MaxWidth="820" HorizontalAlignment="Center"><TextBlock Text="暂时无法创建首次安全备份" Style="{StaticResource Onboarding.Title}"/><TextBlock Text="原有备份不会被覆盖。请先处理真实失败原因，再重新尝试。" Style="{StaticResource Onboarding.Body}" FontSize="15" Margin="0,10,0,20"/><Border Style="{StaticResource Onboarding.Card}" Background="{StaticResource Onboarding.SoftError}" BorderBrush="{StaticResource Onboarding.Error}"><StackPanel><TextBlock x:Name="FailedTitleText" Foreground="{StaticResource Onboarding.Error}" FontWeight="Bold"/><TextBlock x:Name="FailedReasonTextBlock" Style="{StaticResource Onboarding.Body}" Foreground="{StaticResource Onboarding.TextPrimary}" Margin="0,5,0,0"/></StackPanel></Border></StackPanel>
            <StackPanel x:Name="CompletedPanel" Visibility="Collapsed" MaxWidth="820" HorizontalAlignment="Center"><TextBlock Text="首次安全备份已完成" Style="{StaticResource Onboarding.Title}"/><TextBlock Text="恢复依据已经通过校验；后续恢复仍会再次确认和检查。" Style="{StaticResource Onboarding.Body}" FontSize="15" Margin="0,10,0,20"/><Border Style="{StaticResource Onboarding.Card}" Background="{StaticResource Onboarding.SoftSuccess}" BorderBrush="{StaticResource Onboarding.Success}"><StackPanel><TextBlock x:Name="CompletedTitleText" Foreground="{StaticResource Onboarding.Success}" FontWeight="Bold" FontSize="18"/><TextBlock x:Name="CompletedDetailTextBlock" Style="{StaticResource Onboarding.Body}" Foreground="{StaticResource Onboarding.TextPrimary}" Margin="0,5,0,0"/></StackPanel></Border></StackPanel>
        </Grid></ScrollViewer></Grid>

        <Border Grid.Row="2" Background="{StaticResource Onboarding.Header}" BorderBrush="{StaticResource Onboarding.Line}" BorderThickness="0,1,0,0" Padding="28,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="FooterHintText" VerticalAlignment="Center" Foreground="{StaticResource Onboarding.TextMuted}" FontSize="13" TextWrapping="Wrap" Margin="0,0,16,0"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="IntroBackBtn" Content="←　返回" Style="{StaticResource Onboarding.SecondaryButton}" Margin="0,0,10,0" Visibility="Collapsed" Click="IntroBackBtn_Click"/><Button x:Name="IntroExitBtn" Content="暂时跳过" Style="{StaticResource Onboarding.SecondaryButton}" Margin="0,0,10,0" Click="IntroExitBtn_Click"/><Button x:Name="IntroNextBtn" Content="→　继续" Style="{StaticResource Onboarding.PrimaryButton}" Margin="0,0,10,0" Click="IntroNextBtn_Click"/><Button x:Name="StartBackupBtn" Content="→　开始创建备份" Style="{StaticResource Onboarding.PrimaryButton}" Visibility="Collapsed" Click="StartBackupBtn_Click"/><Button x:Name="ManualOpenSettingsBtn" Content="打开系统保护" Style="{StaticResource Onboarding.SecondaryButton}" Margin="0,0,10,0" Visibility="Collapsed" Click="ManualOpenSettingsBtn_Click"/><Button x:Name="ManualRecheckBtn" Content="完成后重新检测" Style="{StaticResource Onboarding.PrimaryButton}" Margin="0,0,10,0" Visibility="Collapsed" Click="ManualRecheckBtn_Click"/><Button x:Name="ManualExitBtn" Content="确认风险并跳过" Style="{StaticResource Onboarding.SecondaryButton}" Visibility="Collapsed" Click="ManualExitBtn_Click"/><Button x:Name="FailedRetryBtn" Content="→　重新尝试备份" Style="{StaticResource Onboarding.PrimaryButton}" Margin="0,0,10,0" Visibility="Collapsed" Click="FailedRetryBtn_Click"/><Button x:Name="FailedExitBtn" Content="确认风险并跳过" Style="{StaticResource Onboarding.SecondaryButton}" Visibility="Collapsed" Click="FailedExitBtn_Click"/><Button x:Name="CompletedOpenSettingsBtn" Content="打开系统保护" Style="{StaticResource Onboarding.SecondaryButton}" Margin="0,0,10,0" Visibility="Collapsed" Click="CompletedOpenSettingsBtn_Click"/><Button x:Name="CompletedEnterBtn" Content="进入软件" Style="{StaticResource Onboarding.PrimaryButton}" Visibility="Collapsed" Click="CompletedEnterBtn_Click"/></StackPanel></Grid></Border>
    </Grid>
</Window>




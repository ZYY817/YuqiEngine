<Window x:Class="GameOptimizer.Shell.Views.OperationInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="功能说明" Width="560" Height="480"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        SizeToContent="Height" MaxHeight="600">
    <Border Background="{DynamicResource Theme.Brush.BackgroundSecondary}" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource Theme.Brush.BorderSubtle}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.6" Color="{DynamicResource Theme.Color.Shadow}"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="{DynamicResource Theme.Brush.SurfaceMuted}" CornerRadius="16,16,0,0" Padding="20,14" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TypeIcon" Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,10,0" Foreground="{DynamicResource Theme.Brush.TextPrimaryAlt}"/>
                        <TextBlock x:Name="DialogTitle" Text="功能说明" Foreground="{DynamicResource Theme.Brush.TextPrimaryAlt}" FontSize="15" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" Click="Close_Click"
                            Background="Transparent" Foreground="{DynamicResource Theme.Brush.TextMuted}" BorderThickness="0"
                            Width="28" Height="28" Cursor="Hand" FontSize="14"/>
                </Grid>
            </Border>
            
            <!-- 内容区域 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                <StackPanel>
                    <!-- 优化项名称 -->
                    <Border Background="{DynamicResource Theme.Brush.RowBackground}" CornerRadius="10" Padding="16,12" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock x:Name="OptimizationTitle" Text="优化项名称" Foreground="{DynamicResource Theme.Brush.TextPrimaryAlt}" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock x:Name="OptimizationDesc" Text="优化项描述" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- 操作类型标签 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border x:Name="TypeBadge" Background="{DynamicResource Theme.Brush.CardBackgroundAlt}" CornerRadius="6" Padding="10,5" BorderBrush="#4060A5FA" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TypeBadgeIcon" Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#60A5FA"/>
                                <TextBlock x:Name="TypeBadgeText" Text="系统操作" Foreground="#60A5FA" FontSize="11" FontWeight="Medium" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    
                    <!-- 目标信息 -->
                    <TextBlock x:Name="LblTargetInfo" Text="🎯 这项功能会改什么" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="13" FontWeight="Medium" Margin="0,0,0,8"/>
                    <Border Background="{DynamicResource Theme.Brush.PanelBackground}" CornerRadius="8" Padding="14,12" BorderBrush="{DynamicResource Theme.Brush.Border}" BorderThickness="1" Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" x:Name="LblTargetName" Text="项目：" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="12"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TargetNameText" Text="-" Foreground="#4ADE80" FontSize="11" 
                                       FontFamily="Consolas" TextWrapping="Wrap"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" x:Name="LblTargetValue" Text="建议：" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="12" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TargetValueText" Text="-" Foreground="#60A5FA" FontSize="11" 
                                       FontFamily="Consolas" Margin="0,6,0,0"/>
                        </Grid>
                    </Border>
                    
                    <!-- 手动操作入口 -->
                    <TextBlock x:Name="ManualPathLabel" Text="📍 系统入口（可选）" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="13" FontWeight="Medium" Margin="0,0,0,8"/>
                    <Border x:Name="ManualPathSection" Background="{DynamicResource Theme.Brush.SurfaceMuted}" CornerRadius="8" Padding="14,12" BorderBrush="{DynamicResource Theme.Brush.Border}" BorderThickness="1" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ManualPathText" Text="services.msc" Foreground="#FBBF24" FontSize="12" FontFamily="Consolas" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- 复制/打开按钮 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Background="{DynamicResource Theme.Brush.Border}" CornerRadius="6" Padding="10,6" Cursor="Hand" MouseLeftButtonUp="CopyPath_Click" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄" FontSize="11"/>
                                <TextBlock x:Name="CopyBtnText" Text="复制入口" FontSize="12" Foreground="{DynamicResource Theme.Brush.TextSecondary}" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="OpenBtn" Background="{DynamicResource Theme.Brush.Border}" CornerRadius="6" Padding="10,6" Cursor="Hand" MouseLeftButtonUp="OpenPath_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🚀" FontSize="11"/>
                                <TextBlock Text="打开系统设置" FontSize="12" Foreground="{DynamicResource Theme.Brush.TextSecondary}" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    
                    <!-- 手动操作步骤 -->
                    <Border Background="{DynamicResource Theme.Brush.CardBackgroundAlt}" CornerRadius="8" Padding="14,12" BorderBrush="{DynamicResource Theme.Brush.Border}" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="💡" FontSize="12"/>
                                <TextBlock x:Name="LblManualSteps" Text="手动操作方法（可选）" Foreground="#60A5FA" FontSize="13" FontWeight="Medium" Margin="6,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="ManualStepsText" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="11" TextWrapping="Wrap" LineHeight="20"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            
            <!-- 底部按钮 -->
            <Border Grid.Row="2" Background="{DynamicResource Theme.Brush.SurfaceMuted}" CornerRadius="0,0,16,16" Padding="20,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ActionBtn" Click="Action_Click" Cursor="Hand"
                            Background="#2563EB" Foreground="White" BorderThickness="0"
                            Padding="16,8" FontSize="12">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="ActionIcon" Text="🚀" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ActionText" Text="打开管理工具" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#3B82F6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="CloseBtn" Click="Close_Click" Cursor="Hand" Margin="10,0,0,0"
                            Background="Transparent" Foreground="{DynamicResource Theme.Brush.TextSecondary}" BorderThickness="1" BorderBrush="{DynamicResource Theme.Brush.BorderLight}"
                            Padding="16,8" FontSize="12">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <TextBlock x:Name="CloseBtnText" Text="关闭" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="12"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Brush.CardBackgroundHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

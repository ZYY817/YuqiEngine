<UserControl x:Class="GameOptimizer.Shell.Views.MasterModuleTemplate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GameOptimizer.Shell.Controls"
             Background="{DynamicResource Theme.Brush.Background}"
             FontFamily="{DynamicResource Token.FontFamily.Body}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>
        <!-- 本地资源引用主题资源，便于动态切换 -->
        <SolidColorBrush x:Key="BgBase" Color="{DynamicResource Theme.Background.Primary}"/>
        <SolidColorBrush x:Key="BgSurface" Color="{DynamicResource Theme.Background.Secondary}"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="{DynamicResource Theme.Border.Subtle}"/>
        <SolidColorBrush x:Key="TextPrimary" Color="{DynamicResource Theme.Text.PrimaryAlt}"/>
        <SolidColorBrush x:Key="TextSecondary" Color="{DynamicResource Theme.Text.Secondary}"/>
        <SolidColorBrush x:Key="TextMuted" Color="{DynamicResource Theme.Text.Muted}"/>
        <SolidColorBrush x:Key="AccentBlue" Color="{DynamicResource Theme.Accent.BlueLight}"/>
        <SolidColorBrush x:Key="AccentBlueDark" Color="{DynamicResource Theme.Accent.BlueDark}"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="{DynamicResource Theme.Status.SuccessAlt}"/>
        <SolidColorBrush x:Key="DangerRed" Color="{DynamicResource Theme.Status.ErrorAlt}"/>
        <SolidColorBrush x:Key="WarningAmber" Color="{DynamicResource Theme.Status.WarningAlt}"/>
        
        <Style x:Key="SegmentedButtonStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="12,6">
                            <ContentPresenter x:Name="ContentHost" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Brush.NavItemSelected}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Theme.Brush.NavItemSelectedBorder}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource Theme.Color.BorderSubtle}"/>
                                    </Setter.Value>
                                </Setter>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="IOSToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="51"/>
            <Setter Property="Height" Value="31"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Token.FocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <!-- Track Background -->
                            <Border x:Name="Track" 
                                    Width="51" Height="31" 
                                    CornerRadius="15.5"
                                    BorderThickness="0">
                                <Border.Background>
                                    <SolidColorBrush x:Name="TrackBrush" Color="#39393D"/>
                                </Border.Background>
                            </Border>
                            
                            <!-- Thumb Slider -->
                            <Border x:Name="Thumb" 
                                    Width="27" Height="27" 
                                    CornerRadius="13.5"
                                    Background="White"
                                    HorizontalAlignment="Left"
                                    Margin="2,0,0,0">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTransform" X="0"/>
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.2" Color="#000"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- Background Color Animation -->
                                            <ColorAnimation Storyboard.TargetName="TrackBrush"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#2E88F2"
                                                            Duration="0:0:0.25">
                                                <ColorAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                            <!-- Thumb Position Animation -->
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="20"
                                                             Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- Background Color Animation (Reverse) -->
                                            <ColorAnimation Storyboard.TargetName="TrackBrush"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#39393D"
                                                            Duration="0:0:0.25">
                                                <ColorAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                            <!-- Thumb Position Animation (Reverse) -->
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="0"
                                                             Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <!-- Why: 原页面内嵌 Hero 光晕 Border 只 RowSpan 头部三行，加载期内容行为空时
         光晕被压缩成色块、切页时又整层消失（背景忽有忽无）。氛围光已上移为
         MainWindow 内容区的常驻底层，所有页面共享同一背景层。 -->
    <Grid x:Name="PageLayout" Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 头部：标题 + 健康指数卡片 -->
        <Grid x:Name="HeroGrid" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="ModuleTopbar" Grid.Row="0" Grid.ColumnSpan="2" Margin="2,0,2,14" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="ModuleAccentMarker" Width="3" Height="18" CornerRadius="2" Margin="0,0,10,0"/>
                    <TextBlock x:Name="ModuleTopbarTitle" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{DynamicResource Theme.Brush.TextPrimary}"/>
                    <Border Width="1" Height="14" Margin="12,0" Background="{DynamicResource Theme.Brush.Border}"/>
                    <TextBlock x:Name="ModuleTopbarSubtitle" VerticalAlignment="Center"
                               Foreground="{DynamicResource Theme.Brush.TextMuted}"/>
                </StackPanel>
                <Border x:Name="ModuleSpecChip" Grid.Column="1" CornerRadius="14" Padding="12,6"
                        BorderThickness="1" VerticalAlignment="Center">
                    <TextBlock x:Name="ModuleSpecChipText" FontWeight="SemiBold"/>
                </Border>
            </Grid>
            
            <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="模块标题" Foreground="{DynamicResource Theme.Brush.TextPrimary}" 
                           FontSize="26" FontWeight="Bold" FontFamily="{DynamicResource Token.FontFamily.Display}"/>
                <TextBlock x:Name="SubtitleText" Text="模块描述" Foreground="{DynamicResource Theme.Brush.TextMuted}" 
                           FontSize="{DynamicResource Token.FontSize.ModuleSubtitle}" Margin="0,8,0,0"/>
            </StackPanel>
            
            <Border x:Name="HealthCard" Grid.Row="1" Grid.Column="1" CornerRadius="16" Padding="20,16" BorderBrush="{DynamicResource Theme.Brush.CardBorder}" BorderThickness="1"
                    Background="{DynamicResource Theme.Brush.CardBackground}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Grid Grid.Column="0" Width="72" Height="72">
                        <Ellipse Width="68" Height="68" StrokeThickness="6" Stroke="{DynamicResource Theme.Brush.ModuleProgressTrack}"/>
                        <Canvas Width="68" Height="68">
                            <Ellipse x:Name="ProgressRing" Width="68" Height="68" StrokeThickness="6" 
                                     StrokeDashArray="0 100" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5"
                                     Stroke="{DynamicResource Theme.Brush.ModuleProgressArc}">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-90"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Canvas>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="AppliedCountRing" Text="0" Foreground="{DynamicResource Theme.Brush.TextPrimary}" 
                                           FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="/" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="{DynamicResource Token.FontSize.ModuleStatus}"
                                           VerticalAlignment="Bottom" Margin="1,0,1,2"/>
                                <TextBlock x:Name="TotalCountRing" Text="0" Foreground="{DynamicResource Theme.Brush.TextMuted}" 
                                           FontSize="{DynamicResource Token.FontSize.ModuleStatus}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock x:Name="OptCountLabel" Text="优化数量" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="{DynamicResource Token.FontSize.ModuleStatus}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource Theme.Brush.Error}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ExtremeCountText" Text="0 高风险" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="{DynamicResource Token.FontSize.ModuleStatus}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource Theme.Brush.Warning}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="BalancedCountText" Text="0 中风险" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="{DynamicResource Token.FontSize.ModuleStatus}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource Theme.Brush.Success}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SafeCountText" Text="0 安全" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="{DynamicResource Token.FontSize.ModuleStatus}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 控制栏：筛选 + 操作按钮 -->
        <Border x:Name="ControlBarCard" Grid.Row="1" Margin="0,24,0,0"
                Background="Transparent" BorderThickness="0" CornerRadius="16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <Border x:Name="FilterSurface" Grid.Column="0" Background="{DynamicResource Theme.Brush.SurfaceMuted}" CornerRadius="8" Padding="4" BorderBrush="{DynamicResource Theme.Brush.Border}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="FilterAll" Style="{StaticResource SegmentedButtonStyle}" IsChecked="True" Checked="Filter_Changed" GroupName="Filter">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="FilterAllText" Text="全部" FontSize="{DynamicResource Token.FontSize.ModuleStatus}" Foreground="{DynamicResource Theme.Brush.TextPrimary}"/>
                            <TextBlock x:Name="FilterAllCountText" Visibility="Collapsed" Margin="5,0,0,0" FontSize="{DynamicResource Token.FontSize.ModuleStatus}" Foreground="{DynamicResource Theme.Brush.TextMuted}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="FilterExtreme" Style="{StaticResource SegmentedButtonStyle}" Checked="Filter_Changed" GroupName="Filter">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#F87171" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="FilterExtremeText" Text="高风险" FontSize="{DynamicResource Token.FontSize.ModuleStatus}" Foreground="{DynamicResource Theme.Brush.TextSecondary}"/>
                            <TextBlock x:Name="FilterExtremeCountText" Visibility="Collapsed" Margin="5,0,0,0" FontSize="{DynamicResource Token.FontSize.ModuleStatus}" Foreground="{DynamicResource Theme.Brush.TextMuted}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="FilterBalanced" Style="{StaticResource SegmentedButtonStyle}" Checked="Filter_Changed" GroupName="Filter">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#FBBF24" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="FilterBalancedText" Text="中等" FontSize="{DynamicResource Token.FontSize.ModuleStatus}" Foreground="{DynamicResource Theme.Brush.TextSecondary}"/>
                            <TextBlock x:Name="FilterBalancedCountText" Visibility="Collapsed" Margin="5,0,0,0" FontSize="{DynamicResource Token.FontSize.ModuleStatus}" Foreground="{DynamicResource Theme.Brush.TextMuted}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="FilterSafe" Style="{StaticResource SegmentedButtonStyle}" Checked="Filter_Changed" GroupName="Filter">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#4ADE80" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="FilterSafeText" Text="安全" FontSize="{DynamicResource Token.FontSize.ModuleStatus}" Foreground="{DynamicResource Theme.Brush.TextSecondary}"/>
                            <TextBlock x:Name="FilterSafeCountText" Visibility="Collapsed" Margin="5,0,0,0" FontSize="{DynamicResource Token.FontSize.ModuleStatus}" Foreground="{DynamicResource Theme.Brush.TextMuted}"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0">
                <TextBlock x:Name="CategoryFilterLabel" Text="分类" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="{DynamicResource Token.FontSize.ModuleStatus}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CategoryFilterComboBox"
                          MinWidth="158"
                          MaxWidth="260"
                          Padding="8,4"
                          Background="{DynamicResource Theme.Brush.SurfaceMuted}"
                          Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                          BorderBrush="{DynamicResource Theme.Brush.Border}"
                          BorderThickness="1"
                          PreviewMouseLeftButtonDown="CategoryFilterComboBox_PreviewMouseLeftButtonDown"
                          SelectionChanged="CategoryFilterComboBox_SelectionChanged"
                          AutomationProperties.Name="按分类筛选功能"/>
            </StackPanel>
            
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="RestoreBtn" Background="Transparent" CornerRadius="8" Padding="16,8" Cursor="Hand"
                        IsEnabled="False" IsHitTestVisible="False"
                        Focusable="True" KeyboardNavigation.IsTabStop="True" AutomationProperties.Name="备份与恢复"
                        MouseLeftButtonUp="RestoreBtn_Click" KeyDown="RestoreBtn_KeyDown"
                        MouseEnter="Restore_MouseEnter" MouseLeave="Restore_MouseLeave">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.BorderLight}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Token.Brush.BorderFocus}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock x:Name="RestoreDefaultText" Text="备份与恢复" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="{DynamicResource Token.FontSize.ModuleStatus}"/>
                </Border>
                <Popup x:Name="RestorePopup" PlacementTarget="{Binding ElementName=RestoreBtn}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                    <Border Background="{DynamicResource Theme.Brush.BackgroundSecondary}" CornerRadius="10" BorderBrush="{DynamicResource Theme.Brush.Border}" BorderThickness="1" Margin="0,6,0,0" Padding="6" MinWidth="180">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.4" Color="#000"/>
                        </Border.Effect>
                        <StackPanel>
                            <Border x:Name="RestoreUserMenuItem" Background="Transparent" CornerRadius="6" Padding="12,10" Cursor="Hand"
                                    Focusable="True" KeyboardNavigation.IsTabStop="True" AutomationProperties.Name="前往备份管理"
                                    MouseLeftButtonUp="Open_BackupManager_Click" KeyDown="Open_BackupManager_KeyDown"
                                    MouseEnter="MenuItem_MouseEnter" MouseLeave="MenuItem_MouseLeave">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Token.Brush.BorderFocus}"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock x:Name="RestoreUserText" Text="前往备份管理" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="{DynamicResource Token.FontSize.ModuleStatus}"/>
                                    <TextBlock x:Name="RestoreUserDescText" Text="创建或恢复已校验的快照和首次基线" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="{DynamicResource Token.FontSize.ModuleStatus}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Height="1" Background="{DynamicResource Theme.Brush.Border}" Margin="8,4"/>
                            <Border x:Name="RestoreWindowsMenuItem" Background="Transparent" CornerRadius="6" Padding="12,10" Cursor="Hand"
                                    Focusable="True" KeyboardNavigation.IsTabStop="True" AutomationProperties.Name="撤销本页已应用改动"
                                    MouseLeftButtonUp="Undo_ModuleChanges_Click" KeyDown="Undo_ModuleChanges_KeyDown"
                                    MouseEnter="MenuItem_MouseEnter" MouseLeave="MenuItem_MouseLeave">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Token.Brush.BorderFocus}"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock x:Name="RestoreWindowsText" Text="撤销本页已应用改动" Foreground="{DynamicResource Theme.Brush.ErrorAlt}" FontSize="{DynamicResource Token.FontSize.ModuleStatus}"/>
                                    <TextBlock x:Name="RestoreWindowsDescText" Text="仅恢复带有真实执行回执的设置" Foreground="{DynamicResource Theme.Brush.TextSecondary}" FontSize="{DynamicResource Token.FontSize.ModuleStatus}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>
        </Grid>
        </Border>

        <!-- Task 9.3: 模块扩展点 - 用于渲染模块特定的自定义控件 -->
        <ContentPresenter x:Name="ModuleExtensionContainer" 
                          Grid.Row="2" 
                          Margin="0,16,0,0"
                          Visibility="Collapsed"/>

        <!-- 列表区域 -->
        <ScrollViewer x:Name="ToggleListScrollViewer" Grid.Row="3" Margin="0,20,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <!-- The centered action island overlays only the non-interactive middle of rows.
                 The scroll tail lets the final row move fully above it at the end. -->
            <ItemsControl x:Name="GroupedItemsControl" Margin="0,0,0,112"/>
        </ScrollViewer>

        <!-- 空状态占位 — 筛选后无匹配项时显示 -->
        <Border x:Name="EmptyStatePanel" Grid.Row="3" Margin="0,20,0,90" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,60,0,0">
                <Border Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center" Margin="0,0,0,20"
                        Background="{DynamicResource Theme.Brush.SurfaceMuted}">
                    <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource Theme.Brush.TextMuted}"/>
                </Border>
                <TextBlock x:Name="EmptyStateTitleText" Text="" FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           Foreground="{DynamicResource Theme.Brush.TextSecondary}"/>
                <TextBlock x:Name="EmptyStateHintText" Text="" FontSize="{DynamicResource Token.FontSize.ModuleStatus}" Margin="0,8,0,0"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           Foreground="{DynamicResource Theme.Brush.TextMuted}"/>
            </StackPanel>
        </Border>

        <!-- 底部浮动岛屿 -->
        <Border x:Name="FooterActionIsland" Grid.Row="3" Panel.ZIndex="20"
                VerticalAlignment="Bottom" HorizontalAlignment="Center"
                CornerRadius="28" Margin="0,0,0,12" Padding="24,12"
                BorderBrush="{DynamicResource Theme.Brush.CardBorderSubtle}" BorderThickness="1">
            <Border.Background>
                <SolidColorBrush Color="{DynamicResource Theme.Background.Primary}" Opacity="0.92"/>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.42" Color="#000"/>
            </Border.Effect>
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Ellipse Grid.Column="0" x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource Theme.Brush.SuccessAlt}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="StatusText" Text="系统就绪" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <Border Grid.Column="2" Width="1" Height="14" Background="{DynamicResource Theme.Brush.BorderLight}" Margin="20,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SelectedLabel" Text="已选" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SelectedCountText" Text="0" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock x:Name="AppliedLabel" Text="生效" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="AppliedCountText" Text="0" Foreground="{DynamicResource Theme.Brush.AccentBlueLight}" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- OPT-011: 待处理操作提示 - 独立列，避免重叠 -->
                <TextBlock Grid.Column="5" x:Name="PendingActionHintText" Text="" 
                           Foreground="{DynamicResource Theme.Brush.WarningAlt}" 
                           FontSize="11" FontWeight="Medium" 
                           VerticalAlignment="Center" Margin="16,0,0,0" 
                           Visibility="Collapsed"/>
                
                <Border Grid.Column="6" Width="1" Height="14" Background="{DynamicResource Theme.Brush.BorderLight}" Margin="20,0" VerticalAlignment="Center"/>
                <Border Grid.Column="7" x:Name="ApplyBtnBorder" Background="{DynamicResource Theme.Brush.AccentBlue}" CornerRadius="18" Padding="24,10" Cursor="Hand" Opacity="0.5"
                        IsEnabled="False" IsHitTestVisible="False"
                        Focusable="True" KeyboardNavigation.IsTabStop="True" AutomationProperties.Name="立即应用更改"
                        MouseLeftButtonUp="ApplyBtn_Click" 
                        KeyDown="ApplyBtn_KeyDown"
                        PreviewMouseLeftButtonDown="ApplyBtn_PreviewMouseDown" 
                        PreviewMouseLeftButtonUp="ApplyBtn_PreviewMouseUp"
                        MouseEnter="ApplyBtn_MouseEnter" 
                        MouseLeave="ApplyBtn_MouseLeave" 
                        VerticalAlignment="Center"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource Token.Brush.BorderFocus}"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.3" Color="#3B82F6"/>
                    </Border.Effect>
                    <Grid IsHitTestVisible="False">
                        <StackPanel x:Name="ApplyNormalContent" Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock x:Name="ApplyBtnText" Text="立即应用更改" Foreground="{DynamicResource Theme.Brush.TextOnAccent}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </StackPanel>
                        <StackPanel x:Name="ApplyProgressContent" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock x:Name="ApplyProgressText" Text="应用中..." Foreground="{DynamicResource Theme.Brush.TextOnAccent}" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Keep loaded content visible while state is refreshed; only the compact status cue is shown. -->
        <Border x:Name="LoadingOverlay" Grid.RowSpan="4" Background="Transparent" Visibility="Collapsed" IsHitTestVisible="False">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="18,14"
                    Background="{DynamicResource Theme.Brush.BackgroundSecondary}"
                    BorderBrush="{DynamicResource Theme.Brush.GlassBorder}"
                    BorderThickness="1"
                    CornerRadius="10"
                    IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:ProgressRing Size="24"
                                           StrokeWidth="3"
                                           RingBrush="{DynamicResource Theme.Brush.Info}"
                                           Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="正在加载系统信息"
                                   Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="内容将在读取完成后自动更新"
                                   Foreground="{DynamicResource Theme.Brush.TextMuted}"
                                   FontSize="11"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>

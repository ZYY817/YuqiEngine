<Window x:Class="GameOptimizer.Shell.Views.ReleaseNoticeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:constants="clr-namespace:GameOptimizer.Shell.Constants"
        Title="测试版使用说明" Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="{DynamicResource Token.FontFamily.Body}"
        Closing="Window_Closing">
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.15"/>
                    <DoubleAnimation Storyboard.TargetName="CardTransform" Storyboard.TargetProperty="Y"
                                     From="6" To="0" Duration="0:0:0.15">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="Card" CornerRadius="12" Margin="12" SnapsToDevicePixels="True"
            Background="#FF18181B" BorderBrush="#22FFFFFF" BorderThickness="1"
            Effect="{DynamicResource Token.Shadow.Xl}">
        <Border.RenderTransform>
            <TranslateTransform x:Name="CardTransform"/>
        </Border.RenderTransform>

        <StackPanel>
            <!-- 标题行:图标 + 标题 + 版本号(右,可拖动) -->
            <Grid Margin="26,20,26,0" MouseLeftButtonDown="Header_Drag">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static constants:IconGlyphs.Warning}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="#E8A93C" VerticalAlignment="Center" Margin="0,0,9,0"/>
                    <TextBlock Text="测试版使用说明" FontSize="15" FontWeight="SemiBold"
                               Foreground="#F2F4F8" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="VersionText" FontSize="11" Foreground="#7E8490"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- 正文 -->
            <TextBlock Margin="26,14,26,0" FontSize="13" LineHeight="21" TextWrapping="Wrap"
                       Foreground="#C9CED6"
                       Text="这是一个测试版。旧版本源码已经遗失，本版正在重新制作，功能尚未全部完成，后续会在空闲时间逐步更新。"/>

            <!-- 三个要点:图标 + 粗体标签 + 说明 -->
            <StackPanel Margin="26,18,26,0">
                <Grid Margin="0,0,0,11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static constants:IconGlyphs.Check}" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               Foreground="#3DBE72" VerticalAlignment="Top" Margin="0,3,0,0"/>
                    <TextBlock Grid.Column="1" FontSize="13" LineHeight="20" TextWrapping="Wrap">
                        <Run Text="现在可以用" FontWeight="SemiBold" Foreground="#F2F4F8"/>
                        <Run Text=" —— 只使用首页“功能矩阵”中标记为可用的基础功能。" Foreground="#A5ABB5"/>
                    </TextBlock>
                </Grid>
                <Grid Margin="0,0,0,11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static constants:IconGlyphs.Warning}" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               Foreground="#E8A93C" VerticalAlignment="Top" Margin="0,3,0,0"/>
                    <TextBlock Grid.Column="1" FontSize="13" LineHeight="20" TextWrapping="Wrap">
                        <Run Text="暂时不要用" FontWeight="SemiBold" Foreground="#F2F4F8"/>
                        <Run Text=" —— 高级工具箱和深层系统调校还没做完，暂时不要使用。" Foreground="#A5ABB5"/>
                    </TextBlock>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static constants:IconGlyphs.ShieldCheck}" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               Foreground="#5B8FF0" VerticalAlignment="Top" Margin="0,3,0,0"/>
                    <TextBlock Grid.Column="1" FontSize="13" LineHeight="20" TextWrapping="Wrap">
                        <Run Text="使用前记得备份" FontWeight="SemiBold" Foreground="#F2F4F8"/>
                        <Run Text=" —— 建议先创建 Windows 系统还原点。" Foreground="#A5ABB5"/>
                    </TextBlock>
                </Grid>
            </StackPanel>

            <!-- 发丝线 -->
            <Border Height="1" Background="#14FFFFFF" Margin="0,16,0,0" SnapsToDevicePixels="True"/>

            <!-- 底部:勾选 + 按钮 -->
            <Grid Margin="26,14,20,18">
                <CheckBox x:Name="AcknowledgementCheckBox" Style="{DynamicResource Yuqi.SelectionCheckBox}" VerticalAlignment="Center"
                          Checked="AcknowledgementCheckBox_Changed" Unchecked="AcknowledgementCheckBox_Changed"
                          AutomationProperties.Name="确认已了解测试版使用范围">
                    <TextBlock Text="我已了解，会按上述范围使用" FontSize="13" Foreground="#C9CED6"/>
                </CheckBox>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="退出软件" Style="{DynamicResource Yuqi.GhostButton}" Height="34" Padding="12,0"
                            Click="ExitButton_Click" AutomationProperties.Name="退出软件"/>
                    <Button x:Name="ContinueButton" Content="进入软件" Height="34" MinWidth="96" Margin="10,0,0,0"
                            IsEnabled="False" IsDefault="True" Click="ContinueButton_Click"
                            AutomationProperties.Name="确认测试版说明并进入软件">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Yuqi.ToolButton}">
                                <Setter Property="Background" Value="#3B7FE8"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="13"/>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>

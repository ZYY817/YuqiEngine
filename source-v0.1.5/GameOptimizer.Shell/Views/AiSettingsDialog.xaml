<Window x:Class="GameOptimizer.Shell.Views.AiSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GameOptimizer.Shell.ViewModels"
        xmlns:ai="clr-namespace:GameOptimizer.Shell.Services.AiAssistant"
        d:DataContext="{d:DesignInstance Type=vm:AiAssistantViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AI 设置" Width="680" Height="740" MinHeight="560"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Border Background="{DynamicResource Theme.Brush.BackgroundSecondary}" CornerRadius="12"
            BorderThickness="1" BorderBrush="{DynamicResource Theme.Brush.BorderSubtle}"
            Effect="{DynamicResource Visual.Shadow.Dialog}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="{DynamicResource Theme.Brush.SurfaceMuted}"
                    CornerRadius="12,12,0,0" Padding="20,14"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="AI 设置" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.Brush.TextPrimaryAlt}"/>
                    <Button Content="✕" HorizontalAlignment="Right" Click="Close_Click"
                            Background="Transparent" Foreground="{DynamicResource Theme.Brush.TextMuted}"
                            BorderThickness="0" Width="28" Height="28" Cursor="Hand" FontSize="14">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Brush.CardBorder}"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,18">
                <StackPanel>

                    <!-- ── 连接配置 ── -->
                    <TextBlock Text="连接配置" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.Brush.TextPrimary}"/>
                    <TextBlock Text="OpenAI 兼容协议：OpenAI、DeepSeek、智谱、Kimi、通义、Ollama 等都支持"
                               FontSize="11" Margin="0,4,0,10"
                               Foreground="{DynamicResource Theme.Brush.TextMuted}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1.1*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="服务商" FontSize="11.5" Height="18" Margin="0,0,0,4"
                                       Foreground="{DynamicResource Theme.Brush.TextSecondary}"/>
                            <ComboBox ItemsSource="{Binding Providers}"
                                      SelectedItem="{Binding SelectedProvider}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ai:AiProviderPreset}">
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="模型" FontSize="11.5" Height="18" Margin="0,0,0,4"
                                       ToolTip="建议选标注『旗舰/更强』的模型，诊断和工具调用更准"
                                       Foreground="{DynamicResource Theme.Brush.TextSecondary}"/>
                            <ComboBox IsEditable="True"
                                      ItemsSource="{Binding ModelOptions}"
                                      Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="可下拉选择，也可直接键入模型名；自定义/中转站先填地址再点下方拉取">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ai:AiModelOption}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Id}"/>
                                            <TextBlock Text="{Binding Tier, StringFormat='  · {0}'}" FontSize="11"
                                                       Foreground="{DynamicResource Theme.Brush.TextMuted}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="↻ 从接口拉取模型列表" Padding="0" Margin="0,6,0,0"
                                    HorizontalAlignment="Left" FontSize="11" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{DynamicResource Theme.Brush.Accent}"
                                    Command="{Binding FetchModelsCommand}"
                                    IsEnabled="{Binding IsFetchingModels, Converter={StaticResource BooleanNegationConverter}}"
                                    ToolTip="向接口地址请求 GET /models，拿到该服务商真实可用的模型名（自定义/中转站必需）"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding ModelFetchStatus}" FontSize="10.5" Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Theme.Brush.TextMuted}"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="接口地址" FontSize="11.5" Height="18" Margin="0,0,0,4"
                                       Foreground="{DynamicResource Theme.Brush.TextSecondary}"/>
                            <Grid>
                                <TextBox x:Name="EndpointBox" VerticalContentAlignment="Center"
                                         Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="base URL（…/v1）或完整 /chat/completions 地址"/>
                                <TextBlock Text="例如 https://api.example.com/v1" IsHitTestVisible="False"
                                           VerticalAlignment="Center" Margin="13,0,0,0" FontSize="11.5"
                                           Foreground="{DynamicResource Theme.Brush.TextMuted}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text.Length, ElementName=EndpointBox}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="API 密钥（DPAPI 加密存储）" FontSize="11.5" Height="18" Margin="0,0,0,4"
                                       Foreground="{DynamicResource Theme.Brush.TextSecondary}"/>
                            <PasswordBox x:Name="ApiKeyBox" VerticalContentAlignment="Center" PasswordChanged="ApiKeyBox_PasswordChanged"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="自定义/中转站：填好接口地址和密钥后，点上方『拉取模型列表』拿到可用模型。密钥只在本机加密保存，不上传"
                               FontSize="10.5" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Theme.Brush.TextMuted}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="保存配置" Padding="16,5" Click="SaveConfig_Click"/>
                        <TextBlock Text="{Binding ConfigStatus}" FontSize="11" Margin="12,0,0,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Theme.Brush.TextMuted}"/>
                    </StackPanel>

                    <!-- ── 交互节奏 ── -->
                    <Border Background="{DynamicResource Theme.Brush.CardDivider}" Height="1" Margin="0,20,0,18"/>
                    <TextBlock Text="回答节奏" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.Brush.TextPrimary}"/>
                    <TextBlock Text="决定 AI 是一步步问诊引导，还是一次输出完整方案"
                               FontSize="11" Margin="0,4,0,10"
                               Foreground="{DynamicResource Theme.Brush.TextMuted}"/>
                    <RadioButton GroupName="AiMode" IsChecked="{Binding IsGuidedMode, Mode=TwoWay}">
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="问诊分轮（推荐）" FontSize="12.5" FontWeight="SemiBold"/>
                            <TextBlock Text="先诊断 → 问清症状 → 出分级清单 → 你挑编号 → 执行 → 复测。适合不确定问题在哪的情况"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Foreground="{DynamicResource Theme.Brush.TextMuted}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="AiMode" Margin="0,10,0,0"
                                 IsChecked="{Binding IsGuidedMode, Mode=TwoWay, Converter={StaticResource BooleanNegationConverter}}">
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="一次给全" FontSize="12.5" FontWeight="SemiBold"/>
                            <TextBlock Text="诊断后直接输出完整方案清单，你自己挑要执行的编号。适合明确知道要做什么的情况"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Foreground="{DynamicResource Theme.Brush.TextMuted}"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- ── 提示词与 Skill ── -->
                    <Border Background="{DynamicResource Theme.Brush.CardDivider}" Height="1" Margin="0,20,0,18"/>
                    <TextBlock Text="提示词与 Skill" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.Brush.TextPrimary}"/>
                    <TextBlock Text="每次对话注入给 AI 的角色设定与优化知识库。可直接编辑，改坏可恢复默认"
                               FontSize="11" Margin="0,4,0,10"
                               Foreground="{DynamicResource Theme.Brush.TextMuted}"/>
                    <StackPanel Margin="0,0,0,12">
                        <CheckBox IsChecked="{Binding UseSystemPrompt}">
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="启用角色提示词" FontSize="12.5" FontWeight="SemiBold"/>
                                <TextBlock Text="system-prompt.md —— 15 年系统架构师人设与问诊规则。关掉后 AI 只按通用助手回答"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Foreground="{DynamicResource Theme.Brush.TextMuted}"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{Binding UseSkill}" Margin="0,10,0,0">
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="启用 Skill 优化知识库" FontSize="12.5" FontWeight="SemiBold"/>
                                <TextBlock Text="SKILL/ITEMS/SAFETY.md —— 优化项库与安全红线。关掉后 AI 不再参考内置优化知识"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Foreground="{DynamicResource Theme.Brush.TextMuted}"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                    <Grid Margin="0,0,0,8">
                        <ComboBox Width="240" HorizontalAlignment="Left"
                                  ItemsSource="{Binding SkillFiles}"
                                  SelectedItem="{Binding SelectedSkillFile}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="打开文件夹" Padding="10,4" FontSize="11.5" Margin="0,0,6,0"
                                    Command="{Binding OpenSkillFolderCommand}"/>
                            <Button Content="恢复默认" Padding="10,4" FontSize="11.5" Margin="0,0,6,0"
                                    Command="{Binding ResetSkillFileCommand}"/>
                            <Button Content="保存" Padding="14,4" FontSize="11.5"
                                    Command="{Binding SaveSkillFileCommand}"/>
                        </StackPanel>
                    </Grid>
                    <TextBox Text="{Binding SkillEditorText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" AcceptsTab="True" Height="180"
                             VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                             FontFamily="Consolas" FontSize="11.5"/>
                    <TextBlock Text="{Binding SkillEditorStatus}" FontSize="11" Margin="0,6,0,0"
                               Foreground="{DynamicResource Theme.Brush.TextMuted}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>

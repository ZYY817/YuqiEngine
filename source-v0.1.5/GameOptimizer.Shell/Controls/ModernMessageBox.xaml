<Window x:Class="GameOptimizer.Shell.Controls.ModernMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Width="400" SizeToContent="Height">
    <Border Background="{DynamicResource Theme.Brush.RowBackground}" BorderBrush="{DynamicResource Theme.Brush.CardBorder}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Border Grid.Row="0" Background="{DynamicResource Theme.Brush.BackgroundSecondary}" CornerRadius="12,12,0,0" Padding="16,12"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock x:Name="TitleText" Text="提示" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="14" FontWeight="Medium"/>
                    <Button Content="✕" HorizontalAlignment="Right" Click="CloseButton_Click"
                            Background="Transparent" BorderThickness="0" Foreground="#6B6B70" 
                            FontSize="14" Cursor="Hand" Width="24" Height="24"/>
                </Grid>
            </Border>
            
            <StackPanel Grid.Row="1" Margin="24,20">
                <Border x:Name="IconBorder" Width="48" Height="48" CornerRadius="24" 
                        Background="#1A007AFF" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock x:Name="IconText" Text="&#xE946;" FontSize="20" 
                               FontFamily="Segoe MDL2 Assets"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="MessageText" Text="" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontSize="14" 
                           TextWrapping="Wrap" TextAlignment="Center" LineHeight="22"/>
            </StackPanel>
            
            <StackPanel x:Name="ButtonPanel" Grid.Row="2" Orientation="Horizontal" 
                        HorizontalAlignment="Center" Margin="24,0,24,20"/>
        </Grid>
    </Border>
</Window>

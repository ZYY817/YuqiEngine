<UserControl x:Class="GameOptimizer.Shell.Controls.ToastNotification"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GameOptimizer.Shell.Controls"
             x:Name="Root" Width="320">
    <UserControl.Resources>
        <Storyboard x:Key="SlideIn">
            <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.2"/>
            <ThicknessAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Margin"
                                From="20,0,0,0" To="0" Duration="0:0:0.2"/>
        </Storyboard>
        <Storyboard x:Key="SlideOut">
            <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.15"/>
            <ThicknessAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Margin"
                                To="20,0,0,0" Duration="0:0:0.15"/>
        </Storyboard>
    </UserControl.Resources>
    
    <Border x:Name="RootBorder" Background="#1C1C1E" BorderBrush="#26FFFFFF" BorderThickness="1" 
            CornerRadius="8" Padding="12" Margin="0,0,0,8" Opacity="0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Margin="0,0,12,0" VerticalAlignment="Top">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#1A007AFF"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ToastType, ElementName=Root}" Value="{x:Static local:ToastType.Success}">
                                <Setter Property="Background" Value="#1A34C759"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ToastType, ElementName=Root}" Value="{x:Static local:ToastType.Warning}">
                                <Setter Property="Background" Value="#1AFF9500"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ToastType, ElementName=Root}" Value="{x:Static local:ToastType.Error}">
                                <Setter Property="Background" Value="#1AFF3B30"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="ℹ️"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ToastType, ElementName=Root}" Value="{x:Static local:ToastType.Success}">
                                    <Setter Property="Text" Value="✓"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ToastType, ElementName=Root}" Value="{x:Static local:ToastType.Warning}">
                                    <Setter Property="Text" Value="⚠"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ToastType, ElementName=Root}" Value="{x:Static local:ToastType.Error}">
                                    <Setter Property="Text" Value="✕"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
            
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title, ElementName=Root}" Foreground="#FFFFFF" FontSize="13" FontWeight="Medium"/>
                <TextBlock Text="{Binding Message, ElementName=Root}" Foreground="#8E8E93" FontSize="12" 
                           TextWrapping="Wrap" Margin="0,2,0,0"
                           Visibility="{Binding HasMessage, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StackPanel>
            
            <Button Grid.Column="2" Click="CloseBtn_Click" Background="Transparent" BorderThickness="0" 
                    Cursor="Hand" Width="24" Height="24" VerticalAlignment="Top">
                <TextBlock Text="✕" Foreground="#8E8E93" FontSize="12"/>
            </Button>
        </Grid>
    </Border>
</UserControl>

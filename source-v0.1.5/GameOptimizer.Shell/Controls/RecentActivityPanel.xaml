<UserControl x:Class="GameOptimizer.Shell.Controls.RecentActivityPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Background="#1C1C1E" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="10" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="最近活动" Foreground="#FFFFFF" FontSize="14" FontWeight="Medium"/>
                <Button Content="清空" HorizontalAlignment="Right" Click="ClearBtn_Click"
                        Background="Transparent" BorderThickness="0" Foreground="#8E8E93" 
                        FontSize="12" Cursor="Hand" Padding="8,4"
                        Visibility="{Binding HasActivities, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
            
            <TextBlock Grid.Row="1" Text="暂无活动记录" Foreground="#48484A" FontSize="12" 
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding HasActivities, ElementName=Root, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
            
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Activities, ElementName=Root}"
                          Visibility="{Binding HasActivities, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#26FFFFFF" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" Foreground="#FFFFFF" FontSize="12" FontWeight="Medium"/>
                                    <TextBlock Text="{Binding Description}" Foreground="#8E8E93" FontSize="11" 
                                               TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                </StackPanel>
                                
                                <TextBlock Grid.Column="2" Text="{Binding TimeAgo}" Foreground="#48484A" FontSize="10" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</UserControl>

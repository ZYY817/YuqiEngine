<Window x:Class="GameOptimizer.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:GameOptimizer.Shell.ViewModels"
        xmlns:models="clr-namespace:GameOptimizer.Shell.Models"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:icons="clr-namespace:GameOptimizer.Shell.Constants"
        mc:Ignorable="d"
        x:Name="RootWindow"
        Title="宇奇引擎 Yuqi Engine" Width="1360" Height="860" MinWidth="1200" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="False" Background="{DynamicResource Theme.Brush.Background}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        d:DataContext="{d:DesignInstance viewModels:DashboardViewModel, IsDesignTimeCreatable=False}">
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="8" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Custom Elegant Window Control Button -->
        <Style x:Key="WinControlBtn" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#01000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextDisabled}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0CFFFFFF"/>
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextSecondary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Close Button with Red Glow on Hover -->
        <Style x:Key="WinCloseBtn" TargetType="Button" BasedOn="{StaticResource WinControlBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#01000000" CornerRadius="0">
                            <Grid x:Name="IconGrid">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#20EF4444"/>
                                <Setter Property="Foreground" Value="#EF4444"/>
                                <Setter TargetName="IconGrid" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#EF4444" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 一级导航选中态沿用旧版单层玻璃胶囊：蓝色 subtle 表面、细边框和轻投影。 -->
        <Style x:Key="GlassPillNavItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="8,1,8,1"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextSecondary}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="IsTabStop" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Pill" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="10" Padding="10,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="IconBg" Width="26" Height="26" CornerRadius="6" Background="Transparent" Margin="0,0,10,0">
                                    <Viewbox Width="16" Height="16" SnapsToDevicePixels="True">
                                        <Path x:Name="IconPath" Data="{Binding IconData}" Stretch="Uniform"
                                              Fill="Transparent" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              SnapsToDevicePixels="True"/>
                                    </Viewbox>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" FontWeight="{TemplateBinding FontWeight}" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Theme.Brush.NavItemHover}"/>
                                <Setter TargetName="IconBg" Property="Background" Value="{DynamicResource Theme.Brush.NavItemHover}"/>
                            </Trigger>
                            <!-- ListBoxItem has no ButtonBase.IsPressed; mouse capture is its pressed visual state. -->
                            <Trigger Property="IsMouseCaptureWithin" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Theme.Brush.NavItemPressed}"/>
                                <Setter TargetName="Pill" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextPrimary}"/>
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Theme.Brush.NavItemSelected}"/>
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Theme.Brush.NavItemSelectedBorder}"/>
                                <Setter TargetName="Pill" Property="BorderThickness" Value="1"/>
                                <Setter TargetName="Pill" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="IconBg" Property="Background" Value="{DynamicResource Theme.Brush.NavItemSelectedIconBackground}"/>
                                <Setter TargetName="IconBg" Property="CornerRadius" Value="8"/>
                                <Setter TargetName="IconPath" Property="Stroke" Value="{DynamicResource Theme.Brush.ControlAccent}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseCaptureWithin" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Theme.Brush.NavItemPressed}"/>
                                <Setter TargetName="Pill" Property="Effect" Value="{x:Null}"/>
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Theme.Brush.ControlAccent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextMuted}"/>
                                <Setter TargetName="Pill" Property="Background" Value="Transparent"/>
                                <Setter TargetName="Pill" Property="BorderBrush" Value="Transparent"/>
                                <Setter TargetName="Pill" Property="BorderThickness" Value="0"/>
                                <Setter TargetName="IconBg" Property="Background" Value="Transparent"/>
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Nav Item Template -->
        <DataTemplate x:Key="NavItemTemplate" DataType="{x:Type models:NavigationSectionModel}">
            <Grid ToolTipService.ToolTip="{Binding Subtitle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="26" Height="26" CornerRadius="0" Background="Transparent" Margin="0,0,10,0">
                    <Viewbox Width="16" Height="16" SnapsToDevicePixels="True">
                        <Path Data="{Binding IconData}" Stretch="Uniform" Fill="Transparent"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                              StrokeThickness="1.7" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" SnapsToDevicePixels="True"/>
                    </Viewbox>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13"
                           FontWeight="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=FontWeight}"
                           VerticalAlignment="Center"
                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/>
            </Grid>
        </DataTemplate>
        
        <!-- Group Header - quiet section label; hierarchy comes from restraint. -->
        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.TextMuted}"/>
            <Setter Property="Opacity" Value="0.85"/>
            <Setter Property="Margin" Value="18,20,18,9"/>
        </Style>
        
        <!-- Invisible Scrollbar - Fully transparent but functional -->
        <Style x:Key="InvisibleScrollBarThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="InvisibleScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource InvisibleScrollBarThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="InvisibleScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Style="{StaticResource InvisibleScrollBar}"
                                       HorizontalAlignment="Right"
                                       Orientation="Vertical"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Hidden Scrollbar - Invisible but scrollable with mouse wheel -->
        <Style x:Key="HiddenScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Orientation="Vertical"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Sidebar and content scrollbars share the same accessible hit target and thumb states. -->
        <!-- Sidebar：极细常驻（3px 滑块、30% 不透明度），悬停/键盘聚焦/拖拽时增强。 -->
        <Style x:Key="SidebarScrollThumb" TargetType="Thumb">
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.ScrollbarThumb}"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbSurface" Background="{TemplateBinding Background}"
                                CornerRadius="1" Width="2" HorizontalAlignment="Right" MinHeight="28"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource Theme.Brush.ScrollbarThumbHover}"/></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource Theme.Brush.ScrollbarThumbDragging}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.15"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Root" Background="{TemplateBinding Background}">
                            <!-- Full-height 1px rail: reads as a subtle edge hairline instead of a floating bar. -->
                            <Border x:Name="RailLine" Width="1" HorizontalAlignment="Right" Background="{DynamicResource Theme.Brush.ScrollbarThumb}" Opacity="0.7"/>
                            <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource Yuqi.ScrollPage}"/></Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb x:Name="PART_Thumb" Style="{StaticResource SidebarScrollThumb}"/></Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource Yuqi.ScrollPage}"/></Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="Height" Value="8"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                <Setter TargetName="RailLine" Property="Width" Value="Auto"/>
                                <Setter TargetName="RailLine" Property="Height" Value="1"/>
                                <Setter TargetName="RailLine" Property="HorizontalAlignment" Value="Stretch"/>
                                <Setter TargetName="RailLine" Property="VerticalAlignment" Value="Bottom"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.9"/></Trigger>
                <Trigger Property="IsMouseCaptureWithin" Value="True"><Setter Property="Opacity" Value="0.9"/></Trigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Value="True"><Setter Property="Opacity" Value="0.45"/></DataTrigger>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Value="True"><Setter Property="Opacity" Value="0.45"/></DataTrigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="SidebarScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter Margin="0,0,12,0"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Style="{StaticResource SidebarScrollBar}"
                                       HorizontalAlignment="Right"
                                       Orientation="Vertical"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="PART_VerticalScrollBar" Property="Opacity" Value="1"/></Trigger>
                            <!-- Flash the rail while wheel/touch scrolling, then fade back to the resting hairline. -->
                            <EventTrigger RoutedEvent="ScrollViewer.ScrollChanged">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_VerticalScrollBar" Storyboard.TargetProperty="Opacity" FillBehavior="Stop">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.85"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.7" Value="0.85"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:1.4" Value="0.15"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Overlay viewers retain their reveal behavior while reusing the common scrollbar. -->
        <Style x:Key="OverlayScrollBar" TargetType="ScrollBar" BasedOn="{StaticResource Yuqi.ScrollBar.Base}">
            <Setter Property="Opacity" Value="0.3"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="OverlayScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter Margin="0,0,0,0"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Style="{StaticResource OverlayScrollBar}"
                                       HorizontalAlignment="Right"
                                       Orientation="Vertical"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Grouped Navigation -->
        <CollectionViewSource x:Key="GroupedNavItems">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="GroupTitle"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>
    
    <!-- AdornerDecorator: 引导系统 Adorner 层必须在此 -->
    <AdornerDecorator>
    <!-- Shell 与工作区使用独立表面，所有页面从这里获得稳定承载层。 -->
    <Border x:Name="RootContainer" CornerRadius="0" BorderThickness="1" BorderBrush="{DynamicResource Shell.Frame.Brush.OuterBorder}">
        <Border.Background>
            <DynamicResource ResourceKey="Theme.Brush.ShellBackground"/>
        </Border.Background>
        <!-- Keep the desktop shell rectilinear in both light and dark themes. -->
        <Border CornerRadius="0" ClipToBounds="True">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Title Bar - Seamless Glass Header -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Left: Brand -->
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Rectangle Width="24" Height="24" Margin="0,0,10,0"
                                   Fill="{DynamicResource Theme.Brush.LogoMark}"
                                   SnapsToDevicePixels="True"
                                   AutomationProperties.Name="宇奇引擎 Logo">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="/Assets/yuqi-engine-mark.png" Stretch="Uniform"/>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <TextBlock Text="宇奇引擎" FontSize="14" FontWeight="Bold" Foreground="#22D3EE" VerticalAlignment="Center"/>
                        <TextBlock Text=" Yuqi" FontSize="14" FontWeight="Bold" Foreground="#3B82F6" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        <TextBlock Text=" Engine" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Brush.TextPrimary}" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource Theme.Brush.CardBackgroundHover}" CornerRadius="0" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleVersionText" FontSize="10" Foreground="{DynamicResource Theme.Brush.TextMuted}" FontWeight="Medium"/>
                        </Border>
                    </StackPanel>
                    
                    <!-- Right: Custom Window Controls -->
                    <Border Grid.Column="1" Background="Transparent" Margin="0,0,0,0">
                        <StackPanel Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button x:Name="AiAssistantButton" Width="92"
                                    AutomationProperties.AutomationId="AiAssistantButton"
                                    AutomationProperties.Name="AI 助手"
                                    Style="{StaticResource WinControlBtn}"
                                    FocusVisualStyle="{StaticResource Token.FocusVisualStyle}"
                                    Click="AiAssistantButton_Click"
                                    ToolTip="AI 助手：对话式系统优化"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Width="13" Height="13" Margin="0,0,5,0" Stretch="Uniform"
                                          Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                          Data="M12,3 L13.8,8.6 L19.5,10.4 L13.8,12.2 L12,17.8 L10.2,12.2 L4.5,10.4 L10.2,8.6 Z M19,15 L19.7,17 L21.7,17.7 L19.7,18.4 L19,20.4 L18.3,18.4 L16.3,17.7 L18.3,17 Z"/>
                                    <TextBlock x:Name="AiAssistantButtonText" Text="AI 助手" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="GitHubProjectButton" Width="92"
                                    AutomationProperties.AutomationId="GitHubProjectButton"
                                    AutomationProperties.Name="GitHub 项目"
                                    Style="{StaticResource WinControlBtn}"
                                    FocusVisualStyle="{StaticResource Token.FocusVisualStyle}"
                                    Click="GitHubProjectButton_Click"
                                    ToolTip="打开 GitHub 项目"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                <TextBlock x:Name="GitHubProjectText" Text="GitHub 项目" FontSize="11" FontWeight="SemiBold" />
                            </Button>
                            <Button x:Name="AboutButton" Width="84" AutomationProperties.AutomationId="AboutButton" AutomationProperties.Name="作者信息" Style="{StaticResource WinControlBtn}" FocusVisualStyle="{StaticResource Token.FocusVisualStyle}" Click="AboutButton_Click" ToolTip="作者信息" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid Width="14" Height="14" Margin="0,0,5,0">
                                        <Ellipse Width="14" Height="14" StrokeThickness="1.2"
                                                 Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                 Fill="Transparent"/>
                                        <TextBlock Text="i" FontSize="10" FontWeight="Bold" FontStyle="Italic"
                                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                    </Grid>
                                    <TextBlock x:Name="AboutButtonText" Text="作者信息" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="SupportAuthorHeaderButton" Width="84"
                                    AutomationProperties.AutomationId="SupportAuthorHeaderButton"
                                    AutomationProperties.Name="支持作者"
                                    Style="{StaticResource WinControlBtn}"
                                    FocusVisualStyle="{StaticResource Token.FocusVisualStyle}"
                                    Click="SupportAuthorButton_Click"
                                    ToolTip="支持作者"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Width="14" Height="14" Margin="0,0,5,0" Stretch="Uniform"
                                          Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                          Data="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                                    <TextBlock x:Name="SupportAuthorHeaderButtonText" Text="支持作者" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="FeedbackButton" Width="64"
                                    AutomationProperties.AutomationId="FeedbackButton"
                                    AutomationProperties.Name="反馈"
                                    Style="{StaticResource WinControlBtn}"
                                    FocusVisualStyle="{StaticResource Token.FocusVisualStyle}"
                                    Click="FeedbackButton_Click"
                                    ToolTip="打开 GitHub 反馈"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                <TextBlock x:Name="FeedbackButtonText" Text="反馈" FontSize="11" FontWeight="SemiBold" />
                            </Button>
                            <!-- Minimize: Thin Wide Line -->
                            <Button x:Name="MinimizeButton" AutomationProperties.AutomationId="MinimizeButton" Style="{StaticResource WinControlBtn}" Click="MinimizeButton_Click" ToolTip="最小化" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                <Border Width="14" Height="1" Background="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" CornerRadius="0"/>
                            </Button>
                            <!-- Maximize: Thin Square Outline -->
                            <Button x:Name="MaximizeButton" AutomationProperties.AutomationId="MaximizeButton" Style="{StaticResource WinControlBtn}" Click="MaximizeButton_Click" ToolTip="最大化" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                <Border Width="12" Height="12" BorderThickness="1.2" BorderBrush="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" CornerRadius="0" Background="Transparent"/>
                            </Button>
                            <!-- Close: Thin X -->
                            <Button x:Name="CloseButton" Style="{StaticResource WinCloseBtn}" Click="CloseButton_Click" ToolTip="关闭" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                <!-- FIX-CLOSE-X: 使用 Path 替代 Border+RotateTransform，避免 DPI/驱动渲染偏移 -->
                                <Path Width="12" Height="12" Stretch="Uniform"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 0,0 L 10,10 M 10,0 L 0,10"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            
            <!-- Main Content Area -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Sidebar：与右侧工作区形成稳定的全局层级。 -->
                <Border Grid.Column="0" Background="{DynamicResource Theme.Brush.SidebarBackground}"
                        BorderBrush="{DynamicResource Theme.Brush.SidebarSeparator}" BorderThickness="0,0,1,0"
                        PreviewMouseWheel="SidebarScrollViewer_PreviewMouseWheel">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Navigation List with Groups - Hidden Scrollbar with Manual Scroll -->
                        <ScrollViewer x:Name="SidebarScrollViewer" Grid.Row="0"
                                      Style="{StaticResource SidebarScrollViewer}"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Margin="0,8,0,0" CanContentScroll="False" PanningMode="VerticalOnly">
                            <Grid x:Name="NavigationIndicatorHost" ClipToBounds="True">
                                <ListBox x:Name="PrimaryNavigationList"
                                     AutomationProperties.Name="主导航"
                                     ItemsSource="{Binding Source={StaticResource GroupedNavItems}}"
                                     SelectedItem="{Binding SelectedNavigationSection, ElementName=RootWindow, Mode=OneWay}"
                                     SelectionChanged="NavigationListBox_SelectionChanged"
                                     PreviewMouseLeftButtonUp="PrimaryNavigationList_PreviewMouseLeftButtonUp"
                                     ItemContainerStyle="{StaticResource GlassPillNavItem}"
                                     ItemTemplate="{StaticResource NavItemTemplate}"
                                     Background="Transparent" BorderThickness="0"
                                     VirtualizingPanel.IsVirtualizing="False"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     ScrollViewer.CanContentScroll="False"
                                     Padding="0,0,0,16">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource GroupHeader}"/>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                </ListBox>
                            </Grid>
                        </ScrollViewer>
                        
                        <!-- Footer - Deep Glass Card -->
                        <Border Grid.Row="1" BorderBrush="{DynamicResource Theme.Brush.SidebarSeparator}" BorderThickness="0,1,0,0" Padding="12,10">
                            <Border CornerRadius="8" Padding="10,8" BorderBrush="{DynamicResource Theme.Brush.CardBorderSubtle}" BorderThickness="1">
                                <Border.Background>
                                    <SolidColorBrush Color="{StaticResource Theme.Role.SurfaceRaised}" Opacity="0.55"/>
                                </Border.Background>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Left: Shield Icon with Status Dot -->
                                    <Grid Width="32" Height="32" Margin="0,0,10,0">
                                        <Border Background="{DynamicResource Theme.Brush.CardBackground}" CornerRadius="8">
                                            <Path Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z" 
                                                  Fill="{DynamicResource Theme.Brush.IconSecondary}" Width="16" Height="16" Stretch="Uniform" 
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Ellipse x:Name="AdminStatusDot" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2">
                                            <Ellipse.Fill>
                                                <SolidColorBrush Color="#22C55E"/>
                                            </Ellipse.Fill>
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#22C55E" BlurRadius="4" ShadowDepth="0" Opacity="0.8"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                    </Grid>
                                    
                                    <!-- Middle: Text -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="AdminModeText" Text="普通模式运行中" FontSize="12" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="StatusVersionText" FontSize="10" Foreground="{DynamicResource Theme.Brush.TextMuted}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    
                                    <!-- Right: Support Author Heart Button -->
                                    <Button x:Name="SupportAuthorButton" AutomationProperties.AutomationId="SupportAuthorButton" Grid.Column="2" Click="SupportAuthorButton_Click" ToolTip="支持作者" Cursor="Hand"
                                            Background="Transparent" BorderThickness="0" Padding="4" VerticalAlignment="Center" Margin="0,0,6,0"
                                            FocusVisualStyle="{x:Null}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid Background="Transparent" RenderTransformOrigin="0.5,0.5">
                                                    <Grid.RenderTransform>
                                                        <ScaleTransform x:Name="HeartScale" ScaleX="1" ScaleY="1"/>
                                                    </Grid.RenderTransform>
                                                    <Path x:Name="HeartPath"
                                                          Data="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                                                          Fill="#F472B6" Width="16" Height="16" Stretch="Uniform"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="HeartPath" Property="Fill" Value="#F43F5E"/>
                                                    </Trigger>
                                                    <EventTrigger RoutedEvent="MouseEnter">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="HeartScale" Storyboard.TargetProperty="ScaleX" To="1.2" Duration="0:0:0.15"/>
                                                                <DoubleAnimation Storyboard.TargetName="HeartScale" Storyboard.TargetProperty="ScaleY" To="1.2" Duration="0:0:0.15"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                    <EventTrigger RoutedEvent="MouseLeave">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="HeartScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                                                                <DoubleAnimation Storyboard.TargetName="HeartScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    
                                    <!-- Right: Settings Gear - Transparent, No Focus Background -->
                                    <Button x:Name="SettingsButton" AutomationProperties.AutomationId="SettingsButton" Grid.Column="3" Click="SettingsButton_Click" ToolTip="设置" Cursor="Hand" 
                                            Background="Transparent" BorderThickness="0" Padding="4" VerticalAlignment="Center"
                                            FocusVisualStyle="{x:Null}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid Background="Transparent" RenderTransformOrigin="0.5,0.5">
                                                    <Grid.RenderTransform>
                                                        <RotateTransform x:Name="GearRotate" Angle="0"/>
                                                    </Grid.RenderTransform>
                                                    <Path x:Name="GearPath" 
                                                          Data="M19.14 12.94c.04-.31.06-.63.06-.94 0-.31-.02-.63-.06-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.04.31-.06.63-.06.94s.02.63.06.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" 
                                                          Fill="{DynamicResource Theme.Brush.IconMuted}" Width="16" Height="16" Stretch="Uniform"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="GearPath" Property="Fill" Value="{DynamicResource Theme.Brush.IconSecondary}"/>
                                                    </Trigger>
                                                    <EventTrigger RoutedEvent="MouseEnter">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="GearRotate" 
                                                                                 Storyboard.TargetProperty="Angle" 
                                                                                 To="90" Duration="0:0:0.3"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                    <EventTrigger RoutedEvent="MouseLeave">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="GearRotate" 
                                                                                 Storyboard.TargetProperty="Angle" 
                                                                                 To="0" Duration="0:0:0.3"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </Border>
                    </Grid>
                </Border>
                
                <!-- Sidebar Light Beam Divider -->
                <Border Grid.Column="0" HorizontalAlignment="Right" Width="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="#15FFFFFF" Offset="0.2"/>
                            <GradientStop Color="#15FFFFFF" Offset="0.8"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                
                <!-- 全部页面共享工作区底板；功能模块可在其上叠加受控氛围层。 -->
                <Grid Grid.Column="1" Background="{DynamicResource Theme.Brush.AppBackground}">
                    <Border x:Name="AmbientBackdrop" IsHitTestVisible="False" Visibility="Collapsed">
                        <Border.Background>
                            <RadialGradientBrush Center="0.85,0.05" RadiusX="0.55" RadiusY="0.45">
                                <GradientStop Color="{DynamicResource Theme.Color.HeroGlow}" Offset="0"/>
                                <GradientStop Color="{DynamicResource Theme.Background.Primary}" Offset="1"/>
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <ContentControl x:Name="OverviewPageHost"/>
                    <ContentControl x:Name="RestorePointPageHost"/>
                    <ContentControl x:Name="RepairCenterPageHost"/>
                    <ContentControl x:Name="BackupManagerPageHost"/>
                    <ContentControl x:Name="CpuAffinityPageHost"/>
                    <ContentControl x:Name="CoreAcceleratorPageHost"/>
                    <ContentControl x:Name="CpuCoreManagementPageHost"/>
                    <ContentControl x:Name="SystemCleanupPageHost"/>
                    <ContentControl x:Name="AppxCleanupPageHost"/>
                    <ContentControl x:Name="HardwareInfoPageHost"/>
                    <ContentControl x:Name="NetworkTestPageHost"/>
                    <ContentControl x:Name="CpuModulePageHost"/>
                    <ContentControl x:Name="GraphicsModulePageHost"/>
                    <ContentControl x:Name="NetworkModulePageHost"/>
                    <ContentControl x:Name="PrivacyModulePageHost"/>
                    <ContentControl x:Name="SystemModulePageHost"/>
                    <ContentControl x:Name="ExplorerModulePageHost"/>
                    <ContentControl x:Name="TasksModulePageHost"/>
                    <ContentControl x:Name="ServicesModulePageHost"/>
                    <ContentControl x:Name="PeripheralModulePageHost"/>
                    <ContentControl x:Name="AudioOptimizationPageHost"/>
                    <ContentControl x:Name="PerformanceBoostPageHost"/>
                    <ContentControl x:Name="MemoryOptimizationPageHost"/>
                    <ContentControl x:Name="PowerPlanEditorPageHost"/>
                    <ContentControl x:Name="EsportsModePageHost"/>
                    <ContentControl x:Name="AiAssistantPageHost"/>
                    <ContentControl x:Name="SettingsPageHost"/>
                    <ContentControl x:Name="ModulePageHost"/>
                    <ContentControl x:Name="StartupManagerPageHost"/>
                </Grid>
            </Grid>
            
            <!-- Toast Container -->
            <StackPanel x:Name="ToastContainer" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0"/>

            <!-- Decorative shell layers stay inside the client bounds and never participate in hit testing. -->
            <Border x:Name="ShellFrameAmbient"
                    Grid.RowSpan="2" Height="72" VerticalAlignment="Top" Margin="2"
                    Background="{DynamicResource Shell.Frame.Brush.Ambient}"
                    IsHitTestVisible="False"/>
            <Border x:Name="ShellFrameInnerHighlight"
                    Grid.RowSpan="2" Margin="1"
                    BorderThickness="1,1,1,0"
                    BorderBrush="{DynamicResource Shell.Frame.Brush.InnerHighlight}"
                    IsHitTestVisible="False"/>
        </Grid>
        </Border>
    </Border>
    </AdornerDecorator>
</Window>
